-- DB03 S22: conservative full-bank-return report, not independently verified bank truth.
-- A report suspends all applicant allocations, and records exact compensating
-- allocation reversal evidence. No original payment/allocation is ever modified.
SET ROLE schoolos_schema_owner;
CREATE TABLE app_private.finance_admission_payment_returns(
 id uuid PRIMARY KEY DEFAULT pg_catalog.gen_random_uuid(),
 application_id uuid NOT NULL,
 school_id uuid NOT NULL,
 campus_id uuid NOT NULL,
 payment_id uuid NOT NULL UNIQUE,
 amount_minor numeric(20,0) NOT NULL CHECK(amount_minor>0 AND amount_minor=trunc(amount_minor)),
 currency_code text NOT NULL CHECK(currency_code ~ '^[A-Z]{3}$'),
 return_kind text NOT NULL CHECK(return_kind IN
  ('BANK_RETURN_REPORTED','CHARGEBACK_REPORTED','DUPLICATE_TRANSFER_REPORTED')),
 bank_reference_private text NOT NULL CHECK(length(btrim(bank_reference_private)) BETWEEN 4 AND 160),
 reason_private text NOT NULL CHECK(length(btrim(reason_private)) BETWEEN 5 AND 1000),
 reported_by uuid NOT NULL REFERENCES app_private.principals(id)
   ON UPDATE RESTRICT ON DELETE RESTRICT,
 reported_at timestamptz NOT NULL DEFAULT pg_catalog.transaction_timestamp(),
 CONSTRAINT db03_return_payment_source FOREIGN KEY
  (payment_id,application_id,school_id,campus_id,currency_code)
  REFERENCES app_private.finance_admission_official_payments
  (id,application_id,school_id,campus_id,currency_code)
  ON UPDATE RESTRICT ON DELETE RESTRICT,
 CONSTRAINT db03_return_reference_unique UNIQUE(school_id,bank_reference_private)
);
CREATE INDEX db03_returns_application ON app_private.finance_admission_payment_returns
 (application_id,reported_at,id);

CREATE TABLE app_private.finance_admission_allocation_reversals(
 id uuid PRIMARY KEY DEFAULT pg_catalog.gen_random_uuid(),
 return_id uuid NOT NULL REFERENCES app_private.finance_admission_payment_returns(id)
  ON UPDATE RESTRICT ON DELETE RESTRICT,
 allocation_id uuid NOT NULL UNIQUE REFERENCES app_private.finance_admission_payment_allocations(id)
  ON UPDATE RESTRICT ON DELETE RESTRICT,
 application_id uuid NOT NULL,
 payment_id uuid NOT NULL,
 reversal_minor numeric(20,0) NOT NULL CHECK(reversal_minor>0),
 recorded_by uuid NOT NULL REFERENCES app_private.principals(id)
  ON UPDATE RESTRICT ON DELETE RESTRICT,
 created_at timestamptz NOT NULL DEFAULT pg_catalog.transaction_timestamp()
);
CREATE INDEX db03_reversals_return ON app_private.finance_admission_allocation_reversals(return_id);

CREATE FUNCTION app_private.db03_guard_bank_return() RETURNS trigger
LANGUAGE plpgsql SECURITY INVOKER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE pay app_private.finance_admission_official_payments%ROWTYPE;
BEGIN
 IF TG_OP<>'INSERT' THEN RAISE EXCEPTION 'DB03 bank return history is immutable'; END IF;
 IF current_user<>'schoolos_schema_owner' THEN
  RAISE EXCEPTION 'DB03 bank return requires trusted Finance authority'; END IF;
 SELECT * INTO pay FROM app_private.finance_admission_official_payments
 WHERE id=NEW.payment_id FOR UPDATE;
 IF pay.id IS NULL OR pay.application_id<>NEW.application_id
  OR pay.school_id<>NEW.school_id OR pay.campus_id<>NEW.campus_id
  OR pay.currency_code<>NEW.currency_code
  OR pay.amount_minor<>NEW.amount_minor
  OR pay.created_by=NEW.reported_by
  OR NOT EXISTS(SELECT 1 FROM app_private.principals p
    WHERE p.id=NEW.reported_by AND p.kind='INDIVIDUAL' AND p.state='ACTIVE') THEN
  RAISE EXCEPTION 'DB03 bank return source mismatch'; END IF;
 RETURN NEW;
END $body$;
CREATE FUNCTION app_private.db03_guard_allocation_reversal() RETURNS trigger
LANGUAGE plpgsql SECURITY INVOKER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE r app_private.finance_admission_payment_returns%ROWTYPE;
 a app_private.finance_admission_payment_allocations%ROWTYPE;
BEGIN
 IF TG_OP<>'INSERT' THEN
  RAISE EXCEPTION 'DB03 allocation reversal history is immutable'; END IF;
 IF current_user<>'schoolos_schema_owner' THEN
  RAISE EXCEPTION 'DB03 allocation reversal requires trusted Finance authority'; END IF;
 SELECT * INTO r FROM app_private.finance_admission_payment_returns
  WHERE id=NEW.return_id;
 SELECT * INTO a FROM app_private.finance_admission_payment_allocations
  WHERE id=NEW.allocation_id;
 IF r.id IS NULL OR a.id IS NULL OR a.application_id<>r.application_id
  OR a.payment_id<>r.payment_id
  OR a.allocated_minor<>NEW.reversal_minor
  OR a.application_id<>NEW.application_id
  OR a.payment_id<>NEW.payment_id OR NEW.recorded_by<>r.reported_by THEN
  RAISE EXCEPTION 'DB03 allocation reversal source mismatch'; END IF;
 RETURN NEW;
END $body$;

-- Executed as a separate BEFORE INSERT trigger after S20's immutability guard.
-- Any reported return places the whole applicant on reconciliation hold.
CREATE FUNCTION app_private.db03_s22_block_returned_allocations()
RETURNS trigger LANGUAGE plpgsql SECURITY INVOKER
SET search_path=pg_catalog,pg_temp AS $body$
BEGIN
 IF EXISTS(SELECT 1 FROM app_private.finance_admission_payment_returns
   WHERE application_id=NEW.application_id) THEN
  RAISE EXCEPTION 'DB03 allocation suspended: bank return reconciliation required';
 END IF;
 RETURN NEW;
END $body$;
CREATE TRIGGER zz_db03_s22_return_allocation_fence BEFORE INSERT
 ON app_private.finance_admission_payment_allocations FOR EACH ROW
 EXECUTE FUNCTION app_private.db03_s22_block_returned_allocations();

ALTER TABLE app_private.finance_admission_payment_returns ENABLE ROW LEVEL SECURITY;
ALTER TABLE app_private.finance_admission_payment_returns FORCE ROW LEVEL SECURITY;
ALTER TABLE app_private.finance_admission_allocation_reversals ENABLE ROW LEVEL SECURITY;
ALTER TABLE app_private.finance_admission_allocation_reversals FORCE ROW LEVEL SECURITY;
REVOKE ALL ON app_private.finance_admission_payment_returns,
 app_private.finance_admission_allocation_reversals
 FROM PUBLIC,anon,authenticated,service_role,schoolos_file_login,
 schoolos_platform_executor,schoolos_workflow_executor,schoolos_evidence_writer;
CREATE POLICY db03_return_owner ON app_private.finance_admission_payment_returns
 TO schoolos_schema_owner USING(true) WITH CHECK(true);
CREATE POLICY db03_reversal_owner ON app_private.finance_admission_allocation_reversals
 TO schoolos_schema_owner USING(true) WITH CHECK(true);
CREATE TRIGGER db03_bank_return_immutable BEFORE INSERT OR UPDATE OR DELETE
 ON app_private.finance_admission_payment_returns FOR EACH ROW
 EXECUTE FUNCTION app_private.db03_guard_bank_return();
CREATE TRIGGER db03_bank_return_no_truncate BEFORE TRUNCATE
 ON app_private.finance_admission_payment_returns FOR EACH STATEMENT
 EXECUTE FUNCTION app_private.db03_guard_bank_return();
CREATE TRIGGER db03_bank_reversal_immutable BEFORE INSERT OR UPDATE OR DELETE
 ON app_private.finance_admission_allocation_reversals FOR EACH ROW
 EXECUTE FUNCTION app_private.db03_guard_allocation_reversal();
CREATE TRIGGER db03_bank_reversal_no_truncate BEFORE TRUNCATE
 ON app_private.finance_admission_allocation_reversals FOR EACH STATEMENT
 EXECUTE FUNCTION app_private.db03_guard_allocation_reversal();
REVOKE ALL ON FUNCTION app_private.db03_guard_bank_return(),
 app_private.db03_guard_allocation_reversal(),
 app_private.db03_s22_block_returned_allocations()
 FROM PUBLIC,anon,authenticated,service_role,schoolos_file_login;
RESET ROLE;
