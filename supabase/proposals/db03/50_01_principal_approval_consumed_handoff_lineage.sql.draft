-- DB03 P46B-2B2A: mandatory one-to-one Principal APPROVE / CONSUMED handoff.
-- INACTIVE exact-source relational prerequisite, NOT the final approval writer.
-- At transaction COMMIT an approved record must have the exact CONSUMED
-- Admissions -> D1 handoff (and vice versa), with the same application,
-- forwarded documents, policy snapshot, version/epoch and command receipt.
-- P44, P38, P41 deny-all writers stay active; no user grants or production DML.
SET ROLE schoolos_schema_owner;
ALTER TABLE app_private.admission_application_policy_snapshots
 ADD CONSTRAINT db03_approval_snapshot_forward_receipt_source
 UNIQUE(id,application_id,application_version,stage_epoch,
        forward_id,command_receipt_id);
ALTER TABLE app_private.admission_student_handoffs
 ADD CONSTRAINT db03_approval_handoff_consumed_source
 UNIQUE(id,application_id,state);
CREATE TABLE app_private.admission_principal_approvals (
 id uuid PRIMARY KEY DEFAULT pg_catalog.gen_random_uuid(),
 application_id uuid NOT NULL UNIQUE
  REFERENCES app_private.admission_applications(id)
  ON UPDATE RESTRICT ON DELETE RESTRICT,
 handoff_id uuid NOT NULL UNIQUE,
 forward_id uuid NOT NULL,
 policy_snapshot_id uuid NOT NULL UNIQUE,
 application_version bigint NOT NULL CHECK(application_version>0),
 stage_epoch bigint NOT NULL CHECK(stage_epoch>0),
 approval_receipt_id uuid NOT NULL UNIQUE
  REFERENCES app_private.command_receipts(id)
  DEFERRABLE INITIALLY DEFERRED,
 required_handoff_state text NOT NULL DEFAULT 'CONSUMED'
  CHECK(required_handoff_state='CONSUMED'),
 approved_at timestamptz NOT NULL DEFAULT pg_catalog.transaction_timestamp(),
 created_by uuid NOT NULL
  REFERENCES app_private.principals(id)
  ON UPDATE RESTRICT ON DELETE RESTRICT,
 CONSTRAINT db03_principal_approval_matching_source UNIQUE(
   id,application_id,forward_id,policy_snapshot_id,approval_receipt_id,
   application_version,stage_epoch,handoff_id),
 CONSTRAINT db03_principal_approval_matching_snapshot
  FOREIGN KEY(policy_snapshot_id,application_id,application_version,
              stage_epoch,forward_id,approval_receipt_id)
  REFERENCES app_private.admission_application_policy_snapshots
    (id,application_id,application_version,stage_epoch,forward_id,
     command_receipt_id)
  ON UPDATE RESTRICT ON DELETE RESTRICT,
 -- Deferral is required because these two rows reference one another and
 -- the handoff must reach CONSUMED (Student exists) before COMMIT.
 CONSTRAINT db03_principal_approval_requires_consumed_handoff
  FOREIGN KEY(handoff_id,application_id,required_handoff_state)
  REFERENCES app_private.admission_student_handoffs(id,application_id,state)
  ON UPDATE NO ACTION ON DELETE NO ACTION
  DEFERRABLE INITIALLY DEFERRED
);
ALTER TABLE app_private.admission_student_handoffs
 ADD COLUMN principal_approval_id uuid NOT NULL UNIQUE,
 ADD CONSTRAINT db03_handoff_exact_principal_approval
  FOREIGN KEY(principal_approval_id,application_id,forward_id,
    policy_snapshot_id,approval_receipt_id,application_version,stage_epoch,id)
  REFERENCES app_private.admission_principal_approvals(
    id,application_id,forward_id,policy_snapshot_id,approval_receipt_id,
    application_version,stage_epoch,handoff_id)
  ON UPDATE NO ACTION ON DELETE NO ACTION
  DEFERRABLE INITIALLY DEFERRED;
-- All proposal tables remain empty. No writable ACL/operation is introduced.
ALTER TABLE app_private.admission_principal_approvals ENABLE ROW LEVEL SECURITY;
ALTER TABLE app_private.admission_principal_approvals FORCE ROW LEVEL SECURITY;
REVOKE ALL ON app_private.admission_principal_approvals FROM
 PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,
 schoolos_student_executor,schoolos_identity_executor,schoolos_evidence_writer,
 schoolos_authz_reader,schoolos_platform_executor,schoolos_file_login;
CREATE POLICY db03_principal_approval_storage_owner
 ON app_private.admission_principal_approvals
 TO schoolos_schema_owner USING(true) WITH CHECK(true);
CREATE FUNCTION app_private.db03_principal_approval_mutation_unavailable()
RETURNS trigger LANGUAGE plpgsql VOLATILE SECURITY INVOKER
SET search_path=pg_catalog,pg_temp AS $body$
BEGIN
 RAISE EXCEPTION 'DB03 atomic Principal APPROVE writer unavailable';
END $body$;
REVOKE ALL ON FUNCTION app_private.db03_principal_approval_mutation_unavailable()
 FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,
 schoolos_student_executor,schoolos_identity_executor,schoolos_evidence_writer,
 schoolos_authz_reader,schoolos_platform_executor,schoolos_file_login;
CREATE TRIGGER db03_principal_approval_mutation_disabled
 BEFORE INSERT OR UPDATE OR DELETE ON app_private.admission_principal_approvals
 FOR EACH ROW EXECUTE FUNCTION app_private.db03_principal_approval_mutation_unavailable();
CREATE TRIGGER db03_principal_approval_no_truncate
 BEFORE TRUNCATE ON app_private.admission_principal_approvals FOR EACH STATEMENT
 EXECUTE FUNCTION app_private.db03_principal_approval_mutation_unavailable();
RESET ROLE;
