-- S24: only the reporter may attach a sealed Finance bank document to a
-- previous S22 return. Upload is private and validated by the server adapter.
SET ROLE schoolos_schema_owner;
CREATE FUNCTION app_private.db03_return_document_submit_authorized(
 p_actor uuid,p_campus uuid)
RETURNS boolean LANGUAGE sql STABLE SECURITY INVOKER
SET search_path=pg_catalog,pg_temp AS $body$
 SELECT p_actor IS NOT NULL AND p_actor=app_private.current_principal_id()
 AND EXISTS(SELECT 1 FROM app_private.principals p WHERE p.id=p_actor
   AND p.kind='INDIVIDUAL' AND p.state='ACTIVE')
 AND app_private.has_complete_grant('finance.admission.payment.return.evidence.submit',
   'CAMPUS',p_campus)
 AND EXISTS(
  SELECT 1 FROM app_private.principal_role_assignments ra
  JOIN app_private.roles r ON r.id=ra.role_id
  JOIN app_private.assignment_permission_scopes sc
   ON sc.assignment_id=ra.id AND sc.role_id=ra.role_id
  JOIN app_private.role_permission_grants g
   ON g.id=sc.grant_id AND g.role_id=ra.role_id
   AND g.permission_id=sc.permission_id
  JOIN app_private.permission_scope_contracts c
   ON c.id=sc.scope_contract_id AND c.permission_id=sc.permission_id
   AND c.scope_kind=sc.scope_kind AND c.resolver_key=sc.resolver_key
  JOIN app_private.permissions pe ON pe.id=sc.permission_id
  WHERE ra.principal_id=p_actor AND ra.principal_kind='INDIVIDUAL'
   AND ra.context_kind='INDIVIDUAL'
   AND r.code='ACCOUNTANT' AND r.state='ACTIVE' AND NOT r.family_only
   AND pe.code='finance.admission.payment.return.evidence.submit'
   AND pe.state='ENABLED' AND NOT pe.family_safe
   AND c.enabled AND sc.resolver_key='DIRECT'
   AND ((sc.scope_kind='CAMPUS' AND sc.campus_id=p_campus)
    OR (sc.scope_kind='ALL' AND sc.campus_id IS NULL))
   AND ra.valid_from<=clock_timestamp()
   AND (ra.valid_until IS NULL OR clock_timestamp()<ra.valid_until)
   AND (ra.revoked_at IS NULL OR clock_timestamp()<ra.revoked_at)
   AND g.valid_from<=clock_timestamp()
   AND (g.valid_until IS NULL OR clock_timestamp()<g.valid_until)
   AND (g.revoked_at IS NULL OR clock_timestamp()<g.revoked_at)
   AND sc.valid_from<=clock_timestamp()
   AND (sc.valid_until IS NULL OR clock_timestamp()<sc.valid_until)
   AND (sc.revoked_at IS NULL OR clock_timestamp()<sc.revoked_at)
 );
$body$;
REVOKE ALL ON FUNCTION app_private.db03_return_document_submit_authorized(uuid,uuid)
 FROM PUBLIC,anon,authenticated,service_role,schoolos_file_login;



CREATE FUNCTION app_private.db03_return_document_preflight(
 p_application uuid,p_expected bigint,p_return uuid,p_key text)
RETURNS boolean LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $body$
DECLARE actor uuid; a app_private.admission_applications%ROWTYPE;
 r app_private.finance_admission_payment_returns%ROWTYPE; exp_str text; op uuid;
BEGIN
 IF session_user<>'schoolos_file_login'
  OR current_setting('transaction_isolation')<>'read committed'
  OR p_application IS NULL OR p_expected IS NULL OR p_expected<1
  OR p_return IS NULL OR p_key IS NULL OR length(p_key) NOT BETWEEN 1 AND 180 THEN
  RAISE EXCEPTION 'DB03 bank-document preflight invalid'; END IF;
 exp_str:=nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'exp';
 IF exp_str IS NULL OR exp_str !~ '^[0-9]{1,12}$'
 OR to_timestamp(exp_str::bigint)<=clock_timestamp() THEN
  RAISE EXCEPTION 'DB03 bank-document JWT expired'; END IF;
 PERFORM pg_advisory_xact_lock_shared(71001,1);
 actor:=app_private.current_principal_id();
 SELECT * INTO a FROM app_private.admission_applications WHERE id=p_application;
 SELECT * INTO r FROM app_private.finance_admission_payment_returns WHERE id=p_return;
 IF a.id IS NULL OR r.id IS NULL OR a.row_version<>p_expected
  OR r.application_id<>a.id OR r.school_id<>a.school_id OR r.campus_id<>a.campus_id
  OR r.reported_by<>actor
  OR NOT app_private.db03_return_document_submit_authorized(actor,a.campus_id) THEN
  RAISE EXCEPTION 'DB03 bank-document submit authority or context denied'; END IF;
 SELECT o.id INTO op FROM app_private.operation_contracts o
 JOIN app_private.permissions p ON p.id=o.request_permission_id
 WHERE o.code='finance.admission.payment.return.evidence.submit'
 AND o.contract_version=1 AND o.handler_key=o.code AND o.payload_schema_version=1
 AND o.enabled AND NOT o.requires_approval
 AND p.code=o.code AND p.state='ENABLED' AND NOT p.family_safe;
 IF op IS NULL THEN RAISE EXCEPTION 'DB03 bank-document submit operation unavailable'; END IF;
 RETURN true;
END $body$;
REVOKE ALL ON FUNCTION app_private.db03_return_document_preflight(uuid,bigint,uuid,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.db03_return_document_preflight(uuid,bigint,uuid,text)
 TO schoolos_file_login;

CREATE FUNCTION app_private.db03_submit_return_bank_document(
 p_application uuid,p_expected bigint,p_return uuid,p_kind text,
 p_bank_reference text,p_mime text,p_size bigint,p_sha bytea,
 p_location text,p_object_key text,p_key text)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $body$
DECLARE a app_private.admission_applications%ROWTYPE;
 r app_private.finance_admission_payment_returns%ROWTYPE;
 evidence app_private.finance_admission_bank_return_evidence%ROWTYPE;
 old app_private.command_receipts%ROWTYPE;
 actor uuid; op uuid; school uuid; campus uuid; year_id uuid;
 claims jsonb; exp_str text; digest bytea;
 result jsonb; receipt_id uuid; correlation uuid; file_id uuid;
BEGIN
 IF session_user<>'schoolos_file_login'
 OR current_setting('transaction_isolation')<>'read committed'
 OR p_application IS NULL OR p_expected IS NULL OR p_expected<1 OR p_return IS NULL
 OR p_kind NOT IN('BANK_STATEMENT','BANK_RETURN_NOTICE','BANK_CASE_CORRESPONDENCE')
 OR p_kind IS NULL
 OR p_bank_reference IS NULL OR length(btrim(p_bank_reference)) NOT BETWEEN 5 AND 160
 OR p_mime NOT IN('application/pdf','image/png','image/jpeg') OR p_mime IS NULL
 OR p_size IS NULL OR p_size NOT BETWEEN 1 AND 1048576
 OR p_sha IS NULL OR octet_length(p_sha)<>32
 OR p_location IS NULL OR p_location !~ '^[A-Z][A-Z0-9_]{0,63}$'
 OR p_object_key IS NULL OR p_object_key !~ '^payments/[a-f0-9-]{36}/[a-f0-9]{64}$'
 OR p_key IS NULL OR length(p_key) NOT BETWEEN 1 AND 180 THEN
 RAISE EXCEPTION 'DB03 bank-document input invalid'; END IF;
 claims:=nullif(current_setting('request.jwt.claims',true),'')::jsonb;
 exp_str:=claims->>'exp';
 IF exp_str IS NULL OR exp_str !~ '^[0-9]{1,12}$'
 OR to_timestamp(exp_str::bigint)<=clock_timestamp() THEN
 RAISE EXCEPTION 'DB03 bank-document JWT expired'; END IF;
 PERFORM pg_advisory_xact_lock_shared(71001,1);
 actor:=app_private.current_principal_id();
 SELECT school_id,campus_id,academic_year_id INTO school,campus,year_id
 FROM app_private.admission_applications WHERE id=p_application;
 IF school IS NULL OR NOT app_private.db03_return_document_submit_authorized(actor,campus) THEN
  RAISE EXCEPTION 'DB03 bank-document submit Finance scope denied'; END IF;
 IF split_part(p_object_key,'/',2)<>school::text THEN
  RAISE EXCEPTION 'DB03 bank-document storage School mismatch'; END IF;
 SELECT o.id INTO op FROM app_private.operation_contracts o
 JOIN app_private.permissions p ON p.id=o.request_permission_id
 WHERE o.code='finance.admission.payment.return.evidence.submit'
 AND o.contract_version=1 AND o.handler_key=o.code AND o.payload_schema_version=1
 AND o.enabled AND NOT o.requires_approval
 AND p.code=o.code AND p.state='ENABLED' AND NOT p.family_safe;
 IF op IS NULL THEN RAISE EXCEPTION 'DB03 bank-document operation unavailable'; END IF;
 digest:=sha256(convert_to(jsonb_build_array('db03-bank-evidence-v1',
 p_application,p_expected,p_return,p_kind,p_bank_reference,p_mime,p_size,
 encode(p_sha,'hex'),p_location,p_object_key)::text,'UTF8'));
 PERFORM pg_advisory_xact_lock(71002,hashtext(actor::text||':'||op::text||':'||p_key));
 PERFORM 1 FROM app_private.school_profiles WHERE id=school
 AND state IN('SETUP','ACTIVE') FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DB03 bank-document School unavailable'; END IF;
 PERFORM 1 FROM app.campuses WHERE id=campus AND school_id=school
 AND state='ACTIVE' FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DB03 bank-document Campus unavailable'; END IF;
 PERFORM 1 FROM app.academic_years WHERE id=year_id AND school_id=school
 AND state IN('PLANNED','ACTIVE') FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DB03 bank-document Year unavailable'; END IF;
 SELECT * INTO a FROM app_private.admission_applications
 WHERE id=p_application FOR UPDATE;
 SELECT * INTO r FROM app_private.finance_admission_payment_returns
 WHERE id=p_return FOR UPDATE;
 IF a.id IS NULL OR a.school_id<>school OR a.campus_id<>campus
 OR a.academic_year_id<>year_id OR a.row_version<>p_expected
 OR r.id IS NULL OR r.application_id<>a.id OR r.school_id<>school OR r.campus_id<>campus
 OR r.reported_by<>actor
 OR to_timestamp(exp_str::bigint)<=clock_timestamp()
 OR NOT app_private.db03_return_document_submit_authorized(actor,campus)
 OR NOT EXISTS(SELECT 1 FROM app_private.operation_contracts o
  JOIN app_private.permissions p ON p.id=o.request_permission_id
  WHERE o.id=op AND o.enabled AND NOT o.requires_approval
  AND p.code=o.code AND p.state='ENABLED') THEN
 RAISE EXCEPTION 'DB03 bank-document submission context stale or denied'; END IF;
 SELECT * INTO old FROM app_private.command_receipts WHERE principal_id=actor
 AND operation_id=op AND idempotency_key='return-bank-document:'||p_key;
 IF old.id IS NOT NULL THEN
  SELECT * INTO evidence FROM app_private.finance_admission_bank_return_evidence
   WHERE id=old.result_ref;
  IF old.state<>'SUCCEEDED'
   OR old.command_kind<>'finance.admission.payment.return.evidence.submit'
   OR old.result_kind<>'FINANCE_ADMISSION_RETURN_BANK_DOCUMENT'
   OR old.canonical_payload_hash IS DISTINCT FROM digest
   OR evidence.id IS NULL OR evidence.return_id<>p_return
   OR evidence.application_id<>p_application OR evidence.submitted_by<>actor
   OR evidence.evidence_kind<>p_kind OR evidence.bank_reference_private<>p_bank_reference
   OR evidence.evidence_sha256<>p_sha
   OR old.result_summary->>'evidence_id' IS DISTINCT FROM evidence.id::text
   OR (SELECT count(*) FROM app_private.audit_events
     WHERE command_receipt_id=old.id)<>1
   OR (SELECT count(*) FROM app_private.outbox_events
     WHERE command_receipt_id=old.id)<>1 THEN
   RAISE EXCEPTION 'DB03 bank-document replay conflict'; END IF;
  RETURN old.result_summary;
 END IF;
 IF EXISTS(SELECT 1 FROM app_private.finance_admission_bank_return_evidence
 WHERE return_id=r.id) THEN
 RAISE EXCEPTION 'DB03 bank-document already submitted for return'; END IF;
 IF NOT EXISTS(
  SELECT 1 FROM app_private.command_receipts cr
  JOIN app_private.operation_contracts o ON o.id=cr.operation_id
  WHERE o.code='finance.admission.payment.return.report'
   AND cr.result_ref=r.id AND cr.result_kind='FINANCE_ADMISSION_PAYMENT_RETURN'
   AND cr.state='SUCCEEDED' AND cr.created_by=r.reported_by
   AND (SELECT count(*) FROM app_private.audit_events au
    WHERE au.command_receipt_id=cr.id AND au.target_ref=r.id)=1
   AND (SELECT count(*) FROM app_private.outbox_events ob
    WHERE ob.command_receipt_id=cr.id AND ob.aggregate_ref=r.id)=1) THEN
 RAISE EXCEPTION 'DB03 bank-document S22 return provenance unavailable'; END IF;
 file_id:=gen_random_uuid();
 INSERT INTO app_private.file_objects(
  id,uploaded_by_principal_id,campus_id,storage_location_key,
  purpose_code,object_key,content_type,byte_size,content_hash,classification,created_by)
 VALUES(file_id,actor,campus,p_location,'ADMISSION_BANK_RETURN_EVIDENCE',
 p_object_key,p_mime,p_size,p_sha,'PRIVATE',actor);
 UPDATE app_private.file_objects SET state='VALIDATED',
 validated_at=clock_timestamp() WHERE id=file_id;
 UPDATE app_private.file_objects SET state='AVAILABLE' WHERE id=file_id;
 INSERT INTO app_private.finance_admission_bank_return_evidence(
  return_id,application_id,school_id,campus_id,evidence_file_id,evidence_sha256,
  evidence_kind,bank_reference_private,submitted_by)
 VALUES(r.id,a.id,school,campus,file_id,p_sha,p_kind,p_bank_reference,actor)
 RETURNING * INTO evidence;
 result:=jsonb_build_object('evidence_id',evidence.id,'return_id',r.id,
 'application_id',a.id,'state','PRIVATE_EVIDENCE_PENDING_INDEPENDENT_REVIEW',
 'evidence_sha256',encode(p_sha,'hex'),
 'document_reviewed',false,'external_bank_verified',false,
 'funding_hold_active',true,'clearance_issued',false);
 receipt_id:=gen_random_uuid();correlation:=gen_random_uuid();
 INSERT INTO app_private.command_receipts(id,principal_id,operation_id,command_kind,
  idempotency_key,canonical_payload_hash,canonicalization_version,state,result_kind,
  result_ref,result_summary,completed_at,created_by)
 VALUES(receipt_id,actor,op,'finance.admission.payment.return.evidence.submit',
  'return-bank-document:'||p_key,digest,1,'SUCCEEDED',
  'FINANCE_ADMISSION_RETURN_BANK_DOCUMENT',evidence.id,result,clock_timestamp(),actor);
 INSERT INTO app_private.audit_events(actor_id,actor_kind,outcome,authority_evidence,
  target_version,event_type,target_kind,target_ref,campus_id,command_receipt_id,
  source_kind,correlation_id,occurred_at,details,created_by)
 VALUES(actor,'INDIVIDUAL','SUCCEEDED',
  jsonb_build_object('operation','finance.admission.payment.return.evidence.submit',
  'return_id',r.id),1,
  'finance.admission.payment.return.evidence.submit','FINANCE_ADMISSION_RETURN_BANK_DOCUMENT',
  evidence.id,campus,receipt_id,'WORKER',correlation,clock_timestamp(),result,actor);
 INSERT INTO app_private.outbox_events(event_type,aggregate_kind,aggregate_ref,
  aggregate_version,command_receipt_id,event_ordinal,correlation_id,occurred_at,
  payload,created_by)
 VALUES('finance.admission.payment.return.evidence.submit',
  'FINANCE_ADMISSION_RETURN_BANK_DOCUMENT',evidence.id,1,receipt_id,1,
  correlation,clock_timestamp(),result,actor);
 RETURN result;
END $body$;
REVOKE ALL ON FUNCTION app_private.db03_submit_return_bank_document(
 uuid,bigint,uuid,text,text,text,bigint,bytea,text,text,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.db03_submit_return_bank_document(
 uuid,bigint,uuid,text,text,text,bigint,bytea,text,text,text)
 TO schoolos_file_login;
RESET ROLE;
