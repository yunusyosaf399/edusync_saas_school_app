-- P28: PRIVATE typed Principal final-decision contract, never a command.
-- No authority to APPROVE/RETURN/REJECT can be inferred from document approval.
-- All three choices remain blocked until independent final-decision authority
-- and a jointly atomic D1 Student-create handoff have passed acceptance.
SET ROLE schoolos_schema_owner;
CREATE FUNCTION app_private.db03_principal_final_decision_contract(
 p_application uuid, p_expected_version bigint, p_forward uuid,
 p_decision text, p_reason_private text)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY INVOKER
SET search_path=pg_catalog,pg_temp AS $body$
DECLARE input_state jsonb;
BEGIN
 IF p_expected_version IS NULL OR p_expected_version<1
  OR p_forward IS NULL OR p_decision IS NULL
  OR p_decision NOT IN('APPROVE','RETURN','REJECT')
  OR p_reason_private IS NULL
  OR length(btrim(p_reason_private)) NOT BETWEEN 1 AND 1000
  OR p_reason_private ~ '[[:cntrl:]]' THEN
  RAISE EXCEPTION 'DB03 Principal final decision intent invalid';
 END IF;
 IF p_application IS NULL THEN RETURN NULL; END IF;
 input_state:=app_private.db03_principal_review_preflight(p_application);
 IF input_state IS NULL THEN RETURN NULL; END IF;
 RETURN jsonb_build_object(
  'application_id',p_application,
  'decision_requested',p_decision,
  'expected_version_matches',
    COALESCE((input_state->>'application_version')::bigint=p_expected_version,false),
  'forward_reference_matches',
    COALESCE((input_state->>'forward_record_id')::uuid=p_forward,false),
  'review_inputs_observed',
    COALESCE((input_state->>'review_inputs_observed')::boolean,false),
  'principal_final_authority_verified',false,
  'current_forward_snapshot_verified',false,
  'assessment_and_skip_outcomes_verified',false,
  'atomic_student_handoff_available',false,
  'can_apply',false,
  'can_create_student',false,
  'status','BLOCKED_PENDING_ATOMIC_FINAL_COMMAND');
END $body$;
REVOKE ALL ON FUNCTION app_private.db03_principal_final_decision_contract(uuid,bigint,uuid,text,text)
 FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,
 schoolos_file_login,schoolos_platform_executor,schoolos_identity_executor,
 schoolos_evidence_writer;
RESET ROLE;
