-- Inactive administrator declaration. This is not a Finance payment or clearance.
SET ROLE schoolos_schema_owner;
CREATE TABLE app_private.admission_fee_dispositions (
 id uuid PRIMARY KEY DEFAULT pg_catalog.gen_random_uuid(),
 application_id uuid NOT NULL REFERENCES app_private.admission_applications(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 revision bigint NOT NULL CHECK(revision>0),
 supersedes_id uuid UNIQUE REFERENCES app_private.admission_fee_dispositions(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 disposition text NOT NULL CHECK(disposition IN('SKIPPED','MARKED_PAID','UNPAID')),
 reason_private text NOT NULL CHECK(length(pg_catalog.btrim(reason_private)) BETWEEN 1 AND 1000),
 application_version bigint NOT NULL CHECK(application_version>0),
 command_receipt_id uuid NOT NULL UNIQUE REFERENCES app_private.command_receipts(id) DEFERRABLE INITIALLY DEFERRED,
 created_by uuid NOT NULL REFERENCES app_private.principals(id),
 occurred_at timestamptz NOT NULL DEFAULT pg_catalog.clock_timestamp(),
 UNIQUE(application_id,revision),
 CHECK((revision=1)=(supersedes_id IS NULL))
);
CREATE INDEX db03_fee_disposition_head ON app_private.admission_fee_dispositions(application_id,revision DESC);
CREATE FUNCTION app_private.db03_fee_disposition_guard() RETURNS trigger
LANGUAGE plpgsql SECURITY INVOKER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE prior app_private.admission_fee_dispositions%ROWTYPE;
BEGIN
 IF TG_OP<>'INSERT' THEN RAISE EXCEPTION 'DB03 fee disposition immutable'; END IF;
 IF current_user<>'schoolos_schema_owner' THEN RAISE EXCEPTION 'DB03 fee disposition writer unavailable'; END IF;
 SELECT * INTO prior FROM app_private.admission_fee_dispositions
  WHERE application_id=NEW.application_id ORDER BY revision DESC LIMIT 1;
 IF (prior.id IS NULL AND (NEW.revision<>1 OR NEW.supersedes_id IS NOT NULL))
  OR (prior.id IS NOT NULL AND (NEW.revision<>prior.revision+1 OR NEW.supersedes_id IS DISTINCT FROM prior.id))
  OR NOT EXISTS(SELECT 1 FROM app_private.admission_applications a
   WHERE a.id=NEW.application_id AND a.state='DRAFT' AND a.row_version=NEW.application_version)
 THEN RAISE EXCEPTION 'DB03 fee disposition revision or target changed'; END IF;
 RETURN NEW;
END $body$;
REVOKE ALL ON FUNCTION app_private.db03_fee_disposition_guard() FROM PUBLIC,anon,authenticated,service_role;
ALTER TABLE app_private.admission_fee_dispositions ENABLE ROW LEVEL SECURITY;
ALTER TABLE app_private.admission_fee_dispositions FORCE ROW LEVEL SECURITY;
REVOKE ALL ON app_private.admission_fee_dispositions FROM PUBLIC,anon,authenticated,service_role,
 schoolos_file_login,schoolos_workflow_executor,schoolos_platform_executor,schoolos_evidence_writer;
CREATE POLICY db03_fee_disposition_owner ON app_private.admission_fee_dispositions
 TO schoolos_schema_owner USING(true) WITH CHECK(true);
CREATE TRIGGER db03_fee_disposition_history BEFORE INSERT OR UPDATE OR DELETE
 ON app_private.admission_fee_dispositions FOR EACH ROW EXECUTE FUNCTION app_private.db03_fee_disposition_guard();
CREATE TRIGGER db03_fee_disposition_no_truncate BEFORE TRUNCATE
 ON app_private.admission_fee_dispositions FOR EACH STATEMENT EXECUTE FUNCTION app_private.db03_fee_disposition_guard();
RESET ROLE;
