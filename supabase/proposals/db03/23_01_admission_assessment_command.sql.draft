-- Inactive initial examiner command. No production permission/operation or stage outcome.
GRANT EXECUTE ON FUNCTION app_private.current_principal_id(),
 app_private.has_complete_grant(text,text,uuid) TO schoolos_schema_owner;
SET ROLE schoolos_schema_owner;
CREATE FUNCTION app_private.db03_record_initial_assessment(
 p_application uuid,p_expected bigint,p_stage uuid,p_kind text,p_outcome text,
 p_score numeric,p_maximum numeric,p_reason text,p_key text)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $body$
DECLARE a app_private.admission_applications%ROWTYPE;
 intake app_private.admission_document_intakes%ROWTYPE;
 stage app_private.admission_policy_stages%ROWTYPE;
 prior app_private.admission_assessments%ROWTYPE;
 saved app_private.admission_assessments%ROWTYPE;
 replay app_private.command_receipts%ROWTYPE;
 actor uuid; operation uuid; school uuid; campus uuid; yr uuid; expiry text;
 v_hash bytea; receipt uuid:=gen_random_uuid(); correlation uuid:=gen_random_uuid();
 result jsonb; today_local date;
BEGIN
 IF session_user<>'schoolos_file_login' OR current_setting('transaction_isolation')<>'read committed'
  OR p_application IS NULL OR p_expected IS NULL OR p_expected<1 OR p_stage IS NULL
  OR p_kind IS NULL OR p_kind NOT IN('ADMISSION_TEST','INTERVIEW')
  OR p_outcome IS NULL OR p_outcome NOT IN('PASSED','FAILED')
  OR (p_score IS NULL)<>(p_maximum IS NULL)
  OR (p_score IS NOT NULL AND (p_score<0 OR p_maximum<=0 OR p_score>p_maximum
   OR p_score>=100000000 OR p_maximum>=100000000 OR p_score<>round(p_score,4)
   OR p_maximum<>round(p_maximum,4)))
  OR p_reason IS NULL OR length(btrim(p_reason)) NOT BETWEEN 1 AND 1000
  OR p_key IS NULL OR length(p_key) NOT BETWEEN 1 AND 180 THEN
  RAISE EXCEPTION 'DB03 assessment command invalid'; END IF;
 expiry:=(NULLIF(current_setting('request.jwt.claims',true),'')::jsonb)->>'exp';
 IF expiry IS NULL OR expiry !~ '^[0-9]{1,12}$' OR to_timestamp(expiry::bigint)<=clock_timestamp() THEN
  RAISE EXCEPTION 'DB03 assessment authentication expired'; END IF;
 PERFORM pg_advisory_xact_lock(71001,1);
 actor:=app_private.current_principal_id();
 SELECT school_id,campus_id,academic_year_id INTO school,campus,yr
  FROM app_private.admission_applications WHERE id=p_application;
 IF actor IS NULL OR school IS NULL OR NOT EXISTS(SELECT 1 FROM app_private.principals p
  WHERE p.id=actor AND p.kind='INDIVIDUAL' AND p.state='ACTIVE') THEN
  RAISE EXCEPTION 'DB03 assessment actor or application unavailable'; END IF;
 SELECT o.id INTO operation FROM app_private.operation_contracts o
 JOIN app_private.permissions pe ON pe.id=o.request_permission_id
 WHERE o.code='admission.assessment.record' AND o.handler_key=o.code
  AND o.contract_version=1 AND o.payload_schema_version=1 AND o.enabled AND NOT o.requires_approval
  AND pe.code=o.code AND pe.state='ENABLED' AND NOT pe.family_safe;
 IF operation IS NULL OR NOT app_private.has_complete_grant('admission.assessment.record','CAMPUS',campus) THEN
  RAISE EXCEPTION 'DB03 assessment authority denied'; END IF;
 v_hash:=sha256(convert_to(jsonb_build_array('db03-assessment-v1',p_application,p_expected,p_stage,
  p_kind,p_outcome,p_score,p_maximum,encode(sha256(convert_to(p_reason,'UTF8')),'hex'))::text,'UTF8'));
 PERFORM pg_advisory_xact_lock(71002,hashtext(actor::text||':'||operation::text||':assessment:'||p_key));
 PERFORM 1 FROM app_private.school_profiles WHERE id=school AND state IN('SETUP','ACTIVE') FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DB03 assessment School unavailable'; END IF;
 SELECT (clock_timestamp() AT TIME ZONE timezone)::date INTO today_local
  FROM app_private.school_profiles WHERE id=school;
 PERFORM 1 FROM app.campuses WHERE id=campus AND school_id=school AND state='ACTIVE' FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DB03 assessment Campus unavailable'; END IF;
 PERFORM 1 FROM app.academic_years WHERE id=yr AND school_id=school AND state IN('PLANNED','ACTIVE') FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DB03 assessment Year unavailable'; END IF;
 SELECT * INTO a FROM app_private.admission_applications WHERE id=p_application FOR UPDATE;
 IF a.id IS NULL OR a.school_id<>school OR a.campus_id<>campus OR a.academic_year_id<>yr
  OR app_private.current_principal_id() IS DISTINCT FROM actor
  OR NOT app_private.has_complete_grant('admission.assessment.record','CAMPUS',campus)
  OR to_timestamp(expiry::bigint)<=clock_timestamp() THEN
  RAISE EXCEPTION 'DB03 assessment authority or target changed'; END IF;
 SELECT * INTO replay FROM app_private.command_receipts
  WHERE principal_id=actor AND operation_id=operation AND idempotency_key='assessment:'||p_key;
 IF replay.id IS NOT NULL THEN
  SELECT * INTO saved FROM app_private.admission_assessments WHERE id=replay.result_ref;
  IF replay.state<>'SUCCEEDED' OR replay.command_kind<>'admission.assessment.record'
   OR replay.result_kind<>'ADMISSION_ASSESSMENT' OR replay.canonical_payload_hash IS DISTINCT FROM v_hash
   OR replay.expected_target_version<>p_expected OR saved.id IS NULL
   OR saved.application_id<>p_application OR saved.policy_stage_id<>p_stage
   OR saved.assessment_kind<>p_kind OR saved.outcome<>p_outcome
   OR saved.score IS DISTINCT FROM p_score OR saved.maximum_score IS DISTINCT FROM p_maximum
   OR saved.reason_private<>p_reason OR saved.assessor_id<>actor
   OR saved.command_receipt_id<>replay.id OR saved.application_version<>p_expected
   OR replay.result_summary->>'assessment_id' IS DISTINCT FROM saved.id::text
   OR (SELECT count(*) FROM app_private.audit_events WHERE command_receipt_id=replay.id)<>1
   OR (SELECT count(*) FROM app_private.outbox_events WHERE command_receipt_id=replay.id)<>1 THEN
   RAISE EXCEPTION 'DB03 assessment replay conflict'; END IF;
  RETURN replay.result_summary;
 END IF;
 SELECT * INTO intake FROM app_private.admission_document_intakes
  WHERE application_id=a.id ORDER BY revision DESC LIMIT 1;
 SELECT * INTO stage FROM app_private.admission_policy_stages WHERE id=p_stage;
 SELECT * INTO prior FROM app_private.admission_assessments
  WHERE application_id=a.id AND policy_stage_id=p_stage FOR UPDATE;
 IF a.state<>'DRAFT' OR a.row_version<>p_expected OR intake.id IS NULL
  OR stage.id IS NULL OR stage.policy_version_id<>intake.policy_version_id
  OR stage.stage_kind<>p_kind OR stage.requirement<>'REQUIRED' OR prior.id IS NOT NULL
  OR NOT EXISTS(SELECT 1 FROM app_private.admission_policy_versions p
   WHERE p.id=stage.policy_version_id AND p.school_id=school AND p.state='PUBLISHED') THEN
  RAISE EXCEPTION 'DB03 assessment stage or version unavailable'; END IF;
 IF app_private.current_principal_id() IS DISTINCT FROM actor
  OR NOT app_private.has_complete_grant('admission.assessment.record','CAMPUS',campus)
  OR to_timestamp(expiry::bigint)<=clock_timestamp() THEN
  RAISE EXCEPTION 'DB03 assessment authority or target changed'; END IF;
 saved.id:=gen_random_uuid();
 result:=jsonb_build_object('assessment_id',saved.id,'application_id',a.id,
  'application_version',a.row_version,'policy_stage_id',stage.id,
  'assessment_kind',p_kind,'outcome',p_outcome,'stage_effect_recorded',false,
  'finance_cleared',false,'student_created',false);
 INSERT INTO app_private.command_receipts(id,principal_id,operation_id,command_kind,idempotency_key,
  canonical_payload_hash,canonicalization_version,expected_target_version,state,
  result_kind,result_ref,result_summary,completed_at,created_by)
 VALUES(receipt,actor,operation,'admission.assessment.record','assessment:'||p_key,
  v_hash,1,p_expected,'SUCCEEDED','ADMISSION_ASSESSMENT',saved.id,result,clock_timestamp(),actor);
 INSERT INTO app_private.admission_assessments(id,application_id,school_id,campus_id,
  academic_year_id,intake_id,policy_stage_id,revision,assessment_kind,outcome,
  score,maximum_score,assessed_on,reason_private,assessor_id,application_version,
  stage_epoch,command_receipt_id)
 VALUES(saved.id,a.id,school,campus,yr,intake.id,stage.id,1,p_kind,p_outcome,
  p_score,p_maximum,today_local,p_reason,actor,p_expected,a.stage_epoch,receipt);
 INSERT INTO app_private.audit_events(actor_id,actor_kind,outcome,authority_evidence,target_version,
  event_type,target_kind,target_ref,campus_id,command_receipt_id,source_kind,correlation_id,
  occurred_at,details,created_by)
 VALUES(actor,'INDIVIDUAL','SUCCEEDED',jsonb_build_object('operation','admission.assessment.record'),
  1,'admission.assessment.record','ADMISSION_ASSESSMENT',saved.id,campus,receipt,'WORKER',correlation,
  clock_timestamp(),result,actor);
 INSERT INTO app_private.outbox_events(event_type,aggregate_kind,aggregate_ref,aggregate_version,
  command_receipt_id,event_ordinal,correlation_id,occurred_at,payload,created_by)
 VALUES('admission.assessment.record','ADMISSION_ASSESSMENT',saved.id,1,receipt,1,correlation,
  clock_timestamp(),result,actor);
 RETURN result;
END $body$;
REVOKE ALL ON FUNCTION app_private.db03_record_initial_assessment(uuid,bigint,uuid,text,text,numeric,numeric,text,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.db03_record_initial_assessment(uuid,bigint,uuid,text,text,numeric,numeric,text,text)
 TO schoolos_file_login;
RESET ROLE;
