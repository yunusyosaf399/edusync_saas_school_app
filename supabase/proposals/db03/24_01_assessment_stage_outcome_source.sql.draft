-- Inactive P3/P4 stage outcome source for initial assessment decisions only.
-- No evaluator command, administration skip, finalization, Finance or Student effect.
SET ROLE schoolos_schema_owner;
CREATE TABLE app_private.admission_stage_outcomes (
 id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
 application_id uuid NOT NULL,
 school_id uuid NOT NULL,
 campus_id uuid NOT NULL,
 academic_year_id uuid NOT NULL,
 policy_stage_id uuid NOT NULL REFERENCES app_private.admission_policy_stages(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 revision bigint NOT NULL CHECK(revision=1),
 stage_kind text NOT NULL CHECK(stage_kind IN('ADMISSION_TEST','INTERVIEW')),
 outcome text NOT NULL CHECK(outcome IN('PASSED','FAILED')),
 assessment_id uuid NOT NULL,
 application_version bigint NOT NULL CHECK(application_version>0),
 stage_epoch bigint NOT NULL CHECK(stage_epoch>0),
 recorded_by uuid NOT NULL REFERENCES app_private.principals(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 command_receipt_id uuid NOT NULL UNIQUE REFERENCES app_private.command_receipts(id)
  ON UPDATE RESTRICT ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
 occurred_at timestamptz NOT NULL DEFAULT transaction_timestamp(),
 FOREIGN KEY(application_id,school_id,campus_id,academic_year_id)
  REFERENCES app_private.admission_applications(id,school_id,campus_id,academic_year_id)
  ON UPDATE RESTRICT ON DELETE RESTRICT,
 FOREIGN KEY(assessment_id,application_id,policy_stage_id)
  REFERENCES app_private.admission_assessments(id,application_id,policy_stage_id)
  ON UPDATE RESTRICT ON DELETE RESTRICT,
 UNIQUE(application_id,policy_stage_id,revision),
 UNIQUE(id,application_id,policy_stage_id)
);
CREATE INDEX db03_stage_outcome_application ON app_private.admission_stage_outcomes(application_id,policy_stage_id,revision DESC);
ALTER TABLE app_private.admission_stage_outcomes ENABLE ROW LEVEL SECURITY;
ALTER TABLE app_private.admission_stage_outcomes FORCE ROW LEVEL SECURITY;
CREATE POLICY db03_stage_outcome_owner ON app_private.admission_stage_outcomes
 TO schoolos_schema_owner USING(true) WITH CHECK(true);
REVOKE ALL ON app_private.admission_stage_outcomes FROM PUBLIC,anon,authenticated,service_role,
 schoolos_file_login,schoolos_workflow_executor,schoolos_platform_executor,schoolos_identity_executor,
 schoolos_evidence_writer;
CREATE FUNCTION app_private.db03_stage_outcome_source_guard() RETURNS trigger
LANGUAGE plpgsql SECURITY INVOKER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE a app_private.admission_applications%ROWTYPE;
 assessment app_private.admission_assessments%ROWTYPE;
 stage app_private.admission_policy_stages%ROWTYPE;
 intake app_private.admission_document_intakes%ROWTYPE;
BEGIN
 IF TG_OP<>'INSERT' THEN RAISE EXCEPTION 'DB03 stage outcome is immutable'; END IF;
 IF current_user<>'schoolos_schema_owner' THEN RAISE EXCEPTION 'DB03 stage outcome requires protected issuer'; END IF;
 SELECT * INTO a FROM app_private.admission_applications WHERE id=NEW.application_id FOR UPDATE;
 SELECT * INTO assessment FROM app_private.admission_assessments WHERE id=NEW.assessment_id;
 SELECT * INTO stage FROM app_private.admission_policy_stages WHERE id=NEW.policy_stage_id;
 SELECT * INTO intake FROM app_private.admission_document_intakes
  WHERE application_id=NEW.application_id ORDER BY revision DESC LIMIT 1;
 IF a.id IS NULL OR a.state<>'DRAFT' OR a.row_version<>NEW.application_version
  OR a.stage_epoch<>NEW.stage_epoch OR a.school_id<>NEW.school_id
  OR a.campus_id<>NEW.campus_id OR a.academic_year_id<>NEW.academic_year_id
  OR assessment.id IS NULL OR assessment.application_id<>a.id
  OR assessment.policy_stage_id<>NEW.policy_stage_id
  OR assessment.application_version<>a.row_version OR assessment.stage_epoch<>a.stage_epoch
  OR assessment.outcome<>NEW.outcome OR assessment.assessment_kind<>NEW.stage_kind
  OR intake.id IS NULL OR intake.id<>assessment.intake_id
  OR stage.id IS NULL OR stage.policy_version_id<>intake.policy_version_id
  OR stage.stage_kind<>NEW.stage_kind OR stage.requirement<>'REQUIRED'
  OR NOT EXISTS(SELECT 1 FROM app_private.admission_policy_versions p
   WHERE p.id=stage.policy_version_id AND p.school_id=a.school_id AND p.state='PUBLISHED')
  OR EXISTS(SELECT 1 FROM app_private.admission_stage_outcomes prior
   WHERE prior.application_id=a.id AND prior.policy_stage_id=stage.id)
 THEN RAISE EXCEPTION 'DB03 stage outcome assessment or context invalid'; END IF;
 RETURN NEW;
END $body$;
REVOKE ALL ON FUNCTION app_private.db03_stage_outcome_source_guard()
 FROM PUBLIC,anon,authenticated,service_role,schoolos_file_login;
CREATE TRIGGER db03_stage_outcome_history BEFORE INSERT OR UPDATE OR DELETE
 ON app_private.admission_stage_outcomes FOR EACH ROW EXECUTE FUNCTION app_private.db03_stage_outcome_source_guard();
CREATE TRIGGER db03_stage_outcome_no_truncate BEFORE TRUNCATE
 ON app_private.admission_stage_outcomes FOR EACH STATEMENT EXECUTE FUNCTION app_private.db03_stage_outcome_source_guard();
RESET ROLE;
