-- Original-document identity attestation. Not government verification, file
-- authenticity, canonical Person creation/merge, SUBMIT or admission completion.
SET ROLE schoolos_schema_owner;
ALTER TABLE app_private.admission_applications
 DROP CONSTRAINT admission_applications_check,
 ADD CONSTRAINT db03_unsubmitted_policy_null CHECK(policy_version_id IS NULL),
 ADD COLUMN stage_epoch bigint NOT NULL DEFAULT 1 CHECK(stage_epoch>0);
CREATE TABLE app_private.admission_identity_resolutions (
 id uuid PRIMARY KEY DEFAULT pg_catalog.gen_random_uuid(),
 application_id uuid NOT NULL REFERENCES app_private.admission_applications(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 revision bigint NOT NULL CHECK(revision>0),
 supersedes_id uuid UNIQUE REFERENCES app_private.admission_identity_resolutions(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 person_id uuid NOT NULL REFERENCES app_private.people(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 person_version bigint NOT NULL CHECK(person_version>0),
 method text NOT NULL CHECK(method='ORIGINAL_BIRTH_CERTIFICATE_INSPECTION'),
 original_reference_private text NOT NULL CHECK(pg_catalog.btrim(original_reference_private)<>'' AND pg_catalog.char_length(original_reference_private)<=200),
 reason_private text NOT NULL CHECK(pg_catalog.btrim(reason_private)<>'' AND pg_catalog.char_length(reason_private)<=1000),
 application_version bigint NOT NULL CHECK(application_version>1),
 stage_epoch bigint NOT NULL CHECK(stage_epoch>1),
 command_receipt_id uuid NOT NULL UNIQUE REFERENCES app_private.command_receipts(id) ON UPDATE RESTRICT ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
 occurred_at timestamptz NOT NULL,
 created_by uuid NOT NULL REFERENCES app_private.principals(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 UNIQUE(application_id,revision),
 CHECK((revision=1)=(supersedes_id IS NULL))
);
CREATE INDEX db03_identity_person_history ON app_private.admission_identity_resolutions(person_id,application_id);
ALTER TABLE app_private.admission_identity_resolutions ENABLE ROW LEVEL SECURITY;
ALTER TABLE app_private.admission_identity_resolutions FORCE ROW LEVEL SECURITY;
REVOKE ALL ON app_private.admission_identity_resolutions FROM PUBLIC,anon,authenticated,service_role;
CREATE POLICY db03_identity_owner ON app_private.admission_identity_resolutions TO schoolos_schema_owner USING(true) WITH CHECK(true);
CREATE POLICY db03_identity_read ON app_private.admission_identity_resolutions FOR SELECT TO schoolos_identity_executor,schoolos_evidence_writer USING(true);
CREATE POLICY db03_identity_insert ON app_private.admission_identity_resolutions FOR INSERT TO schoolos_identity_executor WITH CHECK(true);
GRANT SELECT ON app_private.admission_identity_resolutions TO schoolos_identity_executor,schoolos_evidence_writer;
GRANT INSERT ON app_private.admission_identity_resolutions TO schoolos_identity_executor;
GRANT SELECT ON app_private.admission_applications TO schoolos_identity_executor;
GRANT UPDATE(person_id,stage_epoch) ON app_private.admission_applications TO schoolos_identity_executor;
CREATE POLICY db03_identity_application_read ON app_private.admission_applications FOR SELECT TO schoolos_identity_executor USING(true);
CREATE POLICY db03_identity_application_update ON app_private.admission_applications FOR UPDATE TO schoolos_identity_executor USING(true) WITH CHECK(true);
GRANT SELECT(id,state,row_version),UPDATE(id) ON app_private.people TO schoolos_identity_executor;
GRANT SELECT(id,state,row_version) ON app_private.people TO schoolos_evidence_writer;
CREATE POLICY db03_identity_person_read ON app_private.people FOR SELECT TO schoolos_identity_executor,schoolos_evidence_writer USING(true);
CREATE POLICY db03_identity_person_lock ON app_private.people FOR UPDATE TO schoolos_identity_executor USING(true) WITH CHECK(true);
GRANT SELECT(id,state),UPDATE(id) ON app_private.school_profiles TO schoolos_identity_executor;
CREATE POLICY db03_identity_school_read ON app_private.school_profiles FOR SELECT TO schoolos_identity_executor USING(true);
CREATE POLICY db03_identity_school_lock ON app_private.school_profiles FOR UPDATE TO schoolos_identity_executor USING(true) WITH CHECK(true);
GRANT SELECT(id,school_id,state),UPDATE(id) ON app.campuses,app.academic_years TO schoolos_identity_executor;
CREATE POLICY db03_identity_parent_read ON app.campuses FOR SELECT TO schoolos_identity_executor USING(true);
CREATE POLICY db03_identity_parent_lock ON app.campuses FOR UPDATE TO schoolos_identity_executor USING(true) WITH CHECK(true);
CREATE POLICY db03_identity_parent_read ON app.academic_years FOR SELECT TO schoolos_identity_executor USING(true);
CREATE POLICY db03_identity_parent_lock ON app.academic_years FOR UPDATE TO schoolos_identity_executor USING(true) WITH CHECK(true);
CREATE FUNCTION app_private.db03_guard_identity_resolution() RETURNS trigger
LANGUAGE plpgsql SECURITY INVOKER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE a app_private.admission_applications%ROWTYPE;
 prior app_private.admission_identity_resolutions%ROWTYPE;
BEGIN
 IF TG_OP<>'INSERT' THEN RAISE EXCEPTION 'DB03 identity inspection history is immutable'; END IF;
 IF current_user<>'schoolos_identity_executor' THEN RAISE EXCEPTION 'DB03 identity requires protected attestation'; END IF;
 SELECT * INTO a FROM app_private.admission_applications WHERE id=NEW.application_id FOR UPDATE;
 IF NOT FOUND OR a.state<>'DRAFT' OR a.person_id IS DISTINCT FROM NEW.person_id
  OR a.row_version<>NEW.application_version OR a.stage_epoch<>NEW.stage_epoch THEN
  RAISE EXCEPTION 'DB03 identity application proof invalid'; END IF;
 IF NOT EXISTS(SELECT 1 FROM app_private.people p WHERE p.id=NEW.person_id AND p.state='ACTIVE' AND p.row_version=NEW.person_version) THEN
  RAISE EXCEPTION 'DB03 identity Person proof stale'; END IF;
 SELECT * INTO prior FROM app_private.admission_identity_resolutions WHERE application_id=a.id ORDER BY revision DESC LIMIT 1;
 IF (NOT FOUND AND NEW.revision<>1) OR (FOUND AND (NEW.revision<>prior.revision+1
   OR NEW.supersedes_id IS DISTINCT FROM prior.id OR NEW.person_id<>prior.person_id
   OR NEW.application_version<=prior.application_version OR NEW.stage_epoch<=prior.stage_epoch)) THEN
  RAISE EXCEPTION 'DB03 identity inspection lineage invalid'; END IF;
 RETURN NEW;
END $body$;
REVOKE ALL ON FUNCTION app_private.db03_guard_identity_resolution() FROM PUBLIC,anon,authenticated,service_role;
CREATE TRIGGER aa_db03_identity_history BEFORE INSERT OR UPDATE OR DELETE ON app_private.admission_identity_resolutions
 FOR EACH ROW EXECUTE FUNCTION app_private.db03_guard_identity_resolution();
CREATE TRIGGER db03_identity_no_truncate BEFORE TRUNCATE ON app_private.admission_identity_resolutions
 FOR EACH STATEMENT EXECUTE FUNCTION app_private.db03_guard_identity_resolution();
CREATE OR REPLACE FUNCTION app_private.db03_guard_intake() RETURNS trigger
LANGUAGE plpgsql SECURITY INVOKER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE prior record; parent record;
BEGIN
 IF TG_OP IN('DELETE','TRUNCATE') OR (TG_TABLE_NAME<>'admission_applications' AND TG_OP='UPDATE') THEN
  RAISE EXCEPTION 'DB03 intake history is immutable'; END IF;
 IF current_user='schoolos_identity_executor' AND TG_TABLE_NAME='admission_applications' AND TG_OP='UPDATE' THEN
  IF OLD.state<>'DRAFT' OR NEW.state<>'DRAFT' OR NEW.person_id IS NULL
   OR (OLD.person_id IS NOT NULL AND NEW.person_id IS DISTINCT FROM OLD.person_id)
   OR NEW.stage_epoch<>OLD.stage_epoch+1
   OR (pg_catalog.to_jsonb(NEW)-ARRAY['person_id','stage_epoch','row_version','updated_at']) IS DISTINCT FROM
      (pg_catalog.to_jsonb(OLD)-ARRAY['person_id','stage_epoch','row_version','updated_at']) THEN
   RAISE EXCEPTION 'DB03 identity binding requires same-Person draft attestation'; END IF;
  RETURN NEW;
 END IF;
 IF current_user<>'schoolos_workflow_executor' THEN RAISE EXCEPTION 'DB03 intake requires protected command'; END IF;
 IF TG_TABLE_NAME='admission_applications' THEN
  IF TG_OP='INSERT' AND (NEW.state<>'DRAFT' OR NEW.row_version<>1 OR NEW.person_id IS NOT NULL OR NEW.policy_version_id IS NOT NULL OR NEW.stage_epoch<>1) THEN RAISE EXCEPTION 'DB03 intake begins unresolved DRAFT'; END IF;
  IF TG_OP='UPDATE' AND (OLD.state<>'DRAFT' OR NEW.state NOT IN('DRAFT','WITHDRAWN')
   OR (pg_catalog.to_jsonb(NEW)-ARRAY['state','row_version','updated_at']) IS DISTINCT FROM
      (pg_catalog.to_jsonb(OLD)-ARRAY['state','row_version','updated_at'])) THEN
   RAISE EXCEPTION 'DB03 intake identity is frozen'; END IF;
  IF NOT EXISTS(SELECT 1 FROM app.campuses c WHERE c.id=NEW.campus_id AND c.school_id=NEW.school_id) THEN
   RAISE EXCEPTION 'DB03 intake Campus School mismatch'; END IF;
 ELSE
  SELECT * INTO parent FROM app_private.admission_applications WHERE id=NEW.application_id FOR UPDATE;
  IF NOT FOUND OR parent.row_version<>NEW.application_version THEN RAISE EXCEPTION 'DB03 intake history version mismatch'; END IF;
  IF TG_TABLE_NAME='admission_application_transitions' THEN
   IF parent.state<>NEW.to_state OR (NEW.sequence_number=2 AND NOT EXISTS(
    SELECT 1 FROM app_private.admission_application_transitions t WHERE t.application_id=parent.id AND t.sequence_number=1)) THEN
    RAISE EXCEPTION 'DB03 intake transition lineage invalid'; END IF;
  ELSIF TG_TABLE_NAME='admission_certificate_grace_history' THEN
   IF parent.state<>'DRAFT' THEN RAISE EXCEPTION 'DB03 grace requires pending draft'; END IF;
   SELECT * INTO prior FROM app_private.admission_certificate_grace_history WHERE application_id=parent.id ORDER BY revision DESC LIMIT 1;
   IF (NOT FOUND AND (NEW.revision<>1 OR NEW.first_granted_on<>NEW.recorded_on))
    OR (FOUND AND (NEW.revision<>prior.revision+1 OR NEW.supersedes_id IS DISTINCT FROM prior.id
      OR NEW.first_granted_on<>prior.first_granted_on OR NEW.recorded_on<prior.recorded_on)) THEN
    RAISE EXCEPTION 'DB03 grace original anchor and lineage are immutable'; END IF;
  ELSE RAISE EXCEPTION 'DB03 intake trigger denied'; END IF;
 END IF;
 RETURN NEW;
END $body$;
RESET ROLE;
SET ROLE schoolos_schema_owner;
CREATE VIEW app_private.admission_identity_current WITH(security_invoker=true) AS
 SELECT h.id,h.application_id,h.revision,h.person_id,h.person_version,h.application_version,h.stage_epoch,
 CASE WHEN a.state='WITHDRAWN' THEN 'WITHDRAWN'
      WHEN p.state<>'ACTIVE' OR p.row_version<>h.person_version OR a.person_id IS DISTINCT FROM h.person_id THEN 'REVERIFICATION_REQUIRED'
      ELSE 'CURRENT_STAFF_INSPECTION' END AS status
 FROM app_private.admission_identity_resolutions h
 JOIN app_private.admission_applications a ON a.id=h.application_id
 JOIN app_private.people p ON p.id=h.person_id
 WHERE NOT EXISTS(SELECT 1 FROM app_private.admission_identity_resolutions n WHERE n.application_id=h.application_id AND n.revision>h.revision);
REVOKE ALL ON app_private.admission_identity_current FROM PUBLIC,anon,authenticated,service_role;
RESET ROLE;
