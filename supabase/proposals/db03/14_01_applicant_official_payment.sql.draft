-- S14 Finance candidate: APPROVE atomically issues one unallocated official
-- payment with a permanent admission receipt number. Internal issuer only.
-- ADM is a distinct receipt namespace from DB08 student numeric serials.
SET ROLE schoolos_schema_owner;
ALTER TABLE app_private.finance_admission_slip_submissions
 ADD CONSTRAINT db03_applicant_payment_context UNIQUE
 (id,application_id,school_id,campus_id,claimed_amount_minor,currency_code,
  institution_key,reference_key);
CREATE TABLE app_private.finance_admission_official_payments (
 id uuid PRIMARY KEY DEFAULT pg_catalog.gen_random_uuid(),
 application_id uuid NOT NULL,
 school_id uuid NOT NULL REFERENCES app_private.school_profiles(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 campus_id uuid NOT NULL,
 amount_minor numeric NOT NULL CHECK(amount_minor>0 AND amount_minor=trunc(amount_minor)),
 currency_code text NOT NULL,
 institution_key text NOT NULL,
 reference_key text NOT NULL,
 submission_id uuid NOT NULL UNIQUE,
 review_id uuid NOT NULL UNIQUE,
 review_decision text NOT NULL DEFAULT 'APPROVE' CHECK(review_decision='APPROVE'),
 receipt_serial bigint NOT NULL CHECK(receipt_serial>0),
 receipt_number text GENERATED ALWAYS AS ('ADM-'||lpad(receipt_serial::text,10,'0')) STORED,
 received_at timestamptz NOT NULL DEFAULT pg_catalog.transaction_timestamp(),
 created_by uuid NOT NULL REFERENCES app_private.principals(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 FOREIGN KEY(submission_id,application_id,school_id,campus_id,amount_minor,currency_code,
  institution_key,reference_key) REFERENCES app_private.finance_admission_slip_submissions
  (id,application_id,school_id,campus_id,claimed_amount_minor,currency_code,institution_key,reference_key)
  ON UPDATE RESTRICT ON DELETE RESTRICT,
 FOREIGN KEY(review_id,submission_id,review_decision)
  REFERENCES app_private.finance_admission_slip_reviews(id,submission_id,decision)
  ON UPDATE RESTRICT ON DELETE RESTRICT,
 UNIQUE(school_id,receipt_serial), UNIQUE(school_id,receipt_number),
 UNIQUE(school_id,institution_key,reference_key)
);
CREATE INDEX db03_applicant_payment_application ON app_private.finance_admission_official_payments
 (application_id,received_at,id);
CREATE FUNCTION app_private.db03_applicant_payment_guard() RETURNS trigger
LANGUAGE plpgsql SECURITY INVOKER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE source app_private.finance_admission_slip_submissions%ROWTYPE;
 f app_private.file_objects%ROWTYPE;
BEGIN
 IF TG_OP<>'INSERT' THEN RAISE EXCEPTION 'DB03 applicant payment is immutable'; END IF;
 IF current_user<>'schoolos_schema_owner' THEN RAISE EXCEPTION 'DB03 payment requires protected issuer'; END IF;
 SELECT * INTO source FROM app_private.finance_admission_slip_submissions WHERE id=NEW.submission_id FOR UPDATE;
 SELECT * INTO f FROM app_private.file_objects WHERE id=source.evidence_file_id;
 IF source.id IS NULL OR f.id IS NULL OR f.state<>'AVAILABLE' OR f.classification<>'PRIVATE'
  OR f.purpose_code<>'ADMISSION_PAYMENT_EVIDENCE' OR f.content_hash<>source.evidence_sha256
  OR NOT EXISTS(SELECT 1 FROM app_private.finance_admission_slip_reviews r
   WHERE r.id=NEW.review_id AND r.submission_id=source.id AND r.decision='APPROVE'
    AND r.reviewer_id=NEW.created_by AND r.seen_sha256=source.evidence_sha256) THEN
  RAISE EXCEPTION 'DB03 applicant payment source mismatch'; END IF;
 RETURN NEW;
END $body$;
REVOKE ALL ON FUNCTION app_private.db03_applicant_payment_guard() FROM PUBLIC,anon,authenticated,service_role;
ALTER TABLE app_private.finance_admission_official_payments ENABLE ROW LEVEL SECURITY;
ALTER TABLE app_private.finance_admission_official_payments FORCE ROW LEVEL SECURITY;
REVOKE ALL ON app_private.finance_admission_official_payments FROM PUBLIC,anon,authenticated,service_role,
 schoolos_file_login,schoolos_platform_executor,schoolos_workflow_executor,schoolos_evidence_writer;
CREATE POLICY db03_applicant_payment_owner ON app_private.finance_admission_official_payments
 TO schoolos_schema_owner USING(true) WITH CHECK(true);
CREATE TRIGGER db03_applicant_payment_history BEFORE INSERT OR UPDATE OR DELETE
 ON app_private.finance_admission_official_payments FOR EACH ROW
 EXECUTE FUNCTION app_private.db03_applicant_payment_guard();
CREATE TRIGGER db03_applicant_payment_no_truncate BEFORE TRUNCATE
 ON app_private.finance_admission_official_payments FOR EACH STATEMENT
 EXECUTE FUNCTION app_private.db03_applicant_payment_guard();

CREATE FUNCTION app_private.db03_issue_applicant_payment(p_school uuid,p_submission uuid,
 p_review uuid,p_key text) RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER
 SET search_path=pg_catalog,pg_temp AS $body$
DECLARE actor uuid; operation uuid; source app_private.finance_admission_slip_submissions%ROWTYPE;
 review app_private.finance_admission_slip_reviews%ROWTYPE;
 payment app_private.finance_admission_official_payments%ROWTYPE;
 prior app_private.command_receipts%ROWTYPE; serial bigint; payload_hash bytea; result jsonb;
 receipt_id uuid; correlation uuid;
BEGIN
 IF session_user<>'schoolos_file_login' OR current_setting('transaction_isolation')<>'read committed'
  OR p_school IS NULL OR p_submission IS NULL OR p_review IS NULL
  OR p_key IS NULL OR length(p_key) NOT BETWEEN 1 AND 180 THEN
  RAISE EXCEPTION 'DB03 applicant payment input denied'; END IF;
 -- The review authority checks current Auth, School, Campus, application,
 -- reviewer independence, and the original review grant at issuance time.
 actor:=app_private.db03_applicant_review_authority(p_school,p_submission);
 IF NOT app_private.has_complete_grant('finance.admission.payment.issue','CAMPUS',
  (SELECT campus_id FROM app_private.finance_admission_slip_submissions WHERE id=p_submission)) THEN
  RAISE EXCEPTION 'DB03 applicant payment issue authority denied'; END IF;
 SELECT o.id INTO operation FROM app_private.operation_contracts o
 JOIN app_private.permissions p ON p.id=o.request_permission_id
 WHERE o.code='finance.admission.payment.issue' AND o.contract_version=1
  AND o.handler_key=o.code AND o.payload_schema_version=1 AND o.enabled
  AND NOT o.requires_approval AND p.code=o.code AND p.state='ENABLED' AND NOT p.family_safe;
 IF operation IS NULL THEN RAISE EXCEPTION 'DB03 applicant payment operation unavailable'; END IF;
 -- The School row serializes issuances, including competing submissions.
 PERFORM 1 FROM app_private.school_profiles WHERE id=p_school AND state IN('SETUP','ACTIVE') FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DB03 applicant payment School unavailable'; END IF;
 SELECT * INTO source FROM app_private.finance_admission_slip_submissions
  WHERE id=p_submission AND school_id=p_school FOR UPDATE;
 SELECT * INTO review FROM app_private.finance_admission_slip_reviews
  WHERE id=p_review AND submission_id=p_submission AND decision='APPROVE' FOR UPDATE;
 IF source.id IS NULL OR review.id IS NULL OR review.reviewer_id<>actor
  OR review.seen_sha256<>source.evidence_sha256 THEN
  RAISE EXCEPTION 'DB03 approved applicant review required'; END IF;
 payload_hash:=sha256(convert_to(jsonb_build_array('applicant-payment-v1',p_school,
  p_submission,p_review)::text,'UTF8'));
 SELECT * INTO prior FROM app_private.command_receipts WHERE principal_id=actor
  AND operation_id=operation AND idempotency_key='applicant-payment:'||p_key;
 IF prior.id IS NOT NULL THEN
  SELECT * INTO payment FROM app_private.finance_admission_official_payments WHERE id=prior.result_ref;
  IF prior.state<>'SUCCEEDED' OR prior.command_kind<>'finance.admission.payment.issue'
   OR prior.result_kind<>'FINANCE_ADMISSION_PAYMENT' OR prior.canonical_payload_hash<>payload_hash
   OR payment.id IS NULL OR payment.school_id<>p_school OR payment.submission_id<>p_submission
   OR payment.review_id<>p_review OR payment.created_by<>actor
   OR (SELECT count(*) FROM app_private.audit_events WHERE command_receipt_id=prior.id)<>1
   OR (SELECT count(*) FROM app_private.outbox_events WHERE command_receipt_id=prior.id)<>1 THEN
   RAISE EXCEPTION 'DB03 applicant payment replay conflict'; END IF;
  RETURN prior.result_summary;
 END IF;
 IF EXISTS(SELECT 1 FROM app_private.finance_admission_official_payments p
   JOIN app_private.finance_admission_slip_submissions s ON s.id=p.submission_id
   WHERE p.school_id=p_school AND (p.submission_id=source.id OR p.review_id=review.id
    OR (p.institution_key=source.institution_key AND p.reference_key=source.reference_key)
    OR s.evidence_sha256=source.evidence_sha256)) THEN
  RAISE EXCEPTION 'DB03 applicant payment already issued for transfer'; END IF;
 SELECT coalesce(max(receipt_serial),0)+1 INTO serial
  FROM app_private.finance_admission_official_payments WHERE school_id=p_school;
 IF serial<1 OR serial>9999999999 THEN RAISE EXCEPTION 'DB03 applicant receipt serial exhausted'; END IF;
 INSERT INTO app_private.finance_admission_official_payments(application_id,school_id,campus_id,
  amount_minor,currency_code,institution_key,reference_key,submission_id,review_id,receipt_serial,created_by)
 VALUES(source.application_id,source.school_id,source.campus_id,source.claimed_amount_minor,
  source.currency_code,source.institution_key,source.reference_key,source.id,review.id,serial,actor)
 RETURNING * INTO payment;
 result:=jsonb_build_object('payment_id',payment.id,'application_id',payment.application_id,
  'submission_id',source.id,'review_id',review.id,'school_id',payment.school_id,
  'campus_id',payment.campus_id,'amount_minor',payment.amount_minor,
  'currency_code',payment.currency_code,'receipt_number',payment.receipt_number,
  'state','RECORDED_UNALLOCATED');
 receipt_id:=gen_random_uuid(); correlation:=gen_random_uuid();
 INSERT INTO app_private.command_receipts(id,principal_id,operation_id,command_kind,
  idempotency_key,canonical_payload_hash,canonicalization_version,state,result_kind,result_ref,
  result_summary,completed_at,created_by)
 VALUES(receipt_id,actor,operation,'finance.admission.payment.issue','applicant-payment:'||p_key,
  payload_hash,1,'SUCCEEDED','FINANCE_ADMISSION_PAYMENT',payment.id,result,clock_timestamp(),actor);
 INSERT INTO app_private.audit_events(actor_id,actor_kind,outcome,authority_evidence,
  target_version,event_type,target_kind,target_ref,campus_id,command_receipt_id,
  source_kind,correlation_id,occurred_at,details,created_by)
 VALUES(actor,'INDIVIDUAL','SUCCEEDED',jsonb_build_object('operation','finance.admission.payment.issue',
  'review_id',review.id),1,'finance.admission.payment.issue','FINANCE_ADMISSION_PAYMENT',
  payment.id,payment.campus_id,receipt_id,'WORKER',correlation,clock_timestamp(),result,actor);
 INSERT INTO app_private.outbox_events(event_type,aggregate_kind,aggregate_ref,
  aggregate_version,command_receipt_id,event_ordinal,correlation_id,occurred_at,payload,created_by)
 VALUES('finance.admission.payment.issue','FINANCE_ADMISSION_PAYMENT',payment.id,1,
  receipt_id,1,correlation,clock_timestamp(),result,actor);
 RETURN result;
END $body$;
REVOKE ALL ON FUNCTION app_private.db03_issue_applicant_payment(uuid,uuid,uuid,text)
 FROM PUBLIC,anon,authenticated,service_role,schoolos_file_login;
RESET ROLE;
