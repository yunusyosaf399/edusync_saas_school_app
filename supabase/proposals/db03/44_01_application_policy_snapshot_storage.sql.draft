-- P44 inactive application-scoped published-policy/profile provenance storage.
-- No binding writer, no policy selection, no Principal APPROVE or Student create.
-- Existing admission_applications.policy_version_id remains intentionally NULL.
SET ROLE schoolos_schema_owner;
ALTER TABLE app_private.admission_applications
 ADD CONSTRAINT db03_policy_snapshot_application_scope_key
 UNIQUE(id,school_id,academic_year_id);
ALTER TABLE app_private.admission_policy_versions
 ADD CONSTRAINT db03_policy_snapshot_policy_profiles_key
 UNIQUE(id,school_id,application_numbering_profile_id,admission_numbering_profile_id);
CREATE TABLE app_private.admission_application_policy_snapshots (
 id uuid PRIMARY KEY DEFAULT pg_catalog.gen_random_uuid(),
 application_id uuid NOT NULL,
 school_id uuid NOT NULL REFERENCES app_private.school_profiles(id)
   ON UPDATE RESTRICT ON DELETE RESTRICT,
 academic_year_id uuid NOT NULL,
 policy_version_id uuid NOT NULL,
 application_numbering_profile_id uuid NOT NULL,
 admission_numbering_profile_id uuid NOT NULL,
 revision bigint NOT NULL CHECK(revision>0),
 supersedes_id uuid UNIQUE,
 application_version bigint NOT NULL CHECK(application_version>0),
 stage_epoch bigint NOT NULL CHECK(stage_epoch>0),
 published_configuration_hash bytea NOT NULL
   CHECK(pg_catalog.octet_length(published_configuration_hash)=32),
 command_receipt_id uuid NOT NULL UNIQUE
   REFERENCES app_private.command_receipts(id) DEFERRABLE INITIALLY DEFERRED,
 recorded_at timestamptz NOT NULL DEFAULT pg_catalog.transaction_timestamp(),
 created_by uuid NOT NULL REFERENCES app_private.principals(id)
   ON UPDATE RESTRICT ON DELETE RESTRICT,
 CONSTRAINT db03_policy_snapshot_application_revision UNIQUE(application_id,revision),
 CONSTRAINT db03_policy_snapshot_same_application_key UNIQUE(id,application_id),
 FOREIGN KEY(application_id,school_id,academic_year_id)
   REFERENCES app_private.admission_applications(id,school_id,academic_year_id)
   ON UPDATE RESTRICT ON DELETE RESTRICT,
 FOREIGN KEY(policy_version_id,school_id,application_numbering_profile_id,
             admission_numbering_profile_id)
   REFERENCES app_private.admission_policy_versions
              (id,school_id,application_numbering_profile_id,admission_numbering_profile_id)
   ON UPDATE RESTRICT ON DELETE RESTRICT,
 FOREIGN KEY(supersedes_id,application_id)
   REFERENCES app_private.admission_application_policy_snapshots(id,application_id)
   ON UPDATE RESTRICT ON DELETE RESTRICT,
 CHECK((revision=1)=(supersedes_id IS NULL))
);
CREATE INDEX db03_policy_snapshot_current
 ON app_private.admission_application_policy_snapshots(application_id,revision DESC);
ALTER TABLE app_private.admission_application_policy_snapshots ENABLE ROW LEVEL SECURITY;
ALTER TABLE app_private.admission_application_policy_snapshots FORCE ROW LEVEL SECURITY;
REVOKE ALL ON app_private.admission_application_policy_snapshots
 FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,
 schoolos_student_executor,schoolos_identity_executor,schoolos_evidence_writer,
 schoolos_authz_reader,schoolos_platform_executor,schoolos_file_login;
CREATE POLICY db03_policy_snapshot_owner
 ON app_private.admission_application_policy_snapshots
 TO schoolos_schema_owner USING(true) WITH CHECK(true);
CREATE FUNCTION app_private.db03_policy_snapshot_mutation_unavailable()
RETURNS trigger LANGUAGE plpgsql VOLATILE SECURITY INVOKER
SET search_path=pg_catalog,pg_temp AS $body$
BEGIN
 RAISE EXCEPTION 'DB03 admission policy snapshot writer unavailable';
END $body$;
REVOKE ALL ON FUNCTION app_private.db03_policy_snapshot_mutation_unavailable()
 FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,
 schoolos_student_executor,schoolos_identity_executor,schoolos_evidence_writer,
 schoolos_authz_reader,schoolos_platform_executor,schoolos_file_login;
CREATE TRIGGER db03_policy_snapshot_mutation_disabled
 BEFORE INSERT OR UPDATE OR DELETE
 ON app_private.admission_application_policy_snapshots FOR EACH ROW
 EXECUTE FUNCTION app_private.db03_policy_snapshot_mutation_unavailable();
CREATE TRIGGER db03_policy_snapshot_no_truncate
 BEFORE TRUNCATE ON app_private.admission_application_policy_snapshots FOR EACH STATEMENT
 EXECUTE FUNCTION app_private.db03_policy_snapshot_mutation_unavailable();
RESET ROLE;
