-- Inactive P4 initial assessment source. No examiner command, retake, correction or stage effect.
-- Requires S1-S10 published policy/intake and the applicant stack; no Student/Finance effect.
SET ROLE schoolos_schema_owner;
CREATE TABLE app_private.admission_assessments (
 id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
 application_id uuid NOT NULL,
 school_id uuid NOT NULL,
 campus_id uuid NOT NULL,
 academic_year_id uuid NOT NULL,
 intake_id uuid NOT NULL,
 policy_stage_id uuid NOT NULL REFERENCES app_private.admission_policy_stages(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 revision bigint NOT NULL CHECK(revision=1),
 assessment_kind text NOT NULL CHECK(assessment_kind IN('ADMISSION_TEST','INTERVIEW')),
 outcome text NOT NULL CHECK(outcome IN('PASSED','FAILED')),
 score numeric(12,4), maximum_score numeric(12,4),
 assessed_on date NOT NULL CHECK(isfinite(assessed_on)),
 reason_private text NOT NULL CHECK(length(btrim(reason_private)) BETWEEN 1 AND 1000),
 assessor_id uuid NOT NULL REFERENCES app_private.principals(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 application_version bigint NOT NULL CHECK(application_version>0),
 stage_epoch bigint NOT NULL CHECK(stage_epoch>0),
 command_receipt_id uuid NOT NULL UNIQUE REFERENCES app_private.command_receipts(id)
  ON UPDATE RESTRICT ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
 occurred_at timestamptz NOT NULL DEFAULT transaction_timestamp(),
 FOREIGN KEY(application_id,school_id,campus_id,academic_year_id)
  REFERENCES app_private.admission_applications(id,school_id,campus_id,academic_year_id)
  ON UPDATE RESTRICT ON DELETE RESTRICT,
 FOREIGN KEY(intake_id,application_id) REFERENCES app_private.admission_document_intakes(id,application_id)
  ON UPDATE RESTRICT ON DELETE RESTRICT,
 UNIQUE(application_id,policy_stage_id,revision),
 UNIQUE(id,application_id,policy_stage_id),
 CHECK((score IS NULL AND maximum_score IS NULL) OR
  (score IS NOT NULL AND maximum_score IS NOT NULL AND maximum_score>0 AND score>=0 AND score<=maximum_score))
);
CREATE INDEX db03_assessment_application_stage ON app_private.admission_assessments(application_id,policy_stage_id,revision DESC);
ALTER TABLE app_private.admission_assessments ENABLE ROW LEVEL SECURITY;
ALTER TABLE app_private.admission_assessments FORCE ROW LEVEL SECURITY;
CREATE POLICY db03_assessment_owner ON app_private.admission_assessments
 TO schoolos_schema_owner USING(true) WITH CHECK(true);
REVOKE ALL ON app_private.admission_assessments FROM PUBLIC,anon,authenticated,service_role,
 schoolos_file_login,schoolos_workflow_executor,schoolos_platform_executor,schoolos_identity_executor,
 schoolos_evidence_writer;
CREATE FUNCTION app_private.db03_assessment_source_guard() RETURNS trigger
LANGUAGE plpgsql SECURITY INVOKER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE a app_private.admission_applications%ROWTYPE;
 intake app_private.admission_document_intakes%ROWTYPE;
 stage app_private.admission_policy_stages%ROWTYPE;
BEGIN
 IF TG_OP<>'INSERT' THEN RAISE EXCEPTION 'DB03 assessment source is immutable'; END IF;
 IF current_user<>'schoolos_schema_owner' THEN RAISE EXCEPTION 'DB03 assessment requires protected issuer'; END IF;
 SELECT * INTO a FROM app_private.admission_applications WHERE id=NEW.application_id FOR UPDATE;
 SELECT * INTO intake FROM app_private.admission_document_intakes WHERE id=NEW.intake_id;
 SELECT * INTO stage FROM app_private.admission_policy_stages WHERE id=NEW.policy_stage_id;
 IF a.id IS NULL OR a.state<>'DRAFT' OR a.row_version<>NEW.application_version
  OR a.stage_epoch<>NEW.stage_epoch OR a.school_id<>NEW.school_id
  OR a.campus_id<>NEW.campus_id OR a.academic_year_id<>NEW.academic_year_id
  OR intake.id IS NULL OR intake.application_id<>a.id
  OR EXISTS(SELECT 1 FROM app_private.admission_document_intakes newer
   WHERE newer.application_id=a.id AND newer.revision>intake.revision)
  OR stage.id IS NULL OR stage.policy_version_id<>intake.policy_version_id
  OR stage.stage_kind<>NEW.assessment_kind OR stage.requirement<>'REQUIRED'
  OR NOT EXISTS(SELECT 1 FROM app_private.admission_policy_versions p
   WHERE p.id=stage.policy_version_id AND p.school_id=a.school_id AND p.state='PUBLISHED')
  OR EXISTS(SELECT 1 FROM app_private.admission_assessments prior
   WHERE prior.application_id=a.id AND prior.policy_stage_id=stage.id)
 THEN RAISE EXCEPTION 'DB03 assessment context or initial decision invalid'; END IF;
 RETURN NEW;
END $body$;
REVOKE ALL ON FUNCTION app_private.db03_assessment_source_guard()
 FROM PUBLIC,anon,authenticated,service_role,schoolos_file_login;
CREATE TRIGGER db03_assessment_history BEFORE INSERT OR UPDATE OR DELETE
 ON app_private.admission_assessments FOR EACH ROW EXECUTE FUNCTION app_private.db03_assessment_source_guard();
CREATE TRIGGER db03_assessment_no_truncate BEFORE TRUNCATE
 ON app_private.admission_assessments FOR EACH STATEMENT EXECUTE FUNCTION app_private.db03_assessment_source_guard();
RESET ROLE;
