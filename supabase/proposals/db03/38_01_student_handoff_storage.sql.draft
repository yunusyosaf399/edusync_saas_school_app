-- P38: inactive private Admissions -> D1 single-use Student handoff STORAGE ONLY.
-- No issuer, no consume command, no grants, no Student.create activation.
-- One approval must eventually issue and consume this source IN THE SAME
-- transaction as D1 Student, status, PRIMARY Enrollment, roll and evidence.
SET ROLE schoolos_schema_owner;
CREATE TABLE app_private.admission_student_handoffs (
 id uuid PRIMARY KEY DEFAULT pg_catalog.gen_random_uuid(),
 application_id uuid NOT NULL UNIQUE
   REFERENCES app_private.admission_applications(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 forward_id uuid NOT NULL,
 identity_resolution_id uuid NOT NULL
   REFERENCES app_private.admission_identity_resolutions(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 person_id uuid NOT NULL
   REFERENCES app_private.people(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 class_offering_id uuid NOT NULL
   REFERENCES app_private.class_offerings(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 section_offering_id uuid NOT NULL
   REFERENCES app_private.section_offerings(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 fee_disposition_id uuid NOT NULL
   REFERENCES app_private.admission_fee_dispositions(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 application_version bigint NOT NULL CHECK(application_version>0),
 stage_epoch bigint NOT NULL CHECK(stage_epoch>0),
 reviewed_snapshot_hash bytea NOT NULL CHECK(octet_length(reviewed_snapshot_hash)=32),
 state text NOT NULL CHECK(state IN('READY','CONSUMED')),
 approval_receipt_id uuid NOT NULL UNIQUE
   REFERENCES app_private.command_receipts(id) DEFERRABLE INITIALLY DEFERRED,
 result_student_id uuid UNIQUE
   REFERENCES app_private.students(id) DEFERRABLE INITIALLY DEFERRED,
 consumption_receipt_id uuid UNIQUE
   REFERENCES app_private.command_receipts(id) DEFERRABLE INITIALLY DEFERRED,
 issued_at timestamptz NOT NULL DEFAULT pg_catalog.transaction_timestamp(),
 consumed_at timestamptz,
 created_by uuid NOT NULL
   REFERENCES app_private.principals(id) ON UPDATE RESTRICT ON DELETE RESTRICT,
 FOREIGN KEY(forward_id,application_id)
   REFERENCES app_private.admission_document_forwards(id,application_id)
   ON UPDATE RESTRICT ON DELETE RESTRICT,
 CHECK((state='READY' AND result_student_id IS NULL
         AND consumption_receipt_id IS NULL AND consumed_at IS NULL)
    OR (state='CONSUMED' AND result_student_id IS NOT NULL
         AND consumption_receipt_id IS NOT NULL AND consumed_at IS NOT NULL
         AND consumed_at>=issued_at))
);
-- Exactly one final approved Student handoff per application, including
-- replay and any committed consumption; failure must roll everything back.
CREATE INDEX db03_handoff_person ON app_private.admission_student_handoffs(person_id,application_id);
CREATE INDEX db03_handoff_section ON app_private.admission_student_handoffs(section_offering_id,application_id);
ALTER TABLE app_private.admission_student_handoffs ENABLE ROW LEVEL SECURITY;
ALTER TABLE app_private.admission_student_handoffs FORCE ROW LEVEL SECURITY;
REVOKE ALL ON app_private.admission_student_handoffs
 FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,
 schoolos_student_executor,schoolos_identity_executor,schoolos_evidence_writer,
 schoolos_authz_reader,schoolos_platform_executor,schoolos_file_login;
CREATE POLICY db03_handoff_storage_owner
 ON app_private.admission_student_handoffs
 TO schoolos_schema_owner USING(true) WITH CHECK(true);
-- Fail closed for all actors, *including* the owner in disposable fixtures.
-- The future APPROVE/D1 pair must replace this fence through separately
-- reviewed fixed-owner SQL that preserves RLS, scope and cross-package locks.
CREATE FUNCTION app_private.db03_student_handoff_mutation_unavailable()
RETURNS trigger LANGUAGE plpgsql VOLATILE SECURITY INVOKER
SET search_path=pg_catalog,pg_temp AS $body$
BEGIN
 RAISE EXCEPTION 'DB03 atomic Student handoff writer unavailable';
END $body$;
REVOKE ALL ON FUNCTION app_private.db03_student_handoff_mutation_unavailable()
 FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,
 schoolos_student_executor,schoolos_identity_executor,schoolos_evidence_writer,
 schoolos_authz_reader,schoolos_platform_executor,schoolos_file_login;
CREATE TRIGGER db03_handoff_mutation_disabled
 BEFORE INSERT OR UPDATE OR DELETE ON app_private.admission_student_handoffs
 FOR EACH ROW EXECUTE FUNCTION app_private.db03_student_handoff_mutation_unavailable();
CREATE TRIGGER db03_handoff_no_truncate
 BEFORE TRUNCATE ON app_private.admission_student_handoffs FOR EACH STATEMENT
 EXECUTE FUNCTION app_private.db03_student_handoff_mutation_unavailable();
RESET ROLE;
