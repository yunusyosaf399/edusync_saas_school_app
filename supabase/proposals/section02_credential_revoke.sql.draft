-- DB-014 inactive extension after section02_credential_suspend.sql.draft.
-- Revokes School OS binding and aliases after a separate human suspension.
-- Auth provider sessions must be revoked by an isolated server adapter later.
-- No operation, permission, grant, account or managed Auth object is seeded.
GRANT SELECT(completed_at) ON app_private.command_receipts TO schoolos_identity_executor;
GRANT SELECT(id,principal_id,auth_user_id,binding_version,tokens_valid_from)
  ON app_private.principal_auth_bindings TO schoolos_identity_executor;
GRANT UPDATE(auth_user_id) ON app_private.principal_auth_bindings TO schoolos_identity_executor;
GRANT SELECT(id,principal_id,state) ON app_private.login_aliases TO schoolos_identity_executor;
GRANT UPDATE(state) ON app_private.login_aliases TO schoolos_identity_executor;
GRANT SELECT(id,binding_id,binding_version,event_kind,old_auth_user_id,new_auth_user_id,created_at)
  ON app_private.principal_binding_events TO schoolos_identity_executor;
SET ROLE schoolos_schema_owner;
CREATE POLICY s02_revoke_binding_read ON app_private.principal_auth_bindings
  FOR SELECT TO schoolos_identity_executor USING(true);
CREATE POLICY s02_revoke_binding_write ON app_private.principal_auth_bindings
  FOR UPDATE TO schoolos_identity_executor USING(true) WITH CHECK(true);
CREATE POLICY s02_revoke_alias_read ON app_private.login_aliases
  FOR SELECT TO schoolos_identity_executor USING(true);
CREATE POLICY s02_revoke_alias_write ON app_private.login_aliases
  FOR UPDATE TO schoolos_identity_executor USING(true) WITH CHECK(true);
CREATE POLICY s02_revoke_event_read ON app_private.principal_binding_events
  FOR SELECT TO schoolos_identity_executor USING(true);
GRANT CREATE ON SCHEMA app_private TO schoolos_evidence_writer;
GRANT CREATE ON SCHEMA app TO schoolos_identity_executor;
RESET ROLE;
SET ROLE schoolos_evidence_writer;
CREATE FUNCTION app_private.section02_revocation_evidence(
  p_actor uuid,p_subject uuid,p_target uuid,p_version bigint,p_reason text,
  p_key text,p_hash bytea,p_operation uuid,p_suspension uuid,
  p_binding_event uuid,p_binding_version bigint
) RETURNS uuid LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $evidence$
DECLARE receipt_id uuid:=pg_catalog.gen_random_uuid(); correlation uuid:=pg_catalog.gen_random_uuid();
BEGIN
  INSERT INTO app_private.command_receipts(id,principal_id,operation_id,command_kind,
    idempotency_key,canonical_payload_hash,expected_target_version,state,result_kind,
    result_ref,result_summary,completed_at,created_by)
  VALUES(receipt_id,p_actor,p_operation,'credential.revoke',p_key,p_hash,
    p_version,'SUCCEEDED','PRINCIPAL',p_target,
    pg_catalog.jsonb_build_object('state','SUSPENDED','binding_event_id',p_binding_event,
      'binding_version',p_binding_version,'suspension_receipt_id',p_suspension),
    pg_catalog.clock_timestamp(),p_actor);
  INSERT INTO app_private.audit_events(actor_id,actor_kind,auth_subject_snapshot,outcome,reason,
    authority_evidence,target_version,event_type,target_kind,target_ref,command_receipt_id,
    source_kind,correlation_id,details,created_by)
  VALUES(p_actor,'INDIVIDUAL',p_subject,'SUCCEEDED',p_reason,
    pg_catalog.jsonb_build_object('operation','identity.credential.revoke',
      'scope','ALL','independent_suspension_receipt',p_suspension),
    p_version,'identity.credential_revoked','principal',p_target,
    receipt_id,'API',correlation,
    pg_catalog.jsonb_build_object('binding_event_id',p_binding_event,
      'binding_version',p_binding_version),p_actor);
  INSERT INTO app_private.outbox_events(event_type,aggregate_kind,aggregate_ref,
    aggregate_version,command_receipt_id,event_ordinal,correlation_id,payload,created_by)
  VALUES('identity.credential_revoked','principal_auth_binding',p_target,
    p_binding_version,receipt_id,1,correlation,
    pg_catalog.jsonb_build_object('principal_id',p_target,'binding_event_id',p_binding_event),p_actor);
  RETURN receipt_id;
END $evidence$;
REVOKE ALL ON FUNCTION app_private.section02_revocation_evidence(uuid,uuid,uuid,bigint,text,text,bytea,uuid,uuid,uuid,bigint)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.section02_revocation_evidence(uuid,uuid,uuid,bigint,text,text,bytea,uuid,uuid,uuid,bigint)
 TO schoolos_identity_executor;
RESET ROLE;
SET ROLE schoolos_schema_owner;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_evidence_writer;
RESET ROLE;
SET ROLE schoolos_identity_executor;
CREATE FUNCTION app.section02_revoke_credential(
  p_target uuid,p_expected_version bigint,p_suspension_receipt uuid,
  p_reason text,p_idempotency_key text
) RETURNS uuid LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $body$
DECLARE actor uuid; actor_row record; target_row record; suspension record;
  op record; receipt record; binding_row record; changed record; event_row record;
  payload_hash bytea;
BEGIN
  IF pg_catalog.current_setting('transaction_isolation')<>'read committed'
    OR p_target IS NULL OR p_expected_version IS NULL OR p_expected_version<1
    OR p_suspension_receipt IS NULL OR p_reason IS NULL
    OR pg_catalog.length(pg_catalog.btrim(p_reason)) NOT BETWEEN 5 AND 500
    OR p_idempotency_key IS NULL OR pg_catalog.length(p_idempotency_key) NOT BETWEEN 1 AND 200
  THEN RAISE EXCEPTION 'credential revocation denied'; END IF;
  PERFORM pg_catalog.pg_advisory_xact_lock(71001,1);
  actor:=app_private.current_principal_id();
  IF actor IS NULL OR actor=p_target THEN RAISE EXCEPTION 'credential revocation denied'; END IF;
  PERFORM pg_catalog.pg_advisory_xact_lock(71002,
    pg_catalog.hashtext(actor::text||':'||p_idempotency_key));
  PERFORM 1 FROM app_private.principals p WHERE p.id IN (actor,p_target)
    ORDER BY p.id FOR UPDATE;
  SELECT p.kind,p.person_id,p.state INTO actor_row FROM app_private.principals p WHERE p.id=actor;
  SELECT p.kind,p.state,p.row_version INTO target_row FROM app_private.principals p WHERE p.id=p_target;
  IF actor_row.kind<>'INDIVIDUAL' OR actor_row.state<>'ACTIVE'
    OR NOT EXISTS(SELECT 1 FROM app_private.people person
      WHERE person.id=actor_row.person_id AND person.state='ACTIVE')
    OR target_row.kind NOT IN ('INDIVIDUAL','FAMILY')
    OR NOT EXISTS(SELECT 1 FROM app_private.school_profiles s WHERE s.state='ACTIVE')
  THEN RAISE EXCEPTION 'credential revocation denied'; END IF;
  SELECT o.id INTO op FROM app_private.operation_contracts o
    JOIN app_private.permissions p ON p.id=o.request_permission_id
   WHERE o.code='identity.credential.revoke' AND o.contract_version=1
     AND o.handler_key='SECTION02_REVOKE_V1' AND o.enabled AND NOT o.requires_approval
     AND p.code='identity.credential.revoke' AND p.state='ENABLED' AND NOT p.family_safe;
  IF op.id IS NULL OR app_private.has_complete_grant('identity.credential.revoke','ALL',NULL) IS DISTINCT FROM true
  THEN RAISE EXCEPTION 'credential revocation denied'; END IF;
  payload_hash:=pg_catalog.sha256(pg_catalog.convert_to(pg_catalog.jsonb_build_array(
    p_target,p_expected_version,p_suspension_receipt,p_reason)::text,'UTF8'));
  SELECT r.id,r.command_kind,r.canonical_payload_hash,r.expected_target_version,
    r.state,r.result_kind,r.result_ref INTO receipt
    FROM app_private.command_receipts r
   WHERE r.principal_id=actor AND r.operation_id=op.id AND r.idempotency_key=p_idempotency_key;
  IF FOUND THEN
    IF receipt.command_kind<>'credential.revoke' OR receipt.canonical_payload_hash<>payload_hash
       OR receipt.expected_target_version<>p_expected_version OR receipt.state<>'SUCCEEDED'
       OR receipt.result_kind<>'PRINCIPAL' OR receipt.result_ref<>p_target
    THEN RAISE EXCEPTION 'credential revocation denied'; END IF;
    RETURN receipt.id;
  END IF;
  SELECT r.principal_id,r.command_kind,r.state,r.result_kind,r.result_ref,
         r.result_summary,r.completed_at INTO suspension FROM app_private.command_receipts r
    JOIN app_private.operation_contracts o ON o.id=r.operation_id
   WHERE r.id=p_suspension_receipt AND o.code='identity.credential.suspend'
     AND o.contract_version=1 AND o.handler_key='SECTION02_SUSPEND_V1';
  IF NOT FOUND OR suspension.command_kind<>'credential.suspend'
     OR suspension.state<>'SUCCEEDED' OR suspension.result_kind<>'PRINCIPAL'
     OR suspension.result_ref<>p_target OR suspension.principal_id=actor
     OR NOT EXISTS(SELECT 1 FROM app_private.principals initiator
       WHERE initiator.id=suspension.principal_id AND initiator.kind='INDIVIDUAL'
         AND initiator.person_id<>actor_row.person_id)
     OR target_row.state<>'SUSPENDED' OR target_row.row_version<>p_expected_version
     OR suspension.result_summary->>'state'<>'SUSPENDED'
     OR suspension.result_summary->>'version'<>p_expected_version::text
  THEN RAISE EXCEPTION 'credential revocation denied'; END IF;
  SELECT b.id,b.binding_version,b.auth_user_id INTO binding_row
    FROM app_private.principal_auth_bindings b WHERE b.principal_id=p_target FOR UPDATE;
  IF NOT FOUND OR binding_row.auth_user_id IS NULL
     OR NOT EXISTS(SELECT 1 FROM app_private.principal_binding_events prior
       WHERE prior.binding_id=binding_row.id
         AND prior.binding_version=binding_row.binding_version
         AND prior.new_auth_user_id=binding_row.auth_user_id
         AND prior.created_at<=suspension.completed_at)
  THEN RAISE EXCEPTION 'credential revocation denied'; END IF;
  UPDATE app_private.principal_auth_bindings b SET auth_user_id=NULL
    WHERE b.id=binding_row.id RETURNING b.binding_version INTO changed;
  SELECT e.id,e.binding_version INTO event_row FROM app_private.principal_binding_events e
   WHERE e.binding_id=binding_row.id AND e.binding_version=changed.binding_version
     AND e.event_kind='UNBOUND' AND e.old_auth_user_id=binding_row.auth_user_id
     AND e.new_auth_user_id IS NULL;
  IF NOT FOUND THEN RAISE EXCEPTION 'credential revocation denied'; END IF;
  UPDATE app_private.login_aliases a SET state='RETIRED'
    WHERE a.principal_id=p_target AND a.state IN ('RESERVED','ACTIVE');
  RETURN app_private.section02_revocation_evidence(
    actor,(pg_catalog.current_setting('request.jwt.claims',true)::jsonb->>'sub')::uuid,
    p_target,p_expected_version,p_reason,p_idempotency_key,payload_hash,op.id,
    p_suspension_receipt,event_row.id,changed.binding_version);
END $body$;
REVOKE ALL ON FUNCTION app.section02_revoke_credential(uuid,bigint,uuid,text,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.section02_revoke_credential(uuid,bigint,uuid,text,text) TO authenticated;
RESET ROLE;
SET ROLE schoolos_schema_owner;
REVOKE CREATE ON SCHEMA app FROM schoolos_identity_executor;
RESET ROLE;
