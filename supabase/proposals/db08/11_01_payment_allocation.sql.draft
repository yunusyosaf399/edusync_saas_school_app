-- F11 candidate: immutable allocation of an official payment to a selected
-- Student fee obligation. No invoice, refund or admission clearance.
SET ROLE schoolos_schema_owner;
CREATE TABLE app_private.finance_payment_allocations (
 id uuid PRIMARY KEY DEFAULT pg_catalog.gen_random_uuid(),
 school_id uuid NOT NULL REFERENCES app_private.school_profiles(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
 campus_id uuid NOT NULL REFERENCES app.campuses(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
 student_id uuid NOT NULL REFERENCES app_private.students(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
 payment_id uuid NOT NULL REFERENCES app_private.finance_official_payments(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
 obligation_id uuid NOT NULL REFERENCES app_private.finance_fee_obligations(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
 amount_minor numeric NOT NULL CHECK(amount_minor>0 AND amount_minor<1000000000000000000000000
   AND amount_minor=trunc(amount_minor)),
 allocated_at timestamptz NOT NULL DEFAULT pg_catalog.transaction_timestamp(),
 created_by uuid NOT NULL REFERENCES app_private.principals(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
 UNIQUE(payment_id,obligation_id)
);
CREATE INDEX db08_allocation_obligation ON app_private.finance_payment_allocations(obligation_id,allocated_at,id);
CREATE INDEX db08_allocation_payment ON app_private.finance_payment_allocations(payment_id,allocated_at,id);
ALTER TABLE app_private.finance_payment_allocations ENABLE ROW LEVEL SECURITY;
ALTER TABLE app_private.finance_payment_allocations FORCE ROW LEVEL SECURITY;
CREATE POLICY db08_f11_owner ON app_private.finance_payment_allocations
 FOR ALL TO schoolos_schema_owner USING(true) WITH CHECK(true);
REVOKE ALL ON app_private.finance_payment_allocations
 FROM PUBLIC,anon,authenticated,service_role,schoolos_file_login,schoolos_workflow_executor;
CREATE TRIGGER db08_retain BEFORE UPDATE OR DELETE OR TRUNCATE ON app_private.finance_payment_allocations
 FOR EACH STATEMENT EXECUTE FUNCTION app_private.db08_retain_financial_source();

-- This guard also covers maintenance inserts by the schema owner. Both sums
-- are checked under the same payment-then-obligation lock order as the command.
CREATE FUNCTION app_private.db08_allocation_guard()
RETURNS trigger LANGUAGE plpgsql SECURITY INVOKER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE payment app_private.finance_official_payments%ROWTYPE;
 charge app_private.finance_fee_obligations%ROWTYPE; selection app_private.finance_fee_assessment_selections%ROWTYPE;
 net numeric; used_payment numeric; used_charge numeric;
BEGIN
 SELECT * INTO payment FROM app_private.finance_official_payments WHERE id=NEW.payment_id FOR UPDATE;
 SELECT * INTO charge FROM app_private.finance_fee_obligations WHERE id=NEW.obligation_id FOR UPDATE;
 SELECT * INTO selection FROM app_private.finance_fee_assessment_selections
  WHERE obligation_id=NEW.obligation_id;
 SELECT coalesce(a.net_minor,charge.gross_amount_minor) INTO net
  FROM app_private.finance_fee_obligations o
  LEFT JOIN app_private.finance_discount_adjustments a ON a.obligation_id=o.id
  WHERE o.id=NEW.obligation_id;
 IF payment.id IS NULL OR charge.id IS NULL OR selection.obligation_id IS NULL
  OR payment.school_id<>NEW.school_id OR payment.campus_id<>NEW.campus_id
  OR payment.student_id<>NEW.student_id OR charge.school_id<>NEW.school_id
  OR charge.campus_id<>NEW.campus_id OR selection.student_id<>NEW.student_id
  OR NOT EXISTS(SELECT 1 FROM app_private.finance_fee_rules r
     WHERE r.id=charge.rule_id AND r.currency_unit_id=payment.currency_unit_id)
  OR net IS NULL OR net<=0 OR NEW.amount_minor<=0 THEN
  RAISE EXCEPTION 'DB08 allocation source mismatch'; END IF;
 SELECT coalesce(sum(amount_minor),0) INTO used_payment FROM app_private.finance_payment_allocations
  WHERE payment_id=NEW.payment_id;
 SELECT coalesce(sum(amount_minor),0) INTO used_charge FROM app_private.finance_payment_allocations
  WHERE obligation_id=NEW.obligation_id;
 IF used_payment+NEW.amount_minor>payment.amount_minor OR used_charge+NEW.amount_minor>net THEN
  RAISE EXCEPTION 'DB08 allocation exceeds payment or net charge'; END IF;
 RETURN NEW;
END $body$;
REVOKE ALL ON FUNCTION app_private.db08_allocation_guard()
 FROM PUBLIC,anon,authenticated,service_role,schoolos_file_login;
CREATE TRIGGER db08_allocation_source BEFORE INSERT ON app_private.finance_payment_allocations
 FOR EACH ROW EXECUTE FUNCTION app_private.db08_allocation_guard();

CREATE FUNCTION app_private.db08_discount_allocation_guard()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE allocated numeric;
BEGIN
 PERFORM 1 FROM app_private.finance_fee_obligations WHERE id=NEW.obligation_id FOR UPDATE;
 SELECT coalesce(sum(amount_minor),0) INTO allocated FROM app_private.finance_payment_allocations
  WHERE obligation_id=NEW.obligation_id;
 IF allocated>NEW.net_minor THEN
  RAISE EXCEPTION 'DB08 discount would exceed allocated payment'; END IF;
 RETURN NEW;
END $body$;
REVOKE ALL ON FUNCTION app_private.db08_discount_allocation_guard()
 FROM PUBLIC,anon,authenticated,service_role,schoolos_file_login;
CREATE TRIGGER db08_discount_allocated_guard BEFORE INSERT ON app_private.finance_discount_adjustments
 FOR EACH ROW EXECUTE FUNCTION app_private.db08_discount_allocation_guard();

CREATE FUNCTION app_private.db08_allocate_bank_payment(p_school uuid,p_payment uuid,
 p_obligation uuid,p_amount_minor numeric,p_key text)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER
 SET search_path=pg_catalog,pg_temp AS $body$
DECLARE actor uuid; operation uuid; permission uuid; checked_at timestamptz; claims jsonb;
 payment app_private.finance_official_payments%ROWTYPE;
 charge app_private.finance_fee_obligations%ROWTYPE;
 allocation app_private.finance_payment_allocations%ROWTYPE;
 prior app_private.command_receipts%ROWTYPE;
 net numeric; used_payment numeric; used_charge numeric;
 payload_hash bytea; result jsonb; receipt_id uuid; correlation uuid;
BEGIN
 IF session_user<>'schoolos_file_login' OR current_setting('transaction_isolation')<>'read committed'
  OR p_school IS NULL OR p_payment IS NULL OR p_obligation IS NULL
  OR p_amount_minor IS NULL OR p_amount_minor<=0 OR p_amount_minor<>trunc(p_amount_minor)
  OR p_amount_minor>=1000000000000000000000000
  OR p_key IS NULL OR length(p_key) NOT BETWEEN 1 AND 180 THEN
  RAISE EXCEPTION 'DB08 allocation input denied'; END IF;
 PERFORM pg_advisory_xact_lock_shared(71001,1);
 SELECT * INTO payment FROM app_private.finance_official_payments WHERE id=p_payment;
 SELECT * INTO charge FROM app_private.finance_fee_obligations WHERE id=p_obligation;
 actor:=app_private.current_principal_id();
 claims:=NULLIF(current_setting('request.jwt.claims',true),'')::jsonb;
 IF payment.id IS NULL OR charge.id IS NULL OR payment.school_id<>p_school
  OR charge.school_id<>p_school OR payment.campus_id<>charge.campus_id
  OR actor IS NULL OR NOT EXISTS(SELECT 1 FROM app_private.principals
    WHERE id=actor AND kind='INDIVIDUAL' AND state='ACTIVE')
  OR claims->>'exp' IS NULL OR claims->>'exp' !~ '^[0-9]{1,12}$'
  OR to_timestamp((claims->>'exp')::bigint)<=clock_timestamp()
  OR NOT EXISTS(SELECT 1 FROM app_private.school_profiles
    WHERE id=p_school AND state='ACTIVE')
  OR NOT EXISTS(SELECT 1 FROM app.campuses
    WHERE id=payment.campus_id AND school_id=p_school AND state='ACTIVE') THEN
  RAISE EXCEPTION 'DB08 allocation context denied'; END IF;
 SELECT o.id,o.request_permission_id INTO operation,permission
 FROM app_private.operation_contracts o JOIN app_private.permissions p
  ON p.id=o.request_permission_id
 WHERE o.code='finance.payment.allocate' AND o.contract_version=1
  AND o.handler_key=o.code AND o.payload_schema_version=1 AND o.enabled
  AND NOT o.requires_approval AND p.code=o.code AND p.state='ENABLED' AND NOT p.family_safe;
 checked_at:=clock_timestamp();
 IF operation IS NULL OR NOT EXISTS(
  SELECT 1 FROM app_private.assignment_permission_scopes s
  JOIN app_private.principal_role_assignments a ON a.id=s.assignment_id
  JOIN app_private.role_permission_grants g ON g.id=s.grant_id
  JOIN app_private.permission_scope_contracts c ON c.id=s.scope_contract_id
  JOIN app_private.roles r ON r.id=s.role_id
  WHERE a.principal_id=actor AND a.principal_kind='INDIVIDUAL'
   AND a.context_kind='INDIVIDUAL' AND a.role_id=s.role_id
   AND g.role_id=s.role_id AND g.permission_id=s.permission_id
   AND c.permission_id=s.permission_id AND c.scope_kind=s.scope_kind
   AND c.resolver_key=s.resolver_key AND c.enabled AND s.permission_id=permission
   AND s.scope_kind='CAMPUS' AND s.resolver_key='DIRECT' AND s.campus_id=payment.campus_id
   AND r.state='ACTIVE' AND NOT r.family_only
   AND a.valid_from<=checked_at AND (a.valid_until IS NULL OR checked_at<a.valid_until)
   AND (a.revoked_at IS NULL OR checked_at<a.revoked_at)
   AND g.valid_from<=checked_at AND (g.valid_until IS NULL OR checked_at<g.valid_until)
   AND (g.revoked_at IS NULL OR checked_at<g.revoked_at)
   AND s.valid_from<=checked_at AND (s.valid_until IS NULL OR checked_at<s.valid_until)
   AND (s.revoked_at IS NULL OR checked_at<s.revoked_at)) THEN
  RAISE EXCEPTION 'DB08 allocation authority denied'; END IF;
 PERFORM pg_advisory_xact_lock(71003,hashtext(p_school::text));
 SELECT * INTO payment FROM app_private.finance_official_payments WHERE id=p_payment FOR UPDATE;
 SELECT * INTO charge FROM app_private.finance_fee_obligations WHERE id=p_obligation FOR UPDATE;
 IF payment.id IS NULL OR charge.id IS NULL OR payment.school_id<>p_school
  OR payment.campus_id<>charge.campus_id OR charge.school_id<>p_school
  OR payment.student_id IS DISTINCT FROM
    (SELECT student_id FROM app_private.finance_fee_assessment_selections WHERE obligation_id=p_obligation)
  OR NOT EXISTS(SELECT 1 FROM app_private.finance_fee_rules r
    WHERE r.id=charge.rule_id AND r.currency_unit_id=payment.currency_unit_id) THEN
  RAISE EXCEPTION 'DB08 allocation Student or currency mismatch'; END IF;
 payload_hash:=sha256(convert_to(jsonb_build_array('bank-allocation-v1',p_school,
  p_payment,p_obligation,p_amount_minor::text)::text,'UTF8'));
 SELECT * INTO prior FROM app_private.command_receipts WHERE principal_id=actor
  AND operation_id=operation AND idempotency_key='bank-allocation:'||p_key;
 IF prior.id IS NOT NULL THEN
  SELECT * INTO allocation FROM app_private.finance_payment_allocations WHERE id=prior.result_ref;
  IF prior.state<>'SUCCEEDED' OR prior.command_kind<>'finance.payment.allocate'
   OR prior.result_kind<>'FINANCE_PAYMENT_ALLOCATION'
   OR prior.canonical_payload_hash<>payload_hash OR allocation.id IS NULL
   OR allocation.payment_id<>p_payment OR allocation.obligation_id<>p_obligation
   OR allocation.amount_minor<>p_amount_minor OR allocation.created_by<>actor
   OR (SELECT count(*) FROM app_private.audit_events WHERE command_receipt_id=prior.id)<>1
   OR (SELECT count(*) FROM app_private.outbox_events WHERE command_receipt_id=prior.id)<>1 THEN
   RAISE EXCEPTION 'DB08 allocation replay conflict'; END IF;
  RETURN prior.result_summary;
 END IF;
 SELECT coalesce(a.net_minor,charge.gross_amount_minor) INTO net
  FROM app_private.finance_fee_obligations o
  LEFT JOIN app_private.finance_discount_adjustments a ON a.obligation_id=o.id
  WHERE o.id=p_obligation;
 SELECT coalesce(sum(amount_minor),0) INTO used_payment FROM app_private.finance_payment_allocations
  WHERE payment_id=p_payment;
 SELECT coalesce(sum(amount_minor),0) INTO used_charge FROM app_private.finance_payment_allocations
  WHERE obligation_id=p_obligation;
 IF net IS NULL OR net<=0 OR used_payment+p_amount_minor>payment.amount_minor
  OR used_charge+p_amount_minor>net
  OR EXISTS(SELECT 1 FROM app_private.finance_payment_allocations
    WHERE payment_id=p_payment AND obligation_id=p_obligation) THEN
  RAISE EXCEPTION 'DB08 allocation exceeds available amount or already exists'; END IF;
 INSERT INTO app_private.finance_payment_allocations(school_id,campus_id,student_id,
  payment_id,obligation_id,amount_minor,created_by)
 VALUES(p_school,payment.campus_id,payment.student_id,p_payment,p_obligation,
  p_amount_minor,actor) RETURNING * INTO allocation;
 result:=jsonb_build_object('allocation_id',allocation.id,'payment_id',p_payment,
  'obligation_id',p_obligation,'amount_minor',p_amount_minor,
  'payment_unallocated_minor',payment.amount_minor-used_payment-p_amount_minor,
  'obligation_remaining_minor',net-used_charge-p_amount_minor,'state','ALLOCATED');
 receipt_id:=gen_random_uuid(); correlation:=gen_random_uuid();
 INSERT INTO app_private.command_receipts(id,principal_id,operation_id,command_kind,
  idempotency_key,canonical_payload_hash,canonicalization_version,state,result_kind,result_ref,
  result_summary,completed_at,created_by)
 VALUES(receipt_id,actor,operation,'finance.payment.allocate','bank-allocation:'||p_key,
  payload_hash,1,'SUCCEEDED','FINANCE_PAYMENT_ALLOCATION',allocation.id,result,clock_timestamp(),actor);
 INSERT INTO app_private.audit_events(actor_id,actor_kind,outcome,authority_evidence,
  target_version,event_type,target_kind,target_ref,campus_id,command_receipt_id,
  source_kind,correlation_id,occurred_at,details,created_by)
 VALUES(actor,'INDIVIDUAL','SUCCEEDED',jsonb_build_object('operation','finance.payment.allocate'),
  1,'finance.payment.allocate','FINANCE_PAYMENT_ALLOCATION',allocation.id,payment.campus_id,
  receipt_id,'WORKER',correlation,clock_timestamp(),result,actor);
 INSERT INTO app_private.outbox_events(event_type,aggregate_kind,aggregate_ref,
  aggregate_version,command_receipt_id,event_ordinal,correlation_id,occurred_at,payload,created_by)
 VALUES('finance.payment.allocate','FINANCE_PAYMENT_ALLOCATION',allocation.id,1,
  receipt_id,1,correlation,clock_timestamp(),result,actor);
 RETURN result;
END $body$;
REVOKE ALL ON FUNCTION app_private.db08_allocate_bank_payment(uuid,uuid,uuid,numeric,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.db08_allocate_bank_payment(uuid,uuid,uuid,numeric,text)
 TO schoolos_file_login;
RESET ROLE;
