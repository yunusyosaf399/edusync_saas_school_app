SET ROLE schoolos_schema_owner;
CREATE POLICY db08_fee_receipts ON app_private.command_receipts FOR ALL TO schoolos_evidence_writer
 USING(command_kind IN('finance.fee.configure','finance.charge.assess'))
 WITH CHECK(command_kind IN('finance.fee.configure','finance.charge.assess'));
CREATE POLICY db08_fee_audit ON app_private.audit_events FOR ALL TO schoolos_evidence_writer
 USING((event_type='finance.fee.configure' AND target_kind='FINANCE_FEE_RULE')
    OR (event_type='finance.charge.assess' AND target_kind='FINANCE_OBLIGATION'))
 WITH CHECK((event_type='finance.fee.configure' AND target_kind='FINANCE_FEE_RULE')
    OR (event_type='finance.charge.assess' AND target_kind='FINANCE_OBLIGATION'));
CREATE POLICY db08_fee_outbox ON app_private.outbox_events FOR ALL TO schoolos_evidence_writer
 USING((event_type='finance.fee.configure' AND aggregate_kind='FINANCE_FEE_RULE')
    OR (event_type='finance.charge.assess' AND aggregate_kind='FINANCE_OBLIGATION'))
 WITH CHECK((event_type='finance.fee.configure' AND aggregate_kind='FINANCE_FEE_RULE')
    OR (event_type='finance.charge.assess' AND aggregate_kind='FINANCE_OBLIGATION'));
GRANT SELECT,INSERT ON app_private.command_receipts,app_private.audit_events,app_private.outbox_events
 TO schoolos_evidence_writer;
RESET ROLE;

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
GRANT USAGE ON SCHEMA auth TO schoolos_authz_reader;
GRANT EXECUTE ON FUNCTION auth.jwt() TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE FUNCTION app_private.db08_fee_actor(p_code text,p_campus uuid)
RETURNS TABLE(actor_id uuid,operation_id uuid)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE actor uuid; operation uuid; permission uuid; checked_at timestamptz;
 claims jsonb; exp_text text;
BEGIN
 IF p_code IS NULL OR p_code NOT IN('finance.fee.configure','finance.charge.assess') OR p_campus IS NULL
   OR pg_catalog.current_setting('transaction_isolation')<>'read committed' THEN
   RAISE EXCEPTION 'DB08 Finance operation unavailable'; END IF;
 claims:=auth.jwt(); exp_text:=claims->>'exp';
 IF exp_text IS NULL OR exp_text !~ '^[0-9]{1,12}$' OR
    pg_catalog.to_timestamp(exp_text::bigint)<=pg_catalog.clock_timestamp() THEN
    RAISE EXCEPTION 'DB08 Finance authentication expired'; END IF;
 actor:=app_private.current_principal_id();
 IF actor IS NULL OR NOT EXISTS(SELECT 1 FROM app_private.principals p
    WHERE p.id=actor AND p.kind='INDIVIDUAL' AND p.state='ACTIVE') THEN
    RAISE EXCEPTION 'DB08 active individual staff required'; END IF;
 SELECT o.id,o.request_permission_id INTO operation,permission
 FROM app_private.operation_contracts o JOIN app_private.permissions p ON p.id=o.request_permission_id
 WHERE o.code=p_code AND o.contract_version=1 AND o.handler_key=p_code
  AND o.payload_schema_version=1 AND o.enabled AND NOT o.requires_approval
  AND p.code=p_code AND p.state='ENABLED' AND NOT p.family_safe;
 IF operation IS NULL THEN RAISE EXCEPTION 'DB08 Finance operation disabled'; END IF;
 checked_at:=pg_catalog.clock_timestamp();
 IF NOT EXISTS(
  SELECT 1 FROM app_private.assignment_permission_scopes s
  JOIN app_private.principal_role_assignments a ON a.id=s.assignment_id
  JOIN app_private.role_permission_grants g ON g.id=s.grant_id
  JOIN app_private.permission_scope_contracts c ON c.id=s.scope_contract_id
  JOIN app_private.roles r ON r.id=s.role_id
  WHERE a.principal_id=actor AND a.principal_kind='INDIVIDUAL'
   AND a.context_kind='INDIVIDUAL' AND a.role_id=s.role_id
   AND g.role_id=s.role_id AND g.permission_id=s.permission_id
   AND c.permission_id=s.permission_id AND c.scope_kind=s.scope_kind
   AND c.resolver_key=s.resolver_key AND c.enabled
   AND s.permission_id=permission AND r.state='ACTIVE' AND NOT r.family_only
   AND s.resolver_key='DIRECT'
   AND s.scope_kind='ALL' AND s.campus_id IS NULL
   AND a.valid_from<=checked_at AND (a.valid_until IS NULL OR checked_at<a.valid_until)
   AND (a.revoked_at IS NULL OR checked_at<a.revoked_at)
   AND g.valid_from<=checked_at AND (g.valid_until IS NULL OR checked_at<g.valid_until)
   AND (g.revoked_at IS NULL OR checked_at<g.revoked_at)
   AND s.valid_from<=checked_at AND (s.valid_until IS NULL OR checked_at<s.valid_until)
   AND (s.revoked_at IS NULL OR checked_at<s.revoked_at)) THEN
  RAISE EXCEPTION 'DB08 Finance School/Campus authority denied'; END IF;
 RETURN QUERY SELECT actor,operation;
END $body$;
REVOKE ALL ON FUNCTION app_private.db08_fee_actor(text,uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.db08_fee_actor(text,uuid) TO schoolos_workflow_executor,schoolos_evidence_writer;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;

GRANT CREATE ON SCHEMA app_private TO schoolos_evidence_writer;
SET ROLE schoolos_evidence_writer;
CREATE FUNCTION app_private.db08_fee_receipt(p_code text,p_campus uuid,p_key text,p_hash bytea,
 p_receipt uuid DEFAULT NULL,p_source uuid DEFAULT NULL)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; r app_private.command_receipts%ROWTYPE; pub app_private.finance_fee_publications%ROWTYPE;
 fee app_private.finance_fee_rules%ROWTYPE; ob app_private.finance_fee_obligations%ROWTYPE;
 result_body jsonb; ref uuid; kind text; correlation uuid; moment timestamptz;
BEGIN
 IF p_code IS NULL OR p_code NOT IN('finance.fee.configure','finance.charge.assess') OR p_key IS NULL
  OR length(p_key) NOT BETWEEN 1 AND 200 OR p_hash IS NULL OR octet_length(p_hash)<>32 THEN
  RAISE EXCEPTION 'DB08 receipt intent invalid'; END IF;
 SELECT * INTO ctx FROM app_private.db08_fee_actor(p_code,p_campus);
 SELECT * INTO r FROM app_private.command_receipts
 WHERE principal_id=ctx.actor_id AND operation_id=ctx.operation_id AND idempotency_key=p_key;
 IF FOUND THEN
  IF r.canonical_payload_hash IS DISTINCT FROM p_hash OR r.canonicalization_version<>1
    OR r.request_id IS NOT NULL OR r.expected_target_version IS NOT NULL THEN
    RAISE EXCEPTION 'DB08 Finance idempotency conflict'; END IF;
  p_source:=(r.result_summary->>'source_id')::uuid;
 ELSIF p_receipt IS NULL THEN RETURN NULL;
 END IF;
 IF p_code='finance.fee.configure' THEN
  SELECT * INTO pub FROM app_private.finance_fee_publications WHERE id=p_source;
  SELECT * INTO fee FROM app_private.finance_fee_rules WHERE id=pub.rule_id;
  IF pub.id IS NULL OR fee.id IS NULL OR fee.school_id<>pub.school_id OR fee.campus_id<>p_campus
    OR pub.created_by<>ctx.actor_id OR fee.created_by<>ctx.actor_id
    OR pub.revision<>1 OR pub.state<>'PUBLISHED' OR NOT EXISTS(
     SELECT 1 FROM app_private.finance_fee_rule_revisions v WHERE v.id=pub.revision_id
       AND v.rule_id=fee.id AND v.revision=1 AND v.created_by=ctx.actor_id) THEN
    RAISE EXCEPTION 'DB08 published fee source proof invalid'; END IF;
  ref:=fee.id; kind:='FINANCE_FEE_RULE'; moment:=pub.created_at;
 ELSE
  SELECT * INTO ob FROM app_private.finance_fee_obligations WHERE id=p_source;
  IF ob.id IS NULL OR ob.campus_id<>p_campus OR ob.created_by<>ctx.actor_id
    OR NOT EXISTS(SELECT 1 FROM app_private.finance_fee_publications x
       WHERE x.rule_id=ob.rule_id AND x.revision_id=ob.rule_revision_id
         AND x.school_id=ob.school_id AND x.state='PUBLISHED') THEN
    RAISE EXCEPTION 'DB08 assessed charge source proof invalid'; END IF;
  ref:=ob.id; kind:='FINANCE_OBLIGATION'; moment:=ob.created_at;
 END IF;
 result_body:=jsonb_build_object('source_id',p_source,'resource_id',ref,'campus_id',p_campus);
 IF r.id IS NULL THEN
  IF p_receipt IS NULL OR (p_code='finance.fee.configure' AND pub.command_receipt_id<>p_receipt) THEN
    RAISE EXCEPTION 'DB08 Finance source receipt mismatch'; END IF;
  correlation:=gen_random_uuid();
  INSERT INTO app_private.command_receipts(id,principal_id,operation_id,command_kind,idempotency_key,
   canonical_payload_hash,canonicalization_version,state,result_kind,result_ref,result_summary,completed_at,created_by)
  VALUES(p_receipt,ctx.actor_id,ctx.operation_id,p_code,p_key,p_hash,1,'SUCCEEDED',kind,ref,result_body,
    clock_timestamp(),ctx.actor_id);
  INSERT INTO app_private.audit_events(actor_id,actor_kind,outcome,authority_evidence,target_version,
   event_type,target_kind,target_ref,campus_id,command_receipt_id,source_kind,correlation_id,
   occurred_at,details,created_by)
  VALUES(ctx.actor_id,'INDIVIDUAL','SUCCEEDED',jsonb_build_object('operation',p_code),1,
   p_code,kind,ref,p_campus,p_receipt,'API',correlation,moment,result_body,ctx.actor_id);
  INSERT INTO app_private.outbox_events(event_type,aggregate_kind,aggregate_ref,aggregate_version,
   command_receipt_id,event_ordinal,correlation_id,occurred_at,payload,created_by)
  VALUES(p_code,kind,ref,1,p_receipt,1,correlation,moment,result_body,ctx.actor_id);
  SELECT * INTO r FROM app_private.command_receipts WHERE id=p_receipt;
 END IF;
 IF r.command_kind<>p_code OR r.result_kind<>kind OR r.result_ref<>ref OR r.result_summary IS DISTINCT FROM result_body
  OR r.state<>'SUCCEEDED' OR r.request_id IS NOT NULL
  OR (p_code='finance.fee.configure' AND pub.command_receipt_id<>r.id)
  OR (SELECT count(*) FROM app_private.audit_events x WHERE x.command_receipt_id=r.id AND x.event_type=p_code
      AND x.actor_id=ctx.actor_id AND x.target_ref=ref AND x.target_kind=kind AND x.details=result_body)<>1
  OR (SELECT count(*) FROM app_private.outbox_events x WHERE x.command_receipt_id=r.id AND x.event_type=p_code
      AND x.aggregate_ref=ref AND x.aggregate_kind=kind AND x.payload=result_body)<>1 THEN
  RAISE EXCEPTION 'DB08 Finance immutable receipt invalid'; END IF;
 RETURN result_body;
END $body$;
REVOKE ALL ON FUNCTION app_private.db08_fee_receipt(text,uuid,text,bytea,uuid,uuid)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.db08_fee_receipt(text,uuid,text,bytea,uuid,uuid)
 TO schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_evidence_writer;
