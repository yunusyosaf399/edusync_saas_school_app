-- STUDENT_PROFILE_TYPED_DIRECT_ROLLBACK_ONLY
-- LOCAL-ONLY authenticated DIRECT integration trial; outer CI BEGIN/ROLLBACK.
SET ROLE schoolos_schema_owner;
CREATE POLICY sprev_typed_direct_trial ON app_private.student_profile_revisions
  FOR INSERT TO schoolos_student_executor
  WITH CHECK (
    approval_request_id IS NULL
    AND applied_by_principal_id=app_private.current_principal_id()
    AND old_row_version>0 AND new_row_version=old_row_version+1
  );
GRANT INSERT ON app_private.student_profile_revisions TO schoolos_student_executor;
GRANT CREATE ON SCHEMA app_private,app TO schoolos_student_executor;
RESET ROLE;
SET ROLE schoolos_student_executor;

-- JSON canonicalization independent of the old Student image, necessary for
-- safe idempotent replay after the Student has advanced to a later version.
CREATE FUNCTION app_private.d1_student_profile_direct_canonical_trial(p_actions jsonb)
RETURNS jsonb LANGUAGE plpgsql IMMUTABLE SECURITY INVOKER
SET search_path=pg_catalog,pg_temp AS $canonical$
DECLARE
  keys text[]:=ARRAY['date_of_birth','gender_code','nationality_code',
    'general_contact','previous_school','profile_photo_file_id'];
  f text; entry jsonb; action text; val text; n bigint;
  out_value jsonb:='[]'::jsonb;
BEGIN
  IF pg_catalog.jsonb_typeof(p_actions) IS DISTINCT FROM 'object'
     OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(p_actions))<>6
     OR NOT (p_actions ?& keys) THEN
    RAISE EXCEPTION 'D1_DIRECT_CANONICAL_ALLOWLIST';
  END IF;
  FOREACH f IN ARRAY keys LOOP
    entry:=p_actions->f;
    IF pg_catalog.jsonb_typeof(entry) IS DISTINCT FROM 'object'
       OR pg_catalog.jsonb_typeof(entry->'action') IS DISTINCT FROM 'string' THEN
      RAISE EXCEPTION 'D1_DIRECT_CANONICAL_SHAPE';
    END IF;
    action:=entry->>'action';
    SELECT count(*) INTO n FROM pg_catalog.jsonb_object_keys(entry);
    IF action IN ('UNCHANGED','CLEAR') THEN
      IF n<>1 OR entry ? 'value' THEN
        RAISE EXCEPTION 'D1_DIRECT_CANONICAL_VALUE_FORBIDDEN';
      END IF;
      out_value:=out_value||pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_array(action));
    ELSIF action='SET' THEN
      IF n<>2 OR NOT (entry ? 'value')
         OR pg_catalog.jsonb_typeof(entry->'value') IS DISTINCT FROM 'string' THEN
        RAISE EXCEPTION 'D1_DIRECT_CANONICAL_SET_VALUE';
      END IF;
      val:=pg_catalog.btrim(entry->>'value');
      IF val='' THEN RAISE EXCEPTION 'D1_DIRECT_CANONICAL_BLANK'; END IF;
      IF f='date_of_birth' THEN
        IF val !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' THEN
          RAISE EXCEPTION 'D1_DIRECT_CANONICAL_DATE';
        END IF;
        BEGIN
          val:=(val::date)::text;
        EXCEPTION WHEN invalid_datetime_format OR datetime_field_overflow
                       OR invalid_text_representation THEN
          RAISE EXCEPTION 'D1_DIRECT_CANONICAL_DATE_INVALID';
        END;
      ELSIF f='profile_photo_file_id' THEN
        IF val !~* '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' THEN
          RAISE EXCEPTION 'D1_DIRECT_CANONICAL_FILE_ID';
        END IF;
        val:=(val::uuid)::text;
      END IF;
      out_value:=out_value||pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_array('SET',val));
    ELSE
      RAISE EXCEPTION 'D1_DIRECT_CANONICAL_ACTION';
    END IF;
  END LOOP;
  RETURN out_value;
END
$canonical$;
REVOKE ALL ON FUNCTION app_private.d1_student_profile_direct_canonical_trial(jsonb)
  FROM PUBLIC,anon,authenticated,service_role;

CREATE FUNCTION app.d1_student_profile_typed_direct_trial(
  p_student_id uuid,p_campus_hint uuid,p_expected_version bigint,
  p_actions jsonb,p_reason text,p_idempotency_key text
) RETURNS TABLE(student_id uuid,row_version bigint)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $direct$
DECLARE
  receipt record;
  target_row app_private.students%ROWTYPE;
  campus_id uuid;
  placement_count bigint;
  policy_row record;
  canonical jsonb;
  reason_text text;
  preimage jsonb;
  projected jsonb;
  after_values jsonb;
  next_version bigint;
  saved_receipt uuid;
  corr uuid:=pg_catalog.gen_random_uuid();
BEGIN
  IF p_student_id IS NULL OR p_expected_version IS NULL
     OR p_expected_version<1 OR p_reason IS NULL
     OR pg_catalog.btrim(p_reason)='' THEN
    RAISE EXCEPTION 'D1_TYPED_DIRECT_BAD_INTENT';
  END IF;
  reason_text:=pg_catalog.btrim(p_reason);
  canonical:=app_private.d1_student_profile_direct_canonical_trial(p_actions);
  -- Existing frozen receipt lookup accepts exactly four intent slots.
  -- Nested arrays are JCS supported, unlike new unapproved object keys.
  SELECT * INTO receipt FROM app_private.d1_command_receipt_lookup(
    'student.profile.update','student.profile.update',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_student_id,p_campus_hint,
      p_expected_version::text,pg_catalog.jsonb_build_array(canonical,reason_text)));
  PERFORM app_private.d1_lock_current_principal(receipt.actor_id);
  SELECT count(*),min(co.campus_id::text)::uuid
  INTO placement_count,campus_id
    FROM app_private.enrollments e
    JOIN app_private.section_offerings so ON so.id=e.section_offering_id
    JOIN app_private.class_offerings co ON co.id=so.class_offering_id
    WHERE e.student_id=p_student_id AND e.placement_kind='PRIMARY'
      AND e.placement_state='ACTIVE'
      AND e.effective_from<=pg_catalog.statement_timestamp()::date
      AND (e.effective_until IS NULL OR
        pg_catalog.statement_timestamp()::date<e.effective_until)
      AND so.campus_id=co.campus_id;
  IF placement_count<>1 OR campus_id IS NULL OR
     (p_campus_hint IS NOT NULL AND p_campus_hint<>campus_id) THEN
    RAISE EXCEPTION 'D1_TYPED_DIRECT_BAD_CONTEXT';
  END IF;
  SELECT s.* INTO target_row FROM app_private.students s
    WHERE s.id=p_student_id FOR UPDATE;
  IF NOT FOUND OR target_row.current_status IS DISTINCT FROM 'ACTIVE' THEN
    RAISE EXCEPTION 'D1_TYPED_DIRECT_TARGET_DENIED';
  END IF;
  IF app_private.d1_profile_authorized(
    receipt.actor_id,'student.profile.update','STUDENT',
    p_student_id,campus_id,NULL) IS DISTINCT FROM true THEN
    RAISE EXCEPTION 'D1_TYPED_DIRECT_AUTH_DENIED';
  END IF;
  SELECT * INTO policy_row FROM app_private.d1_profile_policy(
    'student.profile.update',campus_id);
  IF policy_row.policy_id IS NULL
     OR policy_row.route_mode IS DISTINCT FROM 'DIRECT'
     OR app_private.d1_p1_route('student.profile.update',campus_id)
        IS DISTINCT FROM 'DIRECT' THEN
    RAISE EXCEPTION 'D1_TYPED_DIRECT_ROUTE_DENIED';
  END IF;
  IF receipt.receipt_id IS NOT NULL THEN
    IF receipt.receipt_state IS DISTINCT FROM 'SUCCEEDED'
       OR receipt.result_ref IS DISTINCT FROM p_student_id
       OR (receipt.result_summary->>'row_version')::bigint
           IS DISTINCT FROM p_expected_version+1
       OR receipt.result_summary->>'route' IS DISTINCT FROM 'DIRECT' THEN
      RAISE EXCEPTION 'D1_TYPED_DIRECT_RECEIPT_UNREPLAYABLE';
    END IF;
    RETURN QUERY SELECT p_student_id,
      (receipt.result_summary->>'row_version')::bigint;
    RETURN;
  END IF;
  IF target_row.row_version IS DISTINCT FROM p_expected_version THEN
    RAISE EXCEPTION 'D1_TYPED_DIRECT_STALE';
  END IF;
  IF app.d1_student_profile_typed_preflight_trial(
    p_student_id,p_campus_hint,p_expected_version,p_actions,reason_text,
    'DIRECT') IS DISTINCT FROM true THEN
    RAISE EXCEPTION 'D1_TYPED_DIRECT_PREFLIGHT_FAILED';
  END IF;
  preimage:=pg_catalog.jsonb_build_object(
    'date_of_birth',target_row.date_of_birth,
    'gender_code',target_row.gender_code,
    'nationality_code',target_row.nationality_code,
    'general_contact',target_row.general_contact,
    'previous_school',target_row.previous_school,
    'profile_photo_file_id',target_row.profile_photo_file_id);
  projected:=app_private.d1_student_profile_typed_plan_trial(preimage,p_actions);
  after_values:=projected->'after';
  IF after_values->>'profile_photo_file_id' IS DISTINCT FROM
       preimage->>'profile_photo_file_id'
     AND after_values->>'profile_photo_file_id' IS NOT NULL THEN
    RAISE EXCEPTION 'D1_TYPED_DIRECT_PHOTO_NOT_ENTITLED';
  END IF;
  UPDATE app_private.students s SET
    date_of_birth=(after_values->>'date_of_birth')::date,
    gender_code=after_values->>'gender_code',
    nationality_code=after_values->>'nationality_code',
    general_contact=after_values->>'general_contact',
    previous_school=after_values->>'previous_school',
    profile_photo_file_id=(after_values->>'profile_photo_file_id')::uuid
  WHERE s.id=p_student_id AND s.row_version=p_expected_version
    AND s.current_status='ACTIVE'
  RETURNING s.row_version INTO next_version;
  IF next_version IS DISTINCT FROM p_expected_version+1 THEN
    RAISE EXCEPTION 'D1_TYPED_DIRECT_VERSION_FAIL';
  END IF;
  saved_receipt:=app_private.d1_profile_receipt(
    'student.profile.update',receipt.actor_id,receipt.operation_id,
    p_idempotency_key,receipt.intent_hash,p_expected_version,NULL,NULL,
    'SUCCEEDED','D1_STUDENT_PROFILE',p_student_id,
    pg_catalog.jsonb_build_object('row_version',next_version,'route','DIRECT'),
    NULL);
  INSERT INTO app_private.student_profile_revisions (
    student_id,old_row_version,new_row_version,command_receipt_id,
    approval_request_id,applied_by_principal_id,private_reason,
    old_date_of_birth,new_date_of_birth,
    old_gender_code,new_gender_code,
    old_nationality_code,new_nationality_code,
    old_general_contact,new_general_contact,
    old_previous_school,new_previous_school,
    old_profile_photo_file_id,new_profile_photo_file_id
  ) VALUES (
    p_student_id,p_expected_version,next_version,saved_receipt,
    NULL,receipt.actor_id,reason_text,
    target_row.date_of_birth,(after_values->>'date_of_birth')::date,
    target_row.gender_code,after_values->>'gender_code',
    target_row.nationality_code,after_values->>'nationality_code',
    target_row.general_contact,after_values->>'general_contact',
    target_row.previous_school,after_values->>'previous_school',
    target_row.profile_photo_file_id,
    (after_values->>'profile_photo_file_id')::uuid);
  PERFORM app_private.d1_profile_audit(
    receipt.actor_id,'student.profile.update','DIRECT','STUDENT',
    p_student_id,campus_id,saved_receipt,NULL,next_version,'EXECUTED',corr);
  PERFORM app_private.d1_profile_student_event(
    receipt.actor_id,p_student_id,next_version,saved_receipt,corr);
  RETURN QUERY SELECT p_student_id,next_version;
END
$direct$;
REVOKE ALL ON FUNCTION app.d1_student_profile_typed_direct_trial(
  uuid,uuid,bigint,jsonb,text,text)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_student_profile_typed_direct_trial(
  uuid,uuid,bigint,jsonb,text,text) TO authenticated;
RESET ROLE;
SET ROLE schoolos_schema_owner;
REVOKE CREATE ON SCHEMA app_private,app FROM schoolos_student_executor;
RESET ROLE;
