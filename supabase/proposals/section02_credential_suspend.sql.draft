-- DB-014 inactive candidate. Install only after Foundation, in a disposable project.
-- No permission, operation, account, Auth credential, or policy is seeded.
GRANT SELECT(id,kind,person_id,state,row_version) ON app_private.principals TO schoolos_identity_executor;
GRANT SELECT(id,state) ON app_private.people TO schoolos_identity_executor;
GRANT SELECT(id,state) ON app_private.school_profiles TO schoolos_identity_executor;
GRANT SELECT(principal_id,auth_user_id) ON app_private.principal_auth_bindings TO schoolos_identity_executor;
GRANT SELECT(id,code,contract_version,handler_key,request_permission_id,requires_approval,enabled)
  ON app_private.operation_contracts TO schoolos_identity_executor;
GRANT SELECT(id,code,state,family_safe) ON app_private.permissions TO schoolos_identity_executor;
GRANT SELECT(id,principal_id,operation_id,idempotency_key,command_kind,canonical_payload_hash,
  expected_target_version,state,result_kind,result_ref,result_summary)
  ON app_private.command_receipts TO schoolos_identity_executor;
GRANT INSERT ON app_private.command_receipts,app_private.audit_events,app_private.outbox_events
  TO schoolos_identity_executor;
GRANT UPDATE(state) ON app_private.principals TO schoolos_identity_executor;
GRANT EXECUTE ON FUNCTION app_private.current_principal_id(),
  app_private.has_complete_grant(text,text,uuid) TO schoolos_identity_executor;
SET ROLE schoolos_schema_owner;
CREATE POLICY s02_suspend_principal ON app_private.principals FOR SELECT TO schoolos_identity_executor USING(true);
CREATE POLICY s02_suspend_principal_write ON app_private.principals FOR UPDATE TO schoolos_identity_executor USING(true) WITH CHECK(true);
CREATE POLICY s02_suspend_person ON app_private.people FOR SELECT TO schoolos_identity_executor USING(true);
CREATE POLICY s02_suspend_school ON app_private.school_profiles FOR SELECT TO schoolos_identity_executor USING(true);
CREATE POLICY s02_suspend_binding ON app_private.principal_auth_bindings FOR SELECT TO schoolos_identity_executor USING(true);
CREATE POLICY s02_suspend_operation ON app_private.operation_contracts FOR SELECT TO schoolos_identity_executor USING(true);
CREATE POLICY s02_suspend_permission ON app_private.permissions FOR SELECT TO schoolos_identity_executor USING(true);
CREATE POLICY s02_suspend_receipt ON app_private.command_receipts FOR SELECT TO schoolos_identity_executor USING(true);
CREATE POLICY s02_suspend_receipt_append ON app_private.command_receipts FOR INSERT TO schoolos_identity_executor WITH CHECK(true);
CREATE POLICY s02_suspend_audit_append ON app_private.audit_events FOR INSERT TO schoolos_identity_executor WITH CHECK(true);
CREATE POLICY s02_suspend_outbox_append ON app_private.outbox_events FOR INSERT TO schoolos_identity_executor WITH CHECK(true);
GRANT CREATE ON SCHEMA app TO schoolos_identity_executor;
RESET ROLE;
ALTER DEFAULT PRIVILEGES FOR ROLE schoolos_identity_executor REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;
SET ROLE schoolos_identity_executor;
CREATE FUNCTION app.section02_suspend_credential(
  p_target uuid,p_expected_version bigint,p_reason text,p_idempotency_key text
) RETURNS uuid LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $body$
DECLARE actor uuid; target_row record; actor_row record; op record; receipt record;
  payload_hash bytea; receipt_id uuid:=pg_catalog.gen_random_uuid();
  correlation uuid:=pg_catalog.gen_random_uuid(); old_subject uuid;
BEGIN
  IF pg_catalog.current_setting('transaction_isolation')<>'read committed'
    OR p_target IS NULL OR p_expected_version IS NULL OR p_expected_version<1
    OR p_reason IS NULL OR pg_catalog.length(pg_catalog.btrim(p_reason)) NOT BETWEEN 5 AND 500
    OR p_idempotency_key IS NULL OR pg_catalog.length(p_idempotency_key) NOT BETWEEN 1 AND 200
  THEN RAISE EXCEPTION 'credential suspension denied'; END IF;
  -- Exclusive before every authority read. No snapshot from before a revoke.
  PERFORM pg_catalog.pg_advisory_xact_lock(71001,1);
  actor:=app_private.current_principal_id();
  IF actor IS NULL OR actor=p_target THEN RAISE EXCEPTION 'credential suspension denied'; END IF;
  PERFORM pg_catalog.pg_advisory_xact_lock(71002,
    pg_catalog.hashtext(actor::text||':'||p_idempotency_key));
  -- Stable UUID order for actor/target row locks.
  PERFORM 1 FROM app_private.principals p WHERE p.id IN (actor,p_target) ORDER BY p.id FOR UPDATE;
  SELECT p.kind,p.person_id,p.state INTO actor_row FROM app_private.principals p WHERE p.id=actor;
  SELECT p.kind,p.state,p.row_version INTO target_row FROM app_private.principals p WHERE p.id=p_target;
  IF actor_row.kind<>'INDIVIDUAL' OR actor_row.state<>'ACTIVE'
     OR NOT EXISTS(SELECT 1 FROM app_private.people person
                   WHERE person.id=actor_row.person_id AND person.state='ACTIVE')
     OR target_row.kind NOT IN ('INDIVIDUAL','FAMILY')
     OR NOT EXISTS(SELECT 1 FROM app_private.school_profiles s WHERE s.state='ACTIVE')
  THEN RAISE EXCEPTION 'credential suspension denied'; END IF;
  SELECT o.id INTO op FROM app_private.operation_contracts o
    JOIN app_private.permissions p ON p.id=o.request_permission_id
   WHERE o.code='identity.credential.suspend' AND o.contract_version=1
     AND o.handler_key='SECTION02_SUSPEND_V1' AND o.enabled AND NOT o.requires_approval
     AND p.code='identity.credential.suspend' AND p.state='ENABLED' AND NOT p.family_safe;
  IF op.id IS NULL OR app_private.has_complete_grant('identity.credential.suspend','ALL',NULL) IS DISTINCT FROM true
  THEN RAISE EXCEPTION 'credential suspension denied'; END IF;
  payload_hash:=pg_catalog.sha256(pg_catalog.convert_to(
    pg_catalog.jsonb_build_array(p_target,p_expected_version,p_reason)::text,'UTF8'));
  SELECT r.* INTO receipt FROM app_private.command_receipts r
   WHERE r.principal_id=actor AND r.operation_id=op.id AND r.idempotency_key=p_idempotency_key;
  IF FOUND THEN
    IF receipt.command_kind<>'credential.suspend' OR receipt.canonical_payload_hash<>payload_hash
       OR receipt.expected_target_version<>p_expected_version OR receipt.state<>'SUCCEEDED'
       OR receipt.result_kind<>'PRINCIPAL' OR receipt.result_ref<>p_target
    THEN RAISE EXCEPTION 'credential suspension denied'; END IF;
    RETURN receipt.id;
  END IF;
  IF target_row.state<>'ACTIVE' OR target_row.row_version<>p_expected_version
  THEN RAISE EXCEPTION 'credential suspension denied'; END IF;
  SELECT b.auth_user_id INTO old_subject FROM app_private.principal_auth_bindings b
    WHERE b.principal_id=p_target;
  UPDATE app_private.principals p SET state='SUSPENDED' WHERE p.id=p_target;
  INSERT INTO app_private.command_receipts(id,principal_id,operation_id,command_kind,
    idempotency_key,canonical_payload_hash,expected_target_version,state,result_kind,
    result_ref,result_summary,completed_at,created_by)
  VALUES(receipt_id,actor,op.id,'credential.suspend',p_idempotency_key,payload_hash,
    p_expected_version,'SUCCEEDED','PRINCIPAL',p_target,
    pg_catalog.jsonb_build_object('state','SUSPENDED','version',target_row.row_version+1),
    pg_catalog.clock_timestamp(),actor);
  INSERT INTO app_private.audit_events(actor_id,actor_kind,auth_subject_snapshot,outcome,reason,
    authority_evidence,target_version,event_type,target_kind,target_ref,command_receipt_id,
    source_kind,correlation_id,details,created_by)
  VALUES(actor,'INDIVIDUAL',auth.uid(),'SUCCEEDED',p_reason,
    pg_catalog.jsonb_build_object('operation','identity.credential.suspend','scope','ALL'),
    target_row.row_version+1,'identity.credential_suspended','principal',p_target,
    receipt_id,'API',correlation,
    pg_catalog.jsonb_build_object('previous_state','ACTIVE','new_state','SUSPENDED'),actor);
  INSERT INTO app_private.outbox_events(event_type,aggregate_kind,aggregate_ref,
    aggregate_version,command_receipt_id,event_ordinal,correlation_id,payload,created_by)
  VALUES('identity.credential_suspended','principal',p_target,target_row.row_version+1,
    receipt_id,1,correlation,pg_catalog.jsonb_build_object('principal_id',p_target),actor);
  RETURN receipt_id;
END $body$;
REVOKE ALL ON FUNCTION app.section02_suspend_credential(uuid,bigint,text,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.section02_suspend_credential(uuid,bigint,text,text) TO authenticated;
RESET ROLE;
SET ROLE schoolos_schema_owner;
REVOKE CREATE ON SCHEMA app FROM schoolos_identity_executor;
RESET ROLE;
