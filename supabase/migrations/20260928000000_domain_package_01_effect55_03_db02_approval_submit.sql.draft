-- DB-02 I08: authenticated School-wide Roll Policy APPROVAL SUBMIT.
-- Draft-only, disabled by default. REVIEW/APPLY remain separate workstreams.
-- No Roll Policy/allocator/outbox mutation is permitted here.
GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE FUNCTION app.d1_submit_student_roll_policy_change(
 p_school_id uuid,p_action text,p_source_policy_id uuid,
 p_expected_source_revision integer,p_expected_source_mode text,
 p_expected_source_start_value bigint,p_expected_source_effective_from date,
 p_new_mode text,p_new_start_value bigint,p_reason text,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $body$
DECLARE
  ctx record;
  t record;
  new_request uuid:=pg_catalog.gen_random_uuid();
  first_step uuid;
  template_count integer:=0;
  candidate_count integer;
  final_version bigint;
  receipt_id uuid;
  source_snapshot jsonb;
  proposed_core jsonb;
  proposed jsonb;
BEGIN
 -- The Student-owned SUBMIT context enforces the same Foundation SHARED
 -- lock, exact global P1 UUID/APPROVAL route, verified Principal, ALL grant,
 -- idempotency lock and School/source/allocator preflight as DIRECT.
 SELECT * INTO ctx FROM app_private.d1_roll_policy_submit_context(
   p_school_id,p_idempotency_key,p_action,p_source_policy_id,
   p_expected_source_revision,p_expected_source_mode,
   p_expected_source_start_value,p_expected_source_effective_from,
   p_new_mode,p_new_start_value,p_reason);
 IF NOT FOUND OR ctx.actor_id IS NULL OR ctx.operation_id IS NULL
   OR ctx.policy_version_id IS NULL OR ctx.intent_hash IS NULL THEN
   RAISE EXCEPTION 'D1 Roll Policy SUBMIT validated context missing';
 END IF;
 source_snapshot:=pg_catalog.jsonb_build_object(
   'source_policy_id',p_source_policy_id,
   'source_revision',p_expected_source_revision,
   'source_mode',p_expected_source_mode,
   'source_start_value',p_expected_source_start_value,
   'source_effective_from',p_expected_source_effective_from);
 proposed_core:=pg_catalog.jsonb_build_object(
   'action',p_action,'mode',p_new_mode,'start_value',p_new_start_value,
   'selected_p1_version_id',ctx.policy_version_id);

 -- Replay verifies the ORIGINAL Foundation request/receipt/transition/audit
 -- and frozen selected P1; no current-head/source preflight on old effects.
 IF ctx.receipt_id IS NOT NULL THEN
   IF ctx.receipt_state IS DISTINCT FROM 'SUCCEEDED'
     OR ctx.result_ref IS NULL OR
     app_private.d1_roll_policy_submit_rows_match(
       ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
       p_school_id,ctx.result_ref,ctx.policy_version_id,
       p_expected_source_revision,source_snapshot,proposed_core,p_reason)
       IS DISTINCT FROM true THEN
     RAISE EXCEPTION 'D1 Roll Policy SUBMIT historical request proof failed';
   END IF;
   RETURN QUERY SELECT ctx.result_ref,(ctx.result_summary->>'request_version')::bigint;
   RETURN;
 END IF;
 IF ctx.business_date IS NULL THEN
   RAISE EXCEPTION 'D1 Roll Policy SUBMIT trusted School date absent';
 END IF;
 proposed:=proposed_core||pg_catalog.jsonb_build_object(
   'trusted_business_date',ctx.business_date);

 -- All immutable policy/source/new intent data are retained privately on
 -- the Foundation request. Only reason column stores raw private reason.
 INSERT INTO app_private.approval_requests(
   id,operation_id,payload_schema_version,policy_id,requester_id,campus_id,
   target_ref,expected_target_version,reason,old_snapshot,
   requested_payload,created_by)
 VALUES (new_request,ctx.operation_id,1,ctx.policy_version_id,
   ctx.actor_id,NULL,p_school_id,p_expected_source_revision,
   p_reason,source_snapshot,proposed,ctx.actor_id);

 UPDATE app_private.approval_requests
 SET state='SUBMITTED',submitted_at=pg_catalog.statement_timestamp()
 WHERE id=new_request;
 FOR t IN
   SELECT id,step_number,required_reviews,selection_resolver_key
   FROM app_private.approval_step_templates
   WHERE policy_id=ctx.policy_version_id ORDER BY step_number
 LOOP
   template_count:=template_count+1;
   IF t.step_number IS DISTINCT FROM template_count
     OR t.required_reviews IS DISTINCT FROM 1
     OR t.selection_resolver_key IS DISTINCT FROM 'D1_REVIEWER_ROLE_SCOPE' THEN
     RAISE EXCEPTION 'D1 Roll Policy SUBMIT reviewer policy unsupported';
   END IF;
   IF template_count=1 THEN first_step:=pg_catalog.gen_random_uuid(); END IF;
   INSERT INTO app_private.approval_request_steps(
     id,request_id,policy_id,template_id,step_number,required_reviews,created_by)
   VALUES (CASE WHEN template_count=1 THEN first_step
     ELSE pg_catalog.gen_random_uuid() END,
     new_request,ctx.policy_version_id,t.id,t.step_number,t.required_reviews,
     ctx.actor_id);
 END LOOP;
 IF first_step IS NULL THEN
   RAISE EXCEPTION 'D1 Roll Policy SUBMIT first approval step required';
 END IF;
 UPDATE app_private.approval_requests SET state='PENDING'
   WHERE id=new_request RETURNING row_version INTO final_version;
 IF final_version IS DISTINCT FROM 3 THEN
   RAISE EXCEPTION 'D1 Roll Policy SUBMIT request lifecycle unexpected';
 END IF;
 UPDATE app_private.approval_request_steps
   SET state='OPEN',opened_at=pg_catalog.statement_timestamp()
   WHERE id=first_step;
 INSERT INTO app_private.approval_step_reviewers(
   step_id,reviewer_id,assignment_reason,created_by)
 SELECT first_step,c.candidate_principal_id,'D1_REVIEWER_ROLE_SCOPE',ctx.actor_id
 FROM app_private.d1_review_candidates(new_request,first_step) c;
 GET DIAGNOSTICS candidate_count=ROW_COUNT;
 IF candidate_count<1 THEN
   RAISE EXCEPTION 'D1 Roll Policy SUBMIT independent reviewer unavailable';
 END IF;
 -- Receipt is inserted AFTER PENDING + verified independent assignment,
 -- but BEFORE transitions that cite its immutable UUID. Same transaction.
 receipt_id:=app_private.d1_roll_policy_submit_success_evidence(
   ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
   p_school_id,new_request,ctx.policy_version_id,
   p_expected_source_revision,p_action);
 INSERT INTO app_private.approval_transitions(
   request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
 VALUES
   (new_request,1,NULL,'DRAFT','D1_ROLL_POLICY_SUBMIT',receipt_id,ctx.actor_id),
   (new_request,2,'DRAFT','SUBMITTED','D1_ROLL_POLICY_SUBMIT',receipt_id,ctx.actor_id),
   (new_request,3,'SUBMITTED','PENDING','D1_ROLL_POLICY_SUBMIT',receipt_id,ctx.actor_id);
 IF app_private.d1_roll_policy_submit_rows_match(
   ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
   p_school_id,new_request,ctx.policy_version_id,
   p_expected_source_revision,source_snapshot,proposed_core,p_reason)
     IS DISTINCT FROM true THEN
   RAISE EXCEPTION 'D1 Roll Policy SUBMIT persisted request proof failed';
 END IF;
 RETURN QUERY SELECT new_request,final_version;
END $body$;
REVOKE ALL ON FUNCTION app.d1_submit_student_roll_policy_change(
 uuid,text,uuid,integer,text,bigint,date,text,bigint,text,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_submit_student_roll_policy_change(
 uuid,text,uuid,integer,text,bigint,date,text,bigint,text,text)
 TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;
