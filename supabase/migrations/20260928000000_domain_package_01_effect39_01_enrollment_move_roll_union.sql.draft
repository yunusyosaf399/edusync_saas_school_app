-- MOVE prerequisite: source/destination ordered roll locks, no new function or ACL.
GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE OR REPLACE FUNCTION app_private.d1_enrollment_move_lock_context(
  p_student uuid,p_expected_student_version bigint,p_source_enrollment uuid,p_expected_source_section uuid,
  p_expected_source_effective_from date,p_destination_section uuid,p_entry_kind text,p_effective_from date
) RETURNS TABLE(student_version bigint,source_section_id uuid,source_roll_id uuid,school_id uuid,
  source_campus_id uuid,source_year_id uuid,source_class_offering_id uuid,destination_campus_id uuid,destination_year_id uuid,
  destination_class_offering_id uuid,destination_class_capacity integer,destination_section_capacity integer,error_code text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE c record; src record; dst record; source_class uuid; destination_class uuid; anchor uuid;
BEGIN
  -- Acquire the complete retained-source + effective-destination union
  -- BEFORE base context can lock Student. School serializes discovery.
  SELECT * INTO src FROM app_private.d1_enrollment_place_destination(p_expected_source_section);
  SELECT * INTO dst FROM app_private.d1_enrollment_place_destination(p_destination_section);
  IF src.school_id IS NOT NULL AND src.school_id=dst.school_id THEN
    anchor:=src.school_id;
    IF app_private.d1_enrollment_place_lock_school(anchor) IS DISTINCT FROM true THEN
      RAISE EXCEPTION 'D1 Enrollment move School anchor missing'; END IF;
    -- Re-read ancestry after waiting, never retain a pre-wait namespace.
    SELECT * INTO src FROM app_private.d1_enrollment_place_destination(p_expected_source_section);
    SELECT * INTO dst FROM app_private.d1_enrollment_place_destination(p_destination_section);
    IF src.school_id IS DISTINCT FROM anchor OR dst.school_id IS DISTINCT FROM anchor THEN
      RETURN QUERY SELECT NULL::bigint,p_expected_source_section,NULL::uuid,anchor,
        NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,
        NULL::integer,NULL::integer,'D1_ENROLLMENT_MOVE_ANCESTRY_INVALID'::text; RETURN;
    END IF;
    source_class:=src.class_offering_id; destination_class:=dst.class_offering_id;
    -- All policies first, in UUID order. Retained source segments can belong
    -- to expired revisions; destination is selected at the requested date.
    PERFORM 1 FROM app_private.roll_policy_revisions rp
      WHERE rp.school_id=anchor AND (
        rp.id IN (SELECT r.policy_revision_id FROM app_private.roll_allocations r
          JOIN app_private.enrollments e ON e.id=r.enrollment_id
          WHERE e.id=p_source_enrollment AND e.student_id=p_student
            AND e.section_offering_id=p_expected_source_section)
        OR (rp.effective_from<=p_effective_from
          AND (rp.effective_until IS NULL OR p_effective_from<rp.effective_until)))
      ORDER BY rp.id FOR UPDATE;
    -- Only the actual (policy, class/global) pools for each side; de-duplicate
    -- a shared persistent pool and acquire the union in allocator UUID order.
    PERFORM 1 FROM app_private.roll_allocator_states a WHERE EXISTS (
      SELECT 1 FROM (
        SELECT r.policy_revision_id,
          CASE WHEN rp.mode='ACADEMIC_CONTEXT' THEN source_class ELSE NULL::uuid END pool_class
        FROM app_private.roll_allocations r
        JOIN app_private.enrollments e ON e.id=r.enrollment_id
        JOIN app_private.roll_policy_revisions rp ON rp.id=r.policy_revision_id
        WHERE e.id=p_source_enrollment AND e.student_id=p_student
          AND e.section_offering_id=p_expected_source_section AND rp.school_id=anchor
          AND rp.mode IN ('PERSISTENT_STUDENT','ACADEMIC_CONTEXT')
        UNION
        SELECT rp.id,
          CASE WHEN rp.mode='ACADEMIC_CONTEXT' THEN destination_class ELSE NULL::uuid END
        FROM app_private.roll_policy_revisions rp WHERE rp.school_id=anchor
          AND rp.effective_from<=p_effective_from
          AND (rp.effective_until IS NULL OR p_effective_from<rp.effective_until)
          AND rp.mode IN ('PERSISTENT_STUDENT','ACADEMIC_CONTEXT')
      ) pools WHERE pools.policy_revision_id=a.policy_revision_id
        AND pools.pool_class IS NOT DISTINCT FROM a.class_offering_id)
      ORDER BY a.id FOR UPDATE;
  END IF;
  SELECT * INTO c FROM app_private.d1_enrollment_move_lock_context_base(p_student,p_expected_student_version,p_source_enrollment,
    p_expected_source_section,p_expected_source_effective_from,p_destination_section,p_entry_kind,p_effective_from);
  IF c.error_code IS NULL AND (c.school_id IS DISTINCT FROM anchor
      OR c.source_class_offering_id IS DISTINCT FROM source_class
      OR c.destination_class_offering_id IS DISTINCT FROM destination_class) THEN
    c.error_code:='D1_ENROLLMENT_MOVE_DESTINATION_CHANGED';
  END IF;
  IF c.error_code IS NULL AND app_private.d1_enrollment_move_kind_valid(p_entry_kind,c.source_year_id,c.destination_year_id,c.source_campus_id,c.destination_campus_id) IS DISTINCT FROM true THEN
    c.error_code:='D1_ENROLLMENT_MOVE_KIND_MISMATCH';
  END IF;
  RETURN QUERY SELECT c.student_version,c.source_section_id,c.source_roll_id,c.school_id,c.source_campus_id,c.source_year_id,c.source_class_offering_id,
    c.destination_campus_id,c.destination_year_id,c.destination_class_offering_id,c.destination_class_capacity,c.destination_section_capacity,c.error_code;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_enrollment_move_lock_context(uuid,bigint,uuid,uuid,date,uuid,text,date) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_enrollment_move_lock_context(uuid,bigint,uuid,uuid,date,uuid,text,date) TO schoolos_student_executor,schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;
