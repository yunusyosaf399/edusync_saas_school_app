-- Effect 30 lock-order correction.
-- Source and replacement relationship rows are the same relation and must lock UUID-ascending.

GRANT CREATE ON SCHEMA app_private TO schoolos_family_executor;
SET ROLE schoolos_family_executor;
CREATE OR REPLACE FUNCTION app_private.d1_family_relationship_lock_targets(
  p_student uuid,p_family uuid,p_source uuid,p_new_adult_person uuid,p_primary_replacement uuid
) RETURNS TABLE(student_version bigint,family_version bigint,replacement_family_id uuid)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE source_person uuid; source_family uuid; source_student uuid; repl_family uuid;
  person_lock uuid; family_lock uuid; relationship_lock uuid; sver bigint; fver bigint;
BEGIN
  IF p_student IS NULL OR p_family IS NULL THEN RETURN; END IF;
  IF p_source IS NOT NULL THEN
    SELECT r.adult_person_id,r.family_id,r.student_id INTO source_person,source_family,source_student
      FROM app_private.family_relationships r WHERE r.id=p_source;
  END IF;
  IF p_primary_replacement IS NOT NULL THEN
    SELECT r.family_id INTO repl_family FROM app_private.family_relationships r
      WHERE r.id=p_primary_replacement AND r.student_id=p_student;
  END IF;
  FOR person_lock IN
    SELECT x FROM (VALUES (source_person),(p_new_adult_person)) AS p(x)
     WHERE x IS NOT NULL GROUP BY x ORDER BY x
  LOOP
    PERFORM 1 FROM app_private.people p WHERE p.id=person_lock FOR UPDATE;
    IF NOT FOUND THEN RAISE EXCEPTION 'D1 Family relationship Person missing'; END IF;
  END LOOP;
  SELECT s.row_version INTO sver FROM app_private.students s WHERE s.id=p_student FOR UPDATE;
  IF sver IS NULL THEN RETURN; END IF;
  FOR family_lock IN
    SELECT x FROM (VALUES (p_family),(repl_family)) AS f(x)
     WHERE x IS NOT NULL GROUP BY x ORDER BY x
  LOOP
    PERFORM 1 FROM app_private.families f WHERE f.id=family_lock FOR UPDATE;
    IF NOT FOUND THEN RETURN; END IF;
  END LOOP;
  SELECT f.row_version INTO fver FROM app_private.families f WHERE f.id=p_family;
  FOR relationship_lock IN
    SELECT x FROM (VALUES (p_source),(p_primary_replacement)) AS r(x)
     WHERE x IS NOT NULL GROUP BY x ORDER BY x
  LOOP
    PERFORM 1 FROM app_private.family_relationships r WHERE r.id=relationship_lock FOR UPDATE;
    IF NOT FOUND THEN RAISE EXCEPTION 'D1 Family relationship retained target missing'; END IF;
  END LOOP;
  IF p_source IS NOT NULL AND NOT EXISTS (
    SELECT 1 FROM app_private.family_relationships r
     WHERE r.id=p_source AND r.student_id=p_student AND r.family_id=p_family
       AND r.adult_person_id IS NOT DISTINCT FROM source_person)
    OR source_family IS DISTINCT FROM CASE WHEN p_source IS NULL THEN source_family ELSE p_family END
    OR source_student IS DISTINCT FROM CASE WHEN p_source IS NULL THEN source_student ELSE p_student END THEN
    RAISE EXCEPTION 'D1 Family relationship source ancestry changed';
  END IF;
  IF p_primary_replacement IS NOT NULL AND NOT EXISTS (
    SELECT 1 FROM app_private.family_relationships r
     WHERE r.id=p_primary_replacement AND r.student_id=p_student AND r.family_id=repl_family) THEN
    RAISE EXCEPTION 'D1 Family relationship replacement changed';
  END IF;
  RETURN QUERY SELECT sver,fver,repl_family;
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_family_executor;
