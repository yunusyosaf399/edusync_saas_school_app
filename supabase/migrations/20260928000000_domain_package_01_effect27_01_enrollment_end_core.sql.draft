-- D1C1B effect 27/36: Student PRIMARY enrollment end core.
-- Static non-executable continuation only. Migration 10 remains .sql.draft.
-- P1 operation: end the current accepted PRIMARY placement with retained reason; no destination and no Student-status mutation.

SET ROLE schoolos_schema_owner;
GRANT UPDATE (placement_state,effective_until,end_reason,ended_at,ended_by) ON app_private.enrollments TO schoolos_student_executor;
GRANT UPDATE (effective_until,ended_at,ended_by) ON app_private.roll_allocations TO schoolos_student_executor;
RESET ROLE;

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE FUNCTION app_private.d1_enrollment_end_authorized(
  p_principal uuid,p_permission text,p_section uuid,p_reviewer_role uuid DEFAULT NULL
) RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE at_time timestamptz:=pg_catalog.clock_timestamp(); target record;
BEGIN
  IF p_principal IS NULL OR p_section IS NULL OR p_permission NOT IN ('student.enrollment.end','student.enrollment.approve') THEN RETURN false; END IF;
  IF NOT EXISTS (SELECT 1 FROM app_private.principals p JOIN app_private.principal_auth_bindings b ON b.principal_id=p.id
    WHERE p.id=p_principal AND p.kind='INDIVIDUAL' AND p.state='ACTIVE' AND p.person_id IS NOT NULL AND b.auth_user_id IS NOT NULL) THEN RETURN false; END IF;
  IF p_reviewer_role IS NOT NULL AND NOT EXISTS (
    SELECT 1 FROM app_private.principal_role_assignments a JOIN app_private.roles r ON r.id=a.role_id
    WHERE a.principal_id=p_principal AND a.role_id=p_reviewer_role AND a.principal_kind='INDIVIDUAL' AND a.context_kind='INDIVIDUAL'
      AND r.state='ACTIVE' AND NOT r.family_only AND a.valid_from<=at_time AND (a.valid_until IS NULL OR at_time<a.valid_until)
      AND (a.revoked_at IS NULL OR at_time<a.revoked_at)) THEN RETURN false; END IF;
  SELECT so.id section_id,co.id class_offering_id,co.campus_id INTO target
    FROM app_private.section_offerings so JOIN app_private.class_offerings co ON co.id=so.class_offering_id WHERE so.id=p_section;
  IF target.section_id IS NULL THEN RETURN false; END IF;
  RETURN EXISTS (
    SELECT 1 FROM app_private.assignment_permission_scopes sc
    JOIN app_private.principal_role_assignments a ON a.id=sc.assignment_id
    JOIN app_private.role_permission_grants g ON g.id=sc.grant_id
    JOIN app_private.permission_scope_contracts c ON c.id=sc.scope_contract_id
    JOIN app_private.permissions p ON p.id=sc.permission_id JOIN app_private.roles r ON r.id=sc.role_id
    WHERE a.principal_id=p_principal AND a.principal_kind='INDIVIDUAL' AND a.context_kind='INDIVIDUAL'
      AND (p_reviewer_role IS NULL OR a.role_id=p_reviewer_role)
      AND a.role_id=sc.role_id AND g.role_id=sc.role_id AND g.permission_id=sc.permission_id
      AND c.permission_id=sc.permission_id AND c.scope_kind=sc.scope_kind AND c.resolver_key=sc.resolver_key AND c.enabled
      AND p.code=p_permission AND p.state='ENABLED' AND NOT p.family_safe AND r.state='ACTIVE' AND NOT r.family_only
      AND a.valid_from<=at_time AND (a.valid_until IS NULL OR at_time<a.valid_until) AND (a.revoked_at IS NULL OR at_time<a.revoked_at)
      AND g.valid_from<=at_time AND (g.valid_until IS NULL OR at_time<g.valid_until) AND (g.revoked_at IS NULL OR at_time<g.revoked_at)
      AND sc.valid_from<=at_time AND (sc.valid_until IS NULL OR at_time<sc.valid_until) AND (sc.revoked_at IS NULL OR at_time<sc.revoked_at)
      AND sc.resolver_key='DIRECT'
      AND ((sc.scope_kind='ALL' AND sc.campus_id IS NULL)
        OR (sc.scope_kind='CAMPUS' AND sc.campus_id=target.campus_id)
        OR (sc.scope_kind='CLASS' AND sc.class_offering_id=target.class_offering_id)
        OR (sc.scope_kind='SECTION' AND sc.section_offering_id=target.section_id)));
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_enrollment_end_authorized(uuid,text,uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_enrollment_end_authorized(uuid,text,uuid,uuid)
  TO schoolos_student_executor,schoolos_workflow_executor,schoolos_read_executor;

CREATE FUNCTION app_private.d1_enrollment_end_policy(p_section uuid)
RETURNS TABLE(policy_id uuid,route_mode text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE at_time timestamptz:=pg_catalog.clock_timestamp(); campus uuid; school uuid; specific_count bigint; school_count bigint;
  selected uuid; selected_route text; steps bigint; invalid bigint;
BEGIN
  SELECT co.campus_id,co.school_id INTO campus,school FROM app_private.section_offerings so
    JOIN app_private.class_offerings co ON co.id=so.class_offering_id WHERE so.id=p_section;
  IF campus IS NULL OR school IS NULL THEN RETURN; END IF;
  SELECT count(*),min(p.id::text)::uuid,min(p.d1_route_mode) INTO specific_count,selected,selected_route
    FROM app_private.approval_policy_versions p JOIN app_private.operation_contracts o ON o.id=p.operation_id
    WHERE o.code='student.enrollment.end' AND o.contract_version=1 AND o.enabled AND p.state='ACTIVE' AND p.campus_id=campus
      AND p.d1_route_mode IN ('DIRECT','APPROVAL') AND p.effective_from<=at_time AND (p.effective_until IS NULL OR at_time<p.effective_until);
  IF specific_count>1 THEN RETURN; END IF;
  IF specific_count=0 THEN
    SELECT count(*),min(p.id::text)::uuid,min(p.d1_route_mode) INTO school_count,selected,selected_route
      FROM app_private.approval_policy_versions p JOIN app_private.operation_contracts o ON o.id=p.operation_id
      WHERE o.code='student.enrollment.end' AND o.contract_version=1 AND o.enabled AND p.state='ACTIVE' AND p.campus_id IS NULL
        AND p.d1_route_mode IN ('DIRECT','APPROVAL') AND p.effective_from<=at_time AND (p.effective_until IS NULL OR at_time<p.effective_until);
    IF school_count<>1 THEN RETURN; END IF;
  END IF;
  IF selected IS NULL OR selected_route IS NULL THEN RETURN; END IF;
  IF selected_route='APPROVAL' THEN
    SELECT count(*),count(*) FILTER (WHERE r.id IS NULL OR r.state<>'ACTIVE' OR t.required_reviews<>1
      OR t.selection_resolver_key IS DISTINCT FROM 'D1_REVIEWER_ROLE_SCOPE') INTO steps,invalid
      FROM app_private.approval_step_templates t LEFT JOIN app_private.roles r ON r.id=t.reviewer_role_id WHERE t.policy_id=selected;
    IF steps=0 OR invalid<>0 THEN RETURN; END IF;
  END IF;
  RETURN QUERY SELECT selected,selected_route;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_enrollment_end_policy(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_enrollment_end_policy(uuid) TO schoolos_student_executor,schoolos_workflow_executor,schoolos_read_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;

GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE FUNCTION app_private.d1_enrollment_end_lock_context(
  p_student uuid,p_expected_student_version bigint,p_source_enrollment uuid,p_expected_source_section uuid,
  p_expected_source_effective_from date,p_effective_until date
) RETURNS TABLE(student_version bigint,section_id uuid,campus_id uuid,academic_year_id uuid,class_offering_id uuid,
  source_roll_id uuid,source_roll_effective_from date,error_code text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE s app_private.students%ROWTYPE; path record; src app_private.enrollments%ROWTYPE; rollrow record; n bigint; later_count bigint;
BEGIN
  IF p_student IS NULL OR p_expected_student_version IS NULL OR p_expected_student_version<1 OR p_source_enrollment IS NULL
     OR p_expected_source_section IS NULL OR p_expected_source_effective_from IS NULL OR p_effective_until IS NULL THEN
    RETURN QUERY SELECT NULL::bigint,p_expected_source_section,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::date,'D1_ENROLLMENT_END_INTENT_INVALID'; RETURN; END IF;
  SELECT * INTO s FROM app_private.students WHERE id=p_student FOR UPDATE;
  IF NOT FOUND THEN RETURN QUERY SELECT NULL::bigint,p_expected_source_section,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::date,'D1_ENROLLMENT_END_STUDENT_MISSING'; RETURN; END IF;
  IF s.row_version IS DISTINCT FROM p_expected_student_version THEN
    RETURN QUERY SELECT s.row_version,p_expected_source_section,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::date,'D1_ENROLLMENT_END_VERSION_STALE'; RETURN; END IF;
  SELECT * INTO path FROM app_private.d1_enrollment_place_lock_destination(p_expected_source_section);
  IF NOT FOUND THEN RETURN QUERY SELECT s.row_version,p_expected_source_section,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::date,'D1_ENROLLMENT_END_SOURCE_ANCESTRY_MISSING'; RETURN; END IF;
  SELECT * INTO src FROM app_private.enrollments e WHERE e.id=p_source_enrollment FOR UPDATE;
  IF NOT FOUND OR src.student_id IS DISTINCT FROM p_student OR src.placement_kind<>'PRIMARY'
     OR src.section_offering_id IS DISTINCT FROM p_expected_source_section OR src.effective_from IS DISTINCT FROM p_expected_source_effective_from
     OR src.placement_state<>'ACTIVE' OR src.effective_until IS NOT NULL
     OR src.effective_from>pg_catalog.current_date() OR p_effective_until<=src.effective_from THEN
    RETURN QUERY SELECT s.row_version,p_expected_source_section,path.campus_id,path.academic_year_id,path.class_offering_id,NULL::uuid,NULL::date,'D1_ENROLLMENT_END_SOURCE_STALE'; RETURN; END IF;
  SELECT count(*) INTO later_count FROM app_private.enrollments e
    WHERE e.student_id=p_student AND e.placement_kind='PRIMARY' AND e.id<>p_source_enrollment AND e.effective_from>=src.effective_from;
  IF later_count<>0 THEN
    RETURN QUERY SELECT s.row_version,src.section_offering_id,path.campus_id,path.academic_year_id,path.class_offering_id,NULL::uuid,NULL::date,'D1_ENROLLMENT_END_SOURCE_NOT_HEAD'; RETURN; END IF;
  SELECT count(*),min(r.id::text)::uuid,min(r.effective_from) INTO n,rollrow.id,rollrow.effective_from
    FROM app_private.roll_allocations r WHERE r.enrollment_id=p_source_enrollment AND r.student_id=p_student AND r.effective_until IS NULL;
  IF n<>1 OR rollrow.id IS NULL OR rollrow.effective_from IS NULL OR p_effective_until<=rollrow.effective_from THEN
    RETURN QUERY SELECT s.row_version,src.section_offering_id,path.campus_id,path.academic_year_id,path.class_offering_id,NULL::uuid,NULL::date,'D1_ENROLLMENT_END_SOURCE_ROLL_INVALID'; RETURN; END IF;
  PERFORM 1 FROM app_private.roll_allocations r WHERE r.id=rollrow.id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'D1 Enrollment end source roll disappeared'; END IF;
  RETURN QUERY SELECT s.row_version,src.section_offering_id,path.campus_id,path.academic_year_id,path.class_offering_id,
    rollrow.id,rollrow.effective_from,NULL::text;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_enrollment_end_lock_context(uuid,bigint,uuid,uuid,date,date) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_enrollment_end_lock_context(uuid,bigint,uuid,uuid,date,date)
  TO schoolos_student_executor,schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;
