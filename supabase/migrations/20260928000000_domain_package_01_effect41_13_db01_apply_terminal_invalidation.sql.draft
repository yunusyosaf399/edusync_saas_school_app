-- DB01-04 final stale-source INVALIDATED transition and immutable rejected
-- APPLY replay, additive nonactivating SQL draft. Current auth checks, initial
-- success receipt proof, and DB01-03 Roll effect are inherited unchanged.
-- Operation-scoped immutable INVALIDATED outcome witness.
-- School-owned receipt writer records a rejected request.apply, minimal
-- audit and zero Roll/outbox/application effects. For exact-key replay it
-- verifies the retained receipt and returns its original UUID unchanged.
GRANT CREATE ON SCHEMA app_private TO schoolos_evidence_writer;
SET ROLE schoolos_evidence_writer;
CREATE FUNCTION app_private.d1_roll_correct_apply_invalidated_receipt(
 p_actor uuid,p_operation uuid,p_key text,p_hash bytea,p_request uuid,
 p_expected_request_version bigint,p_final_version bigint,
 p_expected_target_version bigint,p_student uuid,p_existing_receipt uuid
) RETURNS uuid LANGUAGE plpgsql VOLATILE SECURITY DEFINER
 SET search_path=pg_catalog,pg_temp AS $body$
DECLARE rid uuid:=gen_random_uuid(); stored record;
BEGIN
 IF p_actor IS NULL OR p_actor IS DISTINCT FROM app_private.current_principal_id()
   OR p_operation IS NULL OR p_key IS NULL OR length(btrim(p_key))=0
   OR p_hash IS NULL OR p_request IS NULL OR p_student IS NULL
   OR p_expected_request_version IS NULL OR p_expected_request_version<1
   OR p_expected_target_version IS NULL OR p_expected_target_version<1
   OR p_final_version IS DISTINCT FROM p_expected_request_version+1
 THEN RAISE EXCEPTION 'D1 Roll correction invalidation intent denied'; END IF;
 IF p_existing_receipt IS NOT NULL THEN
   SELECT r.* INTO stored FROM app_private.command_receipts r
    WHERE r.id=p_existing_receipt AND r.principal_id=p_actor
      AND r.operation_id=p_operation AND r.request_id=p_request
      AND r.idempotency_key=p_key
      AND r.canonical_payload_hash=p_hash
      AND r.command_kind='request.apply' AND r.state='REJECTED'
      AND r.expected_target_version=p_expected_target_version
      AND r.expected_request_version=p_expected_request_version
      AND r.result_ref IS NULL AND r.result_kind IS NULL
      AND r.result_summary=jsonb_build_object(
          'state','INVALIDATED','request_version',p_final_version::text)
      AND r.created_by=p_actor;
   IF NOT FOUND OR
     (SELECT count(*) FROM app_private.audit_events a
       WHERE a.command_receipt_id=p_existing_receipt
         AND a.approval_request_id=p_request
         AND a.actor_id=p_actor AND a.outcome='REJECTED'
         AND a.authority_evidence->>'phase'='APPLY'
         AND a.details->>'code'='D1_ROLL_CORRECT_SOURCE_STALE')<>1
     OR EXISTS (SELECT 1 FROM app_private.outbox_events ev
         WHERE ev.command_receipt_id=p_existing_receipt)
   THEN RAISE EXCEPTION 'D1 Roll correction invalidation evidence invalid'; END IF;
   RETURN p_existing_receipt;
 END IF;
 INSERT INTO app_private.command_receipts(
  id,principal_id,operation_id,command_kind,idempotency_key,
  canonical_payload_hash,canonicalization_version,expected_target_version,
  request_id,expected_request_version,state,result_kind,result_ref,
  result_summary,completed_at,created_by)
 VALUES(rid,p_actor,p_operation,'request.apply',p_key,p_hash,1,
   p_expected_target_version,p_request,p_expected_request_version,'REJECTED',
   NULL,NULL,jsonb_build_object('state','INVALIDATED',
         'request_version',p_final_version::text),
   statement_timestamp(),p_actor);
 INSERT INTO app_private.audit_events(
   actor_id,actor_kind,outcome,authority_evidence,target_version,
   event_type,target_kind,target_ref,command_receipt_id,approval_request_id,
   source_kind,correlation_id,details,created_by)
 VALUES(p_actor,'INDIVIDUAL','REJECTED',
   jsonb_build_object('operation','student.roll.correct','phase','APPLY'),
   p_expected_target_version,'student.roll.correct','STUDENT',
   p_student,rid,p_request,'API',gen_random_uuid(),
   jsonb_build_object('code','D1_ROLL_CORRECT_SOURCE_STALE'),p_actor);
 RETURN rid;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_roll_correct_apply_invalidated_receipt(
 uuid,uuid,text,bytea,uuid,bigint,bigint,bigint,uuid,uuid)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_roll_correct_apply_invalidated_receipt(
 uuid,uuid,text,bytea,uuid,bigint,bigint,bigint,uuid,uuid) TO schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_evidence_writer;

GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE OR REPLACE FUNCTION app.d1_apply_student_roll_correction(
 p_request_id uuid,p_expected_request_version bigint,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint,request_state text,
 corrected_roll_allocation_id uuid,student_version bigint,correction_effective_from date)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; req record; route record; locked record; eff record; available record;
 src uuid; enr uuid; sec uuid; policy uuid; original_origin uuid;
 enroll_from date; roll_from date; old_num bigint; proposed_num bigint;
 live_reviews bigint; total_steps bigint; approved_steps bigint;
 final_version bigint; receipt uuid; summary jsonb;
 correlation uuid:=gen_random_uuid(); seq bigint;
BEGIN
 IF p_request_id IS NULL OR p_expected_request_version IS NULL
   OR p_expected_request_version<1 OR p_idempotency_key IS NULL
   OR length(p_idempotency_key) NOT BETWEEN 1 AND 200
   OR length(btrim(p_idempotency_key))=0
 THEN RAISE EXCEPTION 'D1 Roll correction APPLY intent invalid'; END IF;
 SELECT * INTO ctx FROM app_private.d1_roll_correct_command_context(
  'request.apply',p_idempotency_key,
  jsonb_build_array(p_request_id,p_expected_request_version::text));
 IF NOT FOUND OR ctx.actor_id IS NULL THEN
  RAISE EXCEPTION 'D1 Roll correction APPLY Principal invalid'; END IF;
 PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
 SELECT q.* INTO req FROM app_private.approval_requests q
  WHERE q.id=p_request_id AND q.operation_id=ctx.operation_id FOR UPDATE;
 IF NOT FOUND OR req.policy_id IS NULL OR req.target_ref IS NULL
   OR req.requester_id IS NULL OR req.campus_id IS NULL OR req.reason IS NULL
   OR req.expected_target_version IS NULL
   OR req.old_snapshot IS NULL OR jsonb_typeof(req.old_snapshot)<>'object'
   OR (SELECT count(*) FROM jsonb_object_keys(req.old_snapshot))<>9
   OR NOT (req.old_snapshot ?& ARRAY[
       'student_id','source_enrollment_id','source_section_offering_id',
       'source_enrollment_effective_from','source_roll_allocation_id',
       'source_roll_effective_from','source_policy_revision_id',
       'source_old_numeric_value','source_roll_origin_allocation_id'])
   OR req.requested_payload IS NULL OR jsonb_typeof(req.requested_payload)<>'object'
   OR (SELECT count(*) FROM jsonb_object_keys(req.requested_payload))<>1
   OR NOT(req.requested_payload ? 'proposed_numeric_value')
 THEN RAISE EXCEPTION 'D1 Roll correction APPLY request malformed'; END IF;
 BEGIN
  enr:=NULLIF(req.old_snapshot->>'source_enrollment_id','')::uuid;
  sec:=NULLIF(req.old_snapshot->>'source_section_offering_id','')::uuid;
  src:=NULLIF(req.old_snapshot->>'source_roll_allocation_id','')::uuid;
  policy:=NULLIF(req.old_snapshot->>'source_policy_revision_id','')::uuid;
  original_origin:=NULLIF(req.old_snapshot->>'source_roll_origin_allocation_id','')::uuid;
  enroll_from:=NULLIF(req.old_snapshot->>'source_enrollment_effective_from','')::date;
  roll_from:=NULLIF(req.old_snapshot->>'source_roll_effective_from','')::date;
  old_num:=NULLIF(req.old_snapshot->>'source_old_numeric_value','')::bigint;
  proposed_num:=NULLIF(req.requested_payload->>'proposed_numeric_value','')::bigint;
 EXCEPTION WHEN invalid_text_representation OR datetime_field_overflow
   OR numeric_value_out_of_range THEN
  RAISE EXCEPTION 'D1 Roll correction APPLY stored source malformed';
 END;
 IF req.old_snapshot->>'student_id' IS DISTINCT FROM req.target_ref::text
   OR enr IS NULL OR sec IS NULL OR src IS NULL OR policy IS NULL
   OR enroll_from IS NULL OR roll_from IS NULL OR old_num IS NULL
   OR proposed_num IS NULL OR proposed_num<1
   OR proposed_num>9223372036854775806::bigint OR proposed_num=old_num
   OR req.expected_target_version<1
   OR length(btrim(req.reason))=0 OR octet_length(req.reason)>2048
 THEN RAISE EXCEPTION 'D1 Roll correction APPLY source invalid'; END IF;

 -- DB01-04: Always revalidate current requester, reviewer's distinct Person,
 -- live role/grant/scope, and pinned P1 policy BEFORE considering prior
 -- success evidence. A historical receipt cannot bypass revocation.
 -- APPLY is a separately authenticated command by the current requester.
 -- Approval can never act as an implicit authorization to modify a Roll.
 IF ctx.actor_id IS DISTINCT FROM req.requester_id
   OR app_private.d1_roll_correct_authorized(
     ctx.actor_id,'student.roll.correct',sec,NULL::uuid) IS DISTINCT FROM true
 THEN RAISE EXCEPTION 'D1 Roll correction APPLY requester not authorized'; END IF;

 SELECT count(*),count(*) FILTER (WHERE s.state='APPROVED') INTO total_steps,approved_steps
 FROM app_private.approval_request_steps s WHERE s.request_id=p_request_id;
 IF total_steps=0 OR approved_steps<>total_steps
 THEN RAISE EXCEPTION 'D1 Roll correction APPLY steps incomplete'; END IF;
 -- For each approved step, its one vote must still be independent of the
 -- requester, attached to an unwithdrawn candidate with CURRENT reviewer
 -- role+scope permission. Revoking even an earlier reviewer stops APPLY.
 SELECT count(*) INTO live_reviews
 FROM app_private.approval_request_steps s
 JOIN app_private.approval_step_templates t ON t.id=s.template_id
 JOIN app_private.approval_reviews v ON v.step_id=s.id
 JOIN app_private.approval_step_reviewers a
   ON a.id=v.reviewer_assignment_id AND a.step_id=s.id
 JOIN app_private.principals reviewer ON reviewer.id=v.reviewer_id
 JOIN app_private.principals requester ON requester.id=req.requester_id
 WHERE s.request_id=p_request_id AND s.state='APPROVED'
   AND s.policy_id=req.policy_id AND t.policy_id=req.policy_id
   AND t.required_reviews=1 AND s.required_reviews=1
   AND t.selection_resolver_key='D1_REVIEWER_ROLE_SCOPE'
   AND a.reviewer_id=v.reviewer_id AND a.withdrawn_at IS NULL
   AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE'
   AND v.decision='APPROVE' AND v.created_by=v.reviewer_id
   AND requester.kind='INDIVIDUAL' AND reviewer.kind='INDIVIDUAL'
   AND requester.person_id IS NOT NULL AND reviewer.person_id IS NOT NULL
   AND requester.person_id<>reviewer.person_id
   AND app_private.d1_roll_correct_authorized(
      v.reviewer_id,'student.roll.approve',sec,t.reviewer_role_id) IS TRUE;
 IF live_reviews<>total_steps
 THEN RAISE EXCEPTION 'D1 Roll correction APPLY reviewer authority stale'; END IF;

 SELECT * INTO route FROM app_private.d1_roll_correct_policy(sec);
 IF NOT FOUND OR route.policy_id IS DISTINCT FROM req.policy_id
   OR route.route_mode IS DISTINCT FROM 'APPROVAL'
   OR route.campus_id IS DISTINCT FROM req.campus_id
 THEN RAISE EXCEPTION 'D1 Roll correction APPLY policy stale'; END IF;

 IF ctx.receipt_id IS NOT NULL THEN
  -- Immutable terminal INVALIDATED receipt replay never repeats the failure
  -- or creates a second rejected receipt, transition, audit or outbox.
  IF ctx.receipt_state='REJECTED' THEN
    IF req.state IS DISTINCT FROM 'INVALIDATED'
      OR req.row_version IS DISTINCT FROM p_expected_request_version+1
      OR ctx.result_ref IS NOT NULL OR ctx.result_summary IS NULL
      OR jsonb_typeof(ctx.result_summary) IS DISTINCT FROM 'object'
      OR (SELECT count(*) FROM jsonb_object_keys(ctx.result_summary))<>2
      OR ctx.result_summary->>'state' IS DISTINCT FROM 'INVALIDATED'
      OR ctx.result_summary->>'request_version' IS DISTINCT FROM req.row_version::text
      OR app_private.d1_roll_correct_apply_invalidated_receipt(
        ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
        p_request_id,p_expected_request_version,req.row_version,
        req.expected_target_version,req.target_ref,ctx.receipt_id)
        IS DISTINCT FROM ctx.receipt_id
    THEN RAISE EXCEPTION 'D1 Roll correction invalidation replay denied'; END IF;
    RETURN QUERY SELECT p_request_id,req.row_version,'INVALIDATED',
      NULL::uuid,NULL::bigint,NULL::date;
    RETURN;
  END IF;
  -- Canonical context has already validated the same Principal+operation+key
  -- intent hash. Verify the terminal workflow, immutable evidence and exact
  -- retained source/successor; never rerun effect or acquire obsolete Roll locks.
  IF ctx.receipt_state IS DISTINCT FROM 'SUCCEEDED'
    OR req.state IS DISTINCT FROM 'EXECUTED'
    OR req.row_version IS DISTINCT FROM p_expected_request_version+1
    OR ctx.result_ref IS NULL OR ctx.result_summary IS NULL
    OR jsonb_typeof(ctx.result_summary) IS DISTINCT FROM 'object'
    OR (SELECT count(*) FROM jsonb_object_keys(ctx.result_summary))<>14
    OR ctx.result_summary->>'state' IS DISTINCT FROM 'EXECUTED'
    OR ctx.result_summary->>'request_version' IS DISTINCT FROM req.row_version::text
    OR ctx.result_summary->>'student_id' IS DISTINCT FROM req.target_ref::text
    OR ctx.result_summary->>'source_roll_allocation_id' IS DISTINCT FROM src::text
    OR ctx.result_summary->>'source_policy_revision_id' IS DISTINCT FROM policy::text
    OR ctx.result_summary->>'source_roll_effective_from' IS DISTINCT FROM roll_from::text
    OR ctx.result_summary->>'source_enrollment_effective_from' IS DISTINCT FROM enroll_from::text
    OR ctx.result_summary->>'old_numeric_value' IS DISTINCT FROM old_num::text
    OR ctx.result_summary->>'new_numeric_value' IS DISTINCT FROM proposed_num::text
    OR ctx.result_summary->>'enrollment_id' IS DISTINCT FROM enr::text
    OR ctx.result_summary->>'section_offering_id' IS DISTINCT FROM sec::text
    OR app_private.d1_roll_correct_result_rows_match_exact(
       req.target_ref,enr,src,ctx.result_ref,
       ctx.result_summary-'state'-'request_version') IS DISTINCT FROM true
    OR app_private.d1_roll_correct_reason_matches_exact(
       src,ctx.result_ref,req.reason) IS DISTINCT FROM true
    OR app_private.d1_roll_correct_apply_replay_proof(
       p_request_id,ctx.actor_id,ctx.operation_id,ctx.receipt_id,
       ctx.result_ref,req.expected_target_version,p_expected_request_version,enr)
       IS DISTINCT FROM true
  THEN RAISE EXCEPTION 'D1 Roll correction APPLY replay evidence invalid'; END IF;
  BEGIN
    RETURN QUERY SELECT p_request_id,req.row_version,'EXECUTED',
      ctx.result_ref,(ctx.result_summary->>'student_version')::bigint,
      (ctx.result_summary->>'correction_effective_from')::date;
  EXCEPTION WHEN invalid_text_representation OR datetime_field_overflow
       OR numeric_value_out_of_range THEN
    RAISE EXCEPTION 'D1 Roll correction APPLY replay result invalid';
  END;
  RETURN;
 END IF;
 IF req.state IS DISTINCT FROM 'APPROVED'
   OR req.row_version IS DISTINCT FROM p_expected_request_version
 THEN RAISE EXCEPTION 'D1 Roll correction APPLY request not approved or stale'; END IF;

 -- Full current source lock: School -> stored revision -> allocator ->
 -- Student -> academic ancestry -> Enrollment -> Roll, same as DIRECT.
 SELECT * INTO locked FROM app_private.d1_roll_correct_lock_source(
  req.target_ref,req.expected_target_version,enr,sec,enroll_from,
  src,roll_from,policy,old_num);
 IF NOT FOUND OR locked.error_code IS NOT NULL
   OR locked.business_date IS NULL OR locked.campus_id IS DISTINCT FROM req.campus_id
 THEN
   -- Only now, after the source has been locked and proven stale, perform
   -- a deterministic terminal invalidation. This branch has NO Roll effect.
   UPDATE app_private.approval_requests SET state='INVALIDATED'
    WHERE id=p_request_id AND state='APPROVED'
    RETURNING row_version INTO final_version;
   IF NOT FOUND OR final_version IS DISTINCT FROM p_expected_request_version+1
   THEN RAISE EXCEPTION 'D1 Roll correction stale invalidation transition failed'; END IF;
   receipt:=app_private.d1_roll_correct_apply_invalidated_receipt(
     ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
     p_request_id,p_expected_request_version,final_version,
     req.expected_target_version,req.target_ref,NULL::uuid);
   IF receipt IS NULL THEN
     RAISE EXCEPTION 'D1 Roll correction invalidation receipt unavailable'; END IF;
   SELECT COALESCE(max(t.sequence_number),0)+1 INTO seq
     FROM app_private.approval_transitions t WHERE t.request_id=p_request_id;
   INSERT INTO app_private.approval_transitions(
     request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
   VALUES(p_request_id,seq,'APPROVED','INVALIDATED',
     'D1_ROLL_CORRECT_SOURCE_STALE',receipt,ctx.actor_id);
   RETURN QUERY SELECT p_request_id,final_version,'INVALIDATED',
     NULL::uuid,NULL::bigint,NULL::date;
   RETURN;
 END IF;
 IF ctx.actor_id IS DISTINCT FROM app_private.current_principal_id()
   OR app_private.d1_roll_correct_authorized(
     ctx.actor_id,'student.roll.correct',sec,NULL::uuid) IS DISTINCT FROM true
 THEN RAISE EXCEPTION 'D1 Roll correction APPLY requester revoked'; END IF;
 SELECT * INTO route FROM app_private.d1_roll_correct_policy(sec);
 IF NOT FOUND OR route.policy_id IS DISTINCT FROM req.policy_id
   OR route.route_mode IS DISTINCT FROM 'APPROVAL'
   OR route.campus_id IS DISTINCT FROM locked.campus_id
 THEN RAISE EXCEPTION 'D1 Roll correction APPLY policy changed'; END IF;
 SELECT count(*) INTO live_reviews
 FROM app_private.approval_request_steps s
 JOIN app_private.approval_step_templates t ON t.id=s.template_id
 JOIN app_private.approval_reviews v ON v.step_id=s.id
 JOIN app_private.approval_step_reviewers a
   ON a.id=v.reviewer_assignment_id AND a.step_id=s.id
 JOIN app_private.principals reviewer ON reviewer.id=v.reviewer_id
 JOIN app_private.principals requester ON requester.id=req.requester_id
 WHERE s.request_id=p_request_id AND s.state='APPROVED'
   AND s.policy_id=req.policy_id AND t.policy_id=req.policy_id
   AND s.required_reviews=1 AND t.required_reviews=1
   AND t.selection_resolver_key='D1_REVIEWER_ROLE_SCOPE'
   AND a.reviewer_id=v.reviewer_id AND a.withdrawn_at IS NULL
   AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE'
   AND v.decision='APPROVE' AND v.created_by=v.reviewer_id
   AND requester.kind='INDIVIDUAL' AND reviewer.kind='INDIVIDUAL'
   AND requester.person_id IS NOT NULL AND reviewer.person_id IS NOT NULL
   AND requester.person_id<>reviewer.person_id
   AND app_private.d1_roll_correct_authorized(
    v.reviewer_id,'student.roll.approve',sec,t.reviewer_role_id) IS TRUE;
 IF live_reviews<>total_steps
 THEN RAISE EXCEPTION 'D1 Roll correction APPLY reviewer revoked after wait'; END IF;
 -- Workflow executor may only use the privileged typed availability helper;
 -- it is never granted direct Roll-history SELECT for source inspection.
 SELECT * INTO available FROM app_private.d1_roll_correct_submit_number_available(
    req.target_ref,sec,src,policy,proposed_num,locked.business_date);
 IF NOT FOUND OR available.number_available IS DISTINCT FROM true
   OR available.source_origin IS DISTINCT FROM original_origin
 THEN RAISE EXCEPTION 'D1 Roll correction APPLY origin or numeric namespace stale'; END IF;

 -- Private effect re-acquires the same ordered locks, performs collision
 -- prevention in the retained Roll namespace, and increments Student once.
 SELECT * INTO eff FROM app_private.d1_roll_correct_effect(
  ctx.actor_id,req.target_ref,req.expected_target_version,
  enr,sec,enroll_from,src,roll_from,policy,old_num,proposed_num,req.reason);
 IF NOT FOUND OR eff.source_roll_id IS DISTINCT FROM src
   OR eff.corrected_roll_id IS NULL
   OR eff.student_version IS DISTINCT FROM req.expected_target_version+1
   OR eff.correction_effective_from IS DISTINCT FROM locked.business_date
 THEN RAISE EXCEPTION 'D1 Roll correction APPLY effect mismatch'; END IF;
 summary:=jsonb_build_object(
   'student_id',req.target_ref,'enrollment_id',enr,
   'source_roll_allocation_id',src,
   'corrected_roll_allocation_id',eff.corrected_roll_id,
   'source_policy_revision_id',policy,
   'old_numeric_value',old_num,'new_numeric_value',proposed_num,
   'source_roll_effective_from',roll_from,
   'correction_effective_from',eff.correction_effective_from,
   'student_version',eff.student_version,'section_offering_id',sec,
   'source_enrollment_effective_from',enroll_from);
 UPDATE app_private.approval_requests SET state='EXECUTED'
   WHERE id=p_request_id AND state='APPROVED' RETURNING row_version INTO final_version;
 IF NOT FOUND OR final_version IS DISTINCT FROM p_expected_request_version+1
 THEN RAISE EXCEPTION 'D1 Roll correction APPLY state transition invalid'; END IF;
 receipt:=app_private.d1_roll_correct_apply_evidence(
   ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,p_request_id,
   p_expected_request_version,final_version,req.expected_target_version,
   req.target_ref,enr,sec,src,eff.corrected_roll_id,req.reason,summary,correlation);
 IF receipt IS NULL THEN
  RAISE EXCEPTION 'D1 Roll correction APPLY receipt absent'; END IF;
 -- Frozen operation-specific BEFORE INSERT trigger checks full source,
 -- corrected Roll, exact 14-key receipt and all approved steps. It expects
 -- the original optimistic version (not the already incremented Student).
 INSERT INTO app_private.approval_applications(
  request_id,command_receipt_id,operation_id,applied_target_version,result_ref,created_by)
 VALUES(p_request_id,receipt,ctx.operation_id,
  req.expected_target_version,eff.corrected_roll_id,ctx.actor_id);
 SELECT COALESCE(max(t.sequence_number),0)+1 INTO seq
   FROM app_private.approval_transitions t WHERE t.request_id=p_request_id;
 INSERT INTO app_private.approval_transitions(
  request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
 VALUES(p_request_id,seq,'APPROVED','EXECUTED','Student Roll correction applied',
   receipt,ctx.actor_id);
 RETURN QUERY SELECT p_request_id,final_version,'EXECUTED',
   eff.corrected_roll_id,eff.student_version,eff.correction_effective_from;
END $body$;
REVOKE ALL ON FUNCTION app.d1_apply_student_roll_correction(uuid,bigint,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_apply_student_roll_correction(uuid,bigint,text)
 TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;
