-- D1C2A #551 suite #60: Student Status P2 preflight hits a missing UPDATE
-- privilege because a SELECT over immutable status history requests FOR UPDATE.
-- The function already acquires its authoritative Student aggregate FOR UPDATE
-- before reading the history. No other protected Student mutation can bypass
-- that Student-level lock; retain all current preflight/factual chain checks.
-- Redefine only this exact server-owned preflight, preserving its prior owner,
-- arguments, return shape and SECURITY DEFINER. Never grant history UPDATE.
-- Append-only inactive Migration 10 draft; no hosted deployment.
GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE FUNCTION app_private.d1_student_status_correct_preflight(
  p_student uuid,p_expected_version bigint,p_source uuid,p_expected_source_status text,p_expected_source_effective_on date,
  p_new_status text,p_new_effective_on date,p_reason text
) RETURNS TABLE(eligible boolean,error_code text,derived_previous_status text,next_sequence bigint,resulting_current_status text,scope_date date)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE s app_private.students%ROWTYPE; src app_private.student_status_transitions%ROWTYPE; r record; prev text:=NULL; seq bigint; current_result text:=NULL;
  source_is_authoritative boolean; status_ok boolean:=true; source_date date; source_status text; enrollment_conflict boolean:=false;
BEGIN
  IF p_student IS NULL OR p_expected_version IS NULL OR p_expected_version<1 OR p_source IS NULL
     OR p_expected_source_status NOT IN ('ACTIVE','SUSPENDED','WITHDRAWN','TRANSFERRED','GRADUATED','EXPELLED','DECEASED','ALUMNI')
     OR p_new_status NOT IN ('ACTIVE','SUSPENDED','WITHDRAWN','TRANSFERRED','GRADUATED','EXPELLED','DECEASED','ALUMNI')
     OR p_expected_source_effective_on IS NULL OR p_new_effective_on IS NULL OR p_new_effective_on>pg_catalog.statement_timestamp()::date
     OR p_reason IS NULL OR pg_catalog.length(pg_catalog.btrim(p_reason))=0
  THEN RETURN QUERY SELECT false,'D1_STUDENT_STATUS_CORRECT_PAYLOAD_INVALID',NULL::text,NULL::bigint,NULL::text,NULL::date; RETURN; END IF;
  SELECT * INTO s FROM app_private.students WHERE id=p_student FOR UPDATE;
  IF NOT FOUND THEN RETURN QUERY SELECT false,'D1_STUDENT_STATUS_CORRECT_STUDENT_MISSING',NULL::text,NULL::bigint,NULL::text,NULL::date; RETURN; END IF;
  IF s.row_version IS DISTINCT FROM p_expected_version THEN RETURN QUERY SELECT false,'D1_STUDENT_STATUS_CORRECT_VERSION_STALE',NULL::text,NULL::bigint,NULL::text,NULL::date; RETURN; END IF;
  -- The Student aggregate was already locked FOR UPDATE above. Immutable
  -- status history needs SELECT only; no extra FOR UPDATE privilege or row
  -- locking is required for same-Student command serialization.
  PERFORM 1 FROM app_private.student_status_transitions t WHERE t.student_id=p_student ORDER BY t.sequence_number;
  SELECT * INTO src FROM app_private.student_status_transitions t WHERE t.id=p_source AND t.student_id=p_student;
  IF NOT FOUND THEN RETURN QUERY SELECT false,'D1_STUDENT_STATUS_CORRECT_SOURCE_MISSING',NULL::text,NULL::bigint,NULL::text,NULL::date; RETURN; END IF;
  source_date:=src.effective_on; source_status:=src.new_status;
  IF src.new_status IS DISTINCT FROM p_expected_source_status OR src.effective_on IS DISTINCT FROM p_expected_source_effective_on THEN
    RETURN QUERY SELECT false,'D1_STUDENT_STATUS_CORRECT_SOURCE_STALE',NULL::text,NULL::bigint,NULL::text,NULL::date; RETURN; END IF;
  source_is_authoritative:=NOT EXISTS (SELECT 1 FROM app_private.student_status_transitions x WHERE x.student_id=p_student AND x.supersedes_id=src.id);
  IF NOT source_is_authoritative THEN RETURN QUERY SELECT false,'D1_STUDENT_STATUS_CORRECT_SOURCE_SUPERSEDED',NULL::text,NULL::bigint,NULL::text,NULL::date; RETURN; END IF;
  IF p_new_status IS NOT DISTINCT FROM src.new_status AND p_new_effective_on IS NOT DISTINCT FROM src.effective_on THEN
    RETURN QUERY SELECT false,'D1_STUDENT_STATUS_CORRECT_NOOP',NULL::text,NULL::bigint,NULL::text,NULL::date; RETURN; END IF;
  SELECT COALESCE(pg_catalog.max(t.sequence_number),0)+1 INTO seq FROM app_private.student_status_transitions t WHERE t.student_id=p_student;

  -- Rebuild the authoritative chain: existing non-superseded events except source, plus candidate correction.
  prev:=NULL; current_result:=NULL;
  FOR r IN
    WITH authoritative AS (
      SELECT t.id,t.previous_status,t.new_status,t.effective_on,t.sequence_number,false AS candidate
      FROM app_private.student_status_transitions t
      WHERE t.student_id=p_student AND t.id<>p_source
        AND NOT EXISTS (SELECT 1 FROM app_private.student_status_transitions x WHERE x.student_id=p_student AND x.supersedes_id=t.id)
      UNION ALL
      SELECT NULL::uuid,NULL::text,p_new_status,p_new_effective_on,seq,true
    ) SELECT * FROM authoritative ORDER BY effective_on,sequence_number
  LOOP
    IF prev IS NULL THEN
      IF r.candidate IS false AND r.previous_status IS NOT NULL THEN status_ok:=false; EXIT; END IF;
    ELSE
      IF app_private.d1_student_status_edge_valid(prev,r.new_status) IS DISTINCT FROM true THEN status_ok:=false; EXIT; END IF;
      IF r.candidate IS false AND r.previous_status IS DISTINCT FROM prev THEN status_ok:=false; EXIT; END IF;
    END IF;
    IF r.candidate THEN derived_previous_status:=prev; END IF;
    prev:=r.new_status; current_result:=r.new_status;
  END LOOP;
  IF status_ok IS DISTINCT FROM true OR current_result IS NULL THEN
    RETURN QUERY SELECT false,'D1_STUDENT_STATUS_CORRECT_CHAIN_INVALID',derived_previous_status,seq,current_result,p_new_effective_on; RETURN; END IF;

  -- Correction never rewrites enrollment/roll facts. Detect the approved cross-domain contradictions instead.
  IF p_new_status IN ('WITHDRAWN','TRANSFERRED','GRADUATED','EXPELLED','DECEASED') THEN
    enrollment_conflict:=EXISTS (SELECT 1 FROM app_private.enrollments e WHERE e.student_id=p_student AND e.placement_kind='PRIMARY'
      AND e.effective_from<p_new_effective_on AND (e.effective_until IS NULL OR p_new_effective_on<e.effective_until));
  ELSIF p_new_status IN ('ACTIVE','SUSPENDED') AND src.new_status IN ('WITHDRAWN','TRANSFERRED','GRADUATED','EXPELLED','DECEASED') THEN
    enrollment_conflict:=EXISTS (SELECT 1 FROM app_private.enrollments e WHERE e.student_id=p_student AND e.placement_kind='PRIMARY'
      AND e.effective_until=src.effective_on AND NOT EXISTS (SELECT 1 FROM app_private.enrollments c WHERE c.student_id=p_student AND c.placement_kind='PRIMARY'
        AND c.effective_from<=p_new_effective_on AND (c.effective_until IS NULL OR p_new_effective_on<c.effective_until)));
  END IF;
  IF enrollment_conflict THEN
    RETURN QUERY SELECT false,'D1_STUDENT_STATUS_CORRECT_ENROLLMENT_CONFLICT',derived_previous_status,seq,current_result,p_new_effective_on; RETURN; END IF;
  RETURN QUERY SELECT true,NULL::text,derived_previous_status,seq,current_result,p_new_effective_on;
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;
