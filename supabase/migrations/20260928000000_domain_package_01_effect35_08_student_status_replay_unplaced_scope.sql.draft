-- D1C2A protected Student Status receipt-replay authorization with no placement.
-- Runtime #519 passed first five assertions in suite #56, then replay called
-- the existing private authorization helper with a NULL enrollment. The local
-- PL/pgSQL "scope_row record" was never assigned and raised 55000 during
-- current grant validation. This is not a reason to skip replay authorization.
-- Initialize null-typed campus/class/section before the unchanged checks:
-- enrollment-null grants can satisfy only ALL/DIRECT; specific placement
-- scopes still require a real same-student PRIMARY enrollment. Keep current
-- principal, role, operation, grant, reviewer and time checks exact.
-- Existing NOLOGIN authz-reader owner only; no new client grants.
-- Append-only inactive Migration 10 draft, no deployment.
GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE OR REPLACE FUNCTION app_private.d1_student_status_authorized_enrollment(
  p_principal uuid,p_permission text,p_student uuid,p_enrollment uuid,p_reviewer_role uuid DEFAULT NULL
) RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE at_time timestamptz:=pg_catalog.clock_timestamp(); scope_row record;
BEGIN
  -- No current PRIMARY placement: keep ALL authority valid while missing
  -- campus/class/section scopes cannot match a fabricated placement.
  SELECT NULL::uuid AS section_id,NULL::uuid AS class_id,NULL::uuid AS campus_id INTO scope_row;
  IF p_principal IS NULL OR p_student IS NULL OR p_permission NOT IN ('student.status.change','student.status.approve')
     OR NOT EXISTS (SELECT 1 FROM app_private.students s WHERE s.id=p_student)
     OR NOT EXISTS (SELECT 1 FROM app_private.principals p JOIN app_private.principal_auth_bindings b ON b.principal_id=p.id
       WHERE p.id=p_principal AND p.kind='INDIVIDUAL' AND p.state='ACTIVE' AND p.person_id IS NOT NULL AND b.auth_user_id IS NOT NULL)
  THEN RETURN false; END IF;
  IF p_reviewer_role IS NOT NULL AND NOT EXISTS (
    SELECT 1 FROM app_private.principal_role_assignments a JOIN app_private.roles r ON r.id=a.role_id
     WHERE a.principal_id=p_principal AND a.role_id=p_reviewer_role AND a.principal_kind='INDIVIDUAL' AND a.context_kind='INDIVIDUAL'
       AND r.state='ACTIVE' AND NOT r.family_only AND a.valid_from<=at_time AND (a.valid_until IS NULL OR at_time<a.valid_until)
       AND (a.revoked_at IS NULL OR at_time<a.revoked_at)) THEN RETURN false; END IF;
  IF p_enrollment IS NOT NULL THEN
    SELECT so.id AS section_id,co.id AS class_id,co.campus_id INTO scope_row
      FROM app_private.enrollments e JOIN app_private.section_offerings so ON so.id=e.section_offering_id
      JOIN app_private.class_offerings co ON co.id=so.class_offering_id
     WHERE e.id=p_enrollment AND e.student_id=p_student AND e.placement_kind='PRIMARY';
    IF scope_row.section_id IS NULL THEN RETURN false; END IF;
  END IF;
  RETURN EXISTS (
    SELECT 1 FROM app_private.assignment_permission_scopes sc
    JOIN app_private.principal_role_assignments a ON a.id=sc.assignment_id
    JOIN app_private.role_permission_grants g ON g.id=sc.grant_id
    JOIN app_private.permission_scope_contracts c ON c.id=sc.scope_contract_id
    JOIN app_private.permissions p ON p.id=sc.permission_id JOIN app_private.roles r ON r.id=sc.role_id
    WHERE a.principal_id=p_principal AND a.principal_kind='INDIVIDUAL' AND a.context_kind='INDIVIDUAL'
      AND a.role_id=sc.role_id AND g.role_id=sc.role_id AND g.permission_id=sc.permission_id
      AND c.permission_id=sc.permission_id AND c.scope_kind=sc.scope_kind AND c.resolver_key=sc.resolver_key AND c.enabled
      AND p.code=p_permission AND p.state='ENABLED' AND NOT p.family_safe AND r.state='ACTIVE' AND NOT r.family_only
      AND (p_reviewer_role IS NULL OR sc.role_id=p_reviewer_role)
      AND a.valid_from<=at_time AND (a.valid_until IS NULL OR at_time<a.valid_until) AND (a.revoked_at IS NULL OR at_time<a.revoked_at)
      AND g.valid_from<=at_time AND (g.valid_until IS NULL OR at_time<g.valid_until) AND (g.revoked_at IS NULL OR at_time<g.revoked_at)
      AND sc.valid_from<=at_time AND (sc.valid_until IS NULL OR at_time<sc.valid_until) AND (sc.revoked_at IS NULL OR at_time<sc.revoked_at)
      AND sc.resolver_key='DIRECT'
      AND ((p_enrollment IS NULL AND sc.scope_kind='ALL' AND sc.campus_id IS NULL)
        OR (p_enrollment IS NOT NULL AND sc.scope_kind='ALL' AND sc.campus_id IS NULL)
        OR (p_enrollment IS NOT NULL AND sc.scope_kind='CAMPUS' AND sc.campus_id=scope_row.campus_id)
        OR (p_enrollment IS NOT NULL AND sc.scope_kind='CLASS' AND sc.class_offering_id=scope_row.class_id)
        OR (p_enrollment IS NOT NULL AND sc.scope_kind='SECTION' AND sc.section_offering_id=scope_row.section_id)));
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;
