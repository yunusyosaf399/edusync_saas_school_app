-- D1C1B effect 22/36: Student Special P2 apply.
GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE FUNCTION app.d1_apply_student_special_request(
  p_request_id uuid,p_expected_request_version bigint,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint,request_state text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; req record; policy_row record; pre record; effect_row record; participant text;
  source_id uuid; source_from timestamptz; source_sup uuid; sd boolean; so boolean; sb text;
  nd boolean; no2 boolean; nb text; invalidation_code text; final_state text; final_version bigint;
  receipt uuid; sequence_no bigint; correlation uuid:=pg_catalog.gen_random_uuid();
BEGIN
  IF p_request_id IS NULL OR p_expected_request_version IS NULL OR p_expected_request_version<1 THEN
    RAISE EXCEPTION 'D1 Student special apply intent invalid'; END IF;
  SELECT * INTO ctx FROM app_private.d1_command_receipt_lookup('student.special.correct','request.apply',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_request_id,p_expected_request_version::text));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT r.* INTO req FROM app_private.approval_requests r WHERE r.id=p_request_id AND r.operation_id=ctx.operation_id FOR UPDATE;
  IF NOT FOUND OR app_private.d1_student_special_request_payload_valid(req.old_snapshot,req.requested_payload) IS DISTINCT FROM true THEN
    RAISE EXCEPTION 'D1 Student special request unavailable'; END IF;
  PERFORM s.id FROM app_private.approval_request_steps s WHERE s.request_id=p_request_id ORDER BY s.step_number FOR UPDATE;
  participant:=app_private.d1_student_special_participant(p_request_id,ctx.actor_id);
  IF participant IS NULL OR participant NOT IN ('REQUESTER','FINAL_APPROVER') THEN RAISE EXCEPTION 'D1 Student special request unavailable'; END IF;
  IF ctx.receipt_id IS NOT NULL THEN
    IF ctx.receipt_state NOT IN ('SUCCEEDED','REJECTED') OR ctx.result_summary IS NULL
       OR pg_catalog.jsonb_typeof(ctx.result_summary)<>'object' OR NOT (ctx.result_summary ?& ARRAY['request_version','state'])
       OR (ctx.receipt_state='SUCCEEDED' AND (ctx.result_ref IS NULL
         OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(ctx.result_summary))<>5
         OR NOT (ctx.result_summary ?& ARRAY['special_snapshot_id','student_version','effective_from'])
         OR ctx.result_summary->>'state'<>'EXECUTED'))
       OR (ctx.receipt_state='REJECTED' AND (ctx.result_ref IS NOT NULL
         OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(ctx.result_summary))<>2
         OR ctx.result_summary->>'state'<>'INVALIDATED')) THEN
      RAISE EXCEPTION 'D1 Student special apply receipt invalid'; END IF;
    RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,ctx.result_summary->>'state'; RETURN;
  END IF;
  IF req.state<>'APPROVED' OR req.row_version<>p_expected_request_version THEN RAISE EXCEPTION 'D1 Student special approved request changed'; END IF;
  source_id:=NULLIF(req.old_snapshot->>'source_snapshot_id','')::uuid;
  source_from:=NULLIF(req.old_snapshot->>'source_effective_from','')::timestamptz;
  source_sup:=NULLIF(req.old_snapshot->>'source_supersedes_id','')::uuid;
  sd:=CASE WHEN req.old_snapshot->'disability_indicator'='null'::jsonb THEN NULL ELSE (req.old_snapshot->>'disability_indicator')::boolean END;
  so:=CASE WHEN req.old_snapshot->'orphan_indicator'='null'::jsonb THEN NULL ELSE (req.old_snapshot->>'orphan_indicator')::boolean END;
  sb:=NULLIF(req.old_snapshot->>'blood_group_code','');
  nd:=CASE WHEN req.requested_payload->'disability_indicator'='null'::jsonb THEN NULL ELSE (req.requested_payload->>'disability_indicator')::boolean END;
  no2:=CASE WHEN req.requested_payload->'orphan_indicator'='null'::jsonb THEN NULL ELSE (req.requested_payload->>'orphan_indicator')::boolean END;
  nb:=NULLIF(req.requested_payload->>'blood_group_code','');
  SELECT * INTO policy_row FROM app_private.d1_student_special_p2_policy(req.target_ref);
  IF policy_row.policy_id IS DISTINCT FROM req.policy_id OR policy_row.campus_id IS DISTINCT FROM req.campus_id THEN
    invalidation_code:='D1_STUDENT_SPECIAL_POLICY_STALE';
  ELSIF NOT app_private.d1_student_special_authorized(req.requester_id,'student.special.correct',req.target_ref,NULL) THEN
    invalidation_code:='D1_STUDENT_SPECIAL_REQUESTER_AUTHORITY_STALE';
  ELSIF NOT app_private.d1_student_special_reviews_live(p_request_id) THEN
    invalidation_code:='D1_STUDENT_SPECIAL_REVIEWER_AUTHORITY_STALE';
  ELSE
    SELECT * INTO pre FROM app_private.d1_student_special_preflight(req.target_ref,req.expected_target_version,
      source_id,sd,so,sb,source_from,source_sup,nd,no2,nb);
    IF NOT FOUND OR pre.eligible IS NULL THEN RAISE EXCEPTION 'D1 Student special preflight result unavailable';
    ELSIF pre.eligible IS FALSE THEN invalidation_code:=pre.error_code; END IF;
  END IF;
  IF invalidation_code IS NOT NULL THEN
    final_state:='INVALIDATED';
    UPDATE app_private.approval_requests SET state=final_state WHERE id=p_request_id RETURNING row_version INTO final_version;
    receipt:=app_private.d1_student_special_receipt('request.apply',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
      req.expected_target_version,p_request_id,p_expected_request_version,'REJECTED',NULL,NULL,
      pg_catalog.jsonb_build_object('request_version',final_version,'state',final_state),invalidation_code);
    PERFORM app_private.d1_student_special_audit(ctx.actor_id,'APPLY',req.target_ref,source_id,receipt,p_request_id,
      req.expected_target_version,final_state,NULL,correlation);
  ELSE
    SELECT * INTO effect_row FROM app_private.d1_student_special_effect(req.target_ref,req.expected_target_version,
      source_id,sd,so,sb,source_from,source_sup,nd,no2,nb,req.reason);
    final_state:='EXECUTED';
    UPDATE app_private.approval_requests SET state=final_state WHERE id=p_request_id RETURNING row_version INTO final_version;
    receipt:=app_private.d1_student_special_receipt('request.apply',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
      req.expected_target_version,p_request_id,p_expected_request_version,'SUCCEEDED','D1_STUDENT_SPECIAL_APPLY',effect_row.special_snapshot_id,
      pg_catalog.jsonb_build_object('request_version',final_version,'state',final_state,
        'special_snapshot_id',effect_row.special_snapshot_id,'student_version',effect_row.student_version,'effective_from',effect_row.effective_from),NULL);
    INSERT INTO app_private.approval_applications(request_id,command_receipt_id,operation_id,applied_target_version,result_ref,created_by)
      VALUES (p_request_id,receipt,ctx.operation_id,effect_row.student_version,effect_row.special_snapshot_id,ctx.actor_id);
    PERFORM app_private.d1_student_special_audit(ctx.actor_id,'APPLY',req.target_ref,effect_row.special_snapshot_id,receipt,p_request_id,
      effect_row.student_version,final_state,effect_row.effective_from,correlation);
    PERFORM app_private.d1_student_special_event(ctx.actor_id,req.target_ref,effect_row.special_snapshot_id,source_id,receipt,
      effect_row.student_version,effect_row.effective_from,correlation);
  END IF;
  SELECT pg_catalog.coalesce(max(sequence_number),0) INTO sequence_no FROM app_private.approval_transitions WHERE request_id=p_request_id;
  INSERT INTO app_private.approval_transitions(request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
  VALUES (p_request_id,sequence_no+1,'APPROVED',final_state,
    CASE WHEN final_state='EXECUTED' THEN 'D1_STUDENT_SPECIAL_APPLIED' ELSE invalidation_code END,receipt,ctx.actor_id);
  RETURN QUERY SELECT p_request_id,final_version,final_state;
END $body$;
REVOKE ALL ON FUNCTION app.d1_apply_student_special_request(uuid,bigint,text) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_apply_student_special_request(uuid,bigint,text) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;
