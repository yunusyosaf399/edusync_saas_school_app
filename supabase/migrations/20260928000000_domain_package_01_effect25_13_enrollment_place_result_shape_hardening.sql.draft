-- Effect 25 audit correction: exact durable-result shape before terminal replay casts.

GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE OR REPLACE FUNCTION app_private.d1_enrollment_place_result_matches(
  p_actor uuid,p_student uuid,p_section uuid,p_entry_kind text,p_effective_from date,p_predecessor uuid,
  p_receipt uuid,p_enrollment uuid,p_summary jsonb
) RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE roll_id uuid; status_id uuid; over_cap boolean; summary_enrollment uuid; summary_section uuid; summary_predecessor uuid;
  summary_date date; summary_numeric bigint; summary_version bigint; summary_class uuid; summary_campus uuid; summary_year uuid; target record;
BEGIN
  IF p_actor IS NULL OR p_student IS NULL OR p_section IS NULL OR p_receipt IS NULL OR p_enrollment IS NULL OR p_summary IS NULL
     OR pg_catalog.jsonb_typeof(p_summary)<>'object'
     OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(p_summary))<>15
     OR NOT (p_summary ?& ARRAY['enrollment_id','roll_allocation_id','numeric_value','roll_mode','student_version','status_transition_id',
       'resulting_status','capacity_overridden','section_offering_id','class_offering_id','campus_id','academic_year_id','entry_kind','effective_from','predecessor_id'])
  THEN RETURN false; END IF;
  BEGIN
    summary_enrollment:=NULLIF(p_summary->>'enrollment_id','')::uuid;
    roll_id:=NULLIF(p_summary->>'roll_allocation_id','')::uuid;
    status_id:=NULLIF(p_summary->>'status_transition_id','')::uuid;
    over_cap:=(p_summary->>'capacity_overridden')::boolean;
    summary_section:=NULLIF(p_summary->>'section_offering_id','')::uuid;
    summary_predecessor:=NULLIF(p_summary->>'predecessor_id','')::uuid;
    summary_date:=(p_summary->>'effective_from')::date;
    summary_numeric:=(p_summary->>'numeric_value')::bigint;
    summary_version:=(p_summary->>'student_version')::bigint;
    summary_class:=NULLIF(p_summary->>'class_offering_id','')::uuid;
    summary_campus:=NULLIF(p_summary->>'campus_id','')::uuid;
    summary_year:=NULLIF(p_summary->>'academic_year_id','')::uuid;
  EXCEPTION WHEN invalid_text_representation OR datetime_field_overflow THEN RETURN false; END;
  IF summary_enrollment IS DISTINCT FROM p_enrollment OR summary_section IS DISTINCT FROM p_section
     OR p_summary->>'entry_kind' IS DISTINCT FROM p_entry_kind OR summary_date IS DISTINCT FROM p_effective_from
     OR summary_predecessor IS DISTINCT FROM p_predecessor OR p_summary->>'roll_mode' NOT IN ('ACADEMIC_CONTEXT','PERSISTENT_STUDENT')
     OR summary_numeric IS NULL OR summary_numeric<0 OR summary_version IS NULL OR summary_version<1 OR over_cap IS NULL THEN RETURN false; END IF;
  SELECT co.id class_id,co.campus_id,co.academic_year_id INTO target FROM app_private.section_offerings so
    JOIN app_private.class_offerings co ON co.id=so.class_offering_id WHERE so.id=p_section;
  IF NOT FOUND OR target.class_id IS DISTINCT FROM summary_class OR target.campus_id IS DISTINCT FROM summary_campus
     OR target.academic_year_id IS DISTINCT FROM summary_year THEN RETURN false; END IF;
  IF NOT EXISTS (SELECT 1 FROM app_private.enrollments e WHERE e.id=p_enrollment AND e.student_id=p_student
      AND e.section_offering_id=p_section AND e.entry_kind=p_entry_kind AND e.effective_from=p_effective_from
      AND e.predecessor_id IS NOT DISTINCT FROM p_predecessor) THEN RETURN false; END IF;
  IF roll_id IS NULL OR NOT EXISTS (SELECT 1 FROM app_private.roll_allocations r WHERE r.id=roll_id AND r.enrollment_id=p_enrollment
      AND r.student_id=p_student AND r.numeric_value=summary_numeric) THEN RETURN false; END IF;
  IF over_cap THEN
    IF NOT app_private.d1_enrollment_place_authorized(p_actor,'student.capacity_override',p_section) THEN RETURN false; END IF;
    IF (SELECT count(*) FROM app_private.enrollment_capacity_overrides o WHERE o.enrollment_id=p_enrollment AND o.command_receipt_id=p_receipt)<>1 THEN RETURN false; END IF;
  ELSIF EXISTS (SELECT 1 FROM app_private.enrollment_capacity_overrides o WHERE o.enrollment_id=p_enrollment) THEN RETURN false;
  END IF;
  IF p_entry_kind='REENROLLMENT' THEN
    IF status_id IS NULL OR p_summary->>'resulting_status'<>'ACTIVE'
       OR NOT EXISTS (SELECT 1 FROM app_private.student_status_transitions t WHERE t.id=status_id AND t.student_id=p_student
         AND t.previous_status IN ('WITHDRAWN','TRANSFERRED') AND t.new_status='ACTIVE' AND t.effective_on=p_effective_from AND t.supersedes_id IS NULL)
    THEN RETURN false; END IF;
  ELSIF status_id IS NOT NULL THEN RETURN false;
  END IF;
  RETURN true;
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;
