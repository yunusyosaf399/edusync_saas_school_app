-- DB01-05 checked, minimal P1 request viewing (non-executable Migration 10).
-- Only the requester with current roll.correct, genuinely assigned independent
-- reviewer with current roll.approve role/scope, or separate scoped administrator
-- with BOTH roll.correct and roll_history.view may read a single typed request.
-- A current history grant is separately required for numeric identity disclosure.
-- No client SELECT on private requests, reviewer rows, Roll history or receipts.

GRANT SELECT (id,operation_id,row_version,state,requester_id,target_ref,
              policy_id,old_snapshot,requested_payload,expected_target_version,reason)
  ON app_private.approval_requests TO schoolos_read_executor;
GRANT SELECT (id,operation_id,requester_id,target_ref,policy_id,old_snapshot)
  ON app_private.approval_requests TO schoolos_authz_reader;
GRANT SELECT (id,code) ON app_private.operation_contracts
  TO schoolos_read_executor,schoolos_authz_reader;
GRANT SELECT (id,request_id,state,template_id,policy_id,required_reviews)
  ON app_private.approval_request_steps TO schoolos_authz_reader;
GRANT SELECT (id,policy_id,reviewer_role_id,selection_resolver_key,required_reviews)
  ON app_private.approval_step_templates TO schoolos_authz_reader;
GRANT SELECT (id,step_id,reviewer_id,withdrawn_at,assignment_reason)
  ON app_private.approval_step_reviewers TO schoolos_authz_reader;
GRANT SELECT (step_id,reviewer_id,reviewer_assignment_id,decision)
  ON app_private.approval_reviews TO schoolos_authz_reader;

-- Foundation FORCE RLS applies to the trusted NOLOGIN readers as well.
-- Only the exact Roll correction operation may be selected by this new policy;
-- a caller's actual request participation is checked AFTER this inner boundary.
SET ROLE schoolos_schema_owner;
CREATE POLICY d1_db01_read_approval_request
  ON app_private.approval_requests FOR SELECT
  TO schoolos_read_executor,schoolos_authz_reader
  USING (EXISTS (
    SELECT 1 FROM app_private.operation_contracts o
     WHERE o.id=operation_id AND o.code='student.roll.correct'
  ));
CREATE POLICY d1_db01_read_operation_contract
  ON app_private.operation_contracts FOR SELECT
  TO schoolos_read_executor,schoolos_authz_reader
  USING (code='student.roll.correct');
RESET ROLE;

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE FUNCTION app_private.d1_roll_correct_request_participant(
 p_request uuid,p_actor uuid
) RETURNS text LANGUAGE plpgsql VOLATILE SECURITY DEFINER
 SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; source_section uuid; actor_person uuid; requester_person uuid;
        matching_assignments bigint;
BEGIN
 IF p_request IS NULL OR p_actor IS NULL
    OR p_actor IS DISTINCT FROM app_private.current_principal_id()
 THEN RETURN NULL; END IF;
 SELECT q.id,q.requester_id,q.target_ref,q.policy_id,q.old_snapshot INTO req
   FROM app_private.approval_requests q
   JOIN app_private.operation_contracts o ON o.id=q.operation_id
  WHERE q.id=p_request AND o.code='student.roll.correct';
 IF NOT FOUND OR req.old_snapshot IS NULL OR
    pg_catalog.jsonb_typeof(req.old_snapshot)<>'object' THEN RETURN NULL; END IF;
 BEGIN
   source_section:=NULLIF(req.old_snapshot->>'source_section_offering_id','')::uuid;
 EXCEPTION WHEN invalid_text_representation THEN RETURN NULL; END;
 IF source_section IS NULL OR req.policy_id IS NULL OR req.target_ref IS NULL
   OR req.requester_id IS NULL THEN RETURN NULL; END IF;
 SELECT p.person_id INTO actor_person FROM app_private.principals p
  WHERE p.id=p_actor AND p.kind='INDIVIDUAL' AND p.state='ACTIVE';
 SELECT p.person_id INTO requester_person FROM app_private.principals p
  WHERE p.id=req.requester_id AND p.kind='INDIVIDUAL';
 IF actor_person IS NULL OR requester_person IS NULL THEN RETURN NULL; END IF;

 -- Same Person using a different Principal is not a reviewer/administrator.
 IF actor_person=requester_person THEN
   IF p_actor=req.requester_id AND app_private.d1_roll_correct_authorized(
      p_actor,'student.roll.correct',source_section,NULL::uuid) IS TRUE
   THEN RETURN 'REQUESTER'; END IF;
   RETURN NULL;
 END IF;

 -- Prior vote never conveys future access by itself. The exact nominated
 -- assignment must remain unwithdrawn and the configured review grant live.
 SELECT count(*) INTO matching_assignments
 FROM app_private.approval_request_steps s
 JOIN app_private.approval_step_templates t
   ON t.id=s.template_id AND t.policy_id=s.policy_id
 JOIN app_private.approval_step_reviewers a ON a.step_id=s.id
 WHERE s.request_id=p_request AND s.policy_id=req.policy_id
   AND s.required_reviews=1 AND t.required_reviews=1
   AND t.selection_resolver_key='D1_REVIEWER_ROLE_SCOPE'
   AND a.reviewer_id=p_actor AND a.withdrawn_at IS NULL
   AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE'
   AND (s.state='OPEN' OR EXISTS (
     SELECT 1 FROM app_private.approval_reviews v
      WHERE v.step_id=s.id AND v.reviewer_assignment_id=a.id
        AND v.reviewer_id=p_actor AND v.decision IN ('APPROVE','REJECT')
   ))
   AND app_private.d1_roll_correct_authorized(
        p_actor,'student.roll.approve',source_section,t.reviewer_role_id) IS TRUE;
 IF matching_assignments=1 THEN
   RETURN 'REVIEWER';
 ELSIF matching_assignments>1 THEN
   -- Multiple eligible assignments in one request should not ambiguously
   -- authorize a read when the frozen template expects a single reviewer.
   RETURN NULL;
 END IF;

 -- No explicit new "read all requests" or administrator permission exists.
 -- Admin viewing is a strictly current, scoped two-permission privilege, not
 -- a generic role-name flag or historic participation.
 IF app_private.d1_roll_correct_authorized(
      p_actor,'student.roll.correct',source_section,NULL::uuid) IS TRUE
    AND app_private.d1_authorized('student.roll_history.view','STUDENT',
           req.target_ref,NULL::uuid,CURRENT_DATE) IS TRUE
 THEN RETURN 'AUTHORIZED_ADMIN'; END IF;
 RETURN NULL;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_roll_correct_request_participant(uuid,uuid)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_roll_correct_request_participant(uuid,uuid)
 TO schoolos_read_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;

GRANT CREATE ON SCHEMA app TO schoolos_read_executor;
SET ROLE schoolos_read_executor;
CREATE FUNCTION app.d1_read_student_roll_correction_request(p_request_id uuid)
RETURNS TABLE(
 request_id uuid,request_version bigint,request_state text,student_id uuid,
 source_section_offering_id uuid,expected_student_version bigint,
 source_numeric_value bigint,proposed_numeric_value bigint,
 request_reason text,participant_kind text
)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE actor uuid; req record; kind text; section_id uuid;
        prior_number bigint; next_number bigint; can_view_number boolean;
BEGIN
 IF p_request_id IS NULL THEN RETURN; END IF;
 -- Coordinate live grant and Principal binding revocation with Foundation.
 PERFORM pg_catalog.pg_advisory_xact_lock_shared(71001,1);
 actor:=app_private.current_principal_id();
 IF actor IS NULL THEN RETURN; END IF;
 PERFORM app_private.d1_lock_current_principal(actor);
 SELECT q.id,q.operation_id,q.row_version,q.state,q.requester_id,q.target_ref,
        q.policy_id,q.old_snapshot,q.requested_payload,
        q.expected_target_version,q.reason INTO req
 FROM app_private.approval_requests q
 JOIN app_private.operation_contracts o ON o.id=q.operation_id
 WHERE q.id=p_request_id AND o.code='student.roll.correct';
 IF NOT FOUND OR req.old_snapshot IS NULL OR req.requested_payload IS NULL
    OR pg_catalog.jsonb_typeof(req.old_snapshot)<>'object'
    OR pg_catalog.jsonb_typeof(req.requested_payload)<>'object'
    OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(req.old_snapshot))<>9
    OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(req.requested_payload))<>1
    OR NOT (req.requested_payload ? 'proposed_numeric_value')
    OR req.target_ref IS NULL OR req.expected_target_version<1
 THEN RETURN; END IF;

 kind:=app_private.d1_roll_correct_request_participant(p_request_id,actor);
 IF kind IS NULL THEN RETURN; END IF;
 BEGIN
   section_id:=NULLIF(req.old_snapshot->>'source_section_offering_id','')::uuid;
   prior_number:=NULLIF(req.old_snapshot->>'source_old_numeric_value','')::bigint;
   next_number:=NULLIF(req.requested_payload->>'proposed_numeric_value','')::bigint;
 EXCEPTION WHEN invalid_text_representation OR numeric_value_out_of_range
 THEN RETURN; END;
 IF section_id IS NULL OR prior_number IS NULL OR next_number IS NULL
    OR prior_number<1 OR next_number<1 OR prior_number=next_number
 THEN RETURN; END IF;

 -- Request participation is NOT sufficient for numeric disclosure. Only
 -- the current separately enabled history-view permission can unmask numbers.
 -- CURRENT_DATE never falls back to the older request source date on denial.
 can_view_number:=app_private.d1_authorized(
   'student.roll_history.view','STUDENT',req.target_ref,NULL::uuid,CURRENT_DATE) IS TRUE;
 RETURN QUERY SELECT req.id,req.row_version,req.state,req.target_ref,
   section_id,req.expected_target_version,
   CASE WHEN can_view_number THEN prior_number ELSE NULL::bigint END,
   CASE WHEN can_view_number THEN next_number ELSE NULL::bigint END,
   req.reason,kind;
END $body$;
REVOKE ALL ON FUNCTION app.d1_read_student_roll_correction_request(uuid)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_student_roll_correction_request(uuid)
 TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_read_executor;
