-- Effect 23 independent-audit hardening: historical affected-scope authorization,
-- typed participant read, and successful application binding.

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE FUNCTION app_private.d1_student_status_authorized_enrollment(
  p_principal uuid,p_permission text,p_student uuid,p_enrollment uuid,p_reviewer_role uuid DEFAULT NULL
) RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE at_time timestamptz:=pg_catalog.clock_timestamp(); scope_row record;
BEGIN
  IF p_principal IS NULL OR p_student IS NULL OR p_permission NOT IN ('student.status.change','student.status.approve') THEN RETURN false; END IF;
  IF p_enrollment IS NULL THEN
    RETURN EXISTS (
      SELECT 1 FROM app_private.assignment_permission_scopes sc
      JOIN app_private.principal_role_assignments a ON a.id=sc.assignment_id
      JOIN app_private.role_permission_grants g ON g.id=sc.grant_id
      JOIN app_private.permission_scope_contracts c ON c.id=sc.scope_contract_id
      JOIN app_private.permissions p ON p.id=sc.permission_id JOIN app_private.roles r ON r.id=sc.role_id
      WHERE a.principal_id=p_principal AND a.principal_kind='INDIVIDUAL' AND a.context_kind='INDIVIDUAL'
        AND g.role_id=sc.role_id AND g.permission_id=sc.permission_id AND c.permission_id=sc.permission_id
        AND c.scope_kind=sc.scope_kind AND c.resolver_key=sc.resolver_key AND c.enabled
        AND p.code=p_permission AND p.state='ENABLED' AND NOT p.family_safe AND r.state='ACTIVE' AND NOT r.family_only
        AND (p_reviewer_role IS NULL OR sc.role_id=p_reviewer_role) AND sc.scope_kind='ALL' AND sc.campus_id IS NULL
        AND a.valid_from<=at_time AND (a.valid_until IS NULL OR at_time<a.valid_until) AND (a.revoked_at IS NULL OR at_time<a.revoked_at)
        AND g.valid_from<=at_time AND (g.valid_until IS NULL OR at_time<g.valid_until) AND (g.revoked_at IS NULL OR at_time<g.revoked_at)
        AND sc.valid_from<=at_time AND (sc.valid_until IS NULL OR at_time<sc.valid_until) AND (sc.revoked_at IS NULL OR at_time<sc.revoked_at));
  END IF;
  SELECT so.id AS section_id,co.id AS class_id,co.campus_id INTO scope_row
    FROM app_private.enrollments e JOIN app_private.section_offerings so ON so.id=e.section_offering_id
    JOIN app_private.class_offerings co ON co.id=so.class_offering_id
   WHERE e.id=p_enrollment AND e.student_id=p_student AND e.placement_kind='PRIMARY';
  IF scope_row.section_id IS NULL THEN RETURN false; END IF;
  RETURN EXISTS (
    SELECT 1 FROM app_private.assignment_permission_scopes sc
    JOIN app_private.principal_role_assignments a ON a.id=sc.assignment_id
    JOIN app_private.role_permission_grants g ON g.id=sc.grant_id
    JOIN app_private.permission_scope_contracts c ON c.id=sc.scope_contract_id
    JOIN app_private.permissions p ON p.id=sc.permission_id JOIN app_private.roles r ON r.id=sc.role_id
    WHERE a.principal_id=p_principal AND a.principal_kind='INDIVIDUAL' AND a.context_kind='INDIVIDUAL'
      AND g.role_id=sc.role_id AND g.permission_id=sc.permission_id AND c.permission_id=sc.permission_id
      AND c.scope_kind=sc.scope_kind AND c.resolver_key=sc.resolver_key AND c.enabled
      AND p.code=p_permission AND p.state='ENABLED' AND NOT p.family_safe AND r.state='ACTIVE' AND NOT r.family_only
      AND (p_reviewer_role IS NULL OR sc.role_id=p_reviewer_role)
      AND a.valid_from<=at_time AND (a.valid_until IS NULL OR at_time<a.valid_until) AND (a.revoked_at IS NULL OR at_time<a.revoked_at)
      AND g.valid_from<=at_time AND (g.valid_until IS NULL OR at_time<g.valid_until) AND (g.revoked_at IS NULL OR at_time<g.revoked_at)
      AND sc.valid_from<=at_time AND (sc.valid_until IS NULL OR at_time<sc.valid_until) AND (sc.revoked_at IS NULL OR at_time<sc.revoked_at)
      AND sc.resolver_key='DIRECT'
      AND ((sc.scope_kind='ALL' AND sc.campus_id IS NULL)
        OR (sc.scope_kind='CAMPUS' AND sc.campus_id=scope_row.campus_id)
        OR (sc.scope_kind='CLASS' AND sc.class_offering_id=scope_row.class_id)
        OR (sc.scope_kind='SECTION' AND sc.section_offering_id=scope_row.section_id)));
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_student_status_authorized_enrollment(uuid,text,uuid,uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_student_status_authorized_enrollment(uuid,text,uuid,uuid,uuid)
 TO schoolos_student_executor,schoolos_workflow_executor,schoolos_read_executor;

CREATE FUNCTION app_private.d1_student_status_participant(p_request uuid,p_actor uuid)
RETURNS text LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; enrollment_id uuid; requester_person uuid; actor_person uuid; final_role uuid; decided record;
BEGIN
  SELECT q.* INTO req FROM app_private.approval_requests q JOIN app_private.operation_contracts o ON o.id=q.operation_id
   WHERE q.id=p_request AND o.code='student.status.change'; IF NOT FOUND OR p_actor IS NULL THEN RETURN NULL; END IF;
  BEGIN enrollment_id:=NULLIF(req.old_snapshot->>'enrollment_id','')::uuid;
  EXCEPTION WHEN invalid_text_representation THEN RETURN NULL; END;
  IF p_actor=req.requester_id AND app_private.d1_student_status_authorized_enrollment(
      p_actor,'student.status.change',req.target_ref,enrollment_id,NULL) THEN RETURN 'REQUESTER'; END IF;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id;
  SELECT p.person_id INTO actor_person FROM app_private.principals p WHERE p.id=p_actor;
  IF requester_person IS NULL OR actor_person IS NULL OR requester_person=actor_person THEN RETURN NULL; END IF;
  final_role:=app_private.d1_final_approver_role(p_request,p_actor);
  IF final_role IS NOT NULL AND app_private.d1_student_status_authorized_enrollment(
      p_actor,'student.status.approve',req.target_ref,enrollment_id,final_role) THEN RETURN 'FINAL_APPROVER'; END IF;
  IF EXISTS (
    SELECT 1 FROM app_private.approval_request_steps s JOIN app_private.approval_step_templates t ON t.id=s.template_id
    JOIN app_private.approval_step_reviewers a ON a.step_id=s.id
    WHERE s.request_id=p_request AND s.state='OPEN' AND a.reviewer_id=p_actor AND a.withdrawn_at IS NULL
      AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE' AND t.selection_resolver_key='D1_REVIEWER_ROLE_SCOPE'
      AND app_private.d1_student_status_authorized_enrollment(p_actor,'student.status.approve',req.target_ref,enrollment_id,t.reviewer_role_id)
  ) THEN RETURN 'OPEN_REVIEWER'; END IF;
  FOR decided IN SELECT t.reviewer_role_id,a.assignment_reason FROM app_private.approval_reviews v
    JOIN app_private.approval_request_steps s ON s.id=v.step_id JOIN app_private.approval_step_templates t ON t.id=s.template_id
    JOIN app_private.approval_step_reviewers a ON a.id=v.reviewer_assignment_id
    WHERE s.request_id=p_request AND v.reviewer_id=p_actor LOOP
    IF decided.assignment_reason='D1_REVIEWER_ROLE_SCOPE' AND app_private.d1_student_status_authorized_enrollment(
      p_actor,'student.status.approve',req.target_ref,enrollment_id,decided.reviewer_role_id) THEN RETURN 'DECIDED_REVIEWER'; END IF;
  END LOOP;
  RETURN NULL;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_student_status_participant(uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_student_status_participant(uuid,uuid) TO schoolos_workflow_executor,schoolos_read_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;

GRANT CREATE ON SCHEMA app TO schoolos_read_executor;
SET ROLE schoolos_read_executor;
CREATE FUNCTION app.d1_read_student_status_request(p_request_id uuid)
RETURNS TABLE(request_id uuid,request_state text,request_version bigint,student_id uuid,expected_student_version bigint,
 previous_status text,new_status text,effective_on date,source_transition_id uuid,enrollment_id uuid,created_at timestamptz,decided_at timestamptz,executed_at timestamptz)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE actor uuid:=app_private.current_principal_id(); req record;
BEGIN
  IF actor IS NULL OR app_private.d1_student_status_participant(p_request_id,actor) IS NULL THEN RAISE EXCEPTION 'D1 Student status request read denied'; END IF;
  SELECT q.* INTO req FROM app_private.approval_requests q JOIN app_private.operation_contracts o ON o.id=q.operation_id
   WHERE q.id=p_request_id AND o.code='student.status.change';
  IF NOT FOUND THEN RETURN; END IF;
  RETURN QUERY SELECT req.id,req.state,req.row_version,req.target_ref,req.expected_target_version,
    req.old_snapshot->>'current_status',req.requested_payload->>'new_status',NULLIF(req.requested_payload->>'effective_on','')::date,
    NULLIF(req.old_snapshot->>'source_transition_id','')::uuid,NULLIF(req.old_snapshot->>'enrollment_id','')::uuid,
    req.created_at,
    (SELECT max(t.created_at) FROM app_private.approval_transitions t
      WHERE t.request_id=p_request_id AND t.to_state IN ('APPROVED','REJECTED')),
    (SELECT a.created_at FROM app_private.approval_applications a
      WHERE a.request_id=p_request_id);
END $body$;
REVOKE ALL ON FUNCTION app.d1_read_student_status_request(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_student_status_request(uuid) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_read_executor;

SET ROLE schoolos_schema_owner;
CREATE FUNCTION app_private.d1_student_status_application_guard()
RETURNS trigger LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE op text; r app_private.command_receipts%ROWTYPE; q app_private.approval_requests%ROWTYPE;
  t app_private.student_status_transitions%ROWTYPE; source_id uuid; old_status text; new_status text; effective_on date;
BEGIN
  SELECT code INTO op FROM app_private.operation_contracts WHERE id=NEW.operation_id;
  IF op IS DISTINCT FROM 'student.status.change' THEN RETURN NEW; END IF;
  SELECT * INTO r FROM app_private.command_receipts WHERE id=NEW.command_receipt_id AND operation_id=NEW.operation_id
    AND request_id=NEW.request_id AND command_kind='request.apply' AND state='SUCCEEDED'
    AND result_kind='D1_STUDENT_STATUS_APPLY' AND result_ref=NEW.result_ref;
  SELECT * INTO q FROM app_private.approval_requests WHERE id=NEW.request_id AND operation_id=NEW.operation_id AND state='EXECUTED';
  SELECT * INTO t FROM app_private.student_status_transitions WHERE id=NEW.result_ref;
  IF r.id IS NULL OR q.id IS NULL OR t.id IS NULL OR t.student_id IS DISTINCT FROM q.target_ref
     OR NEW.applied_target_version IS DISTINCT FROM (q.expected_target_version+1)
     OR r.result_summary->>'state'<>'EXECUTED'
     OR (r.result_summary->>'transition_id')::uuid IS DISTINCT FROM t.id
     OR (r.result_summary->>'student_version')::bigint IS DISTINCT FROM NEW.applied_target_version
  THEN RAISE EXCEPTION 'D1 Student status application binding invalid'; END IF;
  BEGIN source_id:=NULLIF(q.old_snapshot->>'source_transition_id','')::uuid; old_status:=q.old_snapshot->>'current_status';
    new_status:=q.requested_payload->>'new_status'; effective_on:=NULLIF(q.requested_payload->>'effective_on','')::date;
  EXCEPTION WHEN invalid_text_representation OR datetime_field_overflow THEN RAISE EXCEPTION 'D1 Student status application payload malformed'; END;
  IF source_id IS NULL OR t.previous_status IS DISTINCT FROM old_status OR t.new_status IS DISTINCT FROM new_status
     OR t.effective_on IS DISTINCT FROM effective_on OR t.reason IS DISTINCT FROM q.reason OR t.supersedes_id IS NOT NULL
     OR NOT EXISTS (SELECT 1 FROM app_private.student_status_transitions s WHERE s.id=source_id AND s.student_id=q.target_ref)
     OR NOT EXISTS (SELECT 1 FROM app_private.students s WHERE s.id=q.target_ref AND s.current_status=t.new_status AND s.row_version=NEW.applied_target_version)
  THEN RAISE EXCEPTION 'D1 Student status transition binding invalid'; END IF;
  RETURN NEW;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_student_status_application_guard() FROM PUBLIC,anon,authenticated,service_role;
CREATE TRIGGER d1_student_status_application_guard BEFORE INSERT ON app_private.approval_applications
 FOR EACH ROW EXECUTE FUNCTION app_private.d1_student_status_application_guard();
RESET ROLE;