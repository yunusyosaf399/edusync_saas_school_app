-- Effect 30 minimized receipt/audit/outbox evidence and retained-history replay proof.

GRANT CREATE ON SCHEMA app_private TO schoolos_evidence_writer;
SET ROLE schoolos_evidence_writer;
CREATE FUNCTION app_private.d1_family_relationship_receipt(
 p_command_kind text,p_actor uuid,p_operation uuid,p_key text,p_hash bytea,p_expected_student bigint,
 p_request uuid,p_expected_request bigint,p_state text,p_result_kind text,p_result uuid,p_summary jsonb,p_error text
) RETURNS uuid
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE rid uuid:=pg_catalog.gen_random_uuid();
BEGIN
  IF p_command_kind NOT IN ('family.relationship.change','request.submit','request.review','request.apply')
     OR p_actor IS NULL OR p_actor IS DISTINCT FROM app_private.current_principal_id()
     OR p_operation IS NULL OR p_key IS NULL OR pg_catalog.length(pg_catalog.btrim(p_key))=0 OR p_hash IS NULL
     OR p_expected_student IS NULL OR p_expected_student<1 OR p_state NOT IN ('SUCCEEDED','REJECTED')
     OR (p_state='SUCCEEDED' AND (p_result_kind IS NULL OR p_error IS NOT NULL))
     OR (p_state='REJECTED' AND (p_error IS NULL OR p_result IS NOT NULL)) THEN
    RAISE EXCEPTION 'D1 Family relationship receipt intent denied';
  END IF;
  INSERT INTO app_private.command_receipts
    (id,principal_id,operation_id,command_kind,idempotency_key,canonical_payload_hash,canonicalization_version,
     expected_target_version,request_id,expected_request_version,state,result_kind,result_ref,result_summary,error_code,completed_at,created_by)
  VALUES (rid,p_actor,p_operation,p_command_kind,p_key,p_hash,1,p_expected_student,p_request,p_expected_request,p_state,
    p_result_kind,p_result,p_summary,p_error,pg_catalog.statement_timestamp(),p_actor);
  RETURN rid;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_family_relationship_receipt(text,uuid,uuid,text,bytea,bigint,uuid,bigint,text,text,uuid,jsonb,text)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_family_relationship_receipt(text,uuid,uuid,text,bytea,bigint,uuid,bigint,text,text,uuid,jsonb,text)
  TO schoolos_family_executor,schoolos_workflow_executor;

CREATE FUNCTION app_private.d1_family_relationship_audit(
 p_actor uuid,p_phase text,p_student uuid,p_family uuid,p_relationship uuid,p_source uuid,p_action text,
 p_receipt uuid,p_request uuid,p_student_version bigint,p_family_version bigint,p_outcome text,p_error text,p_correlation uuid
) RETURNS void
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
BEGIN
  IF p_actor IS DISTINCT FROM app_private.current_principal_id() OR p_phase NOT IN ('DIRECT','SUBMIT','REVIEW','APPLY')
     OR p_student IS NULL OR p_family IS NULL OR p_action NOT IN ('ADD','END','CORRECT') OR p_receipt IS NULL
     OR p_student_version IS NULL OR p_student_version<1 OR p_family_version IS NULL OR p_family_version<1
     OR p_outcome NOT IN ('SUCCEEDED','REJECTED') OR p_correlation IS NULL THEN
    RAISE EXCEPTION 'D1 Family relationship audit intent denied';
  END IF;
  INSERT INTO app_private.audit_events
    (actor_id,actor_kind,outcome,authority_evidence,target_version,event_type,target_kind,target_ref,
     command_receipt_id,approval_request_id,source_kind,correlation_id,details,created_by)
  VALUES (p_actor,'INDIVIDUAL',p_outcome,
    pg_catalog.jsonb_build_object('operation','family.relationship.change','phase',p_phase),
    p_student_version,'family.relationship.change','STUDENT',p_student,p_receipt,p_request,'API',p_correlation,
    pg_catalog.jsonb_build_object('family_id',p_family,'relationship_id',p_relationship,
      'source_relationship_id',p_source,'action',p_action,'family_version',p_family_version,'error_code',p_error),p_actor);
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_family_relationship_audit(uuid,text,uuid,uuid,uuid,uuid,text,uuid,uuid,bigint,bigint,text,text,uuid)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_family_relationship_audit(uuid,text,uuid,uuid,uuid,uuid,text,uuid,uuid,bigint,bigint,text,text,uuid)
  TO schoolos_family_executor,schoolos_workflow_executor;

CREATE FUNCTION app_private.d1_family_relationship_event(
 p_actor uuid,p_student uuid,p_family uuid,p_relationship uuid,p_source uuid,p_action text,p_receipt uuid,p_correlation uuid
) RETURNS void
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
BEGIN
  IF p_actor IS DISTINCT FROM app_private.current_principal_id() OR p_student IS NULL OR p_family IS NULL OR p_relationship IS NULL
     OR p_action NOT IN ('ADD','END','CORRECT') OR p_receipt IS NULL OR p_correlation IS NULL THEN
    RAISE EXCEPTION 'D1 Family relationship event intent denied';
  END IF;
  INSERT INTO app_private.outbox_events
    (event_type,aggregate_kind,aggregate_ref,aggregate_version,command_receipt_id,event_ordinal,correlation_id,payload,created_by)
  VALUES ('family.relationship_changed','FAMILY_RELATIONSHIP',p_relationship,1,p_receipt,1,p_correlation,
    pg_catalog.jsonb_build_object('student_id',p_student,'family_id',p_family,'relationship_id',p_relationship,
      'source_relationship_id',p_source,'action',p_action),p_actor);
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_family_relationship_event(uuid,uuid,uuid,uuid,uuid,text,uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_family_relationship_event(uuid,uuid,uuid,uuid,uuid,text,uuid,uuid)
  TO schoolos_family_executor,schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_evidence_writer;

GRANT CREATE ON SCHEMA app_private TO schoolos_family_executor;
SET ROLE schoolos_family_executor;
CREATE FUNCTION app_private.d1_family_relationship_result_rows_match(
 p_student uuid,p_family uuid,p_action text,p_source uuid,p_result uuid,p_effective_on date,p_summary jsonb
) RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE sver bigint; fver bigint; summary_from date; summary_until date;
BEGIN
  IF p_summary IS NULL OR pg_catalog.jsonb_typeof(p_summary)<>'object'
     OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(p_summary))<>9
     OR NOT (p_summary ?& ARRAY['relationship_id','source_relationship_id','action','effective_from','effective_until',
       'student_version','family_version','primary_context_id','access_closed_count']) THEN RETURN false; END IF;
  BEGIN
    sver:=(p_summary->>'student_version')::bigint; fver:=(p_summary->>'family_version')::bigint;
    summary_from:=NULLIF(p_summary->>'effective_from','')::date; summary_until:=NULLIF(p_summary->>'effective_until','')::date;
  EXCEPTION WHEN invalid_text_representation OR numeric_value_out_of_range OR datetime_field_overflow THEN RETURN false; END;
  IF sver<1 OR fver<1 OR p_summary->>'action' IS DISTINCT FROM p_action
     OR NULLIF(p_summary->>'relationship_id','')::uuid IS DISTINCT FROM p_result
     OR NULLIF(p_summary->>'source_relationship_id','')::uuid IS DISTINCT FROM p_source OR summary_from IS NULL THEN RETURN false; END IF;
  IF p_action IN ('ADD','CORRECT') THEN
    IF summary_from IS DISTINCT FROM p_effective_on OR summary_until IS NOT NULL THEN RETURN false; END IF;
  ELSIF p_action='END' THEN
    IF summary_until IS DISTINCT FROM p_effective_on THEN RETURN false; END IF;
  ELSE RETURN false; END IF;
  IF p_action='ADD' THEN
    RETURN EXISTS (SELECT 1 FROM app_private.family_relationships r
      WHERE r.id=p_result AND r.student_id=p_student AND r.family_id=p_family
        AND r.supersedes_id IS NULL AND r.effective_from=p_effective_on);
  ELSIF p_action='CORRECT' THEN
    RETURN EXISTS (SELECT 1 FROM app_private.family_relationships r
      WHERE r.id=p_result AND r.student_id=p_student AND r.family_id=p_family
        AND r.supersedes_id=p_source AND r.effective_from=p_effective_on)
      AND EXISTS (SELECT 1 FROM app_private.family_relationships s
        WHERE s.id=p_source AND s.student_id=p_student AND s.family_id=p_family
          AND s.effective_until=p_effective_on AND s.ended_at IS NOT NULL AND s.ended_by IS NOT NULL);
  ELSE
    RETURN p_result=p_source AND EXISTS (SELECT 1 FROM app_private.family_relationships s
      WHERE s.id=p_source AND s.student_id=p_student AND s.family_id=p_family
        AND s.effective_from=summary_from AND s.effective_until=p_effective_on
        AND s.ended_at IS NOT NULL AND s.ended_by IS NOT NULL);
  END IF;
EXCEPTION WHEN invalid_text_representation OR datetime_field_overflow THEN RETURN false;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_family_relationship_result_rows_match(uuid,uuid,text,uuid,uuid,date,jsonb)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_family_relationship_result_rows_match(uuid,uuid,text,uuid,uuid,date,jsonb)
  TO schoolos_family_executor,schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_family_executor;
