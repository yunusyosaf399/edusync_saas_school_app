-- Effect 25 bind Student-owned helpers to fixed academic-executor destination helpers.

GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE OR REPLACE FUNCTION app_private.d1_enrollment_place_lock_context(
  p_student uuid,p_expected_version bigint,p_section uuid,p_entry_kind text,p_effective_from date,p_predecessor uuid
) RETURNS TABLE(student_version bigint,current_status text,school_id uuid,campus_id uuid,academic_year_id uuid,
 class_offering_id uuid,class_id uuid,section_id uuid,class_capacity integer,section_capacity integer,predecessor_id uuid,error_code text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE s app_private.students%ROWTYPE; d record; pred app_private.enrollments%ROWTYPE; prior_count bigint; overlap_count bigint; latest_id uuid;
BEGIN
  SELECT * INTO s FROM app_private.students WHERE id=p_student FOR UPDATE;
  IF NOT FOUND THEN RETURN QUERY SELECT NULL::bigint,NULL::text,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::integer,NULL::integer,NULL::uuid,'D1_ENROLLMENT_PLACE_STUDENT_MISSING'; RETURN; END IF;
  IF p_expected_version IS NULL OR p_expected_version<1 OR s.row_version IS DISTINCT FROM p_expected_version THEN
    RETURN QUERY SELECT s.row_version,s.current_status,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::integer,NULL::integer,NULL::uuid,'D1_ENROLLMENT_PLACE_VERSION_STALE'; RETURN; END IF;
  IF p_entry_kind NOT IN ('INITIAL','PROMOTION','REPEAT','REENROLLMENT') OR p_effective_from IS NULL THEN
    RETURN QUERY SELECT s.row_version,s.current_status,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::integer,NULL::integer,NULL::uuid,'D1_ENROLLMENT_PLACE_INTENT_INVALID'; RETURN; END IF;
  SELECT * INTO d FROM app_private.d1_enrollment_place_lock_destination(p_section);
  IF NOT FOUND THEN RETURN QUERY SELECT s.row_version,s.current_status,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::integer,NULL::integer,NULL::uuid,'D1_ENROLLMENT_PLACE_DESTINATION_MISSING'; RETURN; END IF;
  IF d.class_state<>'OPEN' OR d.section_state<>'OPEN' THEN
    RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,NULL::uuid,'D1_ENROLLMENT_PLACE_DESTINATION_NOT_OPEN'; RETURN; END IF;
  IF (p_entry_kind='REENROLLMENT' AND s.current_status NOT IN ('WITHDRAWN','TRANSFERRED'))
     OR (p_entry_kind<>'REENROLLMENT' AND s.current_status<>'ACTIVE') THEN
    RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,NULL::uuid,'D1_ENROLLMENT_PLACE_STATUS_INELIGIBLE'; RETURN; END IF;
  SELECT count(*) INTO prior_count FROM app_private.enrollments e WHERE e.student_id=p_student AND e.placement_kind='PRIMARY';
  IF p_entry_kind='INITIAL' THEN
    IF prior_count<>0 OR p_predecessor IS NOT NULL THEN
      RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,NULL::uuid,'D1_ENROLLMENT_PLACE_INITIAL_HISTORY_CONFLICT'; RETURN; END IF;
  ELSE
    IF p_predecessor IS NULL THEN
      RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,NULL::uuid,'D1_ENROLLMENT_PLACE_PREDECESSOR_REQUIRED'; RETURN; END IF;
    SELECT * INTO pred FROM app_private.enrollments e WHERE e.id=p_predecessor AND e.student_id=p_student AND e.placement_kind='PRIMARY' FOR UPDATE;
    IF NOT FOUND OR pred.effective_until IS NULL OR pred.effective_until>p_effective_from OR pred.placement_state='ACTIVE' THEN
      RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,p_predecessor,'D1_ENROLLMENT_PLACE_PREDECESSOR_INVALID'; RETURN; END IF;
    SELECT e.id INTO latest_id FROM app_private.enrollments e WHERE e.student_id=p_student AND e.placement_kind='PRIMARY' AND e.effective_from<p_effective_from
      ORDER BY e.effective_from DESC,e.created_at DESC,e.id DESC LIMIT 1;
    IF latest_id IS DISTINCT FROM p_predecessor THEN
      RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,p_predecessor,'D1_ENROLLMENT_PLACE_PREDECESSOR_NOT_LATEST'; RETURN; END IF;
  END IF;
  SELECT count(*) INTO overlap_count FROM app_private.enrollments e WHERE e.student_id=p_student AND e.placement_kind='PRIMARY'
    AND p_effective_from<COALESCE(e.effective_until,'infinity'::date);
  IF overlap_count<>0 THEN
    RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,p_predecessor,'D1_ENROLLMENT_PLACE_PRIMARY_OVERLAP'; RETURN; END IF;
  RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,p_predecessor,NULL::text;
END $body$;

CREATE OR REPLACE FUNCTION app_private.d1_enrollment_place_prelock_roll(p_section uuid,p_effective_from date)
RETURNS TABLE(school_id uuid,class_offering_id uuid,policy_revision_id uuid,policy_mode text,allocator_id uuid,error_code text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE d record; pol app_private.roll_policy_revisions%ROWTYPE; a app_private.roll_allocator_states%ROWTYPE; n bigint;
BEGIN
  IF p_section IS NULL OR p_effective_from IS NULL THEN
    RETURN QUERY SELECT NULL::uuid,NULL::uuid,NULL::uuid,NULL::text,NULL::uuid,'D1_ENROLLMENT_PLACE_ROLL_PRELOCK_INVALID'; RETURN; END IF;
  SELECT * INTO d FROM app_private.d1_enrollment_place_destination(p_section);
  IF NOT FOUND THEN RETURN QUERY SELECT NULL::uuid,NULL::uuid,NULL::uuid,NULL::text,NULL::uuid,'D1_ENROLLMENT_PLACE_DESTINATION_MISSING'; RETURN; END IF;
  SELECT count(*) INTO n FROM app_private.roll_policy_revisions r WHERE r.school_id=d.school_id
    AND r.effective_from<=p_effective_from AND (r.effective_until IS NULL OR p_effective_from<r.effective_until);
  IF n<>1 THEN RETURN QUERY SELECT d.school_id,d.class_offering_id,NULL::uuid,NULL::text,NULL::uuid,'D1_ENROLLMENT_PLACE_ROLL_POLICY_AMBIGUOUS'; RETURN; END IF;
  SELECT * INTO pol FROM app_private.roll_policy_revisions r WHERE r.school_id=d.school_id
    AND r.effective_from<=p_effective_from AND (r.effective_until IS NULL OR p_effective_from<r.effective_until) FOR UPDATE;
  IF pol.mode='PERSISTENT_STUDENT' THEN
    SELECT * INTO a FROM app_private.roll_allocator_states x WHERE x.policy_revision_id=pol.id AND x.class_offering_id IS NULL FOR UPDATE;
  ELSIF pol.mode='ACADEMIC_CONTEXT' THEN
    SELECT * INTO a FROM app_private.roll_allocator_states x WHERE x.policy_revision_id=pol.id AND x.class_offering_id=d.class_offering_id FOR UPDATE;
  ELSE
    RETURN QUERY SELECT d.school_id,d.class_offering_id,pol.id,pol.mode,NULL::uuid,'D1_ENROLLMENT_PLACE_ROLL_POLICY_MALFORMED'; RETURN;
  END IF;
  IF NOT FOUND THEN RETURN QUERY SELECT d.school_id,d.class_offering_id,pol.id,pol.mode,NULL::uuid,'D1_ENROLLMENT_PLACE_ROLL_ALLOCATOR_MISSING'; RETURN; END IF;
  RETURN QUERY SELECT d.school_id,d.class_offering_id,pol.id,pol.mode,a.id,NULL::text;
END $body$;

CREATE OR REPLACE FUNCTION app_private.d1_enrollment_place_capacity(
  p_class_offering uuid,p_section uuid,p_effective_from date
) RETURNS TABLE(class_limit integer,section_limit integer,class_count integer,section_count integer,class_full boolean,section_full boolean)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE d record; cl integer; sl integer; cc integer; sc integer;
BEGIN
  IF p_class_offering IS NULL OR p_section IS NULL OR p_effective_from IS NULL THEN RETURN; END IF;
  SELECT * INTO d FROM app_private.d1_enrollment_place_lock_destination(p_section);
  IF NOT FOUND OR d.class_offering_id IS DISTINCT FROM p_class_offering THEN RETURN; END IF;
  cl:=d.class_capacity; sl:=d.section_capacity;
  WITH breakpoints AS (
    SELECT p_effective_from AS d
    UNION SELECT e.effective_from FROM app_private.enrollments e
      JOIN app_private.section_offerings s ON s.id=e.section_offering_id
      WHERE s.class_offering_id=p_class_offering AND e.placement_kind='PRIMARY' AND e.effective_from>=p_effective_from
    UNION SELECT e.effective_until FROM app_private.enrollments e
      JOIN app_private.section_offerings s ON s.id=e.section_offering_id
      WHERE s.class_offering_id=p_class_offering AND e.placement_kind='PRIMARY'
        AND e.effective_until IS NOT NULL AND e.effective_until>=p_effective_from
  ), counts AS (
    SELECT b.d,
      1+(SELECT count(*) FROM app_private.enrollments e
          JOIN app_private.section_offerings s ON s.id=e.section_offering_id
          WHERE s.class_offering_id=p_class_offering AND e.placement_kind='PRIMARY'
            AND e.effective_from<=b.d AND (e.effective_until IS NULL OR b.d<e.effective_until)) AS class_n,
      1+(SELECT count(*) FROM app_private.enrollments e WHERE e.section_offering_id=p_section AND e.placement_kind='PRIMARY'
            AND e.effective_from<=b.d AND (e.effective_until IS NULL OR b.d<e.effective_until)) AS section_n
    FROM breakpoints b WHERE b.d IS NOT NULL
  ) SELECT COALESCE(max(class_n),1)::integer,COALESCE(max(section_n),1)::integer INTO cc,sc FROM counts;
  RETURN QUERY SELECT cl,sl,cc,sc,(cc>cl),(sc>sl);
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;
