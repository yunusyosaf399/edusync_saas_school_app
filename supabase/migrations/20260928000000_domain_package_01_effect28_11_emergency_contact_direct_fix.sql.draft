-- Effect 28 direct-path correction: remove invalid command-context field reference.

GRANT CREATE ON SCHEMA app TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE OR REPLACE FUNCTION app.d1_change_student_emergency_contact(
 p_student_id uuid,p_expected_student_version bigint,p_action text,p_source_contact_id uuid,p_person_id uuid,p_contact_name text,
 p_relationship_label text,p_contact_phone text,p_contact_email text,p_effective_on date,p_reason text,p_idempotency_key text
) RETURNS TABLE(contact_id uuid,source_contact_id uuid,action text,effective_from date,effective_until date,student_version bigint)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; policy_row record; pre record; eff record; receipt uuid; summary jsonb; corr uuid:=pg_catalog.gen_random_uuid(); locked_version bigint;
BEGIN
  SELECT * INTO ctx FROM app_private.d1_student_emergency_contact_command_context('student.emergency_contact.change',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_student_id,p_expected_student_version::text,p_action,p_source_contact_id,p_person_id,p_contact_name,
      p_relationship_label,p_contact_phone,p_contact_email,p_effective_on));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  locked_version:=app_private.d1_student_emergency_contact_lock_student(p_student_id);
  IF locked_version IS NULL THEN RAISE EXCEPTION 'D1 Emergency Contact Student missing'; END IF;
  IF NOT app_private.d1_student_emergency_contact_authorized(ctx.actor_id,'student.emergency_contact.change',p_student_id,NULL)
    THEN RAISE EXCEPTION 'D1 Emergency Contact authority denied'; END IF;
  SELECT * INTO policy_row FROM app_private.d1_student_emergency_contact_policy(p_student_id);
  IF policy_row.policy_id IS NULL OR policy_row.route_mode IS DISTINCT FROM 'DIRECT' THEN RAISE EXCEPTION 'D1 Emergency Contact requires approval request'; END IF;
  IF ctx.receipt_id IS NOT NULL THEN
    IF ctx.receipt_state<>'SUCCEEDED' OR ctx.result_ref IS NULL OR ctx.result_summary IS NULL
       OR app_private.d1_student_emergency_contact_result_rows_match(p_student_id,p_action,p_source_contact_id,ctx.result_ref,p_effective_on,ctx.result_summary) IS DISTINCT FROM true
      THEN RAISE EXCEPTION 'D1 Emergency Contact receipt is not replayable'; END IF;
    RETURN QUERY SELECT ctx.result_ref,NULLIF(ctx.result_summary->>'source_contact_id','')::uuid,p_action,
      NULLIF(ctx.result_summary->>'effective_from','')::date,NULLIF(ctx.result_summary->>'effective_until','')::date,
      (ctx.result_summary->>'student_version')::bigint; RETURN;
  END IF;
  IF locked_version IS DISTINCT FROM p_expected_student_version THEN RAISE EXCEPTION 'D1 Emergency Contact Student version changed'; END IF;
  SELECT * INTO pre FROM app_private.d1_student_emergency_contact_preflight(p_student_id,p_expected_student_version,p_action,p_source_contact_id,
    p_person_id,p_contact_name,p_relationship_label,p_contact_phone,p_contact_email,p_effective_on,p_reason);
  IF pre.eligible IS DISTINCT FROM true THEN RAISE EXCEPTION 'D1 Emergency Contact preflight denied: %',pre.error_code; END IF;
  SELECT * INTO eff FROM app_private.d1_student_emergency_contact_effect(ctx.actor_id,p_student_id,p_expected_student_version,p_action,p_source_contact_id,
    p_person_id,p_contact_name,p_relationship_label,p_contact_phone,p_contact_email,p_effective_on,p_reason);
  summary:=pg_catalog.jsonb_build_object('contact_id',eff.contact_id,'source_contact_id',eff.source_contact_id,'action',p_action,
    'effective_from',eff.effective_from,'effective_until',eff.effective_until,'student_version',eff.student_version);
  receipt:=app_private.d1_student_emergency_contact_receipt('student.emergency_contact.change',ctx.actor_id,ctx.operation_id,p_idempotency_key,
    ctx.intent_hash,p_expected_student_version,NULL,NULL,'SUCCEEDED','D1_STUDENT_EMERGENCY_CONTACT_CHANGE',eff.contact_id,summary,NULL);
  PERFORM app_private.d1_student_emergency_contact_audit(ctx.actor_id,'DIRECT',p_student_id,eff.contact_id,p_source_contact_id,p_action,receipt,NULL,
    eff.student_version,'SUCCEEDED',NULL,corr);
  PERFORM app_private.d1_student_emergency_contact_event(ctx.actor_id,p_student_id,eff.contact_id,p_source_contact_id,p_action,receipt,corr);
  RETURN QUERY SELECT eff.contact_id,eff.source_contact_id,p_action,eff.effective_from,eff.effective_until,eff.student_version;
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_student_executor;