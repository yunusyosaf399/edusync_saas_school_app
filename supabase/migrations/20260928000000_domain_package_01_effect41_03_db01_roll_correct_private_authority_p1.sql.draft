-- DB-01 / RC-06: private current-authority and P1 route gates for Roll CORRECT.
-- Non-activating: no client RPC, command receipt, effect call, catalog enablement,
-- policy row, or grant is created here. Call only after Foundation SHARED auth
-- serialization, before Student/academic locks; recheck after waits at mutation.
GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;

CREATE FUNCTION app_private.d1_roll_correct_authorized(
  p_principal uuid,p_permission text,p_section uuid,p_reviewer_role uuid DEFAULT NULL
) RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE at_time timestamptz:=pg_catalog.clock_timestamp(); target record;
BEGIN
  IF p_principal IS NULL OR p_section IS NULL
     OR p_permission IS NULL OR p_permission NOT IN
        ('student.roll.correct','student.roll.approve')
     OR (p_permission='student.roll.approve' AND p_reviewer_role IS NULL)
     OR (p_permission='student.roll.correct' AND p_reviewer_role IS NOT NULL)
     OR NOT EXISTS (SELECT 1 FROM app_private.operation_contracts o
           WHERE o.code='student.roll.correct' AND o.contract_version=1 AND o.enabled)
  THEN RETURN false; END IF;

  IF NOT EXISTS (SELECT 1 FROM app_private.principals p
    JOIN app_private.principal_auth_bindings b ON b.principal_id=p.id
    WHERE p.id=p_principal AND p.kind='INDIVIDUAL' AND p.state='ACTIVE'
      AND p.person_id IS NOT NULL AND b.auth_user_id IS NOT NULL)
  THEN RETURN false; END IF;

  IF p_reviewer_role IS NOT NULL AND NOT EXISTS (
    SELECT 1 FROM app_private.principal_role_assignments a
    JOIN app_private.roles r ON r.id=a.role_id
    WHERE a.principal_id=p_principal AND a.role_id=p_reviewer_role
      AND a.principal_kind='INDIVIDUAL' AND a.context_kind='INDIVIDUAL'
      AND r.state='ACTIVE' AND NOT r.family_only
      AND a.valid_from<=at_time
      AND (a.valid_until IS NULL OR at_time<a.valid_until)
      AND (a.revoked_at IS NULL OR at_time<a.revoked_at))
  THEN RETURN false; END IF;

  SELECT so.id section_id,co.id class_offering_id,co.campus_id
    INTO target FROM app_private.section_offerings so
    JOIN app_private.class_offerings co ON co.id=so.class_offering_id
    WHERE so.id=p_section;
  IF target.section_id IS NULL OR target.campus_id IS NULL
     OR target.class_offering_id IS NULL THEN RETURN false; END IF;

  RETURN EXISTS (
    SELECT 1 FROM app_private.assignment_permission_scopes sc
    JOIN app_private.principal_role_assignments a ON a.id=sc.assignment_id
    JOIN app_private.role_permission_grants g ON g.id=sc.grant_id
    JOIN app_private.permission_scope_contracts c ON c.id=sc.scope_contract_id
    JOIN app_private.permissions p ON p.id=sc.permission_id
    JOIN app_private.roles r ON r.id=sc.role_id
    WHERE a.principal_id=p_principal AND a.principal_kind='INDIVIDUAL'
      AND a.context_kind='INDIVIDUAL'
      AND (p_reviewer_role IS NULL OR a.role_id=p_reviewer_role)
      AND a.role_id=sc.role_id AND g.role_id=sc.role_id
      AND g.permission_id=sc.permission_id AND c.permission_id=sc.permission_id
      AND c.scope_kind=sc.scope_kind AND c.resolver_key=sc.resolver_key
      AND c.enabled AND p.code=p_permission AND p.state='ENABLED'
      AND NOT p.family_safe AND r.state='ACTIVE' AND NOT r.family_only
      AND a.valid_from<=at_time AND (a.valid_until IS NULL OR at_time<a.valid_until)
      AND (a.revoked_at IS NULL OR at_time<a.revoked_at)
      AND g.valid_from<=at_time AND (g.valid_until IS NULL OR at_time<g.valid_until)
      AND (g.revoked_at IS NULL OR at_time<g.revoked_at)
      AND sc.valid_from<=at_time AND (sc.valid_until IS NULL OR at_time<sc.valid_until)
      AND (sc.revoked_at IS NULL OR at_time<sc.revoked_at)
      AND sc.resolver_key='DIRECT'
      AND ((sc.scope_kind='ALL' AND sc.campus_id IS NULL
             AND sc.class_offering_id IS NULL AND sc.section_offering_id IS NULL AND sc.subject_id IS NULL)
        OR (sc.scope_kind='CAMPUS' AND sc.campus_id=target.campus_id
             AND sc.class_offering_id IS NULL AND sc.section_offering_id IS NULL AND sc.subject_id IS NULL)
        OR (sc.scope_kind='CLASS' AND sc.class_offering_id=target.class_offering_id
             AND sc.campus_id IS NULL AND sc.section_offering_id IS NULL AND sc.subject_id IS NULL)
        OR (sc.scope_kind='SECTION' AND sc.section_offering_id=target.section_id
             AND sc.campus_id IS NULL AND sc.class_offering_id IS NULL AND sc.subject_id IS NULL))
  );
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_roll_correct_authorized(uuid,text,uuid,uuid)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_roll_correct_authorized(uuid,text,uuid,uuid)
 TO schoolos_student_executor,schoolos_workflow_executor,schoolos_read_executor;

CREATE FUNCTION app_private.d1_roll_correct_policy(p_section uuid)
RETURNS TABLE(policy_id uuid,route_mode text,campus_id uuid)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE at_time timestamptz:=pg_catalog.clock_timestamp();
  target_campus uuid; selected uuid; selected_route text;
  n bigint; steps bigint; invalid_steps bigint;
BEGIN
  IF p_section IS NULL THEN RETURN; END IF;
  SELECT co.campus_id INTO target_campus
    FROM app_private.section_offerings so
    JOIN app_private.class_offerings co ON co.id=so.class_offering_id
   WHERE so.id=p_section;
  IF target_campus IS NULL OR NOT EXISTS (
    SELECT 1 FROM app_private.operation_contracts o
      WHERE o.code='student.roll.correct' AND o.contract_version=1 AND o.enabled)
  THEN RETURN; END IF;

  -- Prefer exact campus policy. Ambiguous/invalid active campus rows DENY:
  -- never treat malformed campus policy as absent and fall back to School.
  SELECT count(*),min(p.id::text)::uuid,min(p.d1_route_mode)
    INTO n,selected,selected_route
    FROM app_private.approval_policy_versions p
    JOIN app_private.operation_contracts o ON o.id=p.operation_id
    WHERE o.code='student.roll.correct' AND o.contract_version=1
      AND o.enabled AND p.state='ACTIVE' AND p.campus_id=target_campus
      AND p.effective_from<=at_time AND
      (p.effective_until IS NULL OR at_time<p.effective_until);
  IF n>1 THEN RETURN; END IF;
  IF n=0 THEN
    SELECT count(*),min(p.id::text)::uuid,min(p.d1_route_mode)
      INTO n,selected,selected_route
      FROM app_private.approval_policy_versions p
      JOIN app_private.operation_contracts o ON o.id=p.operation_id
      WHERE o.code='student.roll.correct' AND o.contract_version=1
        AND o.enabled AND p.state='ACTIVE' AND p.campus_id IS NULL
        AND p.effective_from<=at_time AND
        (p.effective_until IS NULL OR at_time<p.effective_until);
  END IF;
  IF n<>1 OR selected IS NULL OR selected_route NOT IN ('DIRECT','APPROVAL')
     OR selected_route IS NULL THEN RETURN; END IF;

  IF selected_route='APPROVAL' THEN
    SELECT count(*),count(*) FILTER (
      WHERE r.id IS NULL OR r.state<>'ACTIVE' OR r.family_only
        OR t.required_reviews IS DISTINCT FROM 1 OR t.selection_resolver_key IS DISTINCT FROM 'D1_REVIEWER_ROLE_SCOPE')
      INTO steps,invalid_steps
      FROM app_private.approval_step_templates t
      LEFT JOIN app_private.roles r ON r.id=t.reviewer_role_id
      WHERE t.policy_id=selected;
    IF steps=0 OR invalid_steps<>0 THEN RETURN; END IF;
  END IF;
  RETURN QUERY SELECT selected,selected_route,target_campus;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_roll_correct_policy(uuid)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_roll_correct_policy(uuid)
 TO schoolos_student_executor,schoolos_workflow_executor,schoolos_read_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;
