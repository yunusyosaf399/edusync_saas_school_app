ALTER FUNCTION app_private.d1_employee_identity_participant(uuid,uuid)
  RENAME TO d1_employee_identity_participant_v0;

REVOKE ALL ON FUNCTION app_private.d1_profile_participant_v0(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,schoolos_read_executor;
REVOKE ALL ON FUNCTION app_private.d1_employee_state_participant_v0(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,schoolos_read_executor;
REVOKE ALL ON FUNCTION app_private.d1_employee_job_assignment_participant_v0(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,schoolos_read_executor;
REVOKE ALL ON FUNCTION app_private.d1_employee_campus_affiliation_participant_v0(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,schoolos_read_executor;
REVOKE ALL ON FUNCTION app_private.d1_teaching_capability_participant_v0(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,schoolos_read_executor;
REVOKE ALL ON FUNCTION app_private.d1_teaching_class_assignment_participant_v0(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,schoolos_read_executor;
REVOKE ALL ON FUNCTION app_private.d1_teaching_subject_assignment_participant_v0(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,schoolos_read_executor;
REVOKE ALL ON FUNCTION app_private.d1_employee_identity_participant_v0(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,schoolos_read_executor;

CREATE FUNCTION app_private.d1_profile_participant(p_request uuid,p_actor uuid)
RETURNS text
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE base text;
BEGIN
  base:=app_private.d1_profile_participant_v0(p_request,p_actor);
  IF base='DECIDED_REVIEWER'
     AND app_private.d1_final_approver_review_present(p_request,p_actor)
     AND app_private.d1_profile_review_evidence_live(p_request)
  THEN RETURN 'FINAL_APPROVER'; END IF;
  RETURN base;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_profile_participant(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_profile_participant(uuid,uuid)
  TO schoolos_workflow_executor,schoolos_read_executor;

