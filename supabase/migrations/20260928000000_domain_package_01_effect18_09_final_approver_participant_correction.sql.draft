-- D1C1B cross-effect approval participant correction discovered during effect 18 audit.
-- Static non-executable continuation only.
-- Sequential approval permits the same currently-authorized reviewer to decide more than
-- one stage. The legacy participant helpers returned on the first matching decided row,
-- so an earlier-stage row could mask that actor's final-stage APPROVE. Preserve all
-- existing operation-specific participant/authority logic, but deterministically upgrade
-- a decided reviewer to FINAL_APPROVER when the immutable final-step review belongs to
-- the actor and the operation's full approved-review evidence is still live.

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;

CREATE FUNCTION app_private.d1_final_approver_review_present(
  p_request uuid,p_actor uuid
) RETURNS boolean
LANGUAGE sql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
  SELECT p_request IS NOT NULL AND p_actor IS NOT NULL AND EXISTS (
    SELECT 1
      FROM app_private.approval_request_steps s
      JOIN app_private.approval_step_templates t
        ON t.id=s.template_id AND t.policy_id=s.policy_id
       AND t.step_number=s.step_number
      JOIN app_private.approval_reviews v ON v.step_id=s.id
      JOIN app_private.approval_step_reviewers a
        ON a.id=v.reviewer_assignment_id AND a.step_id=s.id
       AND a.reviewer_id=v.reviewer_id
     WHERE s.request_id=p_request
       AND s.step_number=(
         SELECT max(f.step_number)
           FROM app_private.approval_request_steps f
          WHERE f.request_id=p_request)
       AND s.state='APPROVED'
       AND t.selection_resolver_key='D1_REVIEWER_ROLE_SCOPE'
       AND v.reviewer_id=p_actor AND v.decision='APPROVE'
       AND a.reviewer_id=p_actor
       AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE'
  );
$body$;
REVOKE ALL ON FUNCTION app_private.d1_final_approver_review_present(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,schoolos_read_executor;

ALTER FUNCTION app_private.d1_profile_participant(uuid,uuid)
  RENAME TO d1_profile_participant_v0;
ALTER FUNCTION app_private.d1_employee_state_participant(uuid,uuid)
  RENAME TO d1_employee_state_participant_v0;
ALTER FUNCTION app_private.d1_employee_job_assignment_participant(uuid,uuid)
