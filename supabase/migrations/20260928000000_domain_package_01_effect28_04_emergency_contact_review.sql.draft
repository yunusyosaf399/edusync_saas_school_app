-- Effect 28 approval review and current-review verification.

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE FUNCTION app_private.d1_student_emergency_contact_reviews_live(p_request uuid)
RETURNS boolean LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; requester_person uuid; s record; n bigint; reviewer uuid; reviewer_person uuid; seen bigint:=0;
BEGIN
  SELECT q.* INTO req FROM app_private.approval_requests q JOIN app_private.operation_contracts o ON o.id=q.operation_id
   WHERE q.id=p_request AND o.code='student.emergency_contact.change'; IF NOT FOUND THEN RETURN false; END IF;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id;
  IF requester_person IS NULL THEN RETURN false; END IF;
  FOR s IN SELECT st.id,st.state,t.reviewer_role_id FROM app_private.approval_request_steps st
      JOIN app_private.approval_step_templates t ON t.id=st.template_id WHERE st.request_id=p_request ORDER BY st.step_number LOOP
    seen:=seen+1; IF s.state<>'APPROVED' OR s.reviewer_role_id IS NULL THEN RETURN false; END IF;
    SELECT count(*),min(v.reviewer_id::text)::uuid INTO n,reviewer FROM app_private.approval_reviews v
      JOIN app_private.approval_step_reviewers a ON a.id=v.reviewer_assignment_id AND a.step_id=s.id
     WHERE v.step_id=s.id AND v.decision='APPROVE' AND a.reviewer_id=v.reviewer_id AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
    IF n<>1 OR reviewer IS NULL THEN RETURN false; END IF;
    SELECT p.person_id INTO reviewer_person FROM app_private.principals p WHERE p.id=reviewer;
    IF reviewer_person IS NULL OR reviewer_person=requester_person
       OR NOT app_private.d1_student_emergency_contact_authorized(reviewer,'student.emergency_contact.approve',req.target_ref,s.reviewer_role_id) THEN RETURN false; END IF;
  END LOOP;
  RETURN seen>0;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_student_emergency_contact_reviews_live(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_student_emergency_contact_reviews_live(uuid) TO schoolos_workflow_executor,schoolos_read_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;

GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE FUNCTION app.d1_review_student_emergency_contact_change(
 p_request_id uuid,p_decision text,p_expected_request_version bigint,p_reason text,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint,request_state text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; req record; step_row record; next_step record; policy_row record; assignment_id uuid; reviewer_role uuid;
  action text; source_contact uuid; n bigint; candidate_count bigint; final_version bigint; final_state text; receipt uuid;
BEGIN
  IF p_request_id IS NULL OR p_decision NOT IN ('APPROVE','REJECT') OR p_expected_request_version IS NULL OR p_expected_request_version<1
     OR p_reason IS NULL OR pg_catalog.length(pg_catalog.btrim(p_reason))=0 THEN RAISE EXCEPTION 'D1 Emergency Contact review intent invalid'; END IF;
  SELECT * INTO ctx FROM app_private.d1_student_emergency_contact_command_context('request.review',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_request_id,p_decision,p_expected_request_version::text,p_reason));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT q.* INTO req FROM app_private.approval_requests q WHERE q.id=p_request_id AND q.operation_id=ctx.operation_id FOR UPDATE;
  IF NOT FOUND OR req.expected_target_version IS NULL OR req.policy_id IS NULL OR req.requested_payload IS NULL THEN RAISE EXCEPTION 'D1 Emergency Contact request missing'; END IF;
  IF pg_catalog.jsonb_typeof(req.requested_payload)<>'object' OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(req.requested_payload))<>8
     OR NOT (req.requested_payload ?& ARRAY['action','person_id','contact_name','relationship_label','contact_phone','contact_email','effective_on'])
    THEN RAISE EXCEPTION 'D1 Emergency Contact stored request malformed'; END IF;
  action:=req.requested_payload->>'action';
  BEGIN source_contact:=NULLIF(req.old_snapshot->>'source_contact_id','')::uuid; EXCEPTION WHEN invalid_text_representation THEN RAISE EXCEPTION 'D1 Emergency Contact stored request malformed'; END;
  IF action NOT IN ('ADD','END','CORRECT') THEN RAISE EXCEPTION 'D1 Emergency Contact stored request malformed'; END IF;
  SELECT * INTO policy_row FROM app_private.d1_student_emergency_contact_policy(req.target_ref);
  IF policy_row.policy_id IS DISTINCT FROM req.policy_id OR policy_row.route_mode IS DISTINCT FROM 'APPROVAL'
     OR policy_row.campus_id IS DISTINCT FROM req.campus_id THEN RAISE EXCEPTION 'D1 Emergency Contact request policy no longer applies'; END IF;
  IF ctx.receipt_id IS NOT NULL THEN
    SELECT count(*),min(t.reviewer_role_id::text)::uuid INTO n,reviewer_role
      FROM app_private.approval_reviews v JOIN app_private.approval_request_steps s ON s.id=v.step_id
      JOIN app_private.approval_step_templates t ON t.id=s.template_id
     WHERE s.request_id=p_request_id AND v.reviewer_id=ctx.actor_id AND v.decision=p_decision AND v.expected_request_version=p_expected_request_version;
    IF n<>1 OR reviewer_role IS NULL
       OR NOT app_private.d1_student_emergency_contact_authorized(ctx.actor_id,'student.emergency_contact.approve',req.target_ref,reviewer_role)
       OR ctx.receipt_state<>'SUCCEEDED' OR ctx.result_ref IS DISTINCT FROM p_request_id OR ctx.result_summary IS NULL
       OR NOT (ctx.result_summary ?& ARRAY['request_version','state']) THEN RAISE EXCEPTION 'D1 Emergency Contact review replay invalid'; END IF;
    RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,ctx.result_summary->>'state'; RETURN;
  END IF;
  SELECT s.* INTO step_row FROM app_private.approval_request_steps s WHERE s.request_id=p_request_id AND s.state='OPEN'
    ORDER BY s.step_number LIMIT 1 FOR UPDATE;
  IF req.state<>'PENDING' OR req.row_version<>p_expected_request_version OR step_row.id IS NULL THEN RAISE EXCEPTION 'D1 Emergency Contact review state changed'; END IF;
  SELECT count(*),min(a.id::text)::uuid INTO n,assignment_id FROM app_private.approval_step_reviewers a
   WHERE a.step_id=step_row.id AND a.reviewer_id=ctx.actor_id AND a.withdrawn_at IS NULL AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
  IF n<>1 OR NOT EXISTS (SELECT 1 FROM app_private.d1_student_emergency_contact_candidates(p_request_id,step_row.id) c WHERE c.candidate_principal_id=ctx.actor_id)
    THEN RAISE EXCEPTION 'D1 Emergency Contact reviewer authority denied'; END IF;
  INSERT INTO app_private.approval_reviews(reviewer_assignment_id,step_id,reviewer_id,decision,reason,expected_request_version,created_by)
  VALUES (assignment_id,step_row.id,ctx.actor_id,p_decision,p_reason,p_expected_request_version,ctx.actor_id);
  UPDATE app_private.approval_request_steps SET state=CASE p_decision WHEN 'APPROVE' THEN 'APPROVED' ELSE 'REJECTED' END,
    closed_at=pg_catalog.statement_timestamp() WHERE id=step_row.id;
  IF p_decision='REJECT' THEN
    UPDATE app_private.approval_request_steps SET state='CANCELLED',closed_at=pg_catalog.statement_timestamp() WHERE request_id=p_request_id AND state='WAITING';
    final_state:='REJECTED'; UPDATE app_private.approval_requests SET state=final_state,decided_at=pg_catalog.statement_timestamp()
      WHERE id=p_request_id RETURNING row_version INTO final_version;
  ELSE
    SELECT s.* INTO next_step FROM app_private.approval_request_steps s
      WHERE s.request_id=p_request_id AND s.step_number=step_row.step_number+1 AND s.state='WAITING' FOR UPDATE;
    IF next_step.id IS NOT NULL THEN
      UPDATE app_private.approval_request_steps SET state='OPEN',opened_at=pg_catalog.statement_timestamp() WHERE id=next_step.id;
      INSERT INTO app_private.approval_step_reviewers(step_id,reviewer_id,assignment_reason,created_by)
      SELECT next_step.id,c.candidate_principal_id,'D1_REVIEWER_ROLE_SCOPE',ctx.actor_id FROM app_private.d1_student_emergency_contact_candidates(p_request_id,next_step.id) c;
      GET DIAGNOSTICS candidate_count=ROW_COUNT; IF candidate_count=0 THEN RAISE EXCEPTION 'D1 Emergency Contact next step has no reviewer'; END IF;
      final_state:='PENDING'; UPDATE app_private.approval_requests SET row_version=row_version+1,updated_at=pg_catalog.statement_timestamp()
        WHERE id=p_request_id RETURNING row_version INTO final_version;
    ELSE
      final_state:='APPROVED'; UPDATE app_private.approval_requests SET state=final_state,decided_at=pg_catalog.statement_timestamp()
        WHERE id=p_request_id RETURNING row_version INTO final_version;
    END IF;
  END IF;
  receipt:=app_private.d1_student_emergency_contact_receipt('request.review',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
    req.expected_target_version,p_request_id,p_expected_request_version,'SUCCEEDED','D1_STUDENT_EMERGENCY_CONTACT_REVIEW',p_request_id,
    pg_catalog.jsonb_build_object('request_version',final_version,'state',final_state),NULL);
  PERFORM app_private.d1_student_emergency_contact_audit(ctx.actor_id,'REVIEW',req.target_ref,source_contact,source_contact,action,receipt,p_request_id,
    req.expected_target_version,'SUCCEEDED',NULL,pg_catalog.gen_random_uuid());
  RETURN QUERY SELECT p_request_id,final_version,final_state;
END $body$;
REVOKE ALL ON FUNCTION app.d1_review_student_emergency_contact_change(uuid,text,bigint,text,text) FROM PUBLIC,anon,service_role;
GRANT EXECUTE ON FUNCTION app.d1_review_student_emergency_contact_change(uuid,text,bigint,text,text) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;