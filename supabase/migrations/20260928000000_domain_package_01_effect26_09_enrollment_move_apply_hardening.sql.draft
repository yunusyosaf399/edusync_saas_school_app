-- Effect 26 apply/replay hardening and approval-application binding.

GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE FUNCTION app_private.d1_enrollment_move_result_rows_match(
  p_student uuid,p_source uuid,p_source_section uuid,p_destination_section uuid,p_entry_kind text,p_effective_from date,
  p_receipt uuid,p_destination uuid,p_summary jsonb
) RETURNS boolean LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE rid uuid; over_cap boolean; override_id uuid; source_roll_count bigint;
BEGIN
  IF p_summary IS NULL OR pg_catalog.jsonb_typeof(p_summary)<>'object' OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(p_summary))<>17
     OR NOT (p_summary ?& ARRAY['enrollment_id','source_enrollment_id','roll_allocation_id','numeric_value','roll_mode','student_version','capacity_overridden',
       'capacity_override_id','source_section_offering_id','destination_section_offering_id','source_class_offering_id','destination_class_offering_id',
       'source_campus_id','destination_campus_id','source_academic_year_id','destination_academic_year_id','entry_kind'])
     OR p_summary->>'entry_kind' IS DISTINCT FROM p_entry_kind THEN RETURN false; END IF;
  over_cap:=pg_catalog.coalesce((p_summary->>'capacity_overridden')::boolean,false); override_id:=NULLIF(p_summary->>'capacity_override_id','')::uuid;
  rid:=NULLIF(p_summary->>'roll_allocation_id','')::uuid;
  IF NULLIF(p_summary->>'enrollment_id','')::uuid IS DISTINCT FROM p_destination OR NULLIF(p_summary->>'source_enrollment_id','')::uuid IS DISTINCT FROM p_source
     OR NULLIF(p_summary->>'source_section_offering_id','')::uuid IS DISTINCT FROM p_source_section
     OR NULLIF(p_summary->>'destination_section_offering_id','')::uuid IS DISTINCT FROM p_destination_section THEN RETURN false; END IF;
  IF NOT EXISTS (SELECT 1 FROM app_private.enrollments e WHERE e.id=p_source AND e.student_id=p_student AND e.section_offering_id=p_source_section
      AND e.placement_kind='PRIMARY' AND e.placement_state='ENDED' AND e.effective_until=p_effective_from AND e.end_reason='MOVE_'||p_entry_kind)
     OR NOT EXISTS (SELECT 1 FROM app_private.enrollments e WHERE e.id=p_destination AND e.student_id=p_student AND e.section_offering_id=p_destination_section
      AND e.placement_kind='PRIMARY' AND e.entry_kind=p_entry_kind AND e.placement_state='ACTIVE' AND e.effective_from=p_effective_from
      AND e.effective_until IS NULL AND e.predecessor_id=p_source)
     OR NOT EXISTS (SELECT 1 FROM app_private.roll_allocations r WHERE r.id=rid AND r.enrollment_id=p_destination AND r.student_id=p_student
      AND r.numeric_value=(p_summary->>'numeric_value')::bigint AND r.effective_from=p_effective_from AND r.effective_until IS NULL)
    THEN RETURN false; END IF;
  SELECT count(*) INTO source_roll_count FROM app_private.roll_allocations r
   WHERE r.enrollment_id=p_source AND r.student_id=p_student AND r.effective_until=p_effective_from AND r.ended_at IS NOT NULL AND r.ended_by IS NOT NULL;
  IF source_roll_count<>1 THEN RETURN false; END IF;
  IF over_cap THEN
    IF override_id IS NULL OR NOT EXISTS (SELECT 1 FROM app_private.enrollment_capacity_overrides o
        WHERE o.id=override_id AND o.enrollment_id=p_destination AND o.command_receipt_id=p_receipt) THEN RETURN false; END IF;
  ELSIF override_id IS NOT NULL OR EXISTS (SELECT 1 FROM app_private.enrollment_capacity_overrides o WHERE o.enrollment_id=p_destination) THEN RETURN false; END IF;
  RETURN true;
EXCEPTION WHEN invalid_text_representation OR numeric_value_out_of_range THEN RETURN false;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_enrollment_move_result_rows_match(uuid,uuid,uuid,uuid,text,date,uuid,uuid,jsonb) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_enrollment_move_result_rows_match(uuid,uuid,uuid,uuid,text,date,uuid,uuid,jsonb) TO schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;

GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE OR REPLACE FUNCTION app.d1_apply_student_enrollment_move(
  p_request_id uuid,p_expected_request_version bigint,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint,request_state text,enrollment_id uuid)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; req record; policy_row record; prelock record; locked record; cap record; eff record; final_role uuid;
  source_id uuid; source_section uuid; source_effective_from date; destination_section uuid; entry_kind text; effective_from date;
  override_reason text; reviewed_override boolean; current_override boolean; invalidation_code text; final_version bigint; receipt uuid;
  override_id uuid; summary jsonb; corr uuid:=pg_catalog.gen_random_uuid(); seq bigint; stripped jsonb;
BEGIN
  IF p_request_id IS NULL OR p_expected_request_version IS NULL OR p_expected_request_version<1 THEN RAISE EXCEPTION 'D1 Enrollment move apply intent invalid'; END IF;
  SELECT * INTO ctx FROM app_private.d1_enrollment_move_command_context('request.apply',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_request_id,p_expected_request_version::text));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT q.* INTO req FROM app_private.approval_requests q WHERE q.id=p_request_id AND q.operation_id=ctx.operation_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'D1 Enrollment move request missing'; END IF;
  IF req.old_snapshot IS NULL OR pg_catalog.jsonb_typeof(req.old_snapshot)<>'object' OR req.requested_payload IS NULL
     OR pg_catalog.jsonb_typeof(req.requested_payload)<>'object' OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(req.old_snapshot))<>4
     OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(req.requested_payload))<>5
     OR NOT (req.old_snapshot ?& ARRAY['student_id','source_enrollment_id','source_section_offering_id','source_effective_from'])
     OR NOT (req.requested_payload ?& ARRAY['destination_section_offering_id','entry_kind','effective_from','capacity_override_reason','capacity_override_required'])
    THEN RAISE EXCEPTION 'D1 Enrollment move stored request malformed'; END IF;
  BEGIN
    source_id:=NULLIF(req.old_snapshot->>'source_enrollment_id','')::uuid; source_section:=NULLIF(req.old_snapshot->>'source_section_offering_id','')::uuid;
    source_effective_from:=NULLIF(req.old_snapshot->>'source_effective_from','')::date; destination_section:=NULLIF(req.requested_payload->>'destination_section_offering_id','')::uuid;
    entry_kind:=req.requested_payload->>'entry_kind'; effective_from:=NULLIF(req.requested_payload->>'effective_from','')::date;
    override_reason:=NULLIF(pg_catalog.btrim(req.requested_payload->>'capacity_override_reason'),'');
    reviewed_override:=(req.requested_payload->>'capacity_override_required')::boolean;
  EXCEPTION WHEN invalid_text_representation OR datetime_field_overflow THEN RAISE EXCEPTION 'D1 Enrollment move stored request malformed'; END;
  IF NULLIF(req.old_snapshot->>'student_id','')::uuid IS DISTINCT FROM req.target_ref OR source_id IS NULL OR source_section IS NULL
     OR source_effective_from IS NULL OR destination_section IS NULL OR entry_kind NOT IN ('PROMOTION','REPEAT','CLASS_CHANGE','SECTION_CHANGE','CAMPUS_TRANSFER')
     OR effective_from IS NULL OR reviewed_override IS NULL OR (reviewed_override AND override_reason IS NULL)
     OR (NOT reviewed_override AND override_reason IS NOT NULL) THEN RAISE EXCEPTION 'D1 Enrollment move stored request malformed'; END IF;
  final_role:=app_private.d1_final_approver_role(p_request_id,ctx.actor_id);
  IF NOT ((ctx.actor_id=req.requester_id AND app_private.d1_enrollment_move_authorized(ctx.actor_id,'student.enrollment.move',source_section,destination_section,NULL))
       OR (final_role IS NOT NULL AND app_private.d1_enrollment_move_authorized(ctx.actor_id,'student.enrollment.approve',source_section,destination_section,final_role)))
    THEN RAISE EXCEPTION 'D1 Enrollment move request unavailable'; END IF;
  -- Successful/invalidated replay occurs before any mutation preflight but still rechecks current requester/reviewer authority.
  IF ctx.receipt_id IS NOT NULL THEN
    IF NOT app_private.d1_enrollment_move_authorized(req.requester_id,'student.enrollment.move',source_section,destination_section,NULL)
       OR (reviewed_override AND NOT app_private.d1_enrollment_move_authorized(req.requester_id,'student.capacity_override',source_section,destination_section,NULL))
      THEN RAISE EXCEPTION 'D1 Enrollment move requester authority revoked'; END IF;
    IF ctx.receipt_state='SUCCEEDED' THEN
      IF app_private.d1_enrollment_move_reviews_live(p_request_id) IS DISTINCT FROM true OR ctx.result_ref IS NULL OR ctx.result_summary IS NULL
         OR ctx.result_summary->>'state'<>'EXECUTED' OR ctx.result_summary->>'request_version' IS NULL
        THEN RAISE EXCEPTION 'D1 Enrollment move apply receipt invalid'; END IF;
      stripped:=ctx.result_summary-'request_version'-'state';
      IF app_private.d1_enrollment_move_result_rows_match(req.target_ref,source_id,source_section,destination_section,entry_kind,effective_from,
          ctx.receipt_id,ctx.result_ref,stripped) IS DISTINCT FROM true
         OR NOT EXISTS (SELECT 1 FROM app_private.approval_applications a WHERE a.request_id=p_request_id AND a.command_receipt_id=ctx.receipt_id
              AND a.operation_id=ctx.operation_id AND a.result_ref=ctx.result_ref)
        THEN RAISE EXCEPTION 'D1 Enrollment move apply replay evidence invalid'; END IF;
      RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,'EXECUTED',ctx.result_ref; RETURN;
    ELSIF ctx.receipt_state='REJECTED' THEN
      IF ctx.result_ref IS NOT NULL OR ctx.result_summary IS NULL OR ctx.result_summary->>'state'<>'INVALIDATED' THEN RAISE EXCEPTION 'D1 Enrollment move invalidation receipt malformed'; END IF;
      RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,'INVALIDATED',NULL::uuid; RETURN;
    ELSE RAISE EXCEPTION 'D1 Enrollment move apply receipt invalid'; END IF;
  END IF;
  IF req.state<>'APPROVED' OR req.row_version<>p_expected_request_version THEN RAISE EXCEPTION 'D1 Enrollment move approved request changed'; END IF;
  SELECT * INTO policy_row FROM app_private.d1_enrollment_move_policy(source_section,destination_section);
  IF policy_row.policy_id IS DISTINCT FROM req.policy_id OR policy_row.route_mode IS DISTINCT FROM 'APPROVAL' THEN invalidation_code:='D1_ENROLLMENT_MOVE_POLICY_STALE';
  ELSIF NOT app_private.d1_enrollment_move_authorized(req.requester_id,'student.enrollment.move',source_section,destination_section,NULL) THEN invalidation_code:='D1_ENROLLMENT_MOVE_REQUESTER_AUTHORITY_STALE';
  ELSIF reviewed_override AND NOT app_private.d1_enrollment_move_authorized(req.requester_id,'student.capacity_override',source_section,destination_section,NULL) THEN invalidation_code:='D1_ENROLLMENT_MOVE_OVERRIDE_AUTHORITY_STALE';
  ELSIF app_private.d1_enrollment_move_reviews_live(p_request_id) IS DISTINCT FROM true THEN invalidation_code:='D1_ENROLLMENT_MOVE_REVIEW_AUTHORITY_STALE'; END IF;
  IF invalidation_code IS NULL THEN SELECT * INTO prelock FROM app_private.d1_enrollment_place_prelock_roll(destination_section,effective_from);
    IF prelock.error_code IS NOT NULL THEN invalidation_code:=prelock.error_code; END IF; END IF;
  IF invalidation_code IS NULL THEN
    SELECT * INTO locked FROM app_private.d1_enrollment_move_lock_context(req.target_ref,req.expected_target_version,source_id,source_section,
      source_effective_from,destination_section,entry_kind,effective_from);
    IF locked.error_code IS NOT NULL THEN invalidation_code:=locked.error_code;
    ELSIF locked.school_id IS DISTINCT FROM prelock.school_id OR locked.destination_class_offering_id IS DISTINCT FROM prelock.class_offering_id THEN invalidation_code:='D1_ENROLLMENT_MOVE_DESTINATION_STALE'; END IF;
  END IF;
  IF invalidation_code IS NULL THEN
    SELECT * INTO cap FROM app_private.d1_enrollment_move_capacity(source_id,locked.destination_class_offering_id,destination_section,effective_from,
      locked.destination_class_capacity,locked.destination_section_capacity);
    IF cap.class_count IS NULL THEN invalidation_code:='D1_ENROLLMENT_MOVE_CAPACITY_UNAVAILABLE';
    ELSE current_override:=cap.class_full OR cap.section_full; IF current_override IS DISTINCT FROM reviewed_override THEN invalidation_code:='D1_ENROLLMENT_MOVE_CAPACITY_CLASSIFICATION_STALE'; END IF; END IF;
  END IF;
  IF invalidation_code IS NOT NULL THEN
    UPDATE app_private.approval_requests SET state='INVALIDATED' WHERE id=p_request_id RETURNING row_version INTO final_version;
    receipt:=app_private.d1_enrollment_move_receipt('request.apply',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,req.expected_target_version,
      p_request_id,p_expected_request_version,'REJECTED',NULL,NULL,pg_catalog.jsonb_build_object('request_version',final_version,'state','INVALIDATED'),invalidation_code);
    SELECT pg_catalog.coalesce(max(t.sequence_number),0)+1 INTO seq FROM app_private.approval_transitions t WHERE t.request_id=p_request_id;
    INSERT INTO app_private.approval_transitions(request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
    VALUES (p_request_id,seq,'APPROVED','INVALIDATED',invalidation_code,receipt,ctx.actor_id);
    PERFORM app_private.d1_enrollment_move_audit(ctx.actor_id,'APPLY',req.target_ref,source_id,NULL,receipt,p_request_id,req.expected_target_version,
      source_section,destination_section,entry_kind,effective_from,reviewed_override,'REJECTED',invalidation_code,corr);
    RETURN QUERY SELECT p_request_id,final_version,'INVALIDATED',NULL::uuid; RETURN;
  END IF;
  IF current_override THEN override_id:=pg_catalog.gen_random_uuid(); END IF;
  SELECT * INTO eff FROM app_private.d1_enrollment_move_effect(ctx.actor_id,req.target_ref,req.expected_target_version,source_id,source_section,
    source_effective_from,destination_section,entry_kind,effective_from,req.reason,cap.class_count,cap.section_count,cap.class_full,cap.section_full);
  IF eff.policy_revision_id IS DISTINCT FROM prelock.policy_revision_id OR eff.roll_mode IS DISTINCT FROM prelock.policy_mode THEN RAISE EXCEPTION 'D1 Enrollment move roll policy changed after protected preflight'; END IF;
  summary:=pg_catalog.jsonb_build_object('enrollment_id',eff.enrollment_id,'source_enrollment_id',source_id,'roll_allocation_id',eff.roll_allocation_id,
    'numeric_value',eff.numeric_value,'roll_mode',eff.roll_mode,'student_version',eff.student_version,'capacity_overridden',current_override,
    'capacity_override_id',override_id,'source_section_offering_id',source_section,'destination_section_offering_id',destination_section,
    'source_class_offering_id',eff.source_class_offering_id,'destination_class_offering_id',eff.destination_class_offering_id,
    'source_campus_id',eff.source_campus_id,'destination_campus_id',eff.destination_campus_id,'source_academic_year_id',eff.source_year_id,
    'destination_academic_year_id',eff.destination_year_id,'entry_kind',entry_kind);
  UPDATE app_private.approval_requests SET state='EXECUTED' WHERE id=p_request_id RETURNING row_version INTO final_version;
  receipt:=app_private.d1_enrollment_move_receipt('request.apply',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,req.expected_target_version,
    p_request_id,p_expected_request_version,'SUCCEEDED','D1_ENROLLMENT_MOVE',eff.enrollment_id,
    summary||pg_catalog.jsonb_build_object('request_version',final_version,'state','EXECUTED'),NULL);
  IF current_override THEN INSERT INTO app_private.enrollment_capacity_overrides(id,enrollment_id,class_overridden,section_overridden,class_limit_at_decision,
    section_limit_at_decision,class_count_at_decision,section_count_at_decision,reason,command_receipt_id,created_by)
    VALUES (override_id,eff.enrollment_id,cap.class_full,cap.section_full,locked.destination_class_capacity,locked.destination_section_capacity,
      cap.class_count,cap.section_count,override_reason,receipt,ctx.actor_id); END IF;
  INSERT INTO app_private.approval_applications(request_id,command_receipt_id,operation_id,applied_target_version,result_ref,created_by)
  VALUES (p_request_id,receipt,ctx.operation_id,eff.student_version,eff.enrollment_id,ctx.actor_id);
  SELECT pg_catalog.coalesce(max(t.sequence_number),0)+1 INTO seq FROM app_private.approval_transitions t WHERE t.request_id=p_request_id;
  INSERT INTO app_private.approval_transitions(request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
  VALUES (p_request_id,seq,'APPROVED','EXECUTED','Enrollment move applied',receipt,ctx.actor_id);
  PERFORM app_private.d1_enrollment_move_audit(ctx.actor_id,'APPLY',req.target_ref,source_id,eff.enrollment_id,receipt,p_request_id,eff.student_version,
    source_section,destination_section,entry_kind,effective_from,current_override,'SUCCEEDED',NULL,corr);
  PERFORM app_private.d1_enrollment_move_events(ctx.actor_id,req.target_ref,source_id,eff.enrollment_id,eff.roll_allocation_id,override_id,receipt,
    source_section,destination_section,eff.source_class_offering_id,eff.destination_class_offering_id,eff.source_campus_id,eff.destination_campus_id,
    eff.source_year_id,eff.destination_year_id,entry_kind,effective_from,eff.numeric_value,eff.policy_revision_id,eff.roll_mode,cap.class_full,cap.section_full,corr);
  RETURN QUERY SELECT p_request_id,final_version,'EXECUTED',eff.enrollment_id;
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;

SET ROLE schoolos_schema_owner;
CREATE FUNCTION app_private.d1_enrollment_move_application_guard()
RETURNS trigger LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE code text; req record; rec record; dest app_private.enrollments%ROWTYPE; src_id uuid; src_section uuid; dst_section uuid; kind text; move_date date; base_summary jsonb;
BEGIN
  SELECT o.code INTO code FROM app_private.operation_contracts o WHERE o.id=NEW.operation_id;
  IF code IS DISTINCT FROM 'student.enrollment.move' THEN RETURN NEW; END IF;
  SELECT q.* INTO req FROM app_private.approval_requests q WHERE q.id=NEW.request_id;
  SELECT r.* INTO rec FROM app_private.command_receipts r WHERE r.id=NEW.command_receipt_id;
  SELECT e.* INTO dest FROM app_private.enrollments e WHERE e.id=NEW.result_ref;
  IF req.id IS NULL OR rec.id IS NULL OR dest.id IS NULL OR req.state<>'EXECUTED' OR req.operation_id IS DISTINCT FROM NEW.operation_id
     OR rec.operation_id IS DISTINCT FROM NEW.operation_id OR rec.request_id IS DISTINCT FROM NEW.request_id OR rec.command_kind<>'request.apply'
     OR rec.state<>'SUCCEEDED' OR rec.result_ref IS DISTINCT FROM NEW.result_ref OR NEW.applied_target_version IS DISTINCT FROM req.expected_target_version
     OR dest.student_id IS DISTINCT FROM req.target_ref OR rec.result_summary IS NULL OR rec.result_summary->>'state'<>'EXECUTED' THEN
    RAISE EXCEPTION 'D1 Enrollment move application evidence invalid'; END IF;
  BEGIN src_id:=NULLIF(req.old_snapshot->>'source_enrollment_id','')::uuid; src_section:=NULLIF(req.old_snapshot->>'source_section_offering_id','')::uuid;
    dst_section:=NULLIF(req.requested_payload->>'destination_section_offering_id','')::uuid; kind:=req.requested_payload->>'entry_kind';
    move_date:=NULLIF(req.requested_payload->>'effective_from','')::date;
  EXCEPTION WHEN invalid_text_representation OR datetime_field_overflow THEN RAISE EXCEPTION 'D1 Enrollment move application evidence malformed'; END;
  base_summary:=rec.result_summary-'request_version'-'state';
  IF app_private.d1_enrollment_move_result_rows_match(req.target_ref,src_id,src_section,dst_section,kind,move_date,rec.id,NEW.result_ref,base_summary) IS DISTINCT FROM true
    THEN RAISE EXCEPTION 'D1 Enrollment move application result binding invalid'; END IF;
  RETURN NEW;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_enrollment_move_application_guard() FROM PUBLIC,anon,authenticated,service_role;
DROP TRIGGER IF EXISTS d1_enrollment_move_application_guard ON app_private.approval_applications;
CREATE TRIGGER d1_enrollment_move_application_guard BEFORE INSERT ON app_private.approval_applications
 FOR EACH ROW EXECUTE FUNCTION app_private.d1_enrollment_move_application_guard();
ALTER FUNCTION app.d1_apply_student_enrollment_move(uuid,bigint,text) OWNER TO schoolos_workflow_executor;
REVOKE ALL ON FUNCTION app.d1_apply_student_enrollment_move(uuid,bigint,text) FROM PUBLIC,anon,service_role;
GRANT EXECUTE ON FUNCTION app.d1_apply_student_enrollment_move(uuid,bigint,text) TO authenticated;
RESET ROLE;
