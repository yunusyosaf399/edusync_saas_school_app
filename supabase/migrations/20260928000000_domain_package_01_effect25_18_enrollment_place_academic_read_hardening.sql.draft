-- Effect 25 final academic read hardening: no Student-owned helper directly reads class/section tables.

GRANT CREATE ON SCHEMA app_private TO schoolos_academic_executor;
SET ROLE schoolos_academic_executor;
CREATE FUNCTION app_private.d1_enrollment_place_class_sections(p_class_offering uuid)
RETURNS TABLE(section_id uuid)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
  SELECT so.id FROM app_private.section_offerings so WHERE so.class_offering_id=p_class_offering ORDER BY so.id;
$body$;
REVOKE ALL ON FUNCTION app_private.d1_enrollment_place_class_sections(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_enrollment_place_class_sections(uuid) TO schoolos_student_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_academic_executor;

GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE OR REPLACE FUNCTION app_private.d1_enrollment_place_capacity(
  p_class_offering uuid,p_section uuid,p_effective_from date
) RETURNS TABLE(class_limit integer,section_limit integer,class_count integer,section_count integer,class_full boolean,section_full boolean)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE d record; cl integer; sl integer; cc integer; sc integer;
BEGIN
  IF p_class_offering IS NULL OR p_section IS NULL OR p_effective_from IS NULL THEN RETURN; END IF;
  SELECT * INTO d FROM app_private.d1_enrollment_place_lock_destination(p_section);
  IF NOT FOUND OR d.class_offering_id IS DISTINCT FROM p_class_offering THEN RETURN; END IF;
  cl:=d.class_capacity; sl:=d.section_capacity;
  WITH class_sections AS MATERIALIZED (
    SELECT x.section_id FROM app_private.d1_enrollment_place_class_sections(p_class_offering) x
  ), breakpoints AS (
    SELECT p_effective_from AS d
    UNION SELECT e.effective_from FROM app_private.enrollments e
      WHERE e.section_offering_id IN (SELECT section_id FROM class_sections)
        AND e.placement_kind='PRIMARY' AND e.effective_from>=p_effective_from
    UNION SELECT e.effective_until FROM app_private.enrollments e
      WHERE e.section_offering_id IN (SELECT section_id FROM class_sections)
        AND e.placement_kind='PRIMARY' AND e.effective_until IS NOT NULL AND e.effective_until>=p_effective_from
  ), counts AS (
    SELECT b.d,
      1+(SELECT count(*) FROM app_private.enrollments e
          WHERE e.section_offering_id IN (SELECT section_id FROM class_sections) AND e.placement_kind='PRIMARY'
            AND e.effective_from<=b.d AND (e.effective_until IS NULL OR b.d<e.effective_until)) AS class_n,
      1+(SELECT count(*) FROM app_private.enrollments e WHERE e.section_offering_id=p_section AND e.placement_kind='PRIMARY'
            AND e.effective_from<=b.d AND (e.effective_until IS NULL OR b.d<e.effective_until)) AS section_n
    FROM breakpoints b WHERE b.d IS NOT NULL
  ) SELECT COALESCE(max(class_n),1)::integer,COALESCE(max(section_n),1)::integer INTO cc,sc FROM counts;
  RETURN QUERY SELECT cl,sl,cc,sc,(cc>cl),(sc>sl);
END $body$;

CREATE OR REPLACE FUNCTION app_private.d1_enrollment_place_allocate_roll(
  p_actor uuid,p_student uuid,p_enrollment uuid,p_school uuid,p_class_offering uuid,p_effective_from date
) RETURNS TABLE(allocation_id uuid,policy_revision_id uuid,numeric_value bigint,origin_allocation_id uuid,policy_mode text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE pol app_private.roll_policy_revisions%ROWTYPE; pol_count bigint; alloc app_private.roll_allocator_states%ROWTYPE;
  prior record; candidate bigint; aid uuid:=pg_catalog.gen_random_uuid(); origin uuid; mode text;
BEGIN
  IF p_actor IS DISTINCT FROM app_private.current_principal_id() OR p_student IS NULL OR p_enrollment IS NULL OR p_school IS NULL
     OR p_class_offering IS NULL OR p_effective_from IS NULL THEN RAISE EXCEPTION 'D1 Enrollment roll intent invalid'; END IF;
  SELECT count(*) INTO pol_count FROM app_private.roll_policy_revisions r WHERE r.school_id=p_school
    AND r.effective_from<=p_effective_from AND (r.effective_until IS NULL OR p_effective_from<r.effective_until);
  IF pol_count<>1 THEN RAISE EXCEPTION 'D1 Enrollment roll policy unavailable'; END IF;
  SELECT * INTO pol FROM app_private.roll_policy_revisions r WHERE r.school_id=p_school
    AND r.effective_from<=p_effective_from AND (r.effective_until IS NULL OR p_effective_from<r.effective_until) FOR UPDATE;
  mode:=pol.mode;
  IF mode NOT IN ('ACADEMIC_CONTEXT','PERSISTENT_STUDENT') THEN RAISE EXCEPTION 'D1 Enrollment roll policy malformed'; END IF;
  IF mode='PERSISTENT_STUDENT' THEN
    SELECT r.id,r.numeric_value,COALESCE(r.origin_allocation_id,r.id) origin_id INTO prior
      FROM app_private.roll_allocations r JOIN app_private.roll_policy_revisions pr ON pr.id=r.policy_revision_id
      WHERE r.student_id=p_student AND pr.school_id=p_school AND pr.mode='PERSISTENT_STUDENT'
        AND NOT EXISTS (SELECT 1 FROM app_private.roll_allocations x WHERE x.student_id=p_student AND x.supersedes_id=r.id)
      ORDER BY r.effective_from DESC,r.created_at DESC,r.id DESC LIMIT 1;
    IF prior.id IS NOT NULL THEN candidate:=prior.numeric_value; origin:=prior.origin_id;
    ELSE
      SELECT * INTO alloc FROM app_private.roll_allocator_states a WHERE a.policy_revision_id=pol.id AND a.class_offering_id IS NULL FOR UPDATE;
      IF NOT FOUND THEN RAISE EXCEPTION 'D1 Enrollment persistent roll allocator unavailable'; END IF;
      candidate:=GREATEST(alloc.next_value,pol.start_value);
      WHILE EXISTS (
        SELECT 1 FROM app_private.roll_allocations r JOIN app_private.roll_policy_revisions pr ON pr.id=r.policy_revision_id
        WHERE pr.school_id=p_school AND pr.mode='PERSISTENT_STUDENT' AND r.numeric_value=candidate AND r.student_id<>p_student
      ) LOOP candidate:=candidate+1; END LOOP;
      UPDATE app_private.roll_allocator_states SET next_value=candidate+1,row_version=row_version+1,updated_at=pg_catalog.statement_timestamp() WHERE id=alloc.id;
    END IF;
  ELSE
    SELECT * INTO alloc FROM app_private.roll_allocator_states a WHERE a.policy_revision_id=pol.id AND a.class_offering_id=p_class_offering FOR UPDATE;
    IF NOT FOUND THEN RAISE EXCEPTION 'D1 Enrollment academic roll allocator unavailable'; END IF;
    candidate:=GREATEST(alloc.next_value,pol.start_value);
    WHILE EXISTS (
      SELECT 1 FROM app_private.roll_allocations r JOIN app_private.enrollments e ON e.id=r.enrollment_id
      WHERE r.policy_revision_id=pol.id AND e.section_offering_id IN (
          SELECT x.section_id FROM app_private.d1_enrollment_place_class_sections(p_class_offering) x)
        AND r.numeric_value=candidate AND p_effective_from<COALESCE(r.effective_until,'infinity'::date)
    ) LOOP candidate:=candidate+1; END LOOP;
    UPDATE app_private.roll_allocator_states SET next_value=candidate+1,row_version=row_version+1,updated_at=pg_catalog.statement_timestamp() WHERE id=alloc.id;
  END IF;
  INSERT INTO app_private.roll_allocations(id,created_by,enrollment_id,student_id,policy_revision_id,numeric_value,effective_from,effective_until,
    origin_allocation_id,supersedes_id,correction_reason)
  VALUES (aid,p_actor,p_enrollment,p_student,pol.id,candidate,p_effective_from,NULL,origin,NULL,NULL);
  IF mode='PERSISTENT_STUDENT' AND origin IS NULL THEN origin:=aid; END IF;
  RETURN QUERY SELECT aid,pol.id,candidate,origin,mode;
END $body$;

CREATE OR REPLACE FUNCTION app_private.d1_enrollment_place_result_matches(
  p_actor uuid,p_student uuid,p_section uuid,p_entry_kind text,p_effective_from date,p_predecessor uuid,
  p_receipt uuid,p_enrollment uuid,p_summary jsonb
) RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE roll_id uuid; status_id uuid; over_cap boolean; summary_enrollment uuid; summary_section uuid; summary_predecessor uuid;
  summary_date date; summary_numeric bigint; summary_version bigint; summary_class uuid; summary_campus uuid; summary_year uuid; target record;
BEGIN
  IF p_actor IS NULL OR p_student IS NULL OR p_section IS NULL OR p_receipt IS NULL OR p_enrollment IS NULL OR p_summary IS NULL
     OR pg_catalog.jsonb_typeof(p_summary)<>'object' OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(p_summary))<>15
     OR NOT (p_summary ?& ARRAY['enrollment_id','roll_allocation_id','numeric_value','roll_mode','student_version','status_transition_id',
       'resulting_status','capacity_overridden','section_offering_id','class_offering_id','campus_id','academic_year_id','entry_kind','effective_from','predecessor_id'])
  THEN RETURN false; END IF;
  BEGIN
    summary_enrollment:=NULLIF(p_summary->>'enrollment_id','')::uuid; roll_id:=NULLIF(p_summary->>'roll_allocation_id','')::uuid;
    status_id:=NULLIF(p_summary->>'status_transition_id','')::uuid; over_cap:=(p_summary->>'capacity_overridden')::boolean;
    summary_section:=NULLIF(p_summary->>'section_offering_id','')::uuid; summary_predecessor:=NULLIF(p_summary->>'predecessor_id','')::uuid;
    summary_date:=(p_summary->>'effective_from')::date; summary_numeric:=(p_summary->>'numeric_value')::bigint;
    summary_version:=(p_summary->>'student_version')::bigint; summary_class:=NULLIF(p_summary->>'class_offering_id','')::uuid;
    summary_campus:=NULLIF(p_summary->>'campus_id','')::uuid; summary_year:=NULLIF(p_summary->>'academic_year_id','')::uuid;
  EXCEPTION WHEN invalid_text_representation OR datetime_field_overflow THEN RETURN false; END;
  IF summary_enrollment IS DISTINCT FROM p_enrollment OR summary_section IS DISTINCT FROM p_section
     OR p_summary->>'entry_kind' IS DISTINCT FROM p_entry_kind OR summary_date IS DISTINCT FROM p_effective_from
     OR summary_predecessor IS DISTINCT FROM p_predecessor OR p_summary->>'roll_mode' NOT IN ('ACADEMIC_CONTEXT','PERSISTENT_STUDENT')
     OR summary_numeric IS NULL OR summary_numeric<0 OR summary_version IS NULL OR summary_version<1 OR over_cap IS NULL THEN RETURN false; END IF;
  SELECT * INTO target FROM app_private.d1_enrollment_place_destination(p_section);
  IF NOT FOUND OR target.class_offering_id IS DISTINCT FROM summary_class OR target.campus_id IS DISTINCT FROM summary_campus
     OR target.academic_year_id IS DISTINCT FROM summary_year THEN RETURN false; END IF;
  IF NOT EXISTS (SELECT 1 FROM app_private.enrollments e WHERE e.id=p_enrollment AND e.student_id=p_student
      AND e.section_offering_id=p_section AND e.entry_kind=p_entry_kind AND e.effective_from=p_effective_from
      AND e.predecessor_id IS NOT DISTINCT FROM p_predecessor) THEN RETURN false; END IF;
  IF roll_id IS NULL OR NOT EXISTS (SELECT 1 FROM app_private.roll_allocations r WHERE r.id=roll_id AND r.enrollment_id=p_enrollment
      AND r.student_id=p_student AND r.numeric_value=summary_numeric) THEN RETURN false; END IF;
  IF over_cap THEN
    IF NOT app_private.d1_enrollment_place_authorized(p_actor,'student.capacity_override',p_section) THEN RETURN false; END IF;
    IF (SELECT count(*) FROM app_private.enrollment_capacity_overrides o WHERE o.enrollment_id=p_enrollment AND o.command_receipt_id=p_receipt)<>1 THEN RETURN false; END IF;
  ELSIF EXISTS (SELECT 1 FROM app_private.enrollment_capacity_overrides o WHERE o.enrollment_id=p_enrollment) THEN RETURN false; END IF;
  IF p_entry_kind='REENROLLMENT' THEN
    IF status_id IS NULL OR p_summary->>'resulting_status'<>'ACTIVE'
       OR NOT EXISTS (SELECT 1 FROM app_private.student_status_transitions t WHERE t.id=status_id AND t.student_id=p_student
         AND t.previous_status IN ('WITHDRAWN','TRANSFERRED') AND t.new_status='ACTIVE' AND t.effective_on=p_effective_from AND t.supersedes_id IS NULL)
    THEN RETURN false; END IF;
  ELSIF status_id IS NOT NULL THEN RETURN false; END IF;
  RETURN true;
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;
