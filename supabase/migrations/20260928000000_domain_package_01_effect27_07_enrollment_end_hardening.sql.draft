REVOKE ALL ON FUNCTION app.d1_submit_student_enrollment_end(uuid,bigint,uuid,uuid,date,date,text,text) FROM PUBLIC,anon,service_role;
GRANT EXECUTE ON FUNCTION app.d1_submit_student_enrollment_end(uuid,bigint,uuid,uuid,date,date,text,text) TO authenticated;
ALTER FUNCTION app.d1_review_student_enrollment_end(uuid,text,bigint,text,text) OWNER TO schoolos_workflow_executor;
REVOKE ALL ON FUNCTION app.d1_review_student_enrollment_end(uuid,text,bigint,text,text) FROM PUBLIC,anon,service_role;
GRANT EXECUTE ON FUNCTION app.d1_review_student_enrollment_end(uuid,text,bigint,text,text) TO authenticated;
