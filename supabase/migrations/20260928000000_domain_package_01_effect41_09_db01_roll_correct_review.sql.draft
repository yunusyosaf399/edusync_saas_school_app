-- DB-01 P1 APPROVAL independent authenticated REVIEW: never mutate a Roll.
-- Migration 10 non-executable draft; only exact immutable request review.
GRANT CREATE ON SCHEMA app_private TO schoolos_evidence_writer;
SET ROLE schoolos_evidence_writer;
CREATE FUNCTION app_private.d1_roll_correct_review_evidence(
 p_actor uuid,p_operation uuid,p_key text,p_hash bytea,p_student uuid,
 p_expected_student_version bigint,p_request uuid,p_expected_request_version bigint,
 p_final_version bigint,p_state text,p_decision text
) RETURNS uuid
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE rid uuid:=pg_catalog.gen_random_uuid();
BEGIN
 IF p_actor IS NULL OR p_actor IS DISTINCT FROM app_private.current_principal_id()
    OR p_operation IS NULL OR p_key IS NULL OR length(btrim(p_key))=0 OR p_hash IS NULL
    OR p_student IS NULL OR p_expected_student_version IS NULL
    OR p_request IS NULL OR p_expected_request_version IS NULL
    OR p_final_version IS NULL OR p_final_version<=p_expected_request_version
    OR p_decision NOT IN ('APPROVE','REJECT')
    OR p_state NOT IN ('PENDING','APPROVED','REJECTED')
 THEN RAISE EXCEPTION 'D1 Roll correction REVIEW evidence invalid'; END IF;
 INSERT INTO app_private.command_receipts(
    id,principal_id,operation_id,command_kind,idempotency_key,
    canonical_payload_hash,canonicalization_version,expected_target_version,
    request_id,expected_request_version,state,result_kind,result_ref,
    result_summary,completed_at,created_by)
 VALUES (rid,p_actor,p_operation,'request.review',p_key,p_hash,1,
    p_expected_student_version,p_request,p_expected_request_version,
    'SUCCEEDED','D1_STUDENT_ROLL_CORRECT_REVIEW',p_request,
    pg_catalog.jsonb_build_object('request_version',p_final_version::text,'state',p_state),
    pg_catalog.statement_timestamp(),p_actor);
 INSERT INTO app_private.audit_events(
    actor_id,actor_kind,outcome,authority_evidence,target_version,event_type,
    target_kind,target_ref,command_receipt_id,approval_request_id,source_kind,
    correlation_id,details,created_by)
 VALUES (p_actor,'INDIVIDUAL','SUCCEEDED',
    pg_catalog.jsonb_build_object('operation','student.roll.correct',
                                    'phase','REVIEW','decision',p_decision),
    p_expected_student_version,'student.roll.correct','STUDENT',p_student,
    rid,p_request,'API',pg_catalog.gen_random_uuid(),
    pg_catalog.jsonb_build_object('request_id',p_request,
       'review_decision',p_decision,'request_version',p_final_version::text),p_actor);
 RETURN rid;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_roll_correct_review_evidence(
 uuid,uuid,text,bytea,uuid,bigint,uuid,bigint,bigint,text,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_roll_correct_review_evidence(
 uuid,uuid,text,bytea,uuid,bigint,uuid,bigint,bigint,text,text)
 TO schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_evidence_writer;

GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE FUNCTION app.d1_review_student_roll_correction(
 p_request_id uuid,p_decision text,p_expected_request_version bigint,
 p_reason text,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint,request_state text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; req record; step_row record; policy_row record; assigned record;
  next_step record; reviewer_role uuid; src uuid; source_enrollment uuid;
  reviewer_count bigint; next_candidates bigint; prior_count bigint;
  final_version bigint; final_state text; evidence uuid;
BEGIN
 IF p_request_id IS NULL OR p_decision NOT IN ('APPROVE','REJECT')
    OR p_expected_request_version IS NULL OR p_expected_request_version<1
    OR p_reason IS NULL OR length(btrim(p_reason))=0
    OR octet_length(p_reason)>2048 OR p_idempotency_key IS NULL
    OR length(p_idempotency_key) NOT BETWEEN 1 AND 200
    OR length(btrim(p_idempotency_key))=0
 THEN RAISE EXCEPTION 'D1 Roll correction REVIEW intent invalid'; END IF;

 SELECT * INTO ctx FROM app_private.d1_roll_correct_command_context(
   'request.review',p_idempotency_key,
   pg_catalog.jsonb_build_array(p_request_id,p_decision,
                                  p_expected_request_version::text,p_reason));
 IF NOT FOUND OR ctx.actor_id IS NULL THEN
   RAISE EXCEPTION 'D1 Roll correction REVIEW Principal invalid'; END IF;
 PERFORM app_private.d1_lock_current_principal(ctx.actor_id);

 SELECT q.* INTO req FROM app_private.approval_requests q
 WHERE q.id=p_request_id AND q.operation_id=ctx.operation_id FOR UPDATE;
 IF NOT FOUND OR req.policy_id IS NULL OR req.old_snapshot IS NULL
    OR req.requester_id IS NULL OR req.target_ref IS NULL OR req.campus_id IS NULL
 THEN RAISE EXCEPTION 'D1 Roll correction REVIEW request missing'; END IF;
 BEGIN
   src:=NULLIF(req.old_snapshot->>'source_section_offering_id','')::uuid;
   source_enrollment:=NULLIF(req.old_snapshot->>'source_enrollment_id','')::uuid;
 EXCEPTION WHEN invalid_text_representation THEN
   RAISE EXCEPTION 'D1 Roll correction REVIEW source malformed'; END;
 IF src IS NULL OR source_enrollment IS NULL
   OR req.old_snapshot->>'student_id' IS DISTINCT FROM req.target_ref::text
 THEN RAISE EXCEPTION 'D1 Roll correction REVIEW source invalid'; END IF;
 SELECT * INTO policy_row FROM app_private.d1_roll_correct_policy(src);
 IF NOT FOUND OR policy_row.policy_id IS DISTINCT FROM req.policy_id
    OR policy_row.route_mode IS DISTINCT FROM 'APPROVAL'
    OR policy_row.campus_id IS DISTINCT FROM req.campus_id
 THEN RAISE EXCEPTION 'D1 Roll correction REVIEW policy changed'; END IF;

 IF ctx.receipt_id IS NOT NULL THEN
   SELECT count(*),min(t.reviewer_role_id::text)::uuid
     INTO prior_count,reviewer_role
   FROM app_private.approval_reviews r
   JOIN app_private.approval_request_steps s ON s.id=r.step_id
   JOIN app_private.approval_step_templates t ON t.id=s.template_id
   JOIN app_private.approval_step_reviewers a
     ON a.id=r.reviewer_assignment_id AND a.step_id=r.step_id
   WHERE s.request_id=p_request_id AND r.reviewer_id=ctx.actor_id
     AND a.reviewer_id=ctx.actor_id AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE'
     AND r.decision=p_decision AND r.reason=p_reason
     AND r.expected_request_version=p_expected_request_version;
   IF prior_count<>1 OR reviewer_role IS NULL
     OR app_private.d1_roll_correct_authorized(
         ctx.actor_id,'student.roll.approve',src,reviewer_role) IS DISTINCT FROM true
     OR ctx.receipt_state IS DISTINCT FROM 'SUCCEEDED'
     OR ctx.result_ref IS DISTINCT FROM p_request_id
     OR ctx.result_summary IS NULL
     OR jsonb_typeof(ctx.result_summary)<>'object'
     OR (SELECT count(*) FROM jsonb_object_keys(ctx.result_summary))<>2
     OR NOT(ctx.result_summary ?& ARRAY['state','request_version'])
     OR ctx.result_summary->>'state' NOT IN ('PENDING','APPROVED','REJECTED')
     OR (ctx.result_summary->>'request_version')::bigint<=p_expected_request_version
   THEN RAISE EXCEPTION 'D1 Roll correction REVIEW immutable replay invalid'; END IF;
   RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,
        ctx.result_summary->>'state';
   RETURN;
 END IF;

 SELECT s.* INTO step_row FROM app_private.approval_request_steps s
   WHERE s.request_id=p_request_id AND s.state='OPEN'
   ORDER BY s.step_number LIMIT 1 FOR UPDATE;
 IF req.state IS DISTINCT FROM 'PENDING'
    OR req.row_version IS DISTINCT FROM p_expected_request_version
    OR step_row.id IS NULL OR step_row.policy_id IS DISTINCT FROM req.policy_id
 THEN RAISE EXCEPTION 'D1 Roll correction REVIEW stale version or step'; END IF;
 SELECT a.id,t.reviewer_role_id INTO assigned
 FROM app_private.approval_step_reviewers a
 JOIN app_private.approval_step_templates t ON t.id=step_row.template_id
 WHERE a.step_id=step_row.id AND a.reviewer_id=ctx.actor_id
   AND a.withdrawn_at IS NULL AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE'
   AND t.policy_id=req.policy_id AND t.required_reviews=1;
 IF NOT FOUND OR assigned.reviewer_role_id IS NULL
   OR app_private.d1_roll_correct_authorized(
      ctx.actor_id,'student.roll.approve',src,assigned.reviewer_role_id)
      IS DISTINCT FROM true
   OR NOT EXISTS (SELECT 1 FROM app_private.d1_roll_correct_reviewer_candidates(
     p_request_id,step_row.id) c WHERE c.candidate_principal_id=ctx.actor_id)
 THEN RAISE EXCEPTION 'D1 Roll correction REVIEW independent authority denied'; END IF;
 -- Recheck the live assignment and permission under Foundation shared and
 -- request/step transaction locks; direct assignment FOR UPDATE is not granted.
 PERFORM 1 FROM app_private.approval_step_reviewers a
   WHERE a.id=assigned.id AND a.step_id=step_row.id AND a.reviewer_id=ctx.actor_id
     AND a.withdrawn_at IS NULL;
 IF NOT FOUND OR app_private.d1_roll_correct_authorized(
     ctx.actor_id,'student.roll.approve',src,assigned.reviewer_role_id)
      IS DISTINCT FROM true
 THEN RAISE EXCEPTION 'D1 Roll correction REVIEW reviewer revoked'; END IF;
 SELECT * INTO policy_row FROM app_private.d1_roll_correct_policy(src);
 IF policy_row.policy_id IS DISTINCT FROM req.policy_id
   OR policy_row.route_mode IS DISTINCT FROM 'APPROVAL'
   OR policy_row.campus_id IS DISTINCT FROM req.campus_id
 THEN RAISE EXCEPTION 'D1 Roll correction REVIEW policy revoked'; END IF;
 INSERT INTO app_private.approval_reviews(
    reviewer_assignment_id,step_id,reviewer_id,decision,reason,
    expected_request_version,created_by)
 VALUES (assigned.id,step_row.id,ctx.actor_id,p_decision,p_reason,
         p_expected_request_version,ctx.actor_id);
 UPDATE app_private.approval_request_steps
   SET state=CASE WHEN p_decision='APPROVE' THEN 'APPROVED' ELSE 'REJECTED' END,
       closed_at=pg_catalog.statement_timestamp()
 WHERE id=step_row.id;
 IF p_decision='REJECT' THEN
   UPDATE app_private.approval_request_steps
     SET state='CANCELLED',closed_at=pg_catalog.statement_timestamp()
   WHERE approval_request_steps.request_id=p_request_id AND state='WAITING';
   final_state:='REJECTED';
   UPDATE app_private.approval_requests SET state=final_state
     WHERE id=p_request_id RETURNING row_version INTO final_version;
 ELSE
   SELECT s.* INTO next_step FROM app_private.approval_request_steps s
     WHERE s.request_id=p_request_id AND s.step_number=step_row.step_number+1
       AND s.state='WAITING' FOR UPDATE;
   IF next_step.id IS NULL THEN
     final_state:='APPROVED';
     UPDATE app_private.approval_requests SET state=final_state
       WHERE id=p_request_id RETURNING row_version INTO final_version;
   ELSE
     UPDATE app_private.approval_request_steps
        SET state='OPEN',opened_at=pg_catalog.statement_timestamp()
       WHERE id=next_step.id;
     INSERT INTO app_private.approval_step_reviewers(
        step_id,reviewer_id,assignment_reason,created_by)
     SELECT next_step.id,c.candidate_principal_id,
       'D1_REVIEWER_ROLE_SCOPE',ctx.actor_id
     FROM app_private.d1_roll_correct_reviewer_candidates(p_request_id,next_step.id) c;
     GET DIAGNOSTICS next_candidates=ROW_COUNT;
     IF next_candidates=0 THEN
       RAISE EXCEPTION 'D1 Roll correction REVIEW next step lacks reviewer'; END IF;
     final_state:='PENDING';
     -- Foundation PENDING->PENDING is an authorized state transition;
     -- its server-owned row-version trigger increments the version exactly once.
     UPDATE app_private.approval_requests SET state='PENDING'
       WHERE id=p_request_id RETURNING row_version INTO final_version;
   END IF;
 END IF;
 evidence:=app_private.d1_roll_correct_review_evidence(
    ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,req.target_ref,
    req.expected_target_version,p_request_id,p_expected_request_version,
    final_version,final_state,p_decision);
 IF evidence IS NULL THEN
   RAISE EXCEPTION 'D1 Roll correction REVIEW receipt absent'; END IF;
 RETURN QUERY SELECT p_request_id,final_version,final_state;
END $body$;
REVOKE ALL ON FUNCTION app.d1_review_student_roll_correction(
 uuid,text,bigint,text,text) FROM PUBLIC,anon,service_role;
GRANT EXECUTE ON FUNCTION app.d1_review_student_roll_correction(
 uuid,text,bigint,text,text) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;
