-- Current Student disclosure classes are separate. A PROFILE grant does not
-- turn the ROSTER endpoint into a history or Restricted Identity endpoint.
CREATE FUNCTION app.d1_read_student_roster(p_student_id uuid)
RETURNS TABLE (
  student_id uuid, display_name text, school_student_id text,
  section_offering_id uuid, roll_number bigint, profile_photo_file_id uuid
)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT s.id, pe.display_name, s.school_student_id,
         e.section_offering_id, ra.numeric_value, s.profile_photo_file_id
    FROM app_private.students s
    JOIN app_private.people pe ON pe.id = s.person_id
    JOIN app_private.enrollments e
      ON e.student_id = s.id AND e.placement_kind = 'PRIMARY'
     AND e.placement_state = 'ACTIVE'
     AND e.effective_from <= CURRENT_DATE
     AND (e.effective_until IS NULL OR CURRENT_DATE < e.effective_until)
    LEFT JOIN app_private.roll_allocations ra
      ON ra.enrollment_id = e.id AND ra.student_id = s.id
     AND ra.effective_from <= CURRENT_DATE
     AND (ra.effective_until IS NULL OR CURRENT_DATE < ra.effective_until)
   WHERE s.id = p_student_id
     AND app_private.d1_authorized('student.roster.view','STUDENT',s.id);
$body$;
REVOKE ALL ON FUNCTION app.d1_read_student_roster(uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_student_roster(uuid) TO authenticated;

CREATE FUNCTION app.d1_read_student_profile(p_student_id uuid)
RETURNS TABLE (
  student_id uuid, display_name text, school_student_id text,
  section_offering_id uuid, roll_number bigint, profile_photo_file_id uuid,
  date_of_birth date, gender_code text, nationality_code text,
  general_contact text, previous_school text
)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT s.id, pe.display_name, s.school_student_id,
         e.section_offering_id, ra.numeric_value,
         s.profile_photo_file_id, s.date_of_birth, s.gender_code,
         s.nationality_code, s.general_contact, s.previous_school
    FROM app_private.students s
    JOIN app_private.people pe ON pe.id = s.person_id
    JOIN app_private.enrollments e
      ON e.student_id = s.id AND e.placement_kind = 'PRIMARY'
     AND e.placement_state = 'ACTIVE'
     AND e.effective_from <= CURRENT_DATE
     AND (e.effective_until IS NULL OR CURRENT_DATE < e.effective_until)
    LEFT JOIN app_private.roll_allocations ra
      ON ra.enrollment_id = e.id AND ra.student_id = s.id
     AND ra.effective_from <= CURRENT_DATE
     AND (ra.effective_until IS NULL OR CURRENT_DATE < ra.effective_until)
   WHERE s.id = p_student_id
     AND app_private.d1_authorized('student.profile.view','STUDENT',s.id);
$body$;
REVOKE ALL ON FUNCTION app.d1_read_student_profile(uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_student_profile(uuid) TO authenticated;

