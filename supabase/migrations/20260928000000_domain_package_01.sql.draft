-- No anon/authenticated/service_role direct D1 table privileges or DML policies are installed.

-- Private fixed-context evaluator. Permission/scope rows are absent until the
-- trusted post-bootstrap registrar runs, so every unregistered code denies.
RESET ROLE;
GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
GRANT EXECUTE ON FUNCTION app_private.current_principal_id()
  TO schoolos_academic_executor, schoolos_student_executor,
     schoolos_family_executor, schoolos_employee_executor,
     schoolos_teaching_executor;
CREATE FUNCTION app_private.d1_authorized(
  wanted_code text, target_kind text, target_id uuid,
  target_subject_id uuid DEFAULT NULL, business_on date DEFAULT NULL
) RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
DECLARE
  actor uuid;
  actor_kind text;
  actor_person uuid;
  at_time timestamptz := pg_catalog.statement_timestamp();
  on_date date;
  target_person uuid;
  target_employee uuid;
  target_student uuid;
  target_section uuid;
  target_class uuid;
  target_campus uuid;
  target_school uuid;
  placement_count integer;
  class_teacher boolean := false;
  subject_teacher boolean := false;
  family_child boolean := false;
  employee_self boolean := false;
  student_self boolean := false;
  teacher_eligible boolean := false;
BEGIN
  actor := app_private.current_principal_id();
  IF actor IS NULL OR target_id IS NULL THEN RETURN false; END IF;
  on_date := COALESCE(business_on, at_time::date);
  SELECT p.kind,p.person_id INTO actor_kind,actor_person
    FROM app_private.principals p WHERE p.id=actor AND p.state='ACTIVE';
  IF actor_kind NOT IN ('INDIVIDUAL','FAMILY') OR actor_kind IS NULL THEN RETURN false; END IF;

  IF target_kind = 'STUDENT' THEN
    SELECT s.person_id INTO target_person FROM app_private.students s WHERE s.id=target_id;
    IF target_person IS NULL THEN RETURN false; END IF;
    target_student := target_id;
    SELECT count(*) INTO placement_count
      FROM app_private.enrollments e
     WHERE e.student_id=target_id AND e.placement_kind='PRIMARY'
       AND e.effective_from<=on_date
       AND (e.effective_until IS NULL OR on_date<e.effective_until);
    IF placement_count>1 THEN RETURN false; END IF;
    IF placement_count=0 AND wanted_code IN
       ('student.roster.view', 'student.profile.view') THEN
      RETURN false;
    END IF;
    IF placement_count=1 THEN
      SELECT e.section_offering_id INTO target_section
        FROM app_private.enrollments e
       WHERE e.student_id=target_id AND e.placement_kind='PRIMARY'
         AND e.effective_from<=on_date
         AND (e.effective_until IS NULL OR on_date<e.effective_until);
    END IF;
    student_self := actor_kind='INDIVIDUAL' AND actor_person=target_person;
  ELSIF target_kind = 'EMPLOYEE' THEN
    SELECT e.person_id INTO target_person FROM app_private.employees e WHERE e.id=target_id;
    IF target_person IS NULL THEN RETURN false; END IF;
    target_employee := target_id;
    employee_self := actor_kind='INDIVIDUAL' AND actor_person=target_person;
  ELSIF target_kind = 'EMPLOYEE_CAMPUS' THEN
    -- The second UUID identifies a stored affiliation target, not a caller
    -- assertion of scope. This row-specific mode prevents a CAMPUS grant for
    -- one affiliation from disclosing a concurrent affiliation elsewhere.
    IF target_subject_id IS NULL THEN RETURN false; END IF;
    SELECT e.person_id INTO target_person FROM app_private.employees e WHERE e.id=target_id;
    IF target_person IS NULL THEN RETURN false; END IF;
    IF NOT EXISTS (
      SELECT 1 FROM app_private.employee_campus_affiliations ca
       WHERE ca.employee_id=target_id AND ca.campus_id=target_subject_id
         AND ca.effective_from<=on_date
         AND (ca.effective_until IS NULL OR on_date<ca.effective_until)
    ) THEN RETURN false; END IF;
    target_employee := target_id;
    target_campus := target_subject_id;
    employee_self := actor_kind='INDIVIDUAL' AND actor_person=target_person;
  ELSIF target_kind = 'CLASS' THEN
    target_class := target_id;
  ELSIF target_kind = 'SECTION' OR target_kind = 'SUBJECT' THEN
    target_section := target_id;
    IF target_kind='SUBJECT' AND target_subject_id IS NULL THEN RETURN false; END IF;
  ELSIF target_kind = 'SCHOOL' THEN
    SELECT id INTO target_school FROM app_private.school_profiles WHERE id=target_id;
    IF target_school IS NULL THEN RETURN false; END IF;
  ELSE
    RETURN false;
  END IF;

  IF target_section IS NOT NULL THEN
    SELECT so.class_offering_id, co.campus_id, co.school_id
      INTO target_class,target_campus,target_school
      FROM app_private.section_offerings so
      JOIN app_private.class_offerings co ON co.id=so.class_offering_id
     WHERE so.id=target_section AND so.campus_id=co.campus_id;
    IF target_class IS NULL THEN RETURN false; END IF;
  ELSIF target_class IS NOT NULL THEN
    SELECT co.campus_id,co.school_id INTO target_campus,target_school
      FROM app_private.class_offerings co WHERE co.id=target_class;
    IF target_campus IS NULL THEN RETURN false; END IF;
  END IF;
  IF target_kind='SUBJECT' AND NOT EXISTS (
    SELECT 1 FROM app_private.subjects s
     WHERE s.id=target_subject_id AND s.school_id=target_school
       AND (s.state='ACTIVE' OR
            (wanted_code='teaching.assignment_history.view' AND s.state='ARCHIVED'))
  ) THEN RETURN false; END IF;

  IF target_student IS NOT NULL AND actor_kind='FAMILY' THEN
    family_child := EXISTS (
      SELECT 1 FROM app_private.family_principal_memberships m
      JOIN app_private.family_student_access a ON a.family_id=m.family_id
      JOIN app_private.family_relationships r ON r.family_id=m.family_id AND r.student_id=a.student_id
     WHERE m.principal_id=actor AND m.principal_kind='FAMILY'
       AND a.student_id=target_student
       AND m.effective_from<=at_time::date AND (m.effective_until IS NULL OR at_time::date<m.effective_until)
       AND a.effective_from<=at_time::date AND (a.effective_until IS NULL OR at_time::date<a.effective_until)
       AND r.effective_from<=at_time::date AND (r.effective_until IS NULL OR at_time::date<r.effective_until)
    );
  END IF;
  IF actor_kind='INDIVIDUAL' AND target_section IS NOT NULL THEN
    SELECT e.id INTO target_employee FROM app_private.employees e
      WHERE e.person_id=actor_person AND e.current_state='ACTIVE';
    IF target_employee IS NOT NULL THEN
      teacher_eligible := EXISTS (
        SELECT 1 FROM app_private.employment_periods ep
        JOIN app_private.teacher_capabilities tc ON tc.employee_id=ep.employee_id
       WHERE ep.employee_id=target_employee AND ep.state='ACTIVE'
         AND ep.effective_from<=at_time::date AND (ep.effective_until IS NULL OR at_time::date<ep.effective_until)
         AND tc.effective_from<=at_time::date AND (tc.effective_until IS NULL OR at_time::date<tc.effective_until)
      );
      IF teacher_eligible THEN
        class_teacher := EXISTS (
          SELECT 1 FROM app_private.class_teacher_assignments ca
           WHERE ca.employee_id=target_employee AND ca.section_offering_id=target_section
             AND ca.effective_from<=at_time::date
             AND (ca.effective_until IS NULL OR at_time::date<ca.effective_until)
        );
        subject_teacher := EXISTS (
          SELECT 1 FROM app_private.subject_teacher_assignments sa
           WHERE sa.employee_id=target_employee AND sa.section_offering_id=target_section
             AND (target_subject_id IS NULL OR sa.subject_id=target_subject_id)
             AND sa.effective_from<=at_time::date
             AND (sa.effective_until IS NULL OR at_time::date<sa.effective_until)
        );
      END IF;
    END IF;
  END IF;

  RETURN EXISTS (
    SELECT 1 FROM app_private.assignment_permission_scopes s
    JOIN app_private.principal_role_assignments a ON a.id=s.assignment_id
    JOIN app_private.role_permission_grants g ON g.id=s.grant_id
    JOIN app_private.permission_scope_contracts c ON c.id=s.scope_contract_id
    JOIN app_private.permissions p ON p.id=s.permission_id
    JOIN app_private.roles r ON r.id=s.role_id
    WHERE a.principal_id=actor AND a.role_id=s.role_id
      AND g.role_id=s.role_id AND g.permission_id=s.permission_id
      AND c.permission_id=s.permission_id AND c.scope_kind=s.scope_kind
      AND c.resolver_key=s.resolver_key AND c.enabled
      AND p.code=wanted_code AND p.state='ENABLED' AND r.state='ACTIVE'
      AND a.valid_from<=at_time AND (a.valid_until IS NULL OR at_time<a.valid_until)
      AND (a.revoked_at IS NULL OR at_time<a.revoked_at)
      AND g.valid_from<=at_time AND (g.valid_until IS NULL OR at_time<g.valid_until)
      AND (g.revoked_at IS NULL OR at_time<g.revoked_at)
      AND s.valid_from<=at_time AND (s.valid_until IS NULL OR at_time<s.valid_until)
      AND (s.revoked_at IS NULL OR at_time<s.revoked_at)
      AND (
        (actor_kind='FAMILY' AND p.family_safe AND s.scope_kind='OWN'
          AND s.resolver_key='D1_FAMILY_CHILD' AND family_child)
        OR (actor_kind<>'FAMILY' AND (
          (s.scope_kind='ALL' AND s.resolver_key='DIRECT'
            AND (target_student IS NULL OR placement_count=1))
          OR (s.scope_kind='CAMPUS' AND s.resolver_key='DIRECT'
            AND target_campus IS NOT NULL AND s.campus_id=target_campus)
          OR (s.scope_kind='CAMPUS' AND s.resolver_key='DIRECT'
            AND target_kind='EMPLOYEE' AND target_employee IS NOT NULL AND EXISTS (
              SELECT 1 FROM app_private.employee_campus_affiliations ca
               WHERE ca.employee_id=target_employee AND ca.campus_id=s.campus_id
                 AND ca.effective_from<=on_date AND (ca.effective_until IS NULL OR on_date<ca.effective_until)))
          OR (s.scope_kind='CLASS' AND s.resolver_key='DIRECT'
            AND target_class IS NOT NULL AND s.class_offering_id=target_class)
          OR (s.scope_kind='SECTION' AND s.resolver_key='DIRECT'
            AND target_section IS NOT NULL AND s.section_offering_id=target_section)
          OR (s.scope_kind='SUBJECT' AND s.resolver_key='DIRECT'
            AND target_subject_id IS NOT NULL AND s.section_offering_id=target_section
            AND s.subject_id=target_subject_id)
          OR (s.scope_kind='OWN' AND s.resolver_key='D1_STUDENT_SELF' AND student_self)
          OR (s.scope_kind='OWN' AND s.resolver_key='D1_EMPLOYEE_SELF' AND employee_self)
          OR (s.scope_kind='ASSIGNED' AND s.resolver_key='D1_CLASS_TEACHER' AND class_teacher)
          OR (s.scope_kind='ASSIGNED' AND s.resolver_key='D1_SUBJECT_TEACHER'
            AND target_subject_id IS NOT NULL AND subject_teacher)
          OR (s.scope_kind='ASSIGNED' AND s.resolver_key='D1_TEACHING_ANY'
            AND (class_teacher OR subject_teacher))
        ))
      )
  );
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_authorized(text,text,uuid,uuid,date)
  FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_authorized(text,text,uuid,uuid,date)
  TO schoolos_read_executor, schoolos_academic_executor, schoolos_student_executor,
     schoolos_family_executor, schoolos_employee_executor, schoolos_teaching_executor;

-- This private selector recognizes only the frozen P1 operation set. An
-- explicit ACTIVE policy row is required. Both zero/multiple matching policies
-- and an invalid APPROVAL step fail closed; absence is never DIRECT. DIRECT
-- never derives from the step count and does not require any step.
CREATE FUNCTION app_private.d1_p1_route(p_operation_code text, p_campus_id uuid)
RETURNS text
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
DECLARE
  at_time timestamptz := pg_catalog.clock_timestamp();
  matches bigint;
  policy_id uuid;
  selected_route text;
  step_count bigint;
  invalid_steps bigint;
  first_step integer;
  last_step integer;
BEGIN
  IF p_operation_code NOT IN (
    'student.roll_policy.change', 'student.roll.correct',
    'student.profile.update', 'student.status.change',
    'student.enrollment.move', 'student.enrollment.end',
    'student.emergency_contact.change', 'family.relationship.change',
    'family.principal_membership.change', 'family.child_access.change',
    'employee.profile.update', 'employee.qualification.change',
    'employee.experience.change', 'employee.state.change',
    'employee.job_assignment.change', 'employee.campus_affiliation.change',
    'teaching.capability.change'
  ) THEN RETURN NULL; END IF;

  SELECT count(*), min(p.id::text)::uuid, min(p.d1_route_mode)
    INTO matches, policy_id, selected_route
    FROM app_private.operation_contracts o
    JOIN app_private.approval_policy_versions p ON p.operation_id = o.id
   WHERE o.code = p_operation_code AND o.enabled AND NOT o.requires_approval
     AND p.state = 'ACTIVE' AND p.effective_from <= at_time
     AND (p.effective_until IS NULL OR at_time < p.effective_until)
     AND (p.campus_id IS NULL OR p.campus_id = p_campus_id);
  IF matches <> 1 OR selected_route IS NULL THEN RETURN NULL; END IF;
  IF selected_route = 'DIRECT' THEN RETURN 'DIRECT'; END IF;
  IF selected_route = 'APPROVAL' THEN
    SELECT count(*),
           count(*) FILTER (WHERE r.id IS NULL OR r.state <> 'ACTIVE'
             OR t.required_reviews <> 1
             OR t.selection_resolver_key IS DISTINCT FROM 'D1_REVIEWER_ROLE_SCOPE'),
           min(t.step_number), max(t.step_number)
      INTO step_count, invalid_steps, first_step, last_step
      FROM app_private.approval_step_templates t
      LEFT JOIN app_private.roles r ON r.id = t.reviewer_role_id
     WHERE t.policy_id = policy_id;
    IF step_count > 0 AND invalid_steps = 0 AND first_step = 1
       AND last_step::bigint = step_count THEN RETURN 'APPROVAL'; END IF;
  END IF;
  RETURN NULL;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_p1_route(text,uuid)
  FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_p1_route(text,uuid)
  TO schoolos_student_executor, schoolos_family_executor,
     schoolos_employee_executor, schoolos_teaching_executor;

-- Only the reviewed key can enumerate candidates. The request and OPEN step
-- supply the operation, policy, target and reviewer-role UUID; no caller may
-- supply a Principal, permission, scope, resolver or target assertion. A
-- target whose fixed operation interpretation is not yet implemented returns
-- no candidates, pending that operation's typed workflow command.
CREATE FUNCTION app_private.d1_review_candidates(
  p_request_id uuid, p_step_id uuid
) RETURNS TABLE (candidate_principal_id uuid)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
DECLARE
  at_time timestamptz := pg_catalog.clock_timestamp();
  ctx record;
  target_kind text;
  target_id uuid;
  target_campus uuid;
  target_class uuid;
  target_section uuid;
  placement_count bigint;
BEGIN
  IF p_request_id IS NULL OR p_step_id IS NULL THEN RETURN; END IF;
  SELECT req.target_ref, req.campus_id, req.requester_id,
         requester.person_id AS requester_person_id,
         op.code AS operation_code, op.requires_approval,
         op.review_permission_id, policy.d1_route_mode,
         template.reviewer_role_id
    INTO ctx
    FROM app_private.approval_requests req
    JOIN app_private.approval_request_steps step
      ON step.request_id = req.id AND step.policy_id = req.policy_id
    JOIN app_private.approval_step_templates template
      ON template.id = step.template_id AND template.policy_id = req.policy_id
    JOIN app_private.approval_policy_versions policy
      ON policy.id = req.policy_id AND policy.operation_id = req.operation_id
    JOIN app_private.operation_contracts op ON op.id = req.operation_id
    JOIN app_private.permissions review_permission
      ON review_permission.id = op.review_permission_id
    JOIN app_private.principals requester ON requester.id = req.requester_id
   WHERE req.id = p_request_id AND step.id = p_step_id
     AND req.state = 'PENDING' AND step.state = 'OPEN'
     AND step.step_number = template.step_number
     AND step.required_reviews = 1 AND template.required_reviews = 1
     AND template.selection_resolver_key = 'D1_REVIEWER_ROLE_SCOPE'
     AND op.contract_version = 1 AND op.enabled
     AND review_permission.state = 'ENABLED'
     AND NOT review_permission.family_safe
     AND requester.kind = 'INDIVIDUAL' AND requester.state = 'ACTIVE'
     AND requester.person_id IS NOT NULL;
  IF NOT FOUND THEN RETURN; END IF;
  IF ctx.target_ref IS NULL THEN RETURN; END IF;

  IF ctx.operation_code IN (
    'student.roll_policy.change', 'student.roll.correct',
    'student.profile.update', 'student.status.change',
    'student.enrollment.move', 'student.enrollment.end',
    'student.emergency_contact.change', 'family.relationship.change',
    'family.principal_membership.change', 'family.child_access.change',
    'employee.profile.update', 'employee.qualification.change',
    'employee.experience.change', 'employee.state.change',
    'employee.job_assignment.change', 'employee.campus_affiliation.change',
    'teaching.capability.change'
  ) THEN
    IF ctx.d1_route_mode IS DISTINCT FROM 'APPROVAL'
       OR ctx.requires_approval THEN RETURN; END IF;
  ELSIF ctx.operation_code IN (
    'student.identity.correct', 'student.special.correct',
    'student.status.correct', 'employee.identity.correct',
    'teaching.class_assignment.change',
    'teaching.subject_assignment.change'
  ) THEN
    IF ctx.d1_route_mode = 'DIRECT' THEN RETURN; END IF;
    IF NOT ctx.requires_approval AND ctx.operation_code NOT IN (
      'teaching.class_assignment.change',
      'teaching.subject_assignment.change') THEN RETURN; END IF;
  ELSE
    RETURN;
  END IF;

  -- The following stored-target interpretations are unambiguous in the
  -- current fixed ledger. Move/reassignment, Family two-sided, roll lineage
  -- and teaching corrections need later typed source/destination validation;
  -- they deliberately resolve nobody here rather than guessing a JSON path.
  IF ctx.operation_code IN (
    'student.profile.update', 'student.status.change'
  ) THEN
    SELECT st.id INTO target_id FROM app_private.students st
     WHERE st.id = ctx.target_ref
       AND (ctx.operation_code <> 'student.profile.update'
            OR st.current_status = 'ACTIVE');
    target_kind := 'STUDENT';
    SELECT count(*) INTO placement_count
      FROM app_private.enrollments e
     WHERE e.student_id = target_id AND e.placement_kind = 'PRIMARY'
       AND e.placement_state = 'ACTIVE'
       AND e.effective_from <= at_time::date
       AND (e.effective_until IS NULL OR at_time::date < e.effective_until);
    IF placement_count <> 1 THEN RETURN; END IF;
    SELECT so.id, co.id, co.campus_id
      INTO target_section, target_class, target_campus
      FROM app_private.enrollments e
      JOIN app_private.section_offerings so ON so.id = e.section_offering_id
      JOIN app_private.class_offerings co ON co.id = so.class_offering_id
     WHERE e.student_id = target_id AND e.placement_kind = 'PRIMARY'
       AND e.placement_state = 'ACTIVE'
       AND e.effective_from <= at_time::date
       AND (e.effective_until IS NULL OR at_time::date < e.effective_until)
       AND so.campus_id = co.campus_id
       AND so.state = 'ACTIVE' AND co.state = 'ACTIVE';
    IF target_section IS NULL OR (ctx.campus_id IS NOT NULL
       AND ctx.campus_id <> target_campus) THEN RETURN; END IF;
  ELSIF ctx.operation_code IN (
    'employee.profile.update'
  ) THEN
    SELECT emp.id INTO target_id FROM app_private.employees emp
     WHERE emp.id = ctx.target_ref AND emp.current_state = 'ACTIVE';
    target_kind := 'EMPLOYEE';
    IF ctx.campus_id IS NOT NULL AND NOT EXISTS (
      SELECT 1 FROM app_private.employee_campus_affiliations ca
       WHERE ca.employee_id = target_id AND ca.campus_id = ctx.campus_id
         AND ca.effective_from <= at_time::date
         AND (ca.effective_until IS NULL OR at_time::date < ca.effective_until)
    ) THEN RETURN; END IF;
  ELSE
    RETURN;
  END IF;
  IF target_id IS NULL THEN RETURN; END IF;

  RETURN QUERY
  SELECT DISTINCT candidate.id
    FROM app_private.principals candidate
    JOIN app_private.principal_role_assignments role_filter
      ON role_filter.principal_id = candidate.id
     AND role_filter.role_id = ctx.reviewer_role_id
    JOIN app_private.roles configured_role
      ON configured_role.id = role_filter.role_id
   WHERE candidate.kind = 'INDIVIDUAL' AND candidate.state = 'ACTIVE'
     AND candidate.person_id IS NOT NULL
     AND candidate.id <> ctx.requester_id
     AND candidate.person_id <> ctx.requester_person_id
     AND configured_role.state = 'ACTIVE' AND NOT configured_role.family_only
     AND role_filter.principal_kind = 'INDIVIDUAL'
     AND role_filter.context_kind = 'INDIVIDUAL'
     AND role_filter.valid_from <= at_time
     AND (role_filter.valid_until IS NULL OR at_time < role_filter.valid_until)
     AND (role_filter.revoked_at IS NULL OR at_time < role_filter.revoked_at)
     AND EXISTS (
       SELECT 1 FROM app_private.principal_auth_bindings binding
        WHERE binding.principal_id = candidate.id
          AND binding.auth_user_id IS NOT NULL
     )
     AND EXISTS (
       SELECT 1
         FROM app_private.assignment_permission_scopes scope
         JOIN app_private.principal_role_assignments assignment
           ON assignment.id = scope.assignment_id
         JOIN app_private.role_permission_grants grant_row
           ON grant_row.id = scope.grant_id
         JOIN app_private.permission_scope_contracts contract
           ON contract.id = scope.scope_contract_id
         JOIN app_private.permissions permission_row
           ON permission_row.id = scope.permission_id
         JOIN app_private.roles grant_role ON grant_role.id = scope.role_id
        WHERE assignment.principal_id = candidate.id
          AND assignment.principal_kind = 'INDIVIDUAL'
          AND assignment.context_kind = 'INDIVIDUAL'
          AND assignment.role_id = scope.role_id
          AND grant_row.role_id = scope.role_id
          AND grant_row.permission_id = scope.permission_id
          AND contract.permission_id = scope.permission_id
          AND contract.scope_kind = scope.scope_kind
          AND contract.resolver_key = scope.resolver_key
          AND contract.enabled
          AND permission_row.id = ctx.review_permission_id
          AND permission_row.state = 'ENABLED'
          AND NOT permission_row.family_safe
          AND grant_role.state = 'ACTIVE'
          AND assignment.valid_from <= at_time
          AND (assignment.valid_until IS NULL OR at_time < assignment.valid_until)
          AND (assignment.revoked_at IS NULL OR at_time < assignment.revoked_at)
          AND grant_row.valid_from <= at_time
          AND (grant_row.valid_until IS NULL OR at_time < grant_row.valid_until)
          AND (grant_row.revoked_at IS NULL OR at_time < grant_row.revoked_at)
          AND scope.valid_from <= at_time
          AND (scope.valid_until IS NULL OR at_time < scope.valid_until)
          AND (scope.revoked_at IS NULL OR at_time < scope.revoked_at)
          AND scope.resolver_key = 'DIRECT'
          AND (
            (scope.scope_kind = 'ALL' AND scope.campus_id IS NULL)
            OR (scope.scope_kind = 'CAMPUS' AND (
              (target_kind = 'STUDENT' AND scope.campus_id = target_campus)
              OR (target_kind = 'EMPLOYEE' AND ctx.campus_id IS NOT NULL
                AND scope.campus_id = ctx.campus_id AND EXISTS (
                SELECT 1 FROM app_private.employee_campus_affiliations ca
                 WHERE ca.employee_id = target_id
                   AND ca.campus_id = scope.campus_id
                   AND ca.effective_from <= at_time::date
                   AND (ca.effective_until IS NULL OR at_time::date < ca.effective_until)
              ))))
            OR (target_kind = 'STUDENT' AND scope.scope_kind = 'CLASS'
                AND scope.class_offering_id = target_class)
            OR (target_kind = 'STUDENT' AND scope.scope_kind = 'SECTION'
                AND scope.section_offering_id = target_section)
          )
     );
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_review_candidates(uuid,uuid)
  FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_review_candidates(uuid,uuid)
  TO schoolos_workflow_executor;

-- A reviewer decision must check the live candidate predicate again. The
-- earlier stored candidate row is evidence of assignment, not enduring
-- authority. The verified request Principal is derived from request claims.
CREATE FUNCTION app_private.d1_current_reviewer_eligible(
  p_request_id uuid, p_step_id uuid
) RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
DECLARE actor uuid;
BEGIN
  actor := app_private.current_principal_id();
  IF actor IS NULL THEN RETURN false; END IF;
  RETURN EXISTS (
    SELECT 1 FROM app_private.d1_review_candidates(p_request_id,p_step_id) c
     WHERE c.candidate_principal_id = actor
  ) AND EXISTS (
    SELECT 1 FROM app_private.approval_step_reviewers assigned
     WHERE assigned.step_id = p_step_id AND assigned.reviewer_id = actor
       AND assigned.withdrawn_at IS NULL
       AND assigned.assignment_reason = 'D1_REVIEWER_ROLE_SCOPE'
       AND assigned.assigned_at <= pg_catalog.statement_timestamp()
  );
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_current_reviewer_eligible(uuid,uuid)
  FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_current_reviewer_eligible(uuid,uuid)
  TO schoolos_workflow_executor;

-- File-service domain gate only. It does not inspect the object/provider,
-- entitlement, stored owner relation, private classification or issue access;
-- the server-controlled file service must perform those independent checks.
CREATE FUNCTION app_private.d1_file_domain_permission(
  p_purpose text, p_action text, p_owner_id uuid
) RETURNS boolean
LANGUAGE sql VOLATILE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT CASE
    WHEN p_action='UPLOAD' AND p_purpose='STUDENT_PROFILE_PHOTO'
      THEN app_private.d1_authorized('student.photo.submit','STUDENT',p_owner_id)
    WHEN p_action='UPLOAD' AND p_purpose='BIRTH_CERTIFICATE'
      THEN app_private.d1_authorized('student.birth_certificate.submit','STUDENT',p_owner_id)
    WHEN p_action='UPLOAD' AND p_purpose='EMPLOYEE_PROFILE_PHOTO'
      THEN app_private.d1_authorized('employee.photo.submit','EMPLOYEE',p_owner_id)
    WHEN p_action='DOWNLOAD' AND p_purpose='STUDENT_PROFILE_PHOTO'
      THEN app_private.d1_authorized('student.roster.view','STUDENT',p_owner_id)
    WHEN p_action='DOWNLOAD' AND p_purpose='BIRTH_CERTIFICATE'
      THEN app_private.d1_authorized('student.restricted_identity.view','STUDENT',p_owner_id)
    WHEN p_action='DOWNLOAD' AND p_purpose='EMPLOYEE_PROFILE_PHOTO'
      THEN app_private.d1_authorized('employee.roster.view','EMPLOYEE',p_owner_id)
        OR app_private.d1_authorized('employee.profile.view','EMPLOYEE',p_owner_id)
    ELSE false
  END;
$body$;
REVOKE ALL ON FUNCTION app_private.d1_file_domain_permission(text,text,uuid)
  FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_file_domain_permission(text,text,uuid)
  TO schoolos_platform_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;

-- Internal first phase for a fixed typed command. It never applies domain
-- state or returns a replay to a client; the calling fixed command must still
-- reauthorize its exact target before returning an existing terminal result.
SET ROLE schoolos_schema_owner;
CREATE FUNCTION app_private.d1_command_receipt_lookup(
  p_operation_code text, p_idempotency_key text, p_intent_hash bytea
) RETURNS TABLE (
  actor_id uuid, operation_id uuid, receipt_id uuid,
  result_ref uuid, result_summary jsonb, receipt_state text
)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
DECLARE
  v_actor uuid;
  v_operation uuid;
  v_digest bytea;
  v_resource bigint;
  v_receipt app_private.command_receipts%ROWTYPE;
BEGIN
  IF pg_catalog.current_setting('transaction_isolation') <> 'read committed' THEN
    RAISE EXCEPTION 'D1 command requires READ COMMITTED';
  END IF;
  IF p_idempotency_key IS NULL OR pg_catalog.char_length(p_idempotency_key) NOT BETWEEN 1 AND 200
     OR p_intent_hash IS NULL OR pg_catalog.octet_length(p_intent_hash) <> 32 THEN
    RAISE EXCEPTION 'D1 command idempotency input invalid';
  END IF;
  PERFORM pg_catalog.pg_advisory_xact_lock_shared(71001,1);
  v_actor := app_private.current_principal_id();
  IF v_actor IS NULL THEN RAISE EXCEPTION 'D1 command requires verified actor'; END IF;
  SELECT o.id INTO v_operation FROM app_private.operation_contracts o
   WHERE o.code = p_operation_code AND o.contract_version = 1
     AND o.handler_key = p_operation_code AND o.enabled;
  IF v_operation IS NULL THEN RAISE EXCEPTION 'D1 operation is not enabled'; END IF;

  -- SHA-256 of the complete tuple supplies a stable signed int32 advisory
  -- resource. Collisions serialize unrelated keys; the full receipt tuple and
  -- canonical intent hash are still compared after the lock.
  v_digest := pg_catalog.sha256(pg_catalog.convert_to(
    v_actor::text || '|' || v_operation::text || '|' || p_idempotency_key, 'UTF8'));
  v_resource := pg_catalog.get_byte(v_digest,0)::bigint * 16777216
              + pg_catalog.get_byte(v_digest,1)::bigint * 65536
              + pg_catalog.get_byte(v_digest,2)::bigint * 256
              + pg_catalog.get_byte(v_digest,3)::bigint;
  IF v_resource > 2147483647 THEN v_resource := v_resource - 4294967296; END IF;
  PERFORM pg_catalog.pg_advisory_xact_lock(71002,v_resource::integer);
  PERFORM 1 FROM app_private.principals p WHERE p.id=v_actor FOR UPDATE;
  IF app_private.current_principal_id() IS DISTINCT FROM v_actor THEN
    RAISE EXCEPTION 'D1 actor changed after command lock';
  END IF;

  SELECT r.* INTO v_receipt FROM app_private.command_receipts r
   WHERE r.principal_id=v_actor AND r.operation_id=v_operation
     AND r.idempotency_key=p_idempotency_key;
  IF FOUND THEN
    IF v_receipt.canonical_payload_hash IS DISTINCT FROM p_intent_hash
       OR v_receipt.command_kind IS DISTINCT FROM p_operation_code THEN
      RAISE EXCEPTION 'D1 idempotency key conflicts with prior intent';
    END IF;
    RETURN QUERY SELECT v_actor,v_operation,v_receipt.id,v_receipt.result_ref,
                        v_receipt.result_summary,v_receipt.state;
  ELSE
    RETURN QUERY SELECT v_actor,v_operation,NULL::uuid,NULL::uuid,NULL::jsonb,NULL::text;
  END IF;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_command_receipt_lookup(text,text,bytea)
  FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_command_receipt_lookup(text,text,bytea)
  TO schoolos_academic_executor, schoolos_student_executor,
     schoolos_family_executor, schoolos_employee_executor,
     schoolos_teaching_executor;
RESET ROLE;

-- D1C1B catalog manifest: 97 permissions, 322 supported alternatives and
-- 36 operation contracts. The trusted bootstrap actor is verified by both
-- frozen UUID and purpose. This function is never invoked by Migration 10.
-- Trusted post-bootstrap registration; this function is not invoked by the migration.
SET ROLE schoolos_schema_owner;
CREATE POLICY d1_bootstrap_actor_lookup ON app_private.principals FOR SELECT TO schoolos_bootstrap_executor USING (true);
CREATE POLICY d1_bootstrap_permission_lookup ON app_private.permissions FOR SELECT TO schoolos_bootstrap_executor USING (true);
CREATE POLICY d1_bootstrap_permission_insert ON app_private.permissions FOR INSERT TO schoolos_bootstrap_executor WITH CHECK (true);
CREATE POLICY d1_bootstrap_scope_lookup ON app_private.permission_scope_contracts FOR SELECT TO schoolos_bootstrap_executor USING (true);
CREATE POLICY d1_bootstrap_scope_insert ON app_private.permission_scope_contracts FOR INSERT TO schoolos_bootstrap_executor WITH CHECK (true);
CREATE POLICY d1_bootstrap_operation_lookup ON app_private.operation_contracts FOR SELECT TO schoolos_bootstrap_executor USING (true);
CREATE POLICY d1_bootstrap_operation_insert ON app_private.operation_contracts FOR INSERT TO schoolos_bootstrap_executor WITH CHECK (true);
GRANT SELECT ON app_private.principals, app_private.permissions, app_private.permission_scope_contracts, app_private.operation_contracts TO schoolos_bootstrap_executor;
GRANT INSERT ON app_private.permissions, app_private.permission_scope_contracts, app_private.operation_contracts TO schoolos_bootstrap_executor;
GRANT CREATE ON SCHEMA app_private TO schoolos_bootstrap_executor;
RESET ROLE;
SET ROLE schoolos_bootstrap_executor;
CREATE FUNCTION app_private.d1_register_catalog_v1() RETURNS void
