  FOR EACH ROW EXECUTE FUNCTION app_private.d1_guard_effective_history('students','student_id','family_id,student_id,relationship_kind,adult_person_id','family_id,student_id,relationship_kind,adult_person_id');
CREATE TRIGGER ab_d1_integrity BEFORE INSERT OR UPDATE ON app_private.family_principal_memberships
  FOR EACH ROW EXECUTE FUNCTION app_private.d1_guard_effective_history('families','family_id','family_id','family_id,principal_id');
CREATE TRIGGER ab_d1_integrity BEFORE INSERT OR UPDATE ON app_private.family_student_access
  FOR EACH ROW EXECUTE FUNCTION app_private.d1_guard_effective_history('students','student_id','family_id,student_id','family_id,student_id');
CREATE TRIGGER ab_d1_integrity BEFORE INSERT OR UPDATE ON app_private.student_primary_family_contexts
  FOR EACH ROW EXECUTE FUNCTION app_private.d1_guard_effective_history('students','student_id','student_id','student_id');
CREATE TRIGGER ab_d1_integrity BEFORE INSERT OR UPDATE ON app_private.student_emergency_contacts
  FOR EACH ROW EXECUTE FUNCTION app_private.d1_guard_effective_history('students','student_id','student_id,person_id','student_id,person_id');
CREATE TRIGGER ab_d1_integrity BEFORE INSERT OR UPDATE ON app_private.employment_periods
  FOR EACH ROW EXECUTE FUNCTION app_private.d1_guard_effective_history('employees','employee_id','employee_id','employee_id');
CREATE TRIGGER ab_d1_integrity BEFORE INSERT OR UPDATE ON app_private.employee_identity_details
  FOR EACH ROW EXECUTE FUNCTION app_private.d1_guard_effective_history('employees','employee_id','employee_id','employee_id');
CREATE TRIGGER ab_d1_integrity BEFORE INSERT OR UPDATE ON app_private.employee_qualifications
  FOR EACH ROW EXECUTE FUNCTION app_private.d1_guard_effective_history('employees','employee_id','employee_id,qualification_record_id','employee_id,qualification_record_id');
CREATE TRIGGER ab_d1_integrity BEFORE INSERT OR UPDATE ON app_private.employee_experience_entries
  FOR EACH ROW EXECUTE FUNCTION app_private.d1_guard_effective_history('employees','employee_id','employee_id,experience_record_id','employee_id,experience_record_id');
CREATE TRIGGER ab_d1_integrity BEFORE INSERT OR UPDATE ON app_private.employee_job_assignments
  FOR EACH ROW EXECUTE FUNCTION app_private.d1_guard_effective_history('employees','employee_id','employee_id,department_id,designation_id','employee_id,department_id,designation_id');
CREATE TRIGGER ab_d1_integrity BEFORE INSERT OR UPDATE ON app_private.employee_campus_affiliations
  FOR EACH ROW EXECUTE FUNCTION app_private.d1_guard_effective_history('employees','employee_id','employee_id,campus_id','employee_id,campus_id');
