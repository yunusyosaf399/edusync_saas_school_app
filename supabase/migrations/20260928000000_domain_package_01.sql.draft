      ('1c7e9f1c-3c82-4d92-8fe5-a0e2cb1c4ec1', 'employee.qualification.approve', 'ALL', 'DIRECT'),
      ('e9e4d41c-d30b-410f-9ddf-2d8bcc89433e', 'employee.qualification.approve', 'CAMPUS', 'DIRECT'),
      ('342c55ea-2157-4162-8a66-bf21dc250651', 'student.emergency_contact.approve', 'ALL', 'DIRECT'),
      ('e621b9db-de51-4498-9f79-da0fe9100856', 'student.emergency_contact.approve', 'CAMPUS', 'DIRECT'),
      ('474fcfeb-ab64-435d-9f81-24f43753a215', 'student.emergency_contact.approve', 'CLASS', 'DIRECT'),
      ('e127ba91-e76b-4124-838e-447342a461c9', 'student.emergency_contact.approve', 'SECTION', 'DIRECT'),
      ('235d3403-c300-4546-bd75-40bf0a2e6c78', 'student.profile.approve', 'ALL', 'DIRECT'),
      ('f51a8626-6eb4-4bb4-9fbd-70a23b1e1467', 'student.profile.approve', 'CAMPUS', 'DIRECT'),
      ('bf2e8152-5c5c-4680-b776-d09d83abcf9f', 'student.profile.approve', 'CLASS', 'DIRECT'),
      ('f3ebcc8b-6d98-4872-a70b-1ccbf8274132', 'student.profile.approve', 'SECTION', 'DIRECT'),
      ('4be995b2-54f5-4f34-8969-995622d2a8d7', 'student.roll.approve', 'ALL', 'DIRECT'),
      ('54baa98a-7e1a-40c6-9b81-2d844825160a', 'student.roll.approve', 'CAMPUS', 'DIRECT'),
      ('890fd49b-0fc2-4b20-aab8-395d0376325c', 'student.roll.approve', 'CLASS', 'DIRECT'),
      ('82ddc9e3-798c-4b32-b8c6-db29f909cb0b', 'student.roll.approve', 'SECTION', 'DIRECT'),
      ('a7c2e5c5-50d5-456d-b1a4-369aaed4abfd', 'student.roll_policy.approve', 'ALL', 'DIRECT'),
      ('bd6b4482-4e24-480b-91a9-e8c13cf3f112', 'teaching.capability.approve', 'ALL', 'DIRECT'),
      ('0301e1bc-99f4-4614-9dc4-efd569ce4845', 'teaching.capability.approve', 'CAMPUS', 'DIRECT')
  ) AS v(id,permission_code,scope_kind,resolver_key) LOOP
    SELECT id INTO pid FROM app_private.permissions WHERE code=item.permission_code;
    IF pid IS NULL THEN RAISE EXCEPTION 'D1 missing permission: %',item.permission_code; END IF;
    SELECT id INTO found_row FROM app_private.permission_scope_contracts
      WHERE permission_id=pid AND scope_kind=item.scope_kind AND resolver_key=item.resolver_key AND contract_version=1;
    IF NOT FOUND THEN
      IF EXISTS(SELECT 1 FROM app_private.permission_scope_contracts WHERE id=item.id::uuid) THEN RAISE EXCEPTION 'D1 scope UUID collision: %',item.permission_code; END IF;
      INSERT INTO app_private.permission_scope_contracts(id,permission_id,scope_kind,resolver_key,contract_version,enabled,created_by)
        VALUES(item.id::uuid,pid,item.scope_kind,item.resolver_key,1,false,actor);
    ELSIF found_row.id<>item.id::uuid THEN
      RAISE EXCEPTION 'D1 scope definition mismatch: %',item.permission_code;
    END IF;
  END LOOP;
  FOR item IN SELECT * FROM (VALUES
      ('e7872b13-7987-43d8-b89a-9e7f4aec073f', 'academic.class.change', 'academic.class.manage', NULL, false),
      ('837e58fd-dc37-4963-9499-bc8c5963fd0e', 'academic.subject.change', 'academic.subject.manage', NULL, false),
      ('34acab4f-596e-428d-a75f-4d87b875f6c2', 'academic.offering.change', 'academic.offering.manage', NULL, false),
