  CONSTRAINT d1_33_fk_03 FOREIGN KEY (supersedes_id) REFERENCES app_private.class_teacher_assignments(id) ON DELETE RESTRICT ON UPDATE RESTRICT
);
ALTER TABLE app_private.class_teacher_assignments ENABLE ROW LEVEL SECURITY;
ALTER TABLE app_private.class_teacher_assignments FORCE ROW LEVEL SECURITY;

-- 34 subject_teacher_assignments (HE)
CREATE TABLE app_private.subject_teacher_assignments (
  id uuid NOT NULL DEFAULT pg_catalog.gen_random_uuid(),
  created_at timestamptz NOT NULL DEFAULT pg_catalog.transaction_timestamp(),
  created_by uuid NOT NULL,
  ended_at timestamptz,
  ended_by uuid,
  section_offering_id uuid NOT NULL,
  subject_id uuid NOT NULL,
  employee_id uuid NOT NULL,
  assignment_kind text NOT NULL,
  effective_from date NOT NULL,
  effective_until date,
  reason text NOT NULL,
  supersedes_id uuid,
  CONSTRAINT d1_34_pkey PRIMARY KEY (id),
  CONSTRAINT d1_34_created_by_fkey FOREIGN KEY (created_by) REFERENCES app_private.principals(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  CONSTRAINT d1_34_ended_by_fkey FOREIGN KEY (ended_by) REFERENCES app_private.principals(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  CONSTRAINT d1_34_fk_01 FOREIGN KEY (section_offering_id) REFERENCES app_private.section_offerings(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  CONSTRAINT d1_34_fk_02 FOREIGN KEY (subject_id) REFERENCES app_private.subjects(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  CONSTRAINT d1_34_fk_03 FOREIGN KEY (employee_id) REFERENCES app_private.employees(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  CONSTRAINT d1_34_fk_04 FOREIGN KEY (supersedes_id) REFERENCES app_private.subject_teacher_assignments(id) ON DELETE RESTRICT ON UPDATE RESTRICT
);
ALTER TABLE app_private.subject_teacher_assignments ENABLE ROW LEVEL SECURITY;
ALTER TABLE app_private.subject_teacher_assignments FORCE ROW LEVEL SECURITY;

