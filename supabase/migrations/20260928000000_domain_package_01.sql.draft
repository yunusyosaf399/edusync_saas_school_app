  CONSTRAINT d1_03_fk_04 FOREIGN KEY (academic_year_id,school_id) REFERENCES app.academic_years(id,school_id) ON DELETE RESTRICT ON UPDATE RESTRICT
);
ALTER TABLE app_private.class_offerings ENABLE ROW LEVEL SECURITY;
ALTER TABLE app_private.class_offerings FORCE ROW LEVEL SECURITY;

