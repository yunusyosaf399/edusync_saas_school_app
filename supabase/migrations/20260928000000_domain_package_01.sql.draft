CREATE FUNCTION app.d1_read_section_room(p_section_id uuid)
RETURNS TABLE (
  room_id uuid, room_code text, room_name text,
  effective_from date, effective_until date
)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT r.id, r.code, r.name, a.effective_from, a.effective_until
    FROM app_private.section_room_assignments a
    JOIN app.rooms r ON r.id = a.room_id
    JOIN app_private.section_offerings s ON s.id = a.section_offering_id
   WHERE a.section_offering_id = p_section_id AND r.campus_id = s.campus_id
     AND a.effective_from <= CURRENT_DATE
     AND (a.effective_until IS NULL OR CURRENT_DATE < a.effective_until)
     AND app_private.d1_authorized('academic.section_room.view','SECTION',s.id);
$body$;
REVOKE ALL ON FUNCTION app.d1_read_section_room(uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_section_room(uuid) TO authenticated;

