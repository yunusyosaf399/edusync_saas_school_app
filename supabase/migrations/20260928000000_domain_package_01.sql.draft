RETURNS TABLE (
  effective_from date, effective_until date, display_name text,
  relationship text, phone text, email text
)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT ec.effective_from, ec.effective_until,
         COALESCE(ec.contact_name, pe.display_name), ec.relationship_label,
         ec.contact_phone, ec.contact_email
    FROM app_private.student_emergency_contacts ec
    LEFT JOIN app_private.people pe ON pe.id = ec.person_id
   WHERE ec.student_id = p_student_id
     AND app_private.d1_authorized('student.emergency_contact_history.view',
                                   'STUDENT',ec.student_id,NULL,ec.effective_from);
$body$;
REVOKE ALL ON FUNCTION app.d1_read_student_emergency_contact_history(uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_student_emergency_contact_history(uuid) TO authenticated;

