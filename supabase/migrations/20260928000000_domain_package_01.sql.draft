-- FAMILY current contact projection contains exactly the four approved fields.
-- The contact row and Person IDs are used internally and never returned.
CREATE FUNCTION app.d1_read_student_emergency_contacts(p_student_id uuid)
RETURNS TABLE (
  display_name text, relationship text, phone text, email text
)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT COALESCE(ec.contact_name, pe.display_name), ec.relationship_label,
         ec.contact_phone, ec.contact_email
    FROM app_private.student_emergency_contacts ec
    LEFT JOIN app_private.people pe ON pe.id = ec.person_id
   WHERE ec.student_id = p_student_id
     AND ec.effective_from <= CURRENT_DATE
     AND (ec.effective_until IS NULL OR CURRENT_DATE < ec.effective_until)
     AND app_private.d1_authorized('student.emergency_contact.view','STUDENT',ec.student_id);
$body$;
REVOKE ALL ON FUNCTION app.d1_read_student_emergency_contacts(uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_student_emergency_contacts(uuid) TO authenticated;

