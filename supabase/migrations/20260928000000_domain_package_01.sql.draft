-- Exact D1B2 row-local CHECK bundles (one per relation).
ALTER TABLE app_private.academic_classes ADD CONSTRAINT d1_01_ck CHECK (
  (length(btrim(code)) > 0)
  AND (length(btrim(label)) > 0)
  AND (display_order >= 0)
  AND ((stage_label IS NULL OR length(btrim(stage_label)) > 0))
  AND (((state = 'ACTIVE' AND archived_at IS NULL AND archived_by IS NULL) OR (state = 'ARCHIVED' AND archived_at IS NOT NULL AND archived_by IS NOT NULL)))
  AND (row_version > 0)
);
ALTER TABLE app_private.subjects ADD CONSTRAINT d1_02_ck CHECK (
  (length(btrim(code)) > 0)
  AND (length(btrim(label)) > 0)
  AND (display_order >= 0)
  AND (((state = 'ACTIVE' AND archived_at IS NULL AND archived_by IS NULL) OR (state = 'ARCHIVED' AND archived_at IS NOT NULL AND archived_by IS NOT NULL)))
  AND (row_version > 0)
);
ALTER TABLE app_private.class_offerings ADD CONSTRAINT d1_03_ck CHECK (
  (capacity >= 0)
  AND (((state IN ('PLANNED','OPEN','CLOSED') AND archived_at IS NULL AND archived_by IS NULL) OR (state = 'ARCHIVED' AND archived_at IS NOT NULL AND archived_by IS NOT NULL)))
  AND (row_version > 0)
);
ALTER TABLE app_private.section_offerings ADD CONSTRAINT d1_04_ck CHECK (
  (length(btrim(code)) > 0)
  AND (length(btrim(label)) > 0)
  AND (display_order >= 0)
  AND (capacity >= 0)
  AND (((state IN ('PLANNED','OPEN','CLOSED') AND archived_at IS NULL AND archived_by IS NULL) OR (state = 'ARCHIVED' AND archived_at IS NOT NULL AND archived_by IS NOT NULL)))
  AND (row_version > 0)
);
ALTER TABLE app_private.section_room_assignments ADD CONSTRAINT d1_05_ck CHECK (
  (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.capacity_revisions ADD CONSTRAINT d1_06_ck CHECK (
  ((class_offering_id IS NULL) <> (section_offering_id IS NULL))
  AND (old_capacity IS NULL OR old_capacity >= 0)
  AND (new_capacity >= 0)
  AND (length(btrim(reason)) > 0)
);
ALTER TABLE app_private.student_id_allocator_states ADD CONSTRAINT d1_07_ck CHECK (
  (next_value > 0)
  AND (row_version > 0)
);
ALTER TABLE app_private.roll_policy_revisions ADD CONSTRAINT d1_08_ck CHECK (
  (revision > 0)
  AND (mode IN ('PERSISTENT_STUDENT','ACADEMIC_CONTEXT'))
  AND (start_value >= 0)
  AND (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.roll_allocator_states ADD CONSTRAINT d1_09_ck CHECK (
  (next_value >= 0)
  AND (row_version > 0)
);
ALTER TABLE app_private.roll_allocations ADD CONSTRAINT d1_10_ck CHECK (
  (numeric_value >= 0)
  AND (supersedes_id IS NULL OR length(btrim(coalesce(correction_reason, ''))) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.students ADD CONSTRAINT d1_11_ck CHECK (
  (length(btrim(school_student_id)) > 0)
  AND (length(btrim(admission_number)) > 0)
  AND (admission_serial >= 0)
  AND (current_status IN ('ACTIVE','SUSPENDED','WITHDRAWN','TRANSFERRED','GRADUATED','EXPELLED','DECEASED','ALUMNI'))
  AND (row_version > 0)
);
ALTER TABLE app_private.student_identity_details ADD CONSTRAINT d1_12_ck CHECK (
  ((national_id IS NULL OR length(btrim(national_id)) > 0))
  AND ((birth_certificate_number IS NULL OR length(btrim(birth_certificate_number)) > 0))
  AND ((private_address IS NULL OR length(btrim(private_address)) > 0))
  AND ((city IS NULL OR length(btrim(city)) > 0))
  AND ((guardian_identity_text IS NULL OR length(btrim(guardian_identity_text)) > 0))
  AND ((guardian_contact IS NULL OR length(btrim(guardian_contact)) > 0))
  AND (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.student_special_details ADD CONSTRAINT d1_13_ck CHECK (
  (blood_group_code IS NULL OR blood_group_code IN ('A_POS','A_NEG','B_POS','B_NEG','AB_POS','AB_NEG','O_POS','O_NEG'))
  AND (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.student_status_transitions ADD CONSTRAINT d1_14_ck CHECK (
  (sequence_number > 0)
  AND ((previous_status IS NULL OR previous_status IN ('ACTIVE','SUSPENDED','WITHDRAWN','TRANSFERRED','GRADUATED','EXPELLED','DECEASED','ALUMNI')))
  AND (new_status IN ('ACTIVE','SUSPENDED','WITHDRAWN','TRANSFERRED','GRADUATED','EXPELLED','DECEASED','ALUMNI'))
  AND (length(btrim(reason)) > 0)
);
ALTER TABLE app_private.enrollments ADD CONSTRAINT d1_15_ck CHECK (
  (placement_kind = 'PRIMARY')
  AND (entry_kind IN ('INITIAL','PROMOTION','REPEAT','CLASS_CHANGE','SECTION_CHANGE','CAMPUS_TRANSFER','REENROLLMENT'))
  AND (((placement_state = 'ACTIVE' AND effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL AND end_reason IS NULL) OR (placement_state IN ('COMPLETED','ENDED') AND effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from AND length(btrim(coalesce(end_reason, ''))) > 0)))
  AND (length(btrim(reason)) > 0)
);
ALTER TABLE app_private.enrollment_capacity_overrides ADD CONSTRAINT d1_16_ck CHECK (
  (class_overridden OR section_overridden)
  AND (class_limit_at_decision >= 0)
  AND (section_limit_at_decision >= 0)
  AND (class_count_at_decision >= 0)
  AND (section_count_at_decision >= 0)
  AND (length(btrim(reason)) > 0)
);
ALTER TABLE app_private.families ADD CONSTRAINT d1_17_ck CHECK (
  (length(btrim(code)) > 0)
  AND (length(btrim(display_label)) > 0)
  AND (((state = 'ACTIVE' AND archived_at IS NULL AND archived_by IS NULL) OR (state = 'ARCHIVED' AND archived_at IS NOT NULL AND archived_by IS NOT NULL)))
  AND (row_version > 0)
);
ALTER TABLE app_private.family_relationships ADD CONSTRAINT d1_18_ck CHECK (
  (relationship_kind IN ('FATHER','MOTHER','GUARDIAN'))
  AND ((adult_person_id IS NOT NULL OR length(btrim(coalesce(display_name, ''))) > 0))
  AND ((display_name IS NULL OR length(btrim(coalesce(display_name, ''))) > 0))
  AND ((relationship_contact IS NULL OR length(btrim(relationship_contact)) > 0))
  AND (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.family_principal_memberships ADD CONSTRAINT d1_19_ck CHECK (
  (principal_kind = 'FAMILY')
  AND (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.family_student_access ADD CONSTRAINT d1_20_ck CHECK (
  (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.student_primary_family_contexts ADD CONSTRAINT d1_21_ck CHECK (
  (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.student_emergency_contacts ADD CONSTRAINT d1_22_ck CHECK (
  (length(btrim(relationship_label)) > 0)
  AND (length(btrim(contact_phone)) > 0)
  AND ((person_id IS NOT NULL OR length(btrim(coalesce(contact_name, ''))) > 0))
  AND ((contact_name IS NULL OR length(btrim(coalesce(contact_name, ''))) > 0))
  AND ((contact_email IS NULL OR length(btrim(contact_email)) > 0))
  AND (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.departments ADD CONSTRAINT d1_23_ck CHECK (
  (length(btrim(code)) > 0)
  AND (length(btrim(label)) > 0)
  AND (((state = 'ACTIVE' AND archived_at IS NULL AND archived_by IS NULL) OR (state = 'ARCHIVED' AND archived_at IS NOT NULL AND archived_by IS NOT NULL)))
  AND (row_version > 0)
);
ALTER TABLE app_private.designations ADD CONSTRAINT d1_24_ck CHECK (
  (length(btrim(code)) > 0)
  AND (length(btrim(label)) > 0)
  AND (((state = 'ACTIVE' AND archived_at IS NULL AND archived_by IS NULL) OR (state = 'ARCHIVED' AND archived_at IS NOT NULL AND archived_by IS NOT NULL)))
  AND (row_version > 0)
);
ALTER TABLE app_private.employees ADD CONSTRAINT d1_25_ck CHECK (
  (length(btrim(employee_code)) > 0)
  AND (current_state IN ('ACTIVE','INACTIVE','ENDED'))
  AND (row_version > 0)
);
ALTER TABLE app_private.employment_periods ADD CONSTRAINT d1_26_ck CHECK (
  (state IN ('ACTIVE','INACTIVE','ENDED'))
  AND (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.employee_identity_details ADD CONSTRAINT d1_27_ck CHECK (
  (((identity_type_code IS NULL AND national_identity_number IS NULL) OR (length(btrim(coalesce(identity_type_code, ''))) > 0 AND length(btrim(coalesce(national_identity_number, ''))) > 0)))
  AND (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.employee_qualifications ADD CONSTRAINT d1_28_ck CHECK (
  (length(btrim(qualification_type)) > 0)
  AND (length(btrim(title)) > 0)
  AND ((institution IS NULL OR length(btrim(institution)) > 0))
  AND ((specialization IS NULL OR length(btrim(specialization)) > 0))
  AND (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.employee_experience_entries ADD CONSTRAINT d1_29_ck CHECK (
  (length(btrim(organization_name)) > 0)
  AND (length(btrim(role_title)) > 0)
  AND ((summary IS NULL OR length(btrim(summary)) > 0))
  AND (ends_on IS NULL OR ends_on >= starts_on)
  AND (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.employee_job_assignments ADD CONSTRAINT d1_30_ck CHECK (
  (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.employee_campus_affiliations ADD CONSTRAINT d1_31_ck CHECK (
  (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.teacher_capabilities ADD CONSTRAINT d1_32_ck CHECK (
  (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.class_teacher_assignments ADD CONSTRAINT d1_33_ck CHECK (
  (length(btrim(reason)) > 0)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);
ALTER TABLE app_private.subject_teacher_assignments ADD CONSTRAINT d1_34_ck CHECK (
  (assignment_kind IN ('PRIMARY','CO_TEACHER','SUBSTITUTE'))
  AND (length(btrim(reason)) > 0)
  AND (assignment_kind <> 'SUBSTITUTE' OR effective_until IS NOT NULL)
  AND (((effective_until IS NULL AND ended_at IS NULL AND ended_by IS NULL) OR (effective_until IS NOT NULL AND ended_at IS NOT NULL AND ended_by IS NOT NULL AND effective_until > effective_from)))
);

-- D1B3A: additive, typed extension of the frozen Foundation scope store.
ALTER TABLE app_private.assignment_permission_scopes
  ADD COLUMN class_offering_id uuid,
  ADD COLUMN section_offering_id uuid,
  ADD COLUMN subject_id uuid;
ALTER TABLE app_private.assignment_permission_scopes
  ADD CONSTRAINT d1_aps_class_offering_fkey FOREIGN KEY (class_offering_id)
    REFERENCES app_private.class_offerings(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  ADD CONSTRAINT d1_aps_section_offering_fkey FOREIGN KEY (section_offering_id)
    REFERENCES app_private.section_offerings(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  ADD CONSTRAINT d1_aps_subject_fkey FOREIGN KEY (subject_id)
    REFERENCES app_private.subjects(id) ON DELETE RESTRICT ON UPDATE RESTRICT;
ALTER TABLE app_private.permission_scope_contracts
  DROP CONSTRAINT permission_scope_contracts_ck_01,
  DROP CONSTRAINT permission_scope_contracts_ck_04,
  ADD CONSTRAINT d1_psc_scope_kind_ck CHECK
    (scope_kind IN ('ALL','CAMPUS','CLASS','SECTION','SUBJECT','OWN','ASSIGNED')),
  ADD CONSTRAINT d1_psc_resolver_class_ck CHECK
    ((scope_kind IN ('ALL','CAMPUS','CLASS','SECTION','SUBJECT')) = (resolver_key = 'DIRECT'));
ALTER TABLE app_private.assignment_permission_scopes
  DROP CONSTRAINT assignment_permission_scopes_ck_01,
  DROP CONSTRAINT assignment_permission_scopes_ck_02,
  ADD CONSTRAINT d1_aps_target_shape_ck CHECK (
    (scope_kind = 'ALL' AND resolver_key = 'DIRECT' AND campus_id IS NULL
      AND class_offering_id IS NULL AND section_offering_id IS NULL AND subject_id IS NULL)
    OR (scope_kind = 'CAMPUS' AND resolver_key = 'DIRECT' AND campus_id IS NOT NULL
      AND class_offering_id IS NULL AND section_offering_id IS NULL AND subject_id IS NULL)
    OR (scope_kind = 'CLASS' AND resolver_key = 'DIRECT' AND campus_id IS NULL
      AND class_offering_id IS NOT NULL AND section_offering_id IS NULL AND subject_id IS NULL)
    OR (scope_kind = 'SECTION' AND resolver_key = 'DIRECT' AND campus_id IS NULL
      AND class_offering_id IS NULL AND section_offering_id IS NOT NULL AND subject_id IS NULL)
    OR (scope_kind = 'SUBJECT' AND resolver_key = 'DIRECT' AND campus_id IS NULL
      AND class_offering_id IS NULL AND section_offering_id IS NOT NULL AND subject_id IS NOT NULL)
    OR (scope_kind IN ('OWN','ASSIGNED') AND resolver_key <> 'DIRECT' AND campus_id IS NULL
      AND class_offering_id IS NULL AND section_offering_id IS NULL AND subject_id IS NULL)
  );
CREATE INDEX d1_aps_class_target_idx ON app_private.assignment_permission_scopes(class_offering_id)
  WHERE class_offering_id IS NOT NULL;
CREATE INDEX d1_aps_section_subject_target_idx ON app_private.assignment_permission_scopes(section_offering_id,subject_id)
  WHERE section_offering_id IS NOT NULL;

CREATE OR REPLACE FUNCTION app_private.guard_assignment_permission_scopes() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
BEGIN
  IF TG_OP = 'INSERT' THEN
    IF NEW.revoked_at IS NOT NULL THEN RAISE EXCEPTION 'new scope cannot start revoked'; END IF;
    RETURN NEW;
  END IF;
  IF OLD.assignment_id IS DISTINCT FROM NEW.assignment_id
     OR OLD.grant_id IS DISTINCT FROM NEW.grant_id
     OR OLD.role_id IS DISTINCT FROM NEW.role_id
     OR OLD.permission_id IS DISTINCT FROM NEW.permission_id
     OR OLD.scope_contract_id IS DISTINCT FROM NEW.scope_contract_id
     OR OLD.scope_kind IS DISTINCT FROM NEW.scope_kind
     OR OLD.resolver_key IS DISTINCT FROM NEW.resolver_key
     OR OLD.campus_id IS DISTINCT FROM NEW.campus_id
     OR OLD.class_offering_id IS DISTINCT FROM NEW.class_offering_id
     OR OLD.section_offering_id IS DISTINCT FROM NEW.section_offering_id
     OR OLD.subject_id IS DISTINCT FROM NEW.subject_id
     OR OLD.valid_from IS DISTINCT FROM NEW.valid_from
     OR OLD.valid_until IS DISTINCT FROM NEW.valid_until
     OR OLD.created_at IS DISTINCT FROM NEW.created_at
     OR OLD.created_by IS DISTINCT FROM NEW.created_by
     OR OLD.id IS DISTINCT FROM NEW.id THEN
    RAISE EXCEPTION 'assignment_permission_scopes: immutable field changed';
  END IF;
  IF OLD.revoked_at IS NOT NULL AND NEW.revoked_at IS DISTINCT FROM OLD.revoked_at THEN
    RAISE EXCEPTION 'assignment scope revocation time cannot change or clear';
  END IF;
  RETURN NEW;
END $body$;

CREATE OR REPLACE FUNCTION app_private.guard_scope_interval() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
DECLARE end_at timestamptz;
BEGIN
  PERFORM pg_catalog.pg_advisory_xact_lock(71001, 1);
  end_at := LEAST(COALESCE(NEW.valid_until, 'infinity'::timestamptz),
                  COALESCE(NEW.revoked_at, 'infinity'::timestamptz));
  IF end_at <= NEW.valid_from THEN RETURN NEW; END IF;
  IF EXISTS (SELECT 1 FROM app_private.assignment_permission_scopes x
      WHERE x.id <> NEW.id AND x.assignment_id = NEW.assignment_id
        AND x.grant_id = NEW.grant_id
        AND x.scope_contract_id = NEW.scope_contract_id
        AND x.campus_id IS NOT DISTINCT FROM NEW.campus_id
        AND x.class_offering_id IS NOT DISTINCT FROM NEW.class_offering_id
        AND x.section_offering_id IS NOT DISTINCT FROM NEW.section_offering_id
        AND x.subject_id IS NOT DISTINCT FROM NEW.subject_id
        AND x.valid_from < end_at
        AND LEAST(COALESCE(x.valid_until,'infinity'::timestamptz),
                  COALESCE(x.revoked_at,'infinity'::timestamptz)) > NEW.valid_from)
  THEN RAISE EXCEPTION 'overlapping permission scope'; END IF;
  RETURN NEW;
END $body$;

CREATE FUNCTION app_private.d1_guard_scope_target() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
BEGIN
  PERFORM pg_catalog.pg_advisory_xact_lock(71001,1);
  IF NEW.scope_kind='CLASS' THEN
    IF NOT EXISTS (SELECT 1 FROM app_private.class_offerings co
                    WHERE co.id=NEW.class_offering_id AND co.state<>'ARCHIVED') THEN
      RAISE EXCEPTION 'invalid D1 CLASS scope target';
    END IF;
  ELSIF NEW.scope_kind IN ('SECTION','SUBJECT') THEN
    IF NOT EXISTS (SELECT 1 FROM app_private.section_offerings so
      JOIN app_private.class_offerings co ON co.id=so.class_offering_id
      WHERE so.id=NEW.section_offering_id AND so.state<>'ARCHIVED'
        AND co.state<>'ARCHIVED' AND so.campus_id=co.campus_id
        AND (NEW.scope_kind='SECTION' OR EXISTS (
          SELECT 1 FROM app_private.subjects su
           WHERE su.id=NEW.subject_id AND su.school_id=co.school_id
             AND su.state='ACTIVE')))
    THEN RAISE EXCEPTION 'invalid D1 SECTION/SUBJECT scope target'; END IF;
  END IF;
  RETURN NEW;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_guard_scope_target() FROM PUBLIC, anon, authenticated, service_role;
CREATE TRIGGER ab_d1_scope_target BEFORE INSERT ON app_private.assignment_permission_scopes
  FOR EACH ROW EXECUTE FUNCTION app_private.d1_guard_scope_target();

-- Defensive provenance/history guards. Entry-point authorization is separate;
-- these guards also reject unsupported privileged fixture writes.
RESET ROLE;
SET ROLE schoolos_authz_reader;
GRANT EXECUTE ON FUNCTION app_private.current_principal_id() TO schoolos_schema_owner;
RESET ROLE;
SET ROLE schoolos_schema_owner;

CREATE FUNCTION app_private.d1_guard_record() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
DECLARE
  actor uuid;
  i integer;
  old_json jsonb;
  new_json jsonb;
BEGIN
  IF TG_OP = 'DELETE' THEN RAISE EXCEPTION 'D1 history and catalog rows cannot be deleted'; END IF;
  actor := app_private.current_principal_id();
  IF actor IS NULL THEN RAISE EXCEPTION 'D1 mutation requires a verified current principal'; END IF;
  IF TG_OP = 'INSERT' THEN
    IF TG_ARGV[0] = 'M' AND pg_catalog.to_jsonb(NEW) ? 'archived_at'
       AND ((pg_catalog.to_jsonb(NEW) ->> 'state') = 'ARCHIVED'
         OR (pg_catalog.to_jsonb(NEW) ->> 'archived_at') IS NOT NULL
         OR (pg_catalog.to_jsonb(NEW) ->> 'archived_by') IS NOT NULL) THEN
      RAISE EXCEPTION 'D1 catalog row cannot start archived';
    END IF;
    NEW.created_by := actor;
    NEW.created_at := pg_catalog.transaction_timestamp();
    IF TG_ARGV[0] = 'M' THEN
      NEW.row_version := 1;
      NEW.updated_at := NEW.created_at;
    ELSIF TG_ARGV[0] = 'HE' AND NEW.effective_until IS NOT NULL THEN
      NEW.ended_at := NEW.created_at;
      NEW.ended_by := actor;
    END IF;
    RETURN NEW;
  END IF;
  old_json := pg_catalog.to_jsonb(OLD);
  new_json := pg_catalog.to_jsonb(NEW);
  IF TG_ARGV[0] = 'H' THEN RAISE EXCEPTION 'D1 retained event is immutable'; END IF;
  IF TG_ARGV[0] = 'HE' THEN
    IF OLD.effective_until IS NOT NULL OR NEW.effective_until IS NULL THEN
      RAISE EXCEPTION 'D1 effective history may be ended exactly once';
    END IF;
    NEW.ended_at := pg_catalog.transaction_timestamp();
    NEW.ended_by := actor;
    IF TG_TABLE_NAME = 'enrollments' THEN
      IF (old_json ->> 'placement_state') <> 'ACTIVE'
         OR (pg_catalog.to_jsonb(NEW) ->> 'placement_state') NOT IN ('COMPLETED','ENDED') THEN
        RAISE EXCEPTION 'D1 enrollment may only complete from ACTIVE';
      END IF;
      old_json := old_json - 'placement_state' - 'end_reason';
      new_json := pg_catalog.to_jsonb(NEW) - 'placement_state' - 'end_reason';
    ELSE
      new_json := pg_catalog.to_jsonb(NEW);
    END IF;
    IF (old_json - 'effective_until' - 'ended_at' - 'ended_by')
       IS DISTINCT FROM (new_json - 'effective_until' - 'ended_at' - 'ended_by') THEN
      RAISE EXCEPTION 'D1 effective history fields are immutable';
    END IF;
    RETURN NEW;
  END IF;
  IF TG_ARGV[0] <> 'M' THEN RAISE EXCEPTION 'unknown D1 record guard class'; END IF;
  IF NEW.id IS DISTINCT FROM OLD.id OR NEW.created_at IS DISTINCT FROM OLD.created_at
     OR NEW.created_by IS DISTINCT FROM OLD.created_by
     OR NEW.row_version IS DISTINCT FROM OLD.row_version
     OR NEW.updated_at IS DISTINCT FROM OLD.updated_at THEN
    RAISE EXCEPTION 'D1 mutable record has a server-owned field change';
  END IF;
  FOR i IN 1..TG_NARGS-1 LOOP
    IF old_json -> TG_ARGV[i] IS DISTINCT FROM new_json -> TG_ARGV[i] THEN
      RAISE EXCEPTION 'D1 immutable field changed: %', TG_ARGV[i];
    END IF;
  END LOOP;
  IF old_json ? 'archived_at' THEN
    IF (old_json ->> 'archived_at') IS NOT NULL
       AND ((old_json -> 'archived_at') IS DISTINCT FROM (new_json -> 'archived_at')
         OR (old_json -> 'archived_by') IS DISTINCT FROM (new_json -> 'archived_by')) THEN
      RAISE EXCEPTION 'D1 archive evidence cannot be changed or cleared';
    END IF;
    IF (old_json ->> 'archived_at') IS NULL AND (new_json ->> 'archived_at') IS NOT NULL THEN
      NEW.archived_at := pg_catalog.transaction_timestamp();
      NEW.archived_by := actor;
    END IF;
  END IF;
  RETURN NEW;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_guard_record() FROM PUBLIC, anon, authenticated, service_role;

