RETURNS TABLE (
  sequence_number bigint, previous_status text, new_status text,
  effective_on date
)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT st.sequence_number, st.previous_status, st.new_status, st.effective_on
    FROM app_private.student_status_transitions st
   WHERE st.student_id = p_student_id
     AND app_private.d1_authorized('student.status_history.view',
                                   'STUDENT',st.student_id,NULL,st.effective_on);
$body$;
REVOKE ALL ON FUNCTION app.d1_read_student_status_history(uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_student_status_history(uuid) TO authenticated;

CREATE FUNCTION app.d1_read_student_placement_history(p_student_id uuid)
RETURNS TABLE (
  enrollment_id uuid, section_offering_id uuid,
  placement_state text, effective_from date, effective_until date,
  roll_number bigint
)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT e.id, e.section_offering_id, e.placement_state,
         e.effective_from, e.effective_until, ra.numeric_value
    FROM app_private.enrollments e
    LEFT JOIN app_private.roll_allocations ra
      ON ra.enrollment_id = e.id AND ra.student_id = e.student_id
     AND ra.effective_from <= e.effective_from
     AND (ra.effective_until IS NULL OR e.effective_from < ra.effective_until)
   WHERE e.student_id = p_student_id AND e.placement_kind = 'PRIMARY'
     AND app_private.d1_authorized('student.placement_history.view',
                                   'STUDENT',e.student_id,NULL,e.effective_from);
$body$;
REVOKE ALL ON FUNCTION app.d1_read_student_placement_history(uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_student_placement_history(uuid) TO authenticated;

-- A FAMILY grant for one child never discloses the other Family records linked
-- to that child. Staff still need the separate complete direct scope chain.
CREATE FUNCTION app.d1_read_family_summary_for_student(p_student_id uuid)
RETURNS TABLE (
  family_id uuid, family_label text, student_id uuid, student_display_name text
)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT DISTINCT f.id, f.display_label, s.id, pe.display_name
    FROM app_private.students s
    JOIN app_private.people pe ON pe.id = s.person_id
    JOIN app_private.family_student_access fa ON fa.student_id = s.id
    JOIN app_private.families f ON f.id = fa.family_id
    JOIN app_private.family_relationships fr
      ON fr.family_id = f.id AND fr.student_id = s.id
   WHERE s.id = p_student_id
     AND fa.effective_from <= CURRENT_DATE
     AND (fa.effective_until IS NULL OR CURRENT_DATE < fa.effective_until)
     AND fr.effective_from <= CURRENT_DATE
     AND (fr.effective_until IS NULL OR CURRENT_DATE < fr.effective_until)
     AND app_private.d1_authorized('family.summary.view','STUDENT',s.id)
     AND EXISTS (
       SELECT 1 FROM app_private.principals actor
        WHERE actor.id = app_private.current_principal_id()
          AND (actor.kind = 'INDIVIDUAL' OR
               (actor.kind = 'FAMILY' AND EXISTS (
                 SELECT 1 FROM app_private.family_principal_memberships fm
                  WHERE fm.principal_id = actor.id AND fm.family_id = f.id
                    AND fm.effective_from <= CURRENT_DATE
                    AND (fm.effective_until IS NULL OR CURRENT_DATE < fm.effective_until)
               )))
     );
$body$;
REVOKE ALL ON FUNCTION app.d1_read_family_summary_for_student(uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_family_summary_for_student(uuid) TO authenticated;

CREATE FUNCTION app.d1_read_family_relationships_for_student(p_student_id uuid)
RETURNS TABLE (
  family_label text, relationship_kind text, adult_display_name text
)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT f.display_label, fr.relationship_kind,
         COALESCE(fr.display_name, pe.display_name)
    FROM app_private.family_relationships fr
    JOIN app_private.families f ON f.id = fr.family_id
    LEFT JOIN app_private.people pe ON pe.id = fr.adult_person_id
   WHERE fr.student_id = p_student_id
     AND fr.effective_from <= CURRENT_DATE
     AND (fr.effective_until IS NULL OR CURRENT_DATE < fr.effective_until)
     AND app_private.d1_authorized('family.relationship.view','STUDENT',fr.student_id)
     AND EXISTS (
       SELECT 1 FROM app_private.principals actor
        WHERE actor.id = app_private.current_principal_id()
          AND (actor.kind = 'INDIVIDUAL' OR
               (actor.kind = 'FAMILY' AND EXISTS (
                 SELECT 1 FROM app_private.family_principal_memberships fm
                  WHERE fm.principal_id = actor.id AND fm.family_id = f.id
                    AND fm.effective_from <= CURRENT_DATE
                    AND (fm.effective_until IS NULL OR CURRENT_DATE < fm.effective_until)
                    AND EXISTS (
                      SELECT 1 FROM app_private.family_student_access fa
                       WHERE fa.family_id=f.id AND fa.student_id=fr.student_id
                         AND fa.effective_from<=CURRENT_DATE
                         AND (fa.effective_until IS NULL OR CURRENT_DATE<fa.effective_until)
                    )
               )))
     );
$body$;
REVOKE ALL ON FUNCTION app.d1_read_family_relationships_for_student(uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_family_relationships_for_student(uuid) TO authenticated;

CREATE FUNCTION app.d1_read_family_relationship_history(p_student_id uuid)
RETURNS TABLE (
  family_label text, relationship_kind text, adult_display_name text,
  effective_from date, effective_until date
)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT f.display_label, fr.relationship_kind,
         COALESCE(fr.display_name, pe.display_name),
         fr.effective_from, fr.effective_until
    FROM app_private.family_relationships fr
    JOIN app_private.families f ON f.id = fr.family_id
    LEFT JOIN app_private.people pe ON pe.id = fr.adult_person_id
   WHERE fr.student_id = p_student_id
     AND app_private.d1_authorized('family.relationship_history.view',
                                   'STUDENT',fr.student_id,NULL,fr.effective_from)
     AND EXISTS (
       SELECT 1 FROM app_private.principals actor
        WHERE actor.id = app_private.current_principal_id()
          AND (actor.kind = 'INDIVIDUAL' OR
               (actor.kind = 'FAMILY' AND EXISTS (
                 SELECT 1 FROM app_private.family_principal_memberships fm
                  WHERE fm.principal_id = actor.id AND fm.family_id = f.id
                    AND fm.effective_from <= CURRENT_DATE
                    AND (fm.effective_until IS NULL OR CURRENT_DATE < fm.effective_until)
                    AND EXISTS (
                      SELECT 1 FROM app_private.family_student_access fa
                       WHERE fa.family_id=f.id AND fa.student_id=fr.student_id
                         AND fa.effective_from<=CURRENT_DATE
                         AND (fa.effective_until IS NULL OR CURRENT_DATE<fa.effective_until)
                    )
                    AND EXISTS (
                      SELECT 1 FROM app_private.family_relationships current_basis
                       WHERE current_basis.family_id=f.id
                         AND current_basis.student_id=fr.student_id
                         AND current_basis.effective_from<=CURRENT_DATE
                         AND (current_basis.effective_until IS NULL OR CURRENT_DATE<current_basis.effective_until)
                    )
               )))
     );
$body$;
REVOKE ALL ON FUNCTION app.d1_read_family_relationship_history(uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_family_relationship_history(uuid) TO authenticated;

