      ('10cdeb24-1e0f-40e2-b55f-d1991c40d137', 'academic.capacity.change', 'academic.capacity.change', NULL, false),
      ('8af65f2a-a5cc-454d-80e2-d1c9168d7c1e', 'student.roll_policy.change', 'student.roll_policy.change', 'student.roll_policy.approve', false),
      ('22e4c10e-23c6-4b15-94e7-08893731e8f6', 'student.roll.correct', 'student.roll.correct', 'student.roll.approve', false),
      ('bcebcc41-e303-4336-8eb6-15caba6c9255', 'student.create', 'student.create', NULL, false),
      ('65f84926-8be0-40be-a6df-96271aa4dd02', 'student.profile.update', 'student.profile.update', 'student.profile.approve', false),
      ('c8c2de83-630f-489e-8719-7cc783bd0463', 'student.identity.correct', 'student.identity.correct', 'student.identity.approve', true),
      ('209f83d3-58f7-4145-8f47-7de56bc0b501', 'student.special.correct', 'student.special.correct', 'student.special.approve', true),
      ('4e8c5b74-32d4-4354-aff7-ffcbd4e7063f', 'student.status.change', 'student.status.change', 'student.status.approve', false),
      ('06305b6d-9f9f-4437-bd90-305b6f38e3b1', 'student.status.correct', 'student.status.correct', 'student.status.approve', true),
      ('33b94093-4813-4709-9d1a-478326e9d3ed', 'student.enrollment.place', 'student.enrollment.place', NULL, false),
      ('15ee679f-4750-4e83-af38-16cf627aa33e', 'student.enrollment.move', 'student.enrollment.move', 'student.enrollment.approve', false),
      ('d4b31095-ed5f-49f3-91f1-27bfdc842460', 'student.enrollment.end', 'student.enrollment.end', 'student.enrollment.approve', false),
      ('d1095aec-d063-45b3-b44c-88f40c9d7a68', 'student.emergency_contact.change', 'student.emergency_contact.change', 'student.emergency_contact.approve', false),
      ('951d8378-4017-438d-88e2-728a77f4adf7', 'family.manage', 'family.manage', NULL, false),
      ('c3c20b95-13fd-4908-9287-315adc5d18f8', 'family.relationship.change', 'family.relationship.change', 'family.access.approve', false),
      ('4701ac82-f9a7-4d7c-9676-1b252a1d3ecc', 'family.principal_membership.change', 'family.principal_membership.change', 'family.access.approve', false),
      ('49b4e651-1a9d-4b57-ba68-7ccb6789ca9d', 'family.child_access.change', 'family.child_access.change', 'family.access.approve', false),
      ('959c7db8-dce4-4261-b830-d9d24a705ad8', 'family.primary_context.change', 'family.primary_context.change', NULL, false),
      ('95b0754a-16fe-4ee9-8f0b-ad48504026c2', 'employee.department.change', 'employee.department.manage', NULL, false),
      ('e9e1deff-36fb-463f-83b2-510d2578a4a7', 'employee.designation.change', 'employee.designation.manage', NULL, false),
      ('9b20dbf8-4f3e-4729-89e9-8cae65be4d14', 'employee.create', 'employee.create', NULL, false),
      ('84cecaa4-fb7a-4f42-bd10-d1c01582e15a', 'employee.profile.update', 'employee.profile.update', 'employee.profile.approve', false),
      ('13a4d87d-cb38-4b95-a6f8-9230f4c2a11e', 'employee.identity.correct', 'employee.identity.correct', 'employee.identity.approve', true),
      ('40f541ab-53e5-48e3-9fa3-b6801bb1fcd1', 'employee.qualification.change', 'employee.qualification.change', 'employee.qualification.approve', false),
      ('c880066a-c5e0-42dd-b20e-f8fd33acc374', 'employee.experience.change', 'employee.experience.change', 'employee.experience.approve', false),
      ('a775a2a6-3d0c-47cb-9ae0-eb0337855842', 'employee.state.change', 'employee.state.change', 'employee.state.approve', false),
      ('97b2a306-572d-4f8f-a435-1cf7661a38cd', 'employee.job_assignment.change', 'employee.job_assignment.change', 'employee.job_assignment.approve', false),
      ('3738831c-3c45-4fd4-a96e-1778abdc2db5', 'employee.campus_affiliation.change', 'employee.campus_affiliation.change', 'employee.campus_affiliation.approve', false),
      ('5b2aff6a-7680-453e-80c3-1e7dfcc93e34', 'teaching.capability.change', 'teaching.capability.change', 'teaching.capability.approve', false),
      ('301dc160-10ec-4829-955b-fc2066bf86f5', 'teaching.class_assignment.change', 'teaching.class_assignment.change', 'teaching.assignment.approve', false),
      ('361a7634-f0da-46c3-8e34-cecd7ef4b5b6', 'teaching.subject_assignment.change', 'teaching.subject_assignment.change', 'teaching.assignment.approve', false)
  ) AS v(id,code,request_code,review_code,requires_approval) LOOP
    SELECT id INTO pid FROM app_private.permissions WHERE code=item.request_code;
    rid:=NULL;
    IF item.review_code IS NOT NULL THEN SELECT id INTO rid FROM app_private.permissions WHERE code=item.review_code; END IF;
    IF pid IS NULL OR (item.review_code IS NOT NULL AND rid IS NULL) THEN RAISE EXCEPTION 'D1 operation permission missing: %',item.code; END IF;
    SELECT id,handler_key,request_permission_id,review_permission_id,payload_schema_version,requires_approval INTO found_row
      FROM app_private.operation_contracts WHERE code=item.code AND contract_version=1;
    IF NOT FOUND THEN
      IF EXISTS(SELECT 1 FROM app_private.operation_contracts WHERE id=item.id::uuid) THEN RAISE EXCEPTION 'D1 operation UUID collision: %',item.code; END IF;
      INSERT INTO app_private.operation_contracts(id,code,contract_version,handler_key,request_permission_id,review_permission_id,payload_schema_version,requires_approval,enabled,created_by)
        VALUES(item.id::uuid,item.code,1,item.code,pid,rid,1,item.requires_approval,false,actor);
    ELSIF found_row.id<>item.id::uuid OR found_row.handler_key<>item.code OR found_row.request_permission_id<>pid
       OR found_row.review_permission_id IS DISTINCT FROM rid OR found_row.payload_schema_version<>1
       OR found_row.requires_approval<>item.requires_approval THEN
      RAISE EXCEPTION 'D1 operation definition mismatch: %',item.code;
    END IF;
  END LOOP;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_register_catalog_v1() FROM PUBLIC, anon, authenticated, service_role;

-- Frozen D1 event vocabulary. Foundation has no event-registry table; this is
-- a private code manifest, not worker activation or an outbox write.
CREATE FUNCTION app_private.d1_event_manifest_v1() RETURNS TABLE(event_type text, schema_version integer)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT v.event_type, 1 FROM (VALUES
    ('academic.class_changed'),
    ('academic.subject_changed'),
    ('academic.offering_changed'),
    ('academic.section_changed'),
    ('academic.section_room_changed'),
    ('academic.capacity_changed'),
    ('student.created'),
    ('student.profile_changed'),
    ('student.identity_corrected'),
    ('student.special_corrected'),
    ('student.status_changed'),
    ('student.emergency_contact_changed'),
    ('enrollment.created'),
    ('enrollment.moved'),
    ('enrollment.ended'),
    ('enrollment.capacity_overridden'),
    ('enrollment.roll_corrected'),
    ('family.changed'),
    ('family.relationship_changed'),
    ('family.principal_link_changed'),
    ('family.child_access_changed'),
    ('family.primary_context_changed'),
    ('employee.created'),
    ('employee.state_changed'),
    ('employee.identity_corrected'),
    ('employee.qualification_changed'),
    ('employee.experience_changed'),
    ('employee.job_changed'),
    ('employee.campus_affiliation_changed'),
    ('teaching.capability_changed'),
    ('teaching.class_assignment_changed'),
    ('teaching.subject_assignment_changed')
  ) AS v(event_type)
$body$;
REVOKE ALL ON FUNCTION app_private.d1_event_manifest_v1() FROM PUBLIC, anon, authenticated, service_role;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_bootstrap_executor;
-- Deployment-only invocation: SET ROLE schoolos_bootstrap_executor; SELECT app_private.d1_register_catalog_v1();
-- All new rows are disabled; registration does not activate role grants or clients.

-- A file FK alone cannot establish the domain-purpose binding. These narrow
-- guards reject a mismatched purpose while leaving upload/download authorization
-- with the existing server-controlled file service.
SET ROLE schoolos_schema_owner;
CREATE FUNCTION app_private.d1_guard_file_purpose() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
DECLARE linked_file uuid; actual_purpose text; file_state text;
BEGIN
  IF TG_TABLE_NAME='students' OR TG_TABLE_NAME='employees' THEN
    linked_file:=NEW.profile_photo_file_id;
  ELSIF TG_TABLE_NAME='student_identity_details' THEN
    linked_file:=NEW.birth_certificate_file_id;
  ELSE
    RAISE EXCEPTION 'unsupported D1 file relationship';
  END IF;
  IF linked_file IS NULL THEN RETURN NEW; END IF;
  SELECT f.purpose_code,f.state INTO actual_purpose,file_state
    FROM app_private.file_objects f WHERE f.id=linked_file;
  IF actual_purpose IS DISTINCT FROM TG_ARGV[0] OR file_state IS DISTINCT FROM 'AVAILABLE' THEN
    RAISE EXCEPTION 'D1 file purpose or availability mismatch';
  END IF;
  RETURN NEW;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_guard_file_purpose() FROM PUBLIC, anon, authenticated, service_role;
CREATE TRIGGER ab_d1_file_purpose BEFORE INSERT OR UPDATE OF profile_photo_file_id
  ON app_private.students FOR EACH ROW
  EXECUTE FUNCTION app_private.d1_guard_file_purpose('STUDENT_PROFILE_PHOTO');
CREATE TRIGGER ab_d1_file_purpose BEFORE INSERT OR UPDATE OF birth_certificate_file_id
  ON app_private.student_identity_details FOR EACH ROW
  EXECUTE FUNCTION app_private.d1_guard_file_purpose('BIRTH_CERTIFICATE');
CREATE TRIGGER ab_d1_file_purpose BEFORE INSERT OR UPDATE OF profile_photo_file_id
  ON app_private.employees FOR EACH ROW
  EXECUTE FUNCTION app_private.d1_guard_file_purpose('EMPLOYEE_PROFILE_PHOTO');
RESET ROLE;

-- Candidate fixed checked reads for the frozen 22 logical read families.
-- Each entry remains subject to independent field-by-field and non-owner
-- security review. The first four are Academic catalog reads; caller inputs
-- are typed target UUIDs and ancestry is resolved from stored rows.
GRANT CREATE ON SCHEMA app TO schoolos_read_executor;
SET ROLE schoolos_read_executor;
CREATE FUNCTION app.d1_read_academic_class(p_class_id uuid)
RETURNS TABLE (
  class_id uuid, class_code text, class_label text, display_order integer,
  stage_label text, class_state text
)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT c.id,c.code,c.label,c.display_order,c.stage_label,c.state
    FROM app_private.academic_classes c
   WHERE c.id=p_class_id
     AND app_private.d1_authorized('academic.class.view','SCHOOL',c.school_id);
$body$;
REVOKE ALL ON FUNCTION app.d1_read_academic_class(uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_academic_class(uuid) TO authenticated;

CREATE FUNCTION app.d1_read_academic_subject(p_subject_id uuid)
RETURNS TABLE (
  subject_id uuid, subject_code text, subject_label text,
