LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT s.id,s.code,s.label,s.display_order,s.state
    FROM app_private.subjects s
   WHERE s.id=p_subject_id
     AND app_private.d1_authorized('academic.subject.view','SCHOOL',s.school_id);
$body$;
REVOKE ALL ON FUNCTION app.d1_read_academic_subject(uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_academic_subject(uuid) TO authenticated;

