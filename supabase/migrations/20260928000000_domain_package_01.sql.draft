-- D1C1A STRUCTURAL/INTEGRITY WORKING DRAFT. NOT AN EXECUTABLE MIGRATION.
-- The D1B3B evaluator, registrar, broad provisional executor policies/grants,
-- and four academic read RPCs below remain exploratory D1C1B material. They
-- are not a final authorization/EXECUTE contract and must not be deployed.
-- Migration-time deployment catalog insertion and SYSTEM principal creation are forbidden.
CREATE ROLE schoolos_academic_executor NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
CREATE ROLE schoolos_student_executor NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
CREATE ROLE schoolos_family_executor NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
CREATE ROLE schoolos_employee_executor NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
CREATE ROLE schoolos_teaching_executor NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
GRANT schoolos_academic_executor, schoolos_student_executor, schoolos_family_executor, schoolos_employee_executor, schoolos_teaching_executor TO postgres;
SET ROLE schoolos_schema_owner;

-- 01 academic_classes (M)
CREATE TABLE app_private.academic_classes (
  id uuid NOT NULL DEFAULT pg_catalog.gen_random_uuid(),
  created_at timestamptz NOT NULL DEFAULT pg_catalog.transaction_timestamp(),
  created_by uuid NOT NULL,
  row_version bigint NOT NULL DEFAULT 1,
  updated_at timestamptz NOT NULL DEFAULT pg_catalog.transaction_timestamp(),
  school_id uuid NOT NULL,
  code text NOT NULL,
  label text NOT NULL,
  display_order integer NOT NULL,
  stage_label text,
  state text NOT NULL DEFAULT 'ACTIVE',
  archived_at timestamptz,
  archived_by uuid,
  CONSTRAINT d1_01_pkey PRIMARY KEY (id),
  CONSTRAINT d1_u01_key UNIQUE (school_id,code),
  CONSTRAINT d1_u02_key UNIQUE (id,school_id),
  CONSTRAINT d1_01_created_by_fkey FOREIGN KEY (created_by) REFERENCES app_private.principals(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  CONSTRAINT d1_01_archived_by_fkey FOREIGN KEY (archived_by) REFERENCES app_private.principals(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  CONSTRAINT d1_01_fk_01 FOREIGN KEY (school_id) REFERENCES app_private.school_profiles(id) ON DELETE RESTRICT ON UPDATE RESTRICT
);
ALTER TABLE app_private.academic_classes ENABLE ROW LEVEL SECURITY;
ALTER TABLE app_private.academic_classes FORCE ROW LEVEL SECURITY;

