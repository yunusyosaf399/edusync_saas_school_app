CREATE FUNCTION app.d1_read_employee_roster(p_employee_id uuid)
RETURNS TABLE (
  employee_id uuid, display_name text, employee_code text,
  current_state text, department_label text, designation_label text,
  profile_photo_file_id uuid
)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT e.id, pe.display_name, e.employee_code, e.current_state,
         d.label, des.label, e.profile_photo_file_id
    FROM app_private.employees e
    JOIN app_private.people pe ON pe.id = e.person_id
    LEFT JOIN app_private.employee_job_assignments ja
      ON ja.employee_id = e.id AND ja.effective_from <= CURRENT_DATE
     AND (ja.effective_until IS NULL OR CURRENT_DATE < ja.effective_until)
    LEFT JOIN app_private.departments d ON d.id = ja.department_id
    LEFT JOIN app_private.designations des ON des.id = ja.designation_id
   WHERE e.id = p_employee_id
     AND app_private.d1_authorized('employee.roster.view','EMPLOYEE',e.id);
$body$;
REVOKE ALL ON FUNCTION app.d1_read_employee_roster(uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_employee_roster(uuid) TO authenticated;

CREATE FUNCTION app.d1_read_employee_profile(p_employee_id uuid)
RETURNS TABLE (
  employee_id uuid, display_name text, employee_code text,
  current_state text, department_label text, designation_label text,
  profile_photo_file_id uuid, employment_effective_from date
)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
  SELECT e.id, pe.display_name, e.employee_code, e.current_state,
         d.label, des.label, e.profile_photo_file_id, ep.effective_from
    FROM app_private.employees e
    JOIN app_private.people pe ON pe.id = e.person_id
    LEFT JOIN app_private.employee_job_assignments ja
      ON ja.employee_id = e.id AND ja.effective_from <= CURRENT_DATE
     AND (ja.effective_until IS NULL OR CURRENT_DATE < ja.effective_until)
    LEFT JOIN app_private.departments d ON d.id = ja.department_id
    LEFT JOIN app_private.designations des ON des.id = ja.designation_id
    LEFT JOIN app_private.employment_periods ep
      ON ep.employee_id = e.id AND ep.effective_from <= CURRENT_DATE
     AND (ep.effective_until IS NULL OR CURRENT_DATE < ep.effective_until)
   WHERE e.id = p_employee_id
     AND app_private.d1_authorized('employee.profile.view','EMPLOYEE',e.id);
$body$;
REVOKE ALL ON FUNCTION app.d1_read_employee_profile(uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_employee_profile(uuid) TO authenticated;

