-- Effect 30 P1 APPROVAL submit path.

GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE FUNCTION app.d1_submit_family_relationship_change(
 p_student_id uuid,p_expected_student_version bigint,p_family_id uuid,p_expected_family_version bigint,
 p_action text,p_source_relationship_id uuid,p_adult_person_id uuid,p_relationship_kind text,p_display_name text,
 p_relationship_contact text,p_effective_on date,p_reason text,p_primary_replacement_relationship_id uuid,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; locks record; policy_row record; pre record; template_row record;
  new_request uuid:=pg_catalog.gen_random_uuid(); first_step uuid; candidate_count bigint; final_version bigint; receipt uuid;
  old_snapshot jsonb; requested jsonb;
BEGIN
  SELECT * INTO ctx FROM app_private.d1_command_receipt_lookup(
    'family.relationship.change','request.submit',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_student_id,p_expected_student_version::text,p_family_id,p_expected_family_version::text,
      p_action,p_source_relationship_id,p_adult_person_id,p_relationship_kind,p_display_name,p_relationship_contact,
      p_effective_on,p_reason,p_primary_replacement_relationship_id));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT * INTO locks FROM app_private.d1_family_relationship_lock_targets(
    p_student_id,p_family_id,p_source_relationship_id,p_adult_person_id,p_primary_replacement_relationship_id);
  IF locks.student_version IS NULL OR locks.family_version IS NULL THEN RAISE EXCEPTION 'D1 Family relationship request target missing'; END IF;
  IF NOT app_private.d1_family_relationship_authorized(ctx.actor_id,'family.relationship.change',p_student_id,NULL) THEN
    RAISE EXCEPTION 'D1 Family relationship request authority denied';
  END IF;
  SELECT * INTO policy_row FROM app_private.d1_family_relationship_policy(p_student_id);
  IF policy_row.policy_id IS NULL OR policy_row.route_mode IS DISTINCT FROM 'APPROVAL' THEN
    RAISE EXCEPTION 'D1 Family relationship policy selects direct command';
  END IF;
  IF ctx.receipt_id IS NOT NULL THEN
    IF ctx.receipt_state<>'SUCCEEDED' OR ctx.result_ref IS NULL OR ctx.result_summary IS NULL
       OR pg_catalog.jsonb_typeof(ctx.result_summary)<>'object'
       OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(ctx.result_summary))<>2
       OR NOT (ctx.result_summary ?& ARRAY['request_version','state'])
       OR ctx.result_summary->>'state'<>'PENDING' THEN
      RAISE EXCEPTION 'D1 Family relationship submit receipt invalid';
    END IF;
    RETURN QUERY SELECT ctx.result_ref,(ctx.result_summary->>'request_version')::bigint; RETURN;
  END IF;
  IF locks.student_version IS DISTINCT FROM p_expected_student_version OR locks.family_version IS DISTINCT FROM p_expected_family_version THEN
    RAISE EXCEPTION 'D1 Family relationship request target version changed';
  END IF;
  SELECT * INTO pre FROM app_private.d1_family_relationship_preflight(
    p_student_id,p_expected_student_version,p_family_id,p_expected_family_version,p_action,p_source_relationship_id,
    p_adult_person_id,p_relationship_kind,p_display_name,p_relationship_contact,p_effective_on,p_reason,p_primary_replacement_relationship_id);
  IF pre.eligible IS DISTINCT FROM true THEN RAISE EXCEPTION 'D1 Family relationship request preflight denied: %',pre.error_code; END IF;

  old_snapshot:=pg_catalog.jsonb_build_object(
    'family_id',p_family_id,'source_relationship_id',p_source_relationship_id);
  requested:=pg_catalog.jsonb_build_object(
    'family_id',p_family_id,'expected_family_version',p_expected_family_version,'action',p_action,
    'source_relationship_id',p_source_relationship_id,'adult_person_id',p_adult_person_id,
    'relationship_kind',p_relationship_kind,'display_name',p_display_name,'relationship_contact',p_relationship_contact,
    'effective_on',p_effective_on,'primary_replacement_relationship_id',p_primary_replacement_relationship_id,
    'replacement_family_id',pre.replacement_family_id);
  INSERT INTO app_private.approval_requests
    (id,operation_id,payload_schema_version,policy_id,requester_id,campus_id,target_ref,
     expected_target_version,reason,old_snapshot,requested_payload,created_by)
  VALUES (new_request,ctx.operation_id,1,policy_row.policy_id,ctx.actor_id,policy_row.campus_id,p_student_id,
    p_expected_student_version,p_reason,old_snapshot,requested,ctx.actor_id);
  UPDATE app_private.approval_requests SET state='SUBMITTED',submitted_at=pg_catalog.statement_timestamp()
    WHERE id=new_request;
  FOR template_row IN
    SELECT t.id,t.step_number,t.required_reviews FROM app_private.approval_step_templates t
      WHERE t.policy_id=policy_row.policy_id ORDER BY t.step_number
  LOOP
    IF template_row.step_number=1 THEN first_step:=pg_catalog.gen_random_uuid(); END IF;
    INSERT INTO app_private.approval_request_steps
      (id,request_id,policy_id,template_id,step_number,required_reviews,created_by)
    VALUES (CASE WHEN template_row.step_number=1 THEN first_step ELSE pg_catalog.gen_random_uuid() END,
      new_request,policy_row.policy_id,template_row.id,template_row.step_number,template_row.required_reviews,ctx.actor_id);
  END LOOP;
  IF first_step IS NULL THEN RAISE EXCEPTION 'D1 Family relationship policy has no first step'; END IF;
  UPDATE app_private.approval_requests SET state='PENDING' WHERE id=new_request RETURNING row_version INTO final_version;
  UPDATE app_private.approval_request_steps SET state='OPEN',opened_at=pg_catalog.statement_timestamp() WHERE id=first_step;
  INSERT INTO app_private.approval_step_reviewers(step_id,reviewer_id,assignment_reason,created_by)
  SELECT first_step,c.candidate_principal_id,'D1_REVIEWER_ROLE_SCOPE',ctx.actor_id
    FROM app_private.d1_family_relationship_candidates(new_request,first_step) c;
  GET DIAGNOSTICS candidate_count=ROW_COUNT;
  IF candidate_count=0 THEN RAISE EXCEPTION 'D1 Family relationship step has no reviewer'; END IF;
  receipt:=app_private.d1_family_relationship_receipt(
    'request.submit',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,p_expected_student_version,
    new_request,NULL,'SUCCEEDED','D1_FAMILY_RELATIONSHIP_REQUEST',new_request,
    pg_catalog.jsonb_build_object('request_version',final_version,'state','PENDING'),NULL);
  PERFORM app_private.d1_family_relationship_audit(
    ctx.actor_id,'SUBMIT',p_student_id,p_family_id,p_source_relationship_id,p_source_relationship_id,p_action,receipt,new_request,
    p_expected_student_version,p_expected_family_version,'SUCCEEDED',NULL,pg_catalog.gen_random_uuid());
  RETURN QUERY SELECT new_request,final_version;
END $body$;
REVOKE ALL ON FUNCTION app.d1_submit_family_relationship_change(uuid,bigint,uuid,bigint,text,uuid,uuid,text,text,text,date,text,uuid,text)
  FROM PUBLIC,anon,service_role;
GRANT EXECUTE ON FUNCTION app.d1_submit_family_relationship_change(uuid,bigint,uuid,bigint,text,uuid,uuid,text,text,text,date,text,uuid,text)
  TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;
