-- P1 approval review. Current policy and operation binding are rechecked on every review and replay.
CREATE FUNCTION app.d1_review_employee_qualification_request(
  p_request_id uuid,p_decision text,p_expected_request_version bigint,p_reason text,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint,request_state text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; req record; step_row record; next_step record; policy_row record;
  assignment_id uuid; n bigint; candidate_count bigint; final_version bigint;
  final_state text; receipt uuid; reviewer_role uuid; action text;
BEGIN
  IF p_request_id IS NULL OR p_decision NOT IN ('APPROVE','REJECT')
     OR p_expected_request_version IS NULL OR p_expected_request_version<1
     OR p_reason IS NULL OR pg_catalog.length(pg_catalog.btrim(p_reason))=0
  THEN RAISE EXCEPTION 'D1 Employee qualification review intent invalid'; END IF;
  SELECT * INTO ctx FROM app_private.d1_employee_qualification_command_context('request.review',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_request_id,p_decision,p_expected_request_version::text,p_reason));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT q.* INTO req FROM app_private.approval_requests q
   WHERE q.id=p_request_id AND q.operation_id=ctx.operation_id FOR UPDATE;
  IF NOT FOUND OR req.expected_target_version IS NULL OR req.policy_id IS NULL THEN
    RAISE EXCEPTION 'D1 Employee qualification request missing'; END IF;
  action:=req.requested_payload->>'action';
  IF action NOT IN ('ADD','CORRECT','ARCHIVE') THEN
    RAISE EXCEPTION 'D1 Employee qualification request payload malformed'; END IF;
  SELECT * INTO policy_row FROM app_private.d1_employee_qualification_policy(req.target_ref);
  IF policy_row.policy_id IS DISTINCT FROM req.policy_id OR policy_row.route_mode IS DISTINCT FROM 'APPROVAL' THEN
    RAISE EXCEPTION 'D1 Employee qualification request policy no longer applies'; END IF;
  IF ctx.receipt_id IS NOT NULL THEN
    SELECT count(*),min(t.reviewer_role_id::text)::uuid INTO n,reviewer_role
      FROM app_private.approval_reviews v
      JOIN app_private.approval_request_steps s ON s.id=v.step_id
      JOIN app_private.approval_step_templates t ON t.id=s.template_id
     WHERE s.request_id=p_request_id AND v.reviewer_id=ctx.actor_id
       AND v.decision=p_decision AND v.expected_request_version=p_expected_request_version;
    IF n<>1 OR reviewer_role IS NULL OR NOT app_private.d1_employee_qualification_authorized(
        ctx.actor_id,'employee.qualification.approve',req.target_ref,reviewer_role) THEN
      RAISE EXCEPTION 'D1 Employee qualification reviewer authority revoked'; END IF;
    IF ctx.receipt_state<>'SUCCEEDED' OR ctx.result_ref IS DISTINCT FROM p_request_id
       OR ctx.result_summary IS NULL OR pg_catalog.jsonb_typeof(ctx.result_summary)<>'object'
       OR NOT (ctx.result_summary ?& ARRAY['request_version','state']) THEN
      RAISE EXCEPTION 'D1 Employee qualification review receipt invalid'; END IF;
    RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,ctx.result_summary->>'state'; RETURN;
  END IF;
  SELECT s.* INTO step_row FROM app_private.approval_request_steps s
   WHERE s.request_id=p_request_id AND s.state='OPEN' ORDER BY s.step_number LIMIT 1 FOR UPDATE;
  IF req.state<>'PENDING' OR req.row_version<>p_expected_request_version OR step_row.id IS NULL THEN
    RAISE EXCEPTION 'D1 Employee qualification review state changed'; END IF;
  SELECT count(*),min(a.id::text)::uuid INTO n,assignment_id
    FROM app_private.approval_step_reviewers a
   WHERE a.step_id=step_row.id AND a.reviewer_id=ctx.actor_id
     AND a.withdrawn_at IS NULL AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
  IF n<>1 OR NOT EXISTS (SELECT 1 FROM app_private.d1_employee_qualification_candidates(
      p_request_id,step_row.id) c WHERE c.candidate_principal_id=ctx.actor_id) THEN
    RAISE EXCEPTION 'D1 Employee qualification reviewer authority denied'; END IF;
  INSERT INTO app_private.approval_reviews
    (reviewer_assignment_id,step_id,reviewer_id,decision,reason,expected_request_version,created_by)
  VALUES (assignment_id,step_row.id,ctx.actor_id,p_decision,p_reason,p_expected_request_version,ctx.actor_id);
  UPDATE app_private.approval_request_steps SET
    state=CASE p_decision WHEN 'APPROVE' THEN 'APPROVED' ELSE 'REJECTED' END,
    closed_at=pg_catalog.statement_timestamp() WHERE id=step_row.id;
  IF p_decision='REJECT' THEN
    UPDATE app_private.approval_request_steps SET state='CANCELLED',closed_at=pg_catalog.statement_timestamp()
     WHERE request_id=p_request_id AND state='WAITING';
    final_state:='REJECTED';
    UPDATE app_private.approval_requests SET state='REJECTED',decided_at=pg_catalog.statement_timestamp()
     WHERE id=p_request_id RETURNING row_version INTO final_version;
  ELSE
    SELECT s.* INTO next_step FROM app_private.approval_request_steps s
     WHERE s.request_id=p_request_id AND s.step_number=step_row.step_number+1 AND s.state='WAITING' FOR UPDATE;
    IF next_step.id IS NOT NULL THEN
      UPDATE app_private.approval_request_steps SET state='OPEN',opened_at=pg_catalog.statement_timestamp() WHERE id=next_step.id;
      INSERT INTO app_private.approval_step_reviewers(step_id,reviewer_id,assignment_reason,created_by)
      SELECT next_step.id,c.candidate_principal_id,'D1_REVIEWER_ROLE_SCOPE',ctx.actor_id
        FROM app_private.d1_employee_qualification_candidates(p_request_id,next_step.id) c;
      GET DIAGNOSTICS candidate_count=ROW_COUNT;
      IF candidate_count=0 THEN RAISE EXCEPTION 'D1 Employee qualification next step has no reviewer'; END IF;
      final_state:='PENDING';
      UPDATE app_private.approval_requests SET row_version=row_version+1,updated_at=pg_catalog.statement_timestamp()
       WHERE id=p_request_id RETURNING row_version INTO final_version;
    ELSE
      final_state:='APPROVED';
      UPDATE app_private.approval_requests SET state='APPROVED',decided_at=pg_catalog.statement_timestamp()
       WHERE id=p_request_id RETURNING row_version INTO final_version;
    END IF;
  END IF;
  receipt:=app_private.d1_employee_qualification_receipt('request.review',ctx.actor_id,ctx.operation_id,
    p_idempotency_key,ctx.intent_hash,req.expected_target_version,p_request_id,p_expected_request_version,
    'SUCCEEDED','D1_EMPLOYEE_QUALIFICATION_REVIEW',p_request_id,
    pg_catalog.jsonb_build_object('request_version',final_version,'state',final_state),NULL);
  PERFORM app_private.d1_employee_qualification_audit(ctx.actor_id,'request.review',action,
    req.target_ref,NULL,NULL,NULL,receipt,p_request_id,req.expected_target_version,'SUCCEEDED',pg_catalog.gen_random_uuid());
  RETURN QUERY SELECT p_request_id,final_version,final_state;
END $body$;
REVOKE ALL ON FUNCTION app.d1_review_employee_qualification_request(uuid,text,bigint,text,text)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_review_employee_qualification_request(uuid,text,bigint,text,text) TO authenticated;
