-- D1C2A #565 Student Status P2 reviewer selection failed at the *first*
-- approval_requests read by the schoolos_authz_reader-owned candidate helper.
-- Close the whole reviewer/participant authorization read boundary at once:
--  - exact column grants for protected Status P2 request + step evidence,
--  - operation-specific RLS for this workflow on Foundation request/operation,
--  - all three inherited authz helpers use bounded column projections.
-- Keep the existing configured role + live authority + Person separation.
-- No public, authenticated, service_role, workflow table privilege or
-- generic approval-request read. Frozen Effect24 remains untouched.
-- This is append-only INACTIVE Migration 10, not a hosted deployment.
SET ROLE schoolos_schema_owner;
GRANT SELECT (id,operation_id,requester_id,target_ref,old_snapshot,requested_payload)
  ON app_private.approval_requests TO schoolos_authz_reader;
GRANT SELECT (id,code) ON app_private.operation_contracts TO schoolos_authz_reader;
GRANT SELECT (id,request_id,state,template_id,step_number)
  ON app_private.approval_request_steps TO schoolos_authz_reader;
GRANT SELECT (id,reviewer_role_id,selection_resolver_key)
  ON app_private.approval_step_templates TO schoolos_authz_reader;
GRANT SELECT (step_id,reviewer_id,reviewer_assignment_id,decision)
  ON app_private.approval_reviews TO schoolos_authz_reader;
GRANT SELECT (id,step_id,reviewer_id,withdrawn_at,assignment_reason)
  ON app_private.approval_step_reviewers TO schoolos_authz_reader;
CREATE POLICY d1_effect35_status_correct_authz_requests
  ON app_private.approval_requests FOR SELECT TO schoolos_authz_reader
  USING (EXISTS (
    SELECT 1 FROM app_private.operation_contracts o
     WHERE o.id=operation_id AND o.code='student.status.correct'
  ));
CREATE POLICY d1_effect35_status_correct_authz_operation
  ON app_private.operation_contracts FOR SELECT TO schoolos_authz_reader
  USING (code='student.status.correct');
RESET ROLE;

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;

CREATE OR REPLACE FUNCTION app_private.d1_student_status_correct_candidates(p_request uuid,p_step uuid)
RETURNS TABLE(candidate_principal_id uuid) LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; templ record; requester_person uuid; source_date date; corrected_date date;
BEGIN
  SELECT q.id,q.requester_id,q.target_ref,q.old_snapshot,q.requested_payload INTO req FROM app_private.approval_requests q JOIN app_private.operation_contracts o ON o.id=q.operation_id
    WHERE q.id=p_request AND o.code='student.status.correct';
  SELECT t.id,t.selection_resolver_key,t.reviewer_role_id INTO templ FROM app_private.approval_request_steps s JOIN app_private.approval_step_templates t ON t.id=s.template_id
    WHERE s.id=p_step AND s.request_id=p_request;
  IF req.id IS NULL OR templ.id IS NULL OR templ.selection_resolver_key IS DISTINCT FROM 'D1_REVIEWER_ROLE_SCOPE' THEN RETURN; END IF;
  BEGIN source_date:=NULLIF(req.old_snapshot->>'effective_on','')::date; corrected_date:=NULLIF(req.requested_payload->>'effective_on','')::date;
  EXCEPTION WHEN OTHERS THEN RETURN; END;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id;
  RETURN QUERY SELECT p.id FROM app_private.principals p WHERE p.kind='INDIVIDUAL' AND p.state='ACTIVE' AND p.person_id IS NOT NULL
    AND p.id<>req.requester_id AND p.person_id<>requester_person
    AND app_private.d1_student_status_correct_authorized_pair(p.id,'student.status.approve',req.target_ref,source_date,corrected_date,templ.reviewer_role_id)
    ORDER BY p.id;
END $body$;

CREATE OR REPLACE FUNCTION app_private.d1_student_status_correct_reviews_live(p_request uuid)
RETURNS boolean LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; requester_person uuid; s record; n bigint; reviewer uuid; reviewer_person uuid; seen bigint:=0; source_date date; corrected_date date;
BEGIN
  SELECT q.id,q.requester_id,q.target_ref,q.old_snapshot,q.requested_payload INTO req FROM app_private.approval_requests q JOIN app_private.operation_contracts o ON o.id=q.operation_id
   WHERE q.id=p_request AND o.code='student.status.correct'; IF NOT FOUND THEN RETURN false; END IF;
  BEGIN source_date:=NULLIF(req.old_snapshot->>'effective_on','')::date; corrected_date:=NULLIF(req.requested_payload->>'effective_on','')::date;
  EXCEPTION WHEN OTHERS THEN RETURN false; END;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id; IF requester_person IS NULL THEN RETURN false; END IF;
  FOR s IN SELECT st.id,st.state,t.reviewer_role_id FROM app_private.approval_request_steps st
    JOIN app_private.approval_step_templates t ON t.id=st.template_id WHERE st.request_id=p_request ORDER BY st.step_number LOOP
    seen:=seen+1; IF s.state<>'APPROVED' OR s.reviewer_role_id IS NULL THEN RETURN false; END IF;
    SELECT count(*),min(v.reviewer_id::text)::uuid INTO n,reviewer FROM app_private.approval_reviews v
      JOIN app_private.approval_step_reviewers a ON a.id=v.reviewer_assignment_id AND a.step_id=s.id
      WHERE v.step_id=s.id AND v.decision='APPROVE' AND a.reviewer_id=v.reviewer_id AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
    IF n<>1 OR reviewer IS NULL THEN RETURN false; END IF;
    SELECT p.person_id INTO reviewer_person FROM app_private.principals p WHERE p.id=reviewer;
    IF reviewer_person IS NULL OR reviewer_person=requester_person OR app_private.d1_student_status_correct_authorized_pair(
      reviewer,'student.status.approve',req.target_ref,source_date,corrected_date,s.reviewer_role_id) IS DISTINCT FROM true THEN RETURN false; END IF;
  END LOOP; RETURN seen>0;
END $body$;

CREATE OR REPLACE FUNCTION app_private.d1_student_status_correct_participant(p_request uuid,p_actor uuid)
RETURNS text LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; source_date date; corrected_date date; final_role uuid; open_step record; requester_person uuid; actor_person uuid;
BEGIN
  SELECT q.id,q.requester_id,q.target_ref,q.old_snapshot,q.requested_payload INTO req FROM app_private.approval_requests q JOIN app_private.operation_contracts o ON o.id=q.operation_id
   WHERE q.id=p_request AND o.code='student.status.correct'; IF NOT FOUND OR p_actor IS NULL THEN RETURN NULL; END IF;
  BEGIN source_date:=NULLIF(req.old_snapshot->>'effective_on','')::date; corrected_date:=NULLIF(req.requested_payload->>'effective_on','')::date;
  EXCEPTION WHEN OTHERS THEN RETURN NULL; END;
  IF p_actor=req.requester_id AND app_private.d1_student_status_correct_authorized_pair(p_actor,'student.status.correct',req.target_ref,source_date,corrected_date,NULL)
    THEN RETURN 'REQUESTER'; END IF;
  final_role:=app_private.d1_final_approver_role(p_request,p_actor);
  IF final_role IS NOT NULL AND app_private.d1_student_status_correct_authorized_pair(p_actor,'student.status.approve',req.target_ref,source_date,corrected_date,final_role)
    THEN RETURN 'FINAL_APPROVER'; END IF;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id;
  SELECT p.person_id INTO actor_person FROM app_private.principals p WHERE p.id=p_actor;
  IF requester_person IS NULL OR actor_person IS NULL OR requester_person=actor_person THEN RETURN NULL; END IF;
  SELECT st.id,t.reviewer_role_id INTO open_step FROM app_private.approval_request_steps st JOIN app_private.approval_step_templates t ON t.id=st.template_id
   WHERE st.request_id=p_request AND st.state='OPEN' AND EXISTS (SELECT 1 FROM app_private.approval_step_reviewers a
    WHERE a.step_id=st.id AND a.reviewer_id=p_actor AND a.withdrawn_at IS NULL AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE')
   ORDER BY st.step_number LIMIT 1;
  IF open_step.id IS NOT NULL AND app_private.d1_student_status_correct_authorized_pair(p_actor,'student.status.approve',req.target_ref,
    source_date,corrected_date,open_step.reviewer_role_id) THEN RETURN 'OPEN_REVIEWER'; END IF;
  RETURN NULL;
END $body$;

RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;
