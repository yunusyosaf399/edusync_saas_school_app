-- Effect 25 audit correction: frozen atomic-move contract owns PROMOTION/REPEAT with CLASS/SECTION/CAMPUS moves.
-- Standalone P0 placement is limited to INITIAL and REENROLLMENT.

GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE OR REPLACE FUNCTION app_private.d1_enrollment_place_lock_context(
  p_student uuid,p_expected_version bigint,p_section uuid,p_entry_kind text,p_effective_from date,p_predecessor uuid
) RETURNS TABLE(student_version bigint,current_status text,school_id uuid,campus_id uuid,academic_year_id uuid,
 class_offering_id uuid,class_id uuid,section_id uuid,class_capacity integer,section_capacity integer,predecessor_id uuid,error_code text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE s app_private.students%ROWTYPE; d record; pred app_private.enrollments%ROWTYPE; prior_count bigint; overlap_count bigint; latest_id uuid;
BEGIN
  SELECT * INTO s FROM app_private.students WHERE id=p_student FOR UPDATE;
  IF NOT FOUND THEN RETURN QUERY SELECT NULL::bigint,NULL::text,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::integer,NULL::integer,NULL::uuid,'D1_ENROLLMENT_PLACE_STUDENT_MISSING'; RETURN; END IF;
  IF p_expected_version IS NULL OR p_expected_version<1 OR s.row_version IS DISTINCT FROM p_expected_version THEN
    RETURN QUERY SELECT s.row_version,s.current_status,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::integer,NULL::integer,NULL::uuid,'D1_ENROLLMENT_PLACE_VERSION_STALE'; RETURN; END IF;
  IF p_entry_kind NOT IN ('INITIAL','REENROLLMENT') OR p_effective_from IS NULL THEN
    RETURN QUERY SELECT s.row_version,s.current_status,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::integer,NULL::integer,NULL::uuid,'D1_ENROLLMENT_PLACE_INTENT_INVALID'; RETURN; END IF;
  SELECT * INTO d FROM app_private.d1_enrollment_place_lock_destination(p_section);
  IF NOT FOUND THEN RETURN QUERY SELECT s.row_version,s.current_status,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::integer,NULL::integer,NULL::uuid,'D1_ENROLLMENT_PLACE_DESTINATION_MISSING'; RETURN; END IF;
  IF d.class_state<>'OPEN' OR d.section_state<>'OPEN' THEN
    RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,NULL::uuid,'D1_ENROLLMENT_PLACE_DESTINATION_NOT_OPEN'; RETURN; END IF;
  IF (p_entry_kind='REENROLLMENT' AND s.current_status NOT IN ('WITHDRAWN','TRANSFERRED'))
     OR (p_entry_kind='INITIAL' AND s.current_status<>'ACTIVE') THEN
    RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,NULL::uuid,'D1_ENROLLMENT_PLACE_STATUS_INELIGIBLE'; RETURN; END IF;
  SELECT count(*) INTO prior_count FROM app_private.enrollments e WHERE e.student_id=p_student AND e.placement_kind='PRIMARY';
  IF p_entry_kind='INITIAL' THEN
    IF prior_count<>0 OR p_predecessor IS NOT NULL THEN
      RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,NULL::uuid,'D1_ENROLLMENT_PLACE_INITIAL_HISTORY_CONFLICT'; RETURN; END IF;
  ELSE
    IF p_predecessor IS NULL THEN
      RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,NULL::uuid,'D1_ENROLLMENT_PLACE_PREDECESSOR_REQUIRED'; RETURN; END IF;
    SELECT * INTO pred FROM app_private.enrollments e WHERE e.id=p_predecessor AND e.student_id=p_student AND e.placement_kind='PRIMARY' FOR UPDATE;
    IF NOT FOUND OR pred.effective_until IS NULL OR pred.effective_until>p_effective_from OR pred.placement_state='ACTIVE' THEN
      RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,p_predecessor,'D1_ENROLLMENT_PLACE_PREDECESSOR_INVALID'; RETURN; END IF;
    SELECT e.id INTO latest_id FROM app_private.enrollments e WHERE e.student_id=p_student AND e.placement_kind='PRIMARY' AND e.effective_from<p_effective_from
      ORDER BY e.effective_from DESC,e.created_at DESC,e.id DESC LIMIT 1;
    IF latest_id IS DISTINCT FROM p_predecessor THEN
      RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,p_predecessor,'D1_ENROLLMENT_PLACE_PREDECESSOR_NOT_LATEST'; RETURN; END IF;
  END IF;
  SELECT count(*) INTO overlap_count FROM app_private.enrollments e WHERE e.student_id=p_student AND e.placement_kind='PRIMARY'
    AND p_effective_from<pg_catalog.coalesce(e.effective_until,'infinity'::date);
  IF overlap_count<>0 THEN
    RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,p_predecessor,'D1_ENROLLMENT_PLACE_PRIMARY_OVERLAP'; RETURN; END IF;
  RETURN QUERY SELECT s.row_version,s.current_status,d.school_id,d.campus_id,d.academic_year_id,d.class_offering_id,d.class_id,d.section_id,d.class_capacity,d.section_capacity,p_predecessor,NULL::text;
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;

GRANT CREATE ON SCHEMA app TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE OR REPLACE FUNCTION app.d1_place_student_enrollment(
  p_student_id uuid,p_expected_student_version bigint,p_section_offering_id uuid,p_entry_kind text,p_effective_from date,
  p_predecessor_id uuid,p_reason text,p_capacity_override_reason text,p_idempotency_key text
) RETURNS TABLE(enrollment_id uuid,roll_allocation_id uuid,numeric_value bigint,roll_mode text,student_version bigint,
  status_transition_id uuid,resulting_status text,capacity_overridden boolean)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; prelock record; locked record; cap record; eff record; receipt uuid; corr uuid:=pg_catalog.gen_random_uuid(); summary jsonb;
  over_cap boolean; override_reason text:=NULLIF(pg_catalog.btrim(p_capacity_override_reason),''); override_id uuid;
BEGIN
  IF p_student_id IS NULL OR p_expected_student_version IS NULL OR p_expected_student_version<1 OR p_section_offering_id IS NULL
     OR p_entry_kind NOT IN ('INITIAL','REENROLLMENT') OR p_effective_from IS NULL
     OR p_reason IS NULL OR pg_catalog.length(pg_catalog.btrim(p_reason))=0 THEN RAISE EXCEPTION 'D1 Enrollment placement intent invalid'; END IF;
  SELECT * INTO ctx FROM app_private.d1_enrollment_place_command_context(p_idempotency_key,
    pg_catalog.jsonb_build_array(p_student_id,p_expected_student_version::text,p_section_offering_id,p_entry_kind,p_effective_from,p_predecessor_id,p_reason,override_reason));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  IF NOT app_private.d1_enrollment_place_authorized(ctx.actor_id,'student.enrollment.place',p_section_offering_id) THEN RAISE EXCEPTION 'D1 Enrollment placement authority denied'; END IF;
  IF ctx.receipt_id IS NOT NULL THEN
    IF ctx.receipt_state<>'SUCCEEDED' OR ctx.result_ref IS NULL OR ctx.result_summary IS NULL
       OR app_private.d1_enrollment_place_result_matches(ctx.actor_id,p_student_id,p_section_offering_id,p_entry_kind,p_effective_from,p_predecessor_id,
            ctx.receipt_id,ctx.result_ref,ctx.result_summary) IS DISTINCT FROM true
    THEN RAISE EXCEPTION 'D1 Enrollment placement receipt is not replayable'; END IF;
    RETURN QUERY SELECT ctx.result_ref,(ctx.result_summary->>'roll_allocation_id')::uuid,(ctx.result_summary->>'numeric_value')::bigint,
      ctx.result_summary->>'roll_mode',(ctx.result_summary->>'student_version')::bigint,NULLIF(ctx.result_summary->>'status_transition_id','')::uuid,
      ctx.result_summary->>'resulting_status',(ctx.result_summary->>'capacity_overridden')::boolean; RETURN;
  END IF;
  SELECT * INTO prelock FROM app_private.d1_enrollment_place_prelock_roll(p_section_offering_id,p_effective_from);
  IF prelock.error_code IS NOT NULL THEN RAISE EXCEPTION 'D1 Enrollment roll prelock denied: %',prelock.error_code; END IF;
  SELECT * INTO locked FROM app_private.d1_enrollment_place_lock_context(p_student_id,p_expected_student_version,p_section_offering_id,p_entry_kind,p_effective_from,p_predecessor_id);
  IF locked.error_code IS NOT NULL THEN RAISE EXCEPTION 'D1 Enrollment placement denied: %',locked.error_code; END IF;
  IF locked.school_id IS DISTINCT FROM prelock.school_id OR locked.class_offering_id IS DISTINCT FROM prelock.class_offering_id THEN RAISE EXCEPTION 'D1 Enrollment destination ancestry changed after roll prelock'; END IF;
  SELECT * INTO cap FROM app_private.d1_enrollment_place_capacity(locked.class_offering_id,p_section_offering_id,p_effective_from);
  IF cap.class_limit IS NULL THEN RAISE EXCEPTION 'D1 Enrollment capacity unavailable'; END IF;
  over_cap:=cap.class_full OR cap.section_full;
  IF over_cap THEN
    IF override_reason IS NULL OR NOT app_private.d1_enrollment_place_authorized(ctx.actor_id,'student.capacity_override',p_section_offering_id) THEN RAISE EXCEPTION 'D1 Enrollment capacity override denied'; END IF;
    override_id:=pg_catalog.gen_random_uuid();
  ELSIF override_reason IS NOT NULL THEN RAISE EXCEPTION 'D1 Enrollment override reason supplied without full capacity'; END IF;
  SELECT * INTO eff FROM app_private.d1_enrollment_place_effect(ctx.actor_id,p_student_id,p_expected_student_version,p_section_offering_id,p_entry_kind,p_effective_from,p_predecessor_id,p_reason);
  IF eff.policy_revision_id IS DISTINCT FROM prelock.policy_revision_id OR eff.policy_mode IS DISTINCT FROM prelock.policy_mode THEN RAISE EXCEPTION 'D1 Enrollment roll policy changed after prelock'; END IF;
  summary:=pg_catalog.jsonb_build_object('enrollment_id',eff.enrollment_id,'roll_allocation_id',eff.roll_allocation_id,'numeric_value',eff.numeric_value,
    'roll_mode',eff.policy_mode,'student_version',eff.student_version,'status_transition_id',eff.status_transition_id,'resulting_status',eff.resulting_status,
    'capacity_overridden',over_cap,'capacity_override_id',override_id,'section_offering_id',p_section_offering_id,
    'class_offering_id',eff.class_offering_id,'campus_id',eff.campus_id,'academic_year_id',eff.academic_year_id,
    'entry_kind',p_entry_kind,'effective_from',p_effective_from,'predecessor_id',p_predecessor_id);
  receipt:=app_private.d1_enrollment_place_receipt(ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,p_expected_student_version,eff.enrollment_id,summary);
  IF over_cap THEN
    INSERT INTO app_private.enrollment_capacity_overrides(id,enrollment_id,class_overridden,section_overridden,class_limit_at_decision,
      section_limit_at_decision,class_count_at_decision,section_count_at_decision,reason,command_receipt_id,created_by)
    VALUES (override_id,eff.enrollment_id,cap.class_full,cap.section_full,cap.class_limit,cap.section_limit,cap.class_count,cap.section_count,override_reason,receipt,ctx.actor_id);
  END IF;
  PERFORM app_private.d1_enrollment_place_audit(ctx.actor_id,p_student_id,eff.enrollment_id,eff.roll_allocation_id,receipt,eff.student_version,p_section_offering_id,p_entry_kind,p_effective_from,over_cap,eff.status_transition_id IS NOT NULL,eff.status_transition_id,corr);
  PERFORM app_private.d1_enrollment_place_events_v2(ctx.actor_id,p_student_id,eff.enrollment_id,eff.roll_allocation_id,override_id,receipt,
    eff.student_version,p_section_offering_id,eff.class_offering_id,eff.campus_id,eff.academic_year_id,p_entry_kind,p_effective_from,
    eff.numeric_value,eff.policy_revision_id,eff.policy_mode,cap.class_full,cap.section_full,eff.status_transition_id,
    eff.previous_status,eff.resulting_status,corr);
  RETURN QUERY SELECT eff.enrollment_id,eff.roll_allocation_id,eff.numeric_value,eff.policy_mode,eff.student_version,eff.status_transition_id,eff.resulting_status,over_cap;
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_student_executor;

GRANT CREATE ON SCHEMA app_private TO schoolos_evidence_writer;
SET ROLE schoolos_evidence_writer;
CREATE OR REPLACE FUNCTION app_private.d1_enrollment_place_events_v2(
  p_actor uuid,p_student uuid,p_enrollment uuid,p_roll uuid,p_override_id uuid,p_receipt uuid,p_student_version bigint,
  p_section uuid,p_class uuid,p_campus uuid,p_year uuid,p_entry_kind text,p_effective_from date,p_numeric bigint,
  p_policy uuid,p_mode text,p_class_over boolean,p_section_over boolean,p_status_transition uuid,
  p_status_before text,p_status_after text,p_correlation uuid
) RETURNS void LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ord integer:=1;
BEGIN
  IF p_actor IS DISTINCT FROM app_private.current_principal_id() OR p_student IS NULL OR p_enrollment IS NULL OR p_roll IS NULL
     OR p_receipt IS NULL OR p_section IS NULL OR p_class IS NULL OR p_campus IS NULL OR p_year IS NULL
     OR p_entry_kind NOT IN ('INITIAL','REENROLLMENT') OR p_effective_from IS NULL
     OR p_numeric IS NULL OR p_numeric<0 OR p_policy IS NULL OR p_mode NOT IN ('ACADEMIC_CONTEXT','PERSISTENT_STUDENT')
     OR p_correlation IS NULL OR (p_override_id IS NULL AND (p_class_over OR p_section_over))
     OR (p_override_id IS NOT NULL AND NOT (p_class_over OR p_section_over))
  THEN RAISE EXCEPTION 'D1 Enrollment placement event intent denied'; END IF;
  INSERT INTO app_private.outbox_events(event_type,aggregate_kind,aggregate_ref,aggregate_version,command_receipt_id,event_ordinal,correlation_id,payload,created_by)
  VALUES ('enrollment.created','ENROLLMENT',p_enrollment,1,p_receipt,ord,p_correlation,
    pg_catalog.jsonb_build_object('student_id',p_student,'enrollment_id',p_enrollment,'roll_allocation_id',p_roll,
      'section_offering_id',p_section,'class_offering_id',p_class,'campus_id',p_campus,'academic_year_id',p_year,
      'entry_kind',p_entry_kind,'effective_from',p_effective_from,'numeric_value',p_numeric,'policy_revision_id',p_policy,'roll_mode',p_mode),p_actor);
  IF p_override_id IS NOT NULL THEN ord:=ord+1;
    INSERT INTO app_private.outbox_events(event_type,aggregate_kind,aggregate_ref,aggregate_version,command_receipt_id,event_ordinal,correlation_id,payload,created_by)
    VALUES ('enrollment.capacity_overridden','ENROLLMENT_CAPACITY_OVERRIDE',p_override_id,1,p_receipt,ord,p_correlation,
      pg_catalog.jsonb_build_object('student_id',p_student,'enrollment_id',p_enrollment,'capacity_override_id',p_override_id,
        'class_overridden',p_class_over,'section_overridden',p_section_over),p_actor); END IF;
  IF p_status_transition IS NOT NULL THEN
    IF p_entry_kind<>'REENROLLMENT' OR p_student_version IS NULL OR p_student_version<1
       OR p_status_before NOT IN ('WITHDRAWN','TRANSFERRED') OR p_status_after<>'ACTIVE' THEN
      RAISE EXCEPTION 'D1 Enrollment re-enrollment status event intent denied'; END IF;
    ord:=ord+1;
    INSERT INTO app_private.outbox_events(event_type,aggregate_kind,aggregate_ref,aggregate_version,command_receipt_id,event_ordinal,correlation_id,payload,created_by)
    VALUES ('student.status_changed','STUDENT',p_student,p_student_version,p_receipt,ord,p_correlation,
      pg_catalog.jsonb_build_object('student_id',p_student,'transition_id',p_status_transition,'previous_status',p_status_before,
        'new_status',p_status_after,'effective_on',p_effective_from),p_actor); END IF;
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_evidence_writer;
