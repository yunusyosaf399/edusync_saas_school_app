-- D1C1B effect 23/36: Student status P1 review/apply.
-- Static non-executable continuation only.

GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE FUNCTION app.d1_review_student_status_request(
  p_request_id uuid,p_decision text,p_expected_request_version bigint,p_reason text,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint,request_state text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; req record; step_row record; next_step record; policy_row record; assignment_id uuid;
  n bigint; candidate_count bigint; final_version bigint; final_state text; receipt uuid; reviewer_role uuid;
  source_transition uuid; old_status text; new_status text; effective_on date; pre record;
BEGIN
  IF p_request_id IS NULL OR p_decision NOT IN ('APPROVE','REJECT') OR p_expected_request_version IS NULL OR p_expected_request_version<1
     OR p_reason IS NULL OR pg_catalog.length(pg_catalog.btrim(p_reason))=0 THEN RAISE EXCEPTION 'D1 Student status review intent invalid'; END IF;
  SELECT * INTO ctx FROM app_private.d1_student_status_command_context('request.review',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_request_id,p_decision,p_expected_request_version::text,p_reason));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT q.* INTO req FROM app_private.approval_requests q WHERE q.id=p_request_id AND q.operation_id=ctx.operation_id FOR UPDATE;
  IF NOT FOUND OR req.old_snapshot IS NULL OR req.requested_payload IS NULL THEN RAISE EXCEPTION 'D1 Student status request missing'; END IF;
  BEGIN source_transition:=NULLIF(req.old_snapshot->>'source_transition_id','')::uuid;
    old_status:=req.old_snapshot->>'current_status'; new_status:=req.requested_payload->>'new_status';
    effective_on:=NULLIF(req.requested_payload->>'effective_on','')::date;
  EXCEPTION WHEN invalid_text_representation OR datetime_field_overflow THEN RAISE EXCEPTION 'D1 Student status stored request malformed'; END;
  IF old_status IS NULL OR new_status IS NULL OR effective_on IS NULL THEN RAISE EXCEPTION 'D1 Student status stored request malformed'; END IF;
  SELECT * INTO policy_row FROM app_private.d1_student_status_policy(req.target_ref);
  IF policy_row.policy_id IS DISTINCT FROM req.policy_id OR policy_row.route_mode IS DISTINCT FROM 'APPROVAL'
     OR policy_row.campus_id IS DISTINCT FROM req.campus_id THEN RAISE EXCEPTION 'D1 Student status request policy no longer applies'; END IF;
  IF ctx.receipt_id IS NOT NULL THEN
    SELECT count(*),min(t.reviewer_role_id::text)::uuid INTO n,reviewer_role
      FROM app_private.approval_reviews v JOIN app_private.approval_request_steps s ON s.id=v.step_id
      JOIN app_private.approval_step_templates t ON t.id=s.template_id
     WHERE s.request_id=p_request_id AND v.reviewer_id=ctx.actor_id AND v.decision=p_decision
       AND v.expected_request_version=p_expected_request_version;
    IF n<>1 OR reviewer_role IS NULL OR NOT app_private.d1_student_status_authorized(ctx.actor_id,'student.status.approve',req.target_ref,reviewer_role)
       OR ctx.receipt_state<>'SUCCEEDED' OR ctx.result_ref IS DISTINCT FROM p_request_id OR ctx.result_summary IS NULL
       OR NOT (ctx.result_summary ?& ARRAY['request_version','state']) THEN RAISE EXCEPTION 'D1 Student status review receipt invalid'; END IF;
    RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,ctx.result_summary->>'state'; RETURN; END IF;
  SELECT * INTO pre FROM app_private.d1_student_status_preflight(req.target_ref,req.expected_target_version,old_status,source_transition,new_status,effective_on);
  IF pre.eligible IS DISTINCT FROM true THEN RAISE EXCEPTION 'D1 Student status request facts changed: %',pre.error_code; END IF;
  SELECT s.* INTO step_row FROM app_private.approval_request_steps s WHERE s.request_id=p_request_id AND s.state='OPEN'
    ORDER BY s.step_number LIMIT 1 FOR UPDATE;
  IF req.state<>'PENDING' OR req.row_version<>p_expected_request_version OR step_row.id IS NULL THEN RAISE EXCEPTION 'D1 Student status review state changed'; END IF;
  SELECT count(*),min(a.id::text)::uuid INTO n,assignment_id FROM app_private.approval_step_reviewers a
   WHERE a.step_id=step_row.id AND a.reviewer_id=ctx.actor_id AND a.withdrawn_at IS NULL AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
  IF n<>1 OR NOT EXISTS (SELECT 1 FROM app_private.d1_student_status_candidates(p_request_id,step_row.id) c WHERE c.candidate_principal_id=ctx.actor_id)
  THEN RAISE EXCEPTION 'D1 Student status reviewer authority denied'; END IF;
  INSERT INTO app_private.approval_reviews(reviewer_assignment_id,step_id,reviewer_id,decision,reason,expected_request_version,created_by)
  VALUES (assignment_id,step_row.id,ctx.actor_id,p_decision,pg_catalog.btrim(p_reason),p_expected_request_version,ctx.actor_id);
  UPDATE app_private.approval_request_steps SET state=CASE p_decision WHEN 'APPROVE' THEN 'APPROVED' ELSE 'REJECTED' END,
    closed_at=pg_catalog.statement_timestamp() WHERE id=step_row.id;
  IF p_decision='REJECT' THEN
    UPDATE app_private.approval_request_steps SET state='CANCELLED',closed_at=pg_catalog.statement_timestamp()
     WHERE request_id=p_request_id AND state='WAITING';
    final_state:='REJECTED'; UPDATE app_private.approval_requests SET state='REJECTED',decided_at=pg_catalog.statement_timestamp()
      WHERE id=p_request_id RETURNING row_version INTO final_version;
  ELSE
    SELECT s.* INTO next_step FROM app_private.approval_request_steps s
     WHERE s.request_id=p_request_id AND s.step_number=step_row.step_number+1 AND s.state='WAITING' FOR UPDATE;
    IF next_step.id IS NOT NULL THEN
      UPDATE app_private.approval_request_steps SET state='OPEN',opened_at=pg_catalog.statement_timestamp() WHERE id=next_step.id;
      INSERT INTO app_private.approval_step_reviewers(step_id,reviewer_id,assignment_reason,created_by)
        SELECT next_step.id,c.candidate_principal_id,'D1_REVIEWER_ROLE_SCOPE',ctx.actor_id FROM app_private.d1_student_status_candidates(p_request_id,next_step.id) c;
      GET DIAGNOSTICS candidate_count=ROW_COUNT; IF candidate_count=0 THEN RAISE EXCEPTION 'D1 Student status next step has no reviewer'; END IF;
      final_state:='PENDING'; UPDATE app_private.approval_requests SET row_version=row_version+1,updated_at=pg_catalog.statement_timestamp()
        WHERE id=p_request_id RETURNING row_version INTO final_version;
    ELSE
      IF EXISTS (SELECT 1 FROM app_private.approval_request_steps s WHERE s.request_id=p_request_id AND s.state<>'APPROVED') THEN
        RAISE EXCEPTION 'D1 Student status approval sequence incomplete'; END IF;
      final_state:='APPROVED'; UPDATE app_private.approval_requests SET state='APPROVED',decided_at=pg_catalog.statement_timestamp()
        WHERE id=p_request_id RETURNING row_version INTO final_version;
    END IF;
  END IF;
  receipt:=app_private.d1_student_status_receipt('request.review',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
    req.expected_target_version,p_request_id,p_expected_request_version,'SUCCEEDED','D1_STUDENT_STATUS_REVIEW',p_request_id,
    pg_catalog.jsonb_build_object('request_version',final_version,'state',final_state),NULL);
  PERFORM app_private.d1_student_status_audit(ctx.actor_id,'request.review',req.target_ref,source_transition,receipt,p_request_id,
    req.expected_target_version,old_status,new_status,effective_on,final_state,pg_catalog.gen_random_uuid());
  RETURN QUERY SELECT p_request_id,final_version,final_state;
END $body$;
REVOKE ALL ON FUNCTION app.d1_review_student_status_request(uuid,text,bigint,text,text) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_review_student_status_request(uuid,text,bigint,text,text) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE FUNCTION app_private.d1_student_status_reviews_live(p_request uuid)
RETURNS boolean LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; requester_person uuid; s record; n bigint; reviewer uuid; reviewer_person uuid; seen bigint:=0;
BEGIN
  SELECT q.* INTO req FROM app_private.approval_requests q JOIN app_private.operation_contracts o ON o.id=q.operation_id
   WHERE q.id=p_request AND o.code='student.status.change'; IF NOT FOUND THEN RETURN false; END IF;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id; IF requester_person IS NULL THEN RETURN false; END IF;
  FOR s IN SELECT st.id,st.state,t.reviewer_role_id FROM app_private.approval_request_steps st
    JOIN app_private.approval_step_templates t ON t.id=st.template_id WHERE st.request_id=p_request ORDER BY st.step_number LOOP
    seen:=seen+1; IF s.state<>'APPROVED' OR s.reviewer_role_id IS NULL THEN RETURN false; END IF;
    SELECT count(*),min(v.reviewer_id::text)::uuid INTO n,reviewer FROM app_private.approval_reviews v
      JOIN app_private.approval_step_reviewers a ON a.id=v.reviewer_assignment_id AND a.step_id=s.id
      WHERE v.step_id=s.id AND v.decision='APPROVE' AND a.reviewer_id=v.reviewer_id AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
    IF n<>1 OR reviewer IS NULL THEN RETURN false; END IF;
    SELECT p.person_id INTO reviewer_person FROM app_private.principals p WHERE p.id=reviewer;
    IF reviewer_person IS NULL OR reviewer_person=requester_person
       OR NOT app_private.d1_student_status_authorized(reviewer,'student.status.approve',req.target_ref,s.reviewer_role_id) THEN RETURN false; END IF;
  END LOOP; RETURN seen>0;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_student_status_reviews_live(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_student_status_reviews_live(uuid) TO schoolos_workflow_executor,schoolos_read_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;

GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE FUNCTION app.d1_apply_student_status_request(p_request_id uuid,p_expected_request_version bigint,p_idempotency_key text)
RETURNS TABLE(request_id uuid,request_version bigint,request_state text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; req record; policy_row record; pre record; eff record; source_transition uuid; old_status text; new_status text; effective_on date;
  invalidation text; final_version bigint; receipt uuid; corr uuid:=pg_catalog.gen_random_uuid(); final_role uuid;
BEGIN
  IF p_request_id IS NULL OR p_expected_request_version IS NULL OR p_expected_request_version<1 THEN RAISE EXCEPTION 'D1 Student status apply intent invalid'; END IF;
  SELECT * INTO ctx FROM app_private.d1_student_status_command_context('request.apply',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_request_id,p_expected_request_version::text));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT q.* INTO req FROM app_private.approval_requests q WHERE q.id=p_request_id AND q.operation_id=ctx.operation_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'D1 Student status request missing'; END IF;
  IF ctx.receipt_id IS NOT NULL THEN
    IF ctx.receipt_state NOT IN ('SUCCEEDED','REJECTED') OR ctx.result_summary IS NULL OR NOT (ctx.result_summary ?& ARRAY['request_version','state']) THEN
      RAISE EXCEPTION 'D1 Student status apply receipt invalid'; END IF;
    RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,ctx.result_summary->>'state'; RETURN; END IF;
  IF req.state<>'APPROVED' OR req.row_version<>p_expected_request_version THEN RAISE EXCEPTION 'D1 Student status approved request changed'; END IF;
  BEGIN source_transition:=NULLIF(req.old_snapshot->>'source_transition_id','')::uuid; old_status:=req.old_snapshot->>'current_status';
    new_status:=req.requested_payload->>'new_status'; effective_on:=NULLIF(req.requested_payload->>'effective_on','')::date;
  EXCEPTION WHEN invalid_text_representation OR datetime_field_overflow THEN RAISE EXCEPTION 'D1 Student status stored request malformed'; END;
  IF old_status IS NULL OR new_status IS NULL OR effective_on IS NULL OR NOT app_private.d1_student_status_edge_valid(old_status,new_status) THEN
    RAISE EXCEPTION 'D1 Student status stored request malformed'; END IF;
  final_role:=app_private.d1_final_approver_role(p_request_id,ctx.actor_id);
  IF ctx.actor_id IS DISTINCT FROM req.requester_id AND final_role IS NULL THEN RAISE EXCEPTION 'D1 Student status request unavailable'; END IF;
  SELECT * INTO policy_row FROM app_private.d1_student_status_policy(req.target_ref);
  IF policy_row.policy_id IS DISTINCT FROM req.policy_id OR policy_row.route_mode IS DISTINCT FROM 'APPROVAL' OR policy_row.campus_id IS DISTINCT FROM req.campus_id THEN
    invalidation:='D1_STUDENT_STATUS_POLICY_STALE';
  ELSIF NOT app_private.d1_student_status_authorized(req.requester_id,'student.status.change',req.target_ref,NULL) THEN
    invalidation:='D1_STUDENT_STATUS_REQUESTER_AUTHORITY_STALE';
  ELSIF app_private.d1_student_status_reviews_live(p_request_id) IS DISTINCT FROM true THEN
    invalidation:='D1_STUDENT_STATUS_REVIEW_AUTHORITY_STALE';
  ELSE
    SELECT * INTO pre FROM app_private.d1_student_status_preflight(req.target_ref,req.expected_target_version,old_status,source_transition,new_status,effective_on);
    IF pre.eligible IS DISTINCT FROM true THEN invalidation:=pg_catalog.coalesce(pre.error_code,'D1_STUDENT_STATUS_PREFLIGHT_STALE'); END IF;
  END IF;
  IF invalidation IS NOT NULL THEN
    UPDATE app_private.approval_requests SET state='INVALIDATED',decided_at=pg_catalog.statement_timestamp()
      WHERE id=p_request_id RETURNING row_version INTO final_version;
    receipt:=app_private.d1_student_status_receipt('request.apply',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
      req.expected_target_version,p_request_id,p_expected_request_version,'REJECTED','D1_STUDENT_STATUS_APPLY',NULL,
      pg_catalog.jsonb_build_object('request_version',final_version,'state','INVALIDATED'),invalidation);
    PERFORM app_private.d1_student_status_audit(ctx.actor_id,'request.apply',req.target_ref,source_transition,receipt,p_request_id,
      req.expected_target_version,old_status,new_status,effective_on,'INVALIDATED',corr);
    RETURN QUERY SELECT p_request_id,final_version,'INVALIDATED'::text; RETURN;
  END IF;
  SELECT * INTO eff FROM app_private.d1_student_status_effect(ctx.actor_id,req.target_ref,req.expected_target_version,
    old_status,source_transition,new_status,effective_on,req.reason);
  UPDATE app_private.approval_requests SET state='EXECUTED',executed_at=pg_catalog.statement_timestamp()
    WHERE id=p_request_id RETURNING row_version INTO final_version;
  receipt:=app_private.d1_student_status_receipt('request.apply',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
    req.expected_target_version,p_request_id,p_expected_request_version,'SUCCEEDED','D1_STUDENT_STATUS_APPLY',eff.transition_id,
    pg_catalog.jsonb_build_object('request_version',final_version,'state','EXECUTED','transition_id',eff.transition_id,
      'sequence_number',eff.sequence_number,'student_version',eff.student_version,'ended_enrollment_id',eff.ended_enrollment_id),NULL);
  INSERT INTO app_private.approval_applications(request_id,operation_id,command_receipt_id,result_kind,result_ref,applied_target_version,created_by)
  VALUES (p_request_id,ctx.operation_id,receipt,'D1_STUDENT_STATUS_APPLY',eff.transition_id,eff.student_version,ctx.actor_id);
  PERFORM app_private.d1_student_status_audit(ctx.actor_id,'request.apply',req.target_ref,eff.transition_id,receipt,p_request_id,
    eff.student_version,old_status,new_status,effective_on,'EXECUTED',corr);
  PERFORM app_private.d1_student_status_event(ctx.actor_id,req.target_ref,eff.transition_id,receipt,eff.student_version,
    old_status,new_status,effective_on,eff.sequence_number,corr);
  RETURN QUERY SELECT p_request_id,final_version,'EXECUTED'::text;
END $body$;
REVOKE ALL ON FUNCTION app.d1_apply_student_status_request(uuid,bigint,text) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_apply_student_status_request(uuid,bigint,text) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;