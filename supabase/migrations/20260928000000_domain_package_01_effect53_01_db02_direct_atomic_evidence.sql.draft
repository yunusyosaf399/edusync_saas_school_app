-- DB-02 I06: private DIRECT receipt, historical replay and atomically composed
-- transition. This overrides only the existing private DB-02 functions.
-- All SQL remains .draft; no public RPC or hosted migration.
-- These SELECT policies are internal-only: evidence_writer is NOLOGIN,
-- has no client grant and verifies persisted evidence via fixed helpers.
-- Foundation private tables are RLS-enabled; GRANT SELECT alone is not a
-- visibility policy for this verifier.
CREATE POLICY db02_i06_evidence_policy_revision_read
 ON app_private.roll_policy_revisions FOR SELECT
 TO schoolos_evidence_writer USING (true);
CREATE POLICY db02_i06_evidence_allocator_read
 ON app_private.roll_allocator_states FOR SELECT
 TO schoolos_evidence_writer USING (true);
CREATE POLICY db02_i06_evidence_offering_read
 ON app_private.class_offerings FOR SELECT
 TO schoolos_evidence_writer USING (true);
CREATE POLICY db02_i06_evidence_audit_read
 ON app_private.audit_events FOR SELECT
 TO schoolos_evidence_writer USING (true);
CREATE POLICY db02_i06_evidence_outbox_read
 ON app_private.outbox_events FOR SELECT
 TO schoolos_evidence_writer USING (true);

GRANT EXECUTE ON FUNCTION app_private.d1_roll_policy_direct_success_evidence(
 uuid,uuid,text,bytea,uuid,uuid,uuid,text,uuid,integer,jsonb)
 TO schoolos_student_executor;

GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE OR REPLACE FUNCTION app_private.d1_roll_policy_command_context(
  p_school uuid,p_phase text,p_key text,p_action text,
  p_source uuid,p_old_revision integer,p_old_mode text,
  p_old_start bigint,p_old_from date,p_new_mode text,
  p_new_start bigint,p_reason text)
RETURNS TABLE(actor_id uuid,operation_id uuid,policy_version_id uuid,
  route_mode text,school_id uuid,command_kind text,intent_hash bytea)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE
  chosen record;
  after_lock record;
  receipt record;
  intent jsonb;
  kind text;
BEGIN
  IF pg_catalog.current_setting('transaction_isolation') <> 'read committed' THEN
    RAISE EXCEPTION 'D1 Roll Policy context requires READ COMMITTED';
  END IF;
  IF p_school IS NULL OR p_phase IS NULL
     OR p_phase NOT IN ('DIRECT','SUBMIT')
     OR p_key IS NULL OR pg_catalog.char_length(p_key) NOT BETWEEN 1 AND 200
     OR p_action IS NULL OR p_action NOT IN ('INIT','REPLACE')
     OR p_new_mode IS NULL OR p_new_mode NOT IN ('PERSISTENT_STUDENT','ACADEMIC_CONTEXT')
     OR p_new_start IS NULL OR p_new_start<0 OR p_new_start>=9223372036854775807
     OR p_reason IS NULL OR pg_catalog.btrim(p_reason)=''
     OR (p_action='INIT' AND (p_source IS NOT NULL
         OR p_old_revision IS NOT NULL OR p_old_mode IS NOT NULL
         OR p_old_start IS NOT NULL OR p_old_from IS NOT NULL))
     OR (p_action='REPLACE' AND (p_source IS NULL
         OR p_old_revision IS NULL OR p_old_revision<1
         OR p_old_mode IS NULL OR p_old_mode NOT IN ('PERSISTENT_STUDENT','ACADEMIC_CONTEXT')
         OR p_old_start IS NULL OR p_old_start<0
         OR p_old_from IS NULL)) THEN
    RAISE EXCEPTION 'D1 Roll Policy typed command context invalid';
  END IF;

  -- Frozen global Foundation authorization lock is always first.
  PERFORM pg_catalog.pg_advisory_xact_lock_shared(71001,1);
  SELECT * INTO chosen FROM app_private.d1_roll_policy_p1_version(p_school);
  IF NOT FOUND OR chosen.error_code IS NOT NULL OR chosen.policy_version_id IS NULL
    THEN RAISE EXCEPTION 'D1 Roll Policy global route unavailable'; END IF;
  IF (p_phase='DIRECT' AND chosen.route_mode IS DISTINCT FROM 'DIRECT')
     OR (p_phase='SUBMIT' AND chosen.route_mode IS DISTINCT FROM 'APPROVAL') THEN
    RAISE EXCEPTION 'D1 Roll Policy command phase does not match route';
  END IF;
  kind:=CASE p_phase WHEN 'DIRECT' THEN 'student.roll_policy.change'
             ELSE 'request.submit' END;
  -- Selected version is SERVER derived; the client cannot pick the UUID.
  intent:=pg_catalog.jsonb_build_array(p_school,p_action,p_source,
     p_old_revision,p_old_mode,p_old_start,p_old_from,NULL::date,
     p_new_mode,p_new_start,p_reason,chosen.policy_version_id);

  -- Delegates the exact fixed-shape / verified Principal / SHA-256/JCS and
  -- idempotency advisory locks to the unchanged evidence-writer function.
  SELECT * INTO receipt FROM app_private.d1_roll_policy_receipt_context(
     kind,p_key,intent);
  IF NOT FOUND OR receipt.actor_id IS NULL
     OR receipt.operation_id IS NULL OR receipt.intent_hash IS NULL
     OR pg_catalog.octet_length(receipt.intent_hash)<>32 THEN
    RAISE EXCEPTION 'D1 Roll Policy receipt context invalid';
  END IF;
  -- I06 permits an exact terminal DIRECT receipt to proceed to a separate
  -- persisted-row verifier; this context itself never returns a replay result.
  IF receipt.receipt_id IS NOT NULL
    AND (p_phase IS DISTINCT FROM 'DIRECT'
      OR receipt.receipt_state IS DISTINCT FROM 'SUCCEEDED'
      OR receipt.result_ref IS NULL) THEN
    RAISE EXCEPTION 'D1 Roll Policy nonterminal or unsupported replay denied';
  END IF;
  -- School is the same serialization anchor already used by PLACE/MOVE.
  IF app_private.d1_enrollment_place_lock_school(p_school) IS DISTINCT FROM true THEN
    RAISE EXCEPTION 'D1 Roll Policy School not found';
  END IF;
  IF app_private.d1_roll_policy_actor_all_authorized(
      p_school,receipt.actor_id) IS DISTINCT FROM true THEN
    RAISE EXCEPTION 'D1 Roll Policy School ALL authority denied';
  END IF;
  -- Verify an unchanged exact global P1 identity after the School wait.
  SELECT * INTO after_lock FROM app_private.d1_roll_policy_p1_version(p_school);
  IF NOT FOUND OR after_lock.error_code IS NOT NULL
     OR after_lock.policy_version_id IS DISTINCT FROM chosen.policy_version_id
     OR after_lock.route_mode IS DISTINCT FROM chosen.route_mode THEN
    RAISE EXCEPTION 'D1 Roll Policy global route changed';
  END IF;
  RETURN QUERY SELECT receipt.actor_id,receipt.operation_id,
    chosen.policy_version_id,chosen.route_mode,p_school,kind,receipt.intent_hash;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_roll_policy_command_context(
  uuid,text,text,text,uuid,integer,text,bigint,date,text,bigint,text)
  FROM PUBLIC,anon,authenticated,service_role;
-- Owner-only, no Workflow/direct client EXECUTE until separate I08 approval.
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;

GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE OR REPLACE FUNCTION app_private.d1_roll_policy_revision_transition(
 p_school uuid,p_key text,p_action text,p_source uuid,
 p_expected_revision integer,p_expected_mode text,p_expected_start bigint,
 p_expected_from date,p_new_mode text,p_new_start bigint,p_reason text)
RETURNS uuid LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $body$
DECLARE
  actor uuid;
  operation_id uuid;
  p1_version uuid;
  intent_hash bytea;
  receipt record;
  intent jsonb;
  gate record;
  new_id uuid;
  cutover date;
  new_revision integer;
  changed integer;
  pool_count integer;
  summary jsonb;
BEGIN
  -- Context holds Foundation route/key + School authorization locks.
  -- Both fresh effects and replay require current School ALL authority.
  SELECT c.actor_id,c.operation_id,c.policy_version_id,c.intent_hash
    INTO actor,operation_id,p1_version,intent_hash
  FROM app_private.d1_roll_policy_command_context(
    p_school,'DIRECT',p_key,p_action,p_source,p_expected_revision,
    p_expected_mode,p_expected_start,p_expected_from,p_new_mode,
    p_new_start,p_reason) AS c;
  IF actor IS NULL OR operation_id IS NULL OR p1_version IS NULL
     OR intent_hash IS NULL OR p_new_start>=9223372036854775807 THEN
    RAISE EXCEPTION 'D1 Roll Policy transition context invalid';
  END IF;
  intent:=pg_catalog.jsonb_build_array(p_school,p_action,p_source,
    p_expected_revision,p_expected_mode,p_expected_start,p_expected_from,
    NULL::date,p_new_mode,p_new_start,p_reason,p1_version);
  SELECT * INTO receipt FROM app_private.d1_roll_policy_receipt_context(
    'student.roll_policy.change',p_key,intent);
  IF NOT FOUND OR receipt.actor_id IS DISTINCT FROM actor
    OR receipt.operation_id IS DISTINCT FROM operation_id
    OR receipt.intent_hash IS DISTINCT FROM intent_hash THEN
    RAISE EXCEPTION 'D1 Roll Policy verified receipt context changed';
  END IF;
  IF receipt.receipt_id IS NOT NULL THEN
    IF receipt.receipt_state IS DISTINCT FROM 'SUCCEEDED'
      OR receipt.result_ref IS NULL
      OR app_private.d1_roll_policy_direct_result_rows_match(
        actor,operation_id,p_key,intent_hash,p_school,p_action,
        p_source,receipt.result_ref,p1_version) IS DISTINCT FROM true THEN
      RAISE EXCEPTION 'D1 Roll Policy historical result proof failed';
    END IF;
    RETURN receipt.result_ref;
  END IF;
  -- I03 rechecks on the already acquired School lock in the same transaction.
  SELECT * INTO gate FROM app_private.d1_roll_policy_change_preflight(
    p_school,p_action,p_source,p_expected_revision,p_expected_mode,
    p_expected_start,p_expected_from,NULL::date,p_new_mode,p_new_start);
  IF NOT FOUND OR gate.error_code IS NOT NULL OR gate.business_date IS NULL THEN
    RAISE EXCEPTION 'D1 Roll Policy transition preflight invalid';
  END IF;
  cutover:=gate.business_date;
  IF p_action='INIT' THEN
    new_revision:=1;
  ELSIF p_action='REPLACE' THEN
    new_revision:=gate.source_revision+1;
    UPDATE app_private.roll_policy_revisions
       SET effective_until=cutover,ended_at=pg_catalog.statement_timestamp(),
           ended_by=actor
     WHERE id=p_source AND school_id=p_school
       AND revision=gate.source_revision AND mode=p_expected_mode
       AND start_value=p_expected_start AND effective_from=p_expected_from
       AND effective_until IS NULL
       AND effective_from<cutover;
    GET DIAGNOSTICS changed=ROW_COUNT;
    IF changed<>1 THEN
      RAISE EXCEPTION 'D1 Roll Policy source changed after locked preflight';
    END IF;
  ELSE
    RAISE EXCEPTION 'D1 Roll Policy action invalid';
  END IF;
  -- No caller-controlled new revision UUID, predecessor or date.
  INSERT INTO app_private.roll_policy_revisions(
    school_id,revision,mode,start_value,effective_from,reason,
    supersedes_id,created_by)
  VALUES (p_school,new_revision,p_new_mode,p_new_start,cutover,
          p_reason,CASE WHEN p_action='REPLACE' THEN p_source ELSE NULL END,
          actor)
  RETURNING id INTO new_id;
  IF new_id IS NULL THEN RAISE EXCEPTION 'D1 Roll Policy insert failed'; END IF;
  -- I05 is in the same SQL transaction. Any missing candidate/overflow,
  -- duplicate or failed pool INSERT aborts BOTH this revision and old
  -- source closure, before I06 can publish success evidence.
  pool_count:=app_private.d1_roll_policy_provision_revision_pools(
    p_school,new_id,actor,cutover);
  summary:=pg_catalog.jsonb_build_object(
    'school_id',p_school,'action',p_action,
    'source_policy_id',p_source,'source_revision',p_expected_revision,
    'source_mode',p_expected_mode,'source_start_value',p_expected_start,
    'source_effective_from',p_expected_from,'policy_revision_id',new_id,
    'revision',new_revision,'mode',p_new_mode,'start_value',p_new_start,
    'effective_from',cutover,'selected_p1_version_id',p1_version,
    'allocator_pool_count',pool_count);
  PERFORM app_private.d1_roll_policy_direct_success_evidence(
    actor,operation_id,p_key,intent_hash,p_school,new_id,p_source,
    p_action,p1_version,new_revision,summary);
  IF app_private.d1_roll_policy_direct_result_rows_match(
     actor,operation_id,p_key,intent_hash,p_school,p_action,p_source,
     new_id,p1_version) IS DISTINCT FROM true THEN
    RAISE EXCEPTION 'D1 Roll Policy new result proof failed';
  END IF;
  RETURN new_id;
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;
