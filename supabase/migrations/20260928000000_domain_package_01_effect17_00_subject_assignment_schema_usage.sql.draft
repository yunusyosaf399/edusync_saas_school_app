-- D1C2A runtime correction for Effect 17 packaging.
-- The Teaching executor already has exact column-level SELECT grants on the
-- Foundation Campus and Academic Year parents, but PostgreSQL also requires
-- namespace USAGE before those objects can be resolved. This fragment is placed
-- before Effect 17 begins any split function body so the grant executes at the
-- migration top level. It adds namespace visibility only: no schema CREATE,
-- table privilege, role membership, client grant, or authorization path.
RESET ROLE;
SET ROLE schoolos_schema_owner;
GRANT USAGE ON SCHEMA app TO schoolos_teaching_executor;
RESET ROLE;
