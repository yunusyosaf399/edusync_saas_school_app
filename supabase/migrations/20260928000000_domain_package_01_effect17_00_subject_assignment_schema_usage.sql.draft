-- D1C2A branch-only diagnostic for the Effect 16/17 boundary.
-- If this fragment executes, the base draft (including Effect 16) completed.
RESET ROLE;
SET ROLE schoolos_schema_owner;
GRANT USAGE ON SCHEMA app TO schoolos_teaching_executor;
DO $d1c2a$
BEGIN
  IF NOT pg_catalog.has_schema_privilege('schoolos_teaching_executor','app','USAGE') THEN
    RAISE EXCEPTION 'D1C2A_TEACHING_APP_USAGE_NOT_EFFECTIVE';
  END IF;
  RAISE NOTICE 'D1C2A_EFFECT17_BOUNDARY_REACHED';
END
$d1c2a$;
RESET ROLE;
