    state='OPEN',opened_at=pg_catalog.statement_timestamp()
   WHERE id=first_step;

  INSERT INTO app_private.approval_step_reviewers
    (step_id,reviewer_id,assignment_reason,created_by)
  SELECT first_step,c.candidate_principal_id,'D1_REVIEWER_ROLE_SCOPE',ctx.actor_id
    FROM app_private.d1_teaching_subject_assignment_candidates(new_request,first_step) c;
  GET DIAGNOSTICS candidate_count=ROW_COUNT;
  IF candidate_count=0 THEN
    RAISE EXCEPTION 'D1 Subject assignment step has no reviewer';
  END IF;

  receipt:=app_private.d1_teaching_subject_assignment_receipt(
    'request.submit',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
    p_expected_section_version,new_request,NULL,'SUCCEEDED',
    'D1_TEACHING_SUBJECT_ASSIGNMENT_REQUEST',new_request,
    pg_catalog.jsonb_build_object('request_version',final_version,'state','PENDING'),NULL);

  INSERT INTO app_private.approval_transitions
    (request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
  VALUES
    (new_request,1,NULL,'DRAFT','D1_TEACHING_SUBJECT_ASSIGNMENT_DRAFT',receipt,ctx.actor_id),
    (new_request,2,'DRAFT','SUBMITTED','D1_TEACHING_SUBJECT_ASSIGNMENT_SUBMIT',receipt,ctx.actor_id),
    (new_request,3,'SUBMITTED','PENDING','D1_TEACHING_SUBJECT_ASSIGNMENT_OPEN',receipt,ctx.actor_id);

  PERFORM app_private.d1_teaching_subject_assignment_audit(
    ctx.actor_id,'SUBMIT','CORRECT',p_section_offering_id,p_subject_id,NULL,
    p_source_assignment_id,p_expected_source_employee_id,p_expected_source_assignment_kind,
    p_employee_id,p_assignment_kind,receipt,new_request,p_expected_section_version,
    p_effective_from,p_effective_until,'SUCCEEDED',pg_catalog.gen_random_uuid());

  RETURN QUERY SELECT new_request,final_version;
END $body$;
REVOKE ALL ON FUNCTION app.d1_submit_subject_teacher_assignment_correction(
  uuid,uuid,bigint,uuid,uuid,text,date,uuid,uuid,text,date,date,text,text)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_submit_subject_teacher_assignment_correction(
  uuid,uuid,bigint,uuid,uuid,text,date,uuid,uuid,text,date,date,text,text)
  TO authenticated;

CREATE FUNCTION app.d1_review_subject_teacher_assignment_request(
  p_request_id uuid,p_decision text,p_expected_request_version bigint,
  p_reason text,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint,request_state text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE
  ctx record; req record; step_row record; next_step record; policy_row record;
  lock_row record; assignment_id uuid; n bigint; candidate_count bigint;
  final_version bigint; final_state text; receipt uuid; sequence_no bigint;
  reviewer_role uuid; payload jsonb; subject_id uuid; source_id uuid;
  source_employee uuid; source_kind text; source_from date; source_supersedes uuid;
  employee uuid; kind text; effect_from date; effect_until date;
BEGIN
  IF p_request_id IS NULL OR p_decision NOT IN ('APPROVE','REJECT')
     OR p_expected_request_version IS NULL OR p_expected_request_version<1
     OR p_reason IS NULL OR pg_catalog.length(pg_catalog.btrim(p_reason))=0
  THEN RAISE EXCEPTION 'D1 Subject assignment review intent invalid'; END IF;

  SELECT * INTO ctx FROM app_private.d1_command_receipt_lookup(
    'teaching.subject_assignment.change','request.review',p_idempotency_key,
    pg_catalog.jsonb_build_array(
      p_request_id,p_decision,p_expected_request_version::text,p_reason));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);

  SELECT q.* INTO req FROM app_private.approval_requests q
   WHERE q.id=p_request_id AND q.operation_id=ctx.operation_id FOR UPDATE;
  IF NOT FOUND OR NOT app_private.d1_teaching_subject_assignment_request_payload_valid(
      req.old_snapshot,req.requested_payload)
  THEN RAISE EXCEPTION 'D1 Subject assignment request unavailable'; END IF;

  payload:=req.old_snapshot||req.requested_payload;
  subject_id:=NULLIF(payload->>'subject_id','')::uuid;
  source_id:=NULLIF(payload->>'source_assignment_id','')::uuid;
  source_employee:=NULLIF(payload->>'source_employee_id','')::uuid;
  source_kind:=NULLIF(payload->>'source_assignment_kind','');
  source_from:=NULLIF(payload->>'source_effective_from','')::date;
  source_supersedes:=NULLIF(payload->>'source_supersedes_id','')::uuid;
  employee:=NULLIF(payload->>'employee_id','')::uuid;
  kind:=NULLIF(payload->>'assignment_kind','');
  effect_from:=NULLIF(payload->>'effective_from','')::date;
  effect_until:=NULLIF(payload->>'effective_until','')::date;

  PERFORM s.id FROM app_private.approval_request_steps s
   WHERE s.request_id=p_request_id ORDER BY s.step_number FOR UPDATE;
  SELECT s.* INTO step_row FROM app_private.approval_request_steps s
   WHERE s.request_id=p_request_id AND s.state='OPEN' ORDER BY s.step_number;

  SELECT * INTO lock_row FROM app_private.d1_teaching_subject_assignment_lock_context(
    req.target_ref,subject_id,req.expected_target_version,false,source_id,source_employee,
    source_kind,source_from,source_supersedes,employee,NULL);

  IF ctx.receipt_id IS NOT NULL THEN
    SELECT count(*),min(t.reviewer_role_id::text)::uuid INTO n,reviewer_role
      FROM app_private.approval_reviews v
      JOIN app_private.approval_request_steps s ON s.id=v.step_id
      JOIN app_private.approval_step_templates t
        ON t.id=s.template_id AND t.policy_id=s.policy_id AND t.step_number=s.step_number
     WHERE s.request_id=p_request_id AND v.reviewer_id=ctx.actor_id
       AND v.decision=p_decision
       AND v.expected_request_version=p_expected_request_version;
    IF n<>1 OR reviewer_role IS NULL
       OR NOT app_private.d1_teaching_subject_assignment_authorized(
         ctx.actor_id,'teaching.assignment.approve',
         req.target_ref,subject_id,reviewer_role)
    THEN RAISE EXCEPTION 'D1 Subject assignment reviewer authority revoked'; END IF;

    IF ctx.receipt_state<>'SUCCEEDED' OR ctx.result_ref IS DISTINCT FROM p_request_id
       OR ctx.result_summary IS NULL
       OR pg_catalog.jsonb_typeof(ctx.result_summary)<>'object'
       OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(ctx.result_summary))<>2
       OR NOT (ctx.result_summary ?& ARRAY['request_version','state'])
    THEN RAISE EXCEPTION 'D1 Subject assignment review receipt invalid'; END IF;

    RETURN QUERY SELECT p_request_id,
      (ctx.result_summary->>'request_version')::bigint,ctx.result_summary->>'state';
    RETURN;
  END IF;

  SELECT count(*) INTO n FROM app_private.approval_request_steps s
   WHERE s.request_id=p_request_id AND s.state='OPEN';
  IF lock_row.error_code IS NOT NULL OR req.state<>'PENDING'
     OR req.row_version<>p_expected_request_version
     OR step_row.id IS NULL OR n<>1 OR effect_from>=CURRENT_DATE
  THEN RAISE EXCEPTION 'D1 Subject assignment review state changed'; END IF;

  SELECT * INTO policy_row
    FROM app_private.d1_teaching_subject_assignment_p2_policy(req.target_ref);
  IF policy_row.policy_id IS DISTINCT FROM req.policy_id
     OR policy_row.campus_id IS DISTINCT FROM req.campus_id
  THEN RAISE EXCEPTION 'D1 Subject assignment request policy no longer applies'; END IF;

  SELECT count(*),min(a.id::text)::uuid INTO n,assignment_id
    FROM app_private.approval_step_reviewers a
   WHERE a.step_id=step_row.id AND a.reviewer_id=ctx.actor_id
     AND a.withdrawn_at IS NULL AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
  IF n<>1 OR NOT EXISTS (
    SELECT 1 FROM app_private.d1_teaching_subject_assignment_candidates(
      p_request_id,step_row.id) c WHERE c.candidate_principal_id=ctx.actor_id)
  THEN RAISE EXCEPTION 'D1 Subject assignment reviewer authority denied'; END IF;

  INSERT INTO app_private.approval_reviews
    (reviewer_assignment_id,step_id,reviewer_id,decision,reason,
     expected_request_version,created_by)
  VALUES (
    assignment_id,step_row.id,ctx.actor_id,p_decision,p_reason,
    p_expected_request_version,ctx.actor_id);

