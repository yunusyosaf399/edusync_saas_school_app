-- D1C1B effect 23/36: Student ordinary lifecycle status change core.
-- Static non-executable continuation only. Migration 10 remains .sql.draft.
-- Approved contract: P1 DIRECT/APPROVAL; append numbered status event; synchronize
-- Student projection; departure statuses atomically close active PRIMARY placement and rolls.

SET ROLE schoolos_schema_owner;
GRANT SELECT (id,row_version,current_status,updated_at) ON app_private.students TO schoolos_student_executor;
GRANT UPDATE (current_status,row_version,updated_at) ON app_private.students TO schoolos_student_executor;
GRANT SELECT (id,created_at,created_by,student_id,previous_status,new_status,effective_on,sequence_number,reason,supersedes_id,command_receipt_id),
  INSERT (id,created_by,student_id,previous_status,new_status,effective_on,sequence_number,reason,supersedes_id,command_receipt_id)
  ON app_private.student_status_transitions TO schoolos_student_executor;
GRANT SELECT (id,student_id,section_offering_id,placement_kind,entry_kind,placement_state,effective_from,effective_until,predecessor_id,reason,end_reason,ended_at,ended_by)
  ON app_private.enrollments TO schoolos_student_executor;
GRANT UPDATE (placement_state,effective_until,end_reason,ended_at,ended_by)
  ON app_private.enrollments TO schoolos_student_executor;
GRANT SELECT (id,enrollment_id,student_id,effective_from,effective_until,ended_at,ended_by)
  ON app_private.roll_allocations TO schoolos_student_executor;
GRANT UPDATE (effective_until,ended_at,ended_by) ON app_private.roll_allocations TO schoolos_student_executor;
RESET ROLE;

GRANT CREATE ON SCHEMA app_private TO schoolos_evidence_writer;
SET ROLE schoolos_evidence_writer;
CREATE FUNCTION app_private.d1_student_status_command_context(p_command_kind text,p_idempotency_key text,p_intent jsonb)
RETURNS TABLE(actor_id uuid,operation_id uuid,receipt_id uuid,result_ref uuid,result_summary jsonb,receipt_state text,intent_hash bytea)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE v_actor uuid; v_operation uuid; v_hash bytea; v_digest bytea; v_resource bigint; v_receipt app_private.command_receipts%ROWTYPE;
BEGIN
  IF p_command_kind NOT IN ('student.status.change','request.submit','request.review','request.apply')
     OR p_idempotency_key IS NULL OR pg_catalog.length(pg_catalog.btrim(p_idempotency_key))=0
     OR p_intent IS NULL OR pg_catalog.jsonb_typeof(p_intent)<>'array'
     OR NOT ((p_command_kind IN ('student.status.change','request.submit') AND pg_catalog.jsonb_array_length(p_intent)=5)
          OR (p_command_kind='request.review' AND pg_catalog.jsonb_array_length(p_intent)=4)
          OR (p_command_kind='request.apply' AND pg_catalog.jsonb_array_length(p_intent)=2))
  THEN RAISE EXCEPTION 'D1 Student status receipt operation phase or shape unsupported'; END IF;
  PERFORM pg_catalog.pg_advisory_xact_lock_shared(71001,1);
  v_actor:=app_private.current_principal_id();
  IF v_actor IS NULL THEN RAISE EXCEPTION 'D1 Student status command requires verified actor'; END IF;
  SELECT o.id INTO v_operation FROM app_private.operation_contracts o
   WHERE o.code='student.status.change' AND o.contract_version=1 AND o.handler_key='student.status.change' AND o.enabled;
  IF v_operation IS NULL THEN RAISE EXCEPTION 'D1 Student status operation is not enabled'; END IF;
  v_hash:=pg_catalog.sha256(pg_catalog.convert_to(app_private.d1_jcs_typed(pg_catalog.jsonb_build_object(
    'canonicalization_version',1,'operation_code','student.status.change','operation_contract_version','1',
    'operation_id',v_operation::text,'command_kind',p_command_kind,'principal_id',v_actor::text,
    'intent',p_intent,'idempotency_key',p_idempotency_key)),'UTF8'));
  v_digest:=pg_catalog.sha256(pg_catalog.convert_to(v_actor::text||'|'||v_operation::text||'|'||p_idempotency_key,'UTF8'));
  v_resource:=pg_catalog.get_byte(v_digest,0)::bigint*16777216+pg_catalog.get_byte(v_digest,1)::bigint*65536+
    pg_catalog.get_byte(v_digest,2)::bigint*256+pg_catalog.get_byte(v_digest,3)::bigint;
  IF v_resource>2147483647 THEN v_resource:=v_resource-4294967296; END IF;
  PERFORM pg_catalog.pg_advisory_xact_lock(71002,v_resource::integer);
  SELECT r.* INTO v_receipt FROM app_private.command_receipts r
   WHERE r.principal_id=v_actor AND r.operation_id=v_operation AND r.idempotency_key=p_idempotency_key;
  IF FOUND THEN
    IF v_receipt.canonicalization_version<>1 OR v_receipt.canonical_payload_hash IS DISTINCT FROM v_hash
       OR v_receipt.command_kind IS DISTINCT FROM p_command_kind THEN
      RAISE EXCEPTION 'D1 Student status idempotency key conflicts with prior intent'; END IF;
    RETURN QUERY SELECT v_actor,v_operation,v_receipt.id,v_receipt.result_ref,v_receipt.result_summary,v_receipt.state,v_hash; RETURN;
  END IF;
  RETURN QUERY SELECT v_actor,v_operation,NULL::uuid,NULL::uuid,NULL::jsonb,NULL::text,v_hash;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_student_status_command_context(text,text,jsonb) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_student_status_command_context(text,text,jsonb)
  TO schoolos_student_executor,schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_evidence_writer;

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE FUNCTION app_private.d1_student_status_authorized(
  p_principal uuid,p_permission text,p_student uuid,p_reviewer_role uuid DEFAULT NULL
) RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE at_time timestamptz:=pg_catalog.clock_timestamp(); on_date date:=at_time::date; placement record; n bigint;
BEGIN
  IF p_principal IS NULL OR p_student IS NULL OR p_permission NOT IN ('student.status.change','student.status.approve')
     OR NOT EXISTS (SELECT 1 FROM app_private.students s WHERE s.id=p_student)
     OR NOT EXISTS (SELECT 1 FROM app_private.principals p JOIN app_private.principal_auth_bindings b ON b.principal_id=p.id
       WHERE p.id=p_principal AND p.kind='INDIVIDUAL' AND p.state='ACTIVE' AND p.person_id IS NOT NULL AND b.auth_user_id IS NOT NULL)
  THEN RETURN false; END IF;
  IF p_reviewer_role IS NOT NULL AND NOT EXISTS (
    SELECT 1 FROM app_private.principal_role_assignments a JOIN app_private.roles r ON r.id=a.role_id
     WHERE a.principal_id=p_principal AND a.role_id=p_reviewer_role AND a.principal_kind='INDIVIDUAL'
       AND a.context_kind='INDIVIDUAL' AND r.state='ACTIVE' AND NOT r.family_only
       AND a.valid_from<=at_time AND (a.valid_until IS NULL OR at_time<a.valid_until)
       AND (a.revoked_at IS NULL OR at_time<a.revoked_at)) THEN RETURN false; END IF;
  SELECT count(*) INTO n FROM app_private.enrollments e
   WHERE e.student_id=p_student AND e.placement_kind='PRIMARY' AND e.placement_state='ACTIVE'
     AND e.effective_from<=on_date AND (e.effective_until IS NULL OR on_date<e.effective_until);
  IF n>1 THEN RETURN false; END IF;
  IF n=1 THEN
    SELECT so.id AS section_id,co.id AS class_id,co.campus_id INTO placement
      FROM app_private.enrollments e JOIN app_private.section_offerings so ON so.id=e.section_offering_id
      JOIN app_private.class_offerings co ON co.id=so.class_offering_id
     WHERE e.student_id=p_student AND e.placement_kind='PRIMARY' AND e.placement_state='ACTIVE'
       AND e.effective_from<=on_date AND (e.effective_until IS NULL OR on_date<e.effective_until);
  END IF;
  RETURN EXISTS (
    SELECT 1 FROM app_private.assignment_permission_scopes sc
    JOIN app_private.principal_role_assignments a ON a.id=sc.assignment_id
    JOIN app_private.role_permission_grants g ON g.id=sc.grant_id
    JOIN app_private.permission_scope_contracts c ON c.id=sc.scope_contract_id
    JOIN app_private.permissions p ON p.id=sc.permission_id JOIN app_private.roles r ON r.id=sc.role_id
     WHERE a.principal_id=p_principal AND a.principal_kind='INDIVIDUAL' AND a.context_kind='INDIVIDUAL'
       AND a.role_id=sc.role_id AND g.role_id=sc.role_id AND g.permission_id=sc.permission_id
       AND c.permission_id=sc.permission_id AND c.scope_kind=sc.scope_kind AND c.resolver_key=sc.resolver_key AND c.enabled
       AND p.code=p_permission AND p.state='ENABLED' AND NOT p.family_safe AND r.state='ACTIVE' AND NOT r.family_only
       AND (p_reviewer_role IS NULL OR sc.role_id=p_reviewer_role)
       AND a.valid_from<=at_time AND (a.valid_until IS NULL OR at_time<a.valid_until) AND (a.revoked_at IS NULL OR at_time<a.revoked_at)
       AND g.valid_from<=at_time AND (g.valid_until IS NULL OR at_time<g.valid_until) AND (g.revoked_at IS NULL OR at_time<g.revoked_at)
       AND sc.valid_from<=at_time AND (sc.valid_until IS NULL OR at_time<sc.valid_until) AND (sc.revoked_at IS NULL OR at_time<sc.revoked_at)
       AND sc.resolver_key='DIRECT'
       AND ((sc.scope_kind='ALL' AND sc.campus_id IS NULL)
         OR (n=1 AND sc.scope_kind='CAMPUS' AND sc.campus_id=placement.campus_id)
         OR (n=1 AND sc.scope_kind='CLASS' AND sc.class_offering_id=placement.class_id)
         OR (n=1 AND sc.scope_kind='SECTION' AND sc.section_offering_id=placement.section_id))
  );
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_student_status_authorized(uuid,text,uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_student_status_authorized(uuid,text,uuid,uuid)
 TO schoolos_student_executor,schoolos_workflow_executor,schoolos_read_executor;

CREATE FUNCTION app_private.d1_student_status_policy(p_student uuid)
RETURNS TABLE(policy_id uuid,route_mode text,campus_id uuid)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE at_time timestamptz:=pg_catalog.clock_timestamp(); on_date date:=at_time::date; target_campus uuid;
  n bigint; school_n bigint; campus_n bigint; school_p uuid; school_r text; campus_p uuid; campus_r text;
  chosen uuid; route text; steps bigint; invalid bigint;
BEGIN
  SELECT count(*) INTO n FROM app_private.enrollments e WHERE e.student_id=p_student AND e.placement_kind='PRIMARY'
    AND e.placement_state='ACTIVE' AND e.effective_from<=on_date AND (e.effective_until IS NULL OR on_date<e.effective_until);
  IF n>1 THEN RETURN; END IF;
  IF n=1 THEN SELECT co.campus_id INTO target_campus FROM app_private.enrollments e
    JOIN app_private.section_offerings so ON so.id=e.section_offering_id JOIN app_private.class_offerings co ON co.id=so.class_offering_id
    WHERE e.student_id=p_student AND e.placement_kind='PRIMARY' AND e.placement_state='ACTIVE'
      AND e.effective_from<=on_date AND (e.effective_until IS NULL OR on_date<e.effective_until); END IF;
  SELECT count(*),min(p.id::text)::uuid,min(p.d1_route_mode) INTO school_n,school_p,school_r
    FROM app_private.approval_policy_versions p JOIN app_private.operation_contracts o ON o.id=p.operation_id
   WHERE o.code='student.status.change' AND o.contract_version=1 AND o.enabled AND p.state='ACTIVE' AND p.campus_id IS NULL
     AND p.d1_route_mode IN ('DIRECT','APPROVAL') AND p.effective_from<=at_time AND (p.effective_until IS NULL OR at_time<p.effective_until);
  IF target_campus IS NULL THEN IF school_n<>1 THEN RETURN; END IF; chosen:=school_p; route:=school_r;
  ELSE
    SELECT count(*),min(p.id::text)::uuid,min(p.d1_route_mode) INTO campus_n,campus_p,campus_r
      FROM app_private.approval_policy_versions p JOIN app_private.operation_contracts o ON o.id=p.operation_id
     WHERE o.code='student.status.change' AND o.contract_version=1 AND o.enabled AND p.state='ACTIVE' AND p.campus_id=target_campus
       AND p.d1_route_mode IN ('DIRECT','APPROVAL') AND p.effective_from<=at_time AND (p.effective_until IS NULL OR at_time<p.effective_until);
    IF campus_n>1 OR school_n>1 THEN RETURN; END IF;
    IF campus_n=1 THEN chosen:=campus_p; route:=campus_r; ELSIF school_n=1 THEN chosen:=school_p; route:=school_r; ELSE RETURN; END IF;
  END IF;
  IF route='APPROVAL' THEN
    SELECT count(*),count(*) FILTER (WHERE r.id IS NULL OR r.state<>'ACTIVE' OR t.required_reviews<>1
      OR t.selection_resolver_key IS DISTINCT FROM 'D1_REVIEWER_ROLE_SCOPE') INTO steps,invalid
      FROM app_private.approval_step_templates t LEFT JOIN app_private.roles r ON r.id=t.reviewer_role_id WHERE t.policy_id=chosen;
    IF steps=0 OR invalid<>0 THEN RETURN; END IF;
  END IF;
  RETURN QUERY SELECT chosen,route,target_campus;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_student_status_policy(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_student_status_policy(uuid) TO schoolos_student_executor,schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;

GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE FUNCTION app_private.d1_student_status_edge_valid(p_old text,p_new text)
RETURNS boolean LANGUAGE sql IMMUTABLE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
 SELECT (p_old,p_new) IN (('ACTIVE','SUSPENDED'),('ACTIVE','WITHDRAWN'),('ACTIVE','TRANSFERRED'),('ACTIVE','GRADUATED'),
   ('ACTIVE','EXPELLED'),('ACTIVE','DECEASED'),('SUSPENDED','ACTIVE'),('SUSPENDED','WITHDRAWN'),
   ('SUSPENDED','TRANSFERRED'),('SUSPENDED','EXPELLED'),('SUSPENDED','DECEASED'),('GRADUATED','ALUMNI'));
$body$;
REVOKE ALL ON FUNCTION app_private.d1_student_status_edge_valid(text,text) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_student_status_edge_valid(text,text) TO schoolos_student_executor,schoolos_workflow_executor;

CREATE FUNCTION app_private.d1_student_status_lock_context(p_student uuid,p_expected_version bigint DEFAULT NULL)
RETURNS TABLE(student_version bigint,current_status text,last_transition_id uuid,last_effective_on date,last_sequence bigint,
  enrollment_id uuid,enrollment_from date,error_code text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE s app_private.students%ROWTYPE; st app_private.student_status_transitions%ROWTYPE; e app_private.enrollments%ROWTYPE; n bigint;
BEGIN
  SELECT * INTO s FROM app_private.students WHERE id=p_student FOR UPDATE;
  IF NOT FOUND THEN RETURN QUERY SELECT NULL::bigint,NULL::text,NULL::uuid,NULL::date,NULL::bigint,NULL::uuid,NULL::date,'D1_STUDENT_STATUS_STUDENT_MISSING'; RETURN; END IF;
  IF p_expected_version IS NOT NULL AND s.row_version IS DISTINCT FROM p_expected_version THEN
    RETURN QUERY SELECT s.row_version,s.current_status,NULL::uuid,NULL::date,NULL::bigint,NULL::uuid,NULL::date,'D1_STUDENT_STATUS_VERSION_STALE'; RETURN; END IF;
  SELECT t.* INTO st FROM app_private.student_status_transitions t
   WHERE t.student_id=p_student AND NOT EXISTS (SELECT 1 FROM app_private.student_status_transitions x WHERE x.student_id=p_student AND x.supersedes_id=t.id)
   ORDER BY t.effective_on DESC,t.sequence_number DESC LIMIT 1 FOR UPDATE;
  IF NOT FOUND OR st.new_status IS DISTINCT FROM s.current_status THEN
    RETURN QUERY SELECT s.row_version,s.current_status,NULL::uuid,NULL::date,NULL::bigint,NULL::uuid,NULL::date,'D1_STUDENT_STATUS_PROJECTION_DIVERGED'; RETURN; END IF;
  SELECT count(*) INTO n FROM app_private.enrollments x WHERE x.student_id=p_student AND x.placement_kind='PRIMARY' AND x.placement_state='ACTIVE' AND x.effective_until IS NULL;
  IF n>1 THEN RETURN QUERY SELECT s.row_version,s.current_status,st.id,st.effective_on,st.sequence_number,NULL::uuid,NULL::date,'D1_STUDENT_STATUS_ACTIVE_PLACEMENT_AMBIGUOUS'; RETURN; END IF;
  IF n=1 THEN SELECT * INTO e FROM app_private.enrollments x WHERE x.student_id=p_student AND x.placement_kind='PRIMARY' AND x.placement_state='ACTIVE' AND x.effective_until IS NULL FOR UPDATE;
    PERFORM r.id FROM app_private.roll_allocations r WHERE r.student_id=p_student AND r.enrollment_id=e.id AND r.effective_until IS NULL ORDER BY r.id FOR UPDATE;
  END IF;
  RETURN QUERY SELECT s.row_version,s.current_status,st.id,st.effective_on,st.sequence_number,e.id,e.effective_from,NULL::text;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_student_status_lock_context(uuid,bigint) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_student_status_lock_context(uuid,bigint) TO schoolos_student_executor,schoolos_workflow_executor;

CREATE FUNCTION app_private.d1_student_status_preflight(p_student uuid,p_expected_version bigint,p_expected_status text,
  p_expected_transition uuid,p_new_status text,p_effective_on date)
RETURNS TABLE(eligible boolean,error_code text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE c record;
BEGIN
  IF p_new_status NOT IN ('ACTIVE','SUSPENDED','WITHDRAWN','TRANSFERRED','GRADUATED','EXPELLED','DECEASED','ALUMNI')
     OR p_effective_on IS NULL OR p_effective_on>pg_catalog.current_date() THEN RETURN QUERY SELECT false,'D1_STUDENT_STATUS_INTENT_INVALID'; RETURN; END IF;
  SELECT * INTO c FROM app_private.d1_student_status_lock_context(p_student,p_expected_version);
  IF c.error_code IS NOT NULL THEN RETURN QUERY SELECT false,c.error_code; RETURN; END IF;
  IF c.current_status IS DISTINCT FROM p_expected_status OR c.last_transition_id IS DISTINCT FROM p_expected_transition THEN
    RETURN QUERY SELECT false,'D1_STUDENT_STATUS_SOURCE_STALE'; RETURN; END IF;
  IF NOT app_private.d1_student_status_edge_valid(c.current_status,p_new_status) THEN RETURN QUERY SELECT false,'D1_STUDENT_STATUS_EDGE_DENIED'; RETURN; END IF;
  IF p_effective_on<c.last_effective_on THEN RETURN QUERY SELECT false,'D1_STUDENT_STATUS_BACKDATE_BREAKS_CHAIN'; RETURN; END IF;
  IF p_new_status IN ('WITHDRAWN','TRANSFERRED','GRADUATED','EXPELLED','DECEASED') THEN
    IF c.enrollment_id IS NULL THEN RETURN QUERY SELECT false,'D1_STUDENT_STATUS_DEPARTURE_PLACEMENT_REQUIRED'; RETURN; END IF;
    IF p_effective_on<=c.enrollment_from THEN RETURN QUERY SELECT false,'D1_STUDENT_STATUS_DEPARTURE_DATE_INVALID'; RETURN; END IF;
    IF EXISTS (SELECT 1 FROM app_private.roll_allocations r WHERE r.enrollment_id=c.enrollment_id AND r.student_id=p_student
      AND r.effective_until IS NULL AND p_effective_on<=r.effective_from) THEN
      RETURN QUERY SELECT false,'D1_STUDENT_STATUS_ROLL_END_DATE_INVALID'; RETURN; END IF;
  ELSIF p_new_status='ACTIVE' AND c.current_status='SUSPENDED' AND c.enrollment_id IS NULL THEN
    RETURN QUERY SELECT false,'D1_STUDENT_STATUS_SUSPENSION_PLACEMENT_MISSING'; RETURN;
  ELSIF p_new_status='ALUMNI' AND c.enrollment_id IS NOT NULL THEN
    RETURN QUERY SELECT false,'D1_STUDENT_STATUS_ALUMNI_ACTIVE_PLACEMENT'; RETURN;
  END IF;
  RETURN QUERY SELECT true,NULL::text;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_student_status_preflight(uuid,bigint,text,uuid,text,date) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_student_status_preflight(uuid,bigint,text,uuid,text,date) TO schoolos_student_executor,schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;