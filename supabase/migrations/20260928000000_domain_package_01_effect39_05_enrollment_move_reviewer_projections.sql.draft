-- MOVE reviewer helpers keep their Authz Reader owner and existing column grants.
-- Permit only this operation's request/contract rows, never generic request reads.
SET ROLE schoolos_schema_owner;
CREATE POLICY d1_effect39_move_authz_requests
  ON app_private.approval_requests FOR SELECT TO schoolos_authz_reader
  USING (EXISTS (SELECT 1 FROM app_private.operation_contracts o
    WHERE o.id=operation_id AND o.code='student.enrollment.move'));
CREATE POLICY d1_effect39_move_authz_operation
  ON app_private.operation_contracts FOR SELECT TO schoolos_authz_reader
  USING (code='student.enrollment.move');
RESET ROLE;
GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE OR REPLACE FUNCTION app_private.d1_enrollment_move_candidates(p_request uuid,p_step uuid)
RETURNS TABLE(candidate_principal_id uuid)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; templ record; requester_person uuid; src uuid; dst uuid;
BEGIN
  SELECT q.id,q.requester_id,q.old_snapshot,q.requested_payload INTO req
    FROM app_private.approval_requests q JOIN app_private.operation_contracts o ON o.id=q.operation_id
    WHERE q.id=p_request AND o.code='student.enrollment.move';
  SELECT t.id,t.selection_resolver_key,t.reviewer_role_id INTO templ FROM app_private.approval_request_steps s JOIN app_private.approval_step_templates t ON t.id=s.template_id
   WHERE s.id=p_step AND s.request_id=p_request;
  IF req.id IS NULL OR templ.id IS NULL OR templ.selection_resolver_key IS DISTINCT FROM 'D1_REVIEWER_ROLE_SCOPE' THEN RETURN; END IF;
  src:=NULLIF(req.old_snapshot->>'source_section_offering_id','')::uuid;
  dst:=NULLIF(req.requested_payload->>'destination_section_offering_id','')::uuid;
  IF src IS NULL OR dst IS NULL THEN RETURN; END IF;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id;
  RETURN QUERY SELECT p.id FROM app_private.principals p
   WHERE p.kind='INDIVIDUAL' AND p.state='ACTIVE' AND p.person_id IS NOT NULL
     AND p.id<>req.requester_id AND p.person_id<>requester_person
     AND app_private.d1_enrollment_move_authorized(p.id,'student.enrollment.approve',src,dst,templ.reviewer_role_id)
   ORDER BY p.id;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_enrollment_move_candidates(uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_enrollment_move_candidates(uuid,uuid) TO schoolos_workflow_executor,schoolos_read_executor;

CREATE OR REPLACE FUNCTION app_private.d1_enrollment_move_reviews_live(p_request uuid)
RETURNS boolean LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; requester_person uuid; source_section uuid; destination_section uuid; s record; n bigint; reviewer uuid; reviewer_person uuid; seen bigint:=0;
BEGIN
  SELECT q.id,q.requester_id,q.old_snapshot,q.requested_payload INTO req FROM app_private.approval_requests q JOIN app_private.operation_contracts o ON o.id=q.operation_id
   WHERE q.id=p_request AND o.code='student.enrollment.move'; IF NOT FOUND THEN RETURN false; END IF;
  BEGIN source_section:=NULLIF(req.old_snapshot->>'source_section_offering_id','')::uuid;
    destination_section:=NULLIF(req.requested_payload->>'destination_section_offering_id','')::uuid;
  EXCEPTION WHEN invalid_text_representation THEN RETURN false; END;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id;
  IF requester_person IS NULL OR source_section IS NULL OR destination_section IS NULL THEN RETURN false; END IF;
  FOR s IN SELECT st.id,st.state,t.reviewer_role_id FROM app_private.approval_request_steps st
      JOIN app_private.approval_step_templates t ON t.id=st.template_id WHERE st.request_id=p_request ORDER BY st.step_number LOOP
    seen:=seen+1; IF s.state<>'APPROVED' OR s.reviewer_role_id IS NULL THEN RETURN false; END IF;
    SELECT count(*),min(v.reviewer_id::text)::uuid INTO n,reviewer FROM app_private.approval_reviews v
      JOIN app_private.approval_step_reviewers a ON a.id=v.reviewer_assignment_id AND a.step_id=s.id
     WHERE v.step_id=s.id AND v.decision='APPROVE' AND a.reviewer_id=v.reviewer_id AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
    IF n<>1 OR reviewer IS NULL THEN RETURN false; END IF;
    SELECT p.person_id INTO reviewer_person FROM app_private.principals p WHERE p.id=reviewer;
    IF reviewer_person IS NULL OR reviewer_person=requester_person
       OR NOT app_private.d1_enrollment_move_authorized(reviewer,'student.enrollment.approve',source_section,destination_section,s.reviewer_role_id)
      THEN RETURN false; END IF;
  END LOOP;
  RETURN seen>0;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_enrollment_move_reviews_live(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_enrollment_move_reviews_live(uuid) TO schoolos_workflow_executor,schoolos_read_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;
