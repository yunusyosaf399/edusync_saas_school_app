-- D1C1B effect 22/36: Student Special P2 submit command.
-- Static non-executable continuation only.

GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;

CREATE FUNCTION app.d1_submit_student_special_correction(
  p_student_id uuid,p_disability_indicator boolean,p_orphan_indicator boolean,
  p_blood_group_code text,p_reason text,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; locked record; policy_row record; pre record; template_row record; req record;
  requested jsonb; old_snapshot jsonb; new_request uuid:=pg_catalog.gen_random_uuid(); first_step uuid;
  candidate_count bigint; final_version bigint; receipt uuid;
  blood text:=NULLIF(pg_catalog.btrim(p_blood_group_code),'');
BEGIN
  requested:=pg_catalog.jsonb_build_object('disability_indicator',p_disability_indicator,
    'orphan_indicator',p_orphan_indicator,'blood_group_code',blood);
  IF p_student_id IS NULL OR p_reason IS NULL OR pg_catalog.length(pg_catalog.btrim(p_reason))=0
     OR app_private.d1_student_special_payload_valid(requested) IS DISTINCT FROM true THEN
    RAISE EXCEPTION 'D1 Student special request intent invalid'; END IF;
  SELECT * INTO ctx FROM app_private.d1_command_receipt_lookup(
    'student.special.correct','request.submit',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_student_id,p_disability_indicator,p_orphan_indicator,blood,p_reason));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT * INTO locked FROM app_private.d1_student_special_lock_context(p_student_id,NULL);
  IF NOT app_private.d1_student_special_authorized(ctx.actor_id,'student.special.correct',p_student_id,NULL) THEN
    RAISE EXCEPTION 'D1 Student special request authority denied'; END IF;
  IF ctx.receipt_id IS NOT NULL THEN
    SELECT r.requester_id,r.target_ref INTO req FROM app_private.approval_requests r
     WHERE r.id=ctx.result_ref AND r.operation_id=ctx.operation_id;
    IF NOT FOUND OR req.requester_id IS DISTINCT FROM ctx.actor_id OR req.target_ref IS DISTINCT FROM p_student_id
       OR ctx.receipt_state<>'SUCCEEDED' OR ctx.result_ref IS NULL
       OR ctx.result_summary IS NULL OR pg_catalog.jsonb_typeof(ctx.result_summary)<>'object'
       OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(ctx.result_summary))<>2
       OR NOT (ctx.result_summary ?& ARRAY['request_version','state']) OR ctx.result_summary->>'state'<>'PENDING' THEN
      RAISE EXCEPTION 'D1 Student special submit receipt is not replayable'; END IF;
    RETURN QUERY SELECT ctx.result_ref,(ctx.result_summary->>'request_version')::bigint; RETURN;
  END IF;
  IF locked.student_version IS NULL OR locked.error_code IS NOT NULL THEN
    RAISE EXCEPTION 'D1 Student special source unavailable: %',pg_catalog.coalesce(locked.error_code,'UNKNOWN'); END IF;
  SELECT * INTO policy_row FROM app_private.d1_student_special_p2_policy(p_student_id);
  IF policy_row.policy_id IS NULL THEN RAISE EXCEPTION 'D1 Student special approval policy unavailable'; END IF;
  IF NOT EXISTS (
    SELECT 1 FROM app_private.operation_contracts o JOIN app_private.permissions rp ON rp.id=o.review_permission_id
     WHERE o.id=ctx.operation_id AND o.code='student.special.correct' AND o.contract_version=1 AND o.enabled
       AND rp.code='student.special.approve' AND rp.state='ENABLED' AND NOT rp.family_safe) THEN
    RAISE EXCEPTION 'D1 Student special review permission unavailable'; END IF;
  SELECT * INTO pre FROM app_private.d1_student_special_preflight(p_student_id,locked.student_version,
    locked.source_snapshot_id,locked.disability_indicator,locked.orphan_indicator,locked.blood_group_code,
    locked.source_effective_from,locked.source_supersedes_id,p_disability_indicator,p_orphan_indicator,blood);
  IF NOT FOUND OR pre.eligible IS DISTINCT FROM true THEN
    RAISE EXCEPTION 'D1 Student special request denied: %',pg_catalog.coalesce(pre.error_code,'PREFLIGHT_UNAVAILABLE'); END IF;
  old_snapshot:=pg_catalog.jsonb_build_object('source_snapshot_id',locked.source_snapshot_id,
    'disability_indicator',locked.disability_indicator,'orphan_indicator',locked.orphan_indicator,
    'blood_group_code',locked.blood_group_code,'source_effective_from',locked.source_effective_from,
    'source_supersedes_id',locked.source_supersedes_id,'source_present',true);
  INSERT INTO app_private.approval_requests
    (id,operation_id,payload_schema_version,policy_id,requester_id,campus_id,target_ref,
     expected_target_version,reason,old_snapshot,requested_payload,created_by)
  VALUES (new_request,ctx.operation_id,1,policy_row.policy_id,ctx.actor_id,policy_row.campus_id,p_student_id,
    locked.student_version,p_reason,old_snapshot,requested,ctx.actor_id);
  UPDATE app_private.approval_requests SET state='SUBMITTED',submitted_at=pg_catalog.statement_timestamp() WHERE id=new_request;
  FOR template_row IN SELECT t.id,t.step_number,t.required_reviews FROM app_private.approval_step_templates t
     WHERE t.policy_id=policy_row.policy_id ORDER BY t.step_number LOOP
    IF template_row.step_number=1 THEN first_step:=pg_catalog.gen_random_uuid(); END IF;
    INSERT INTO app_private.approval_request_steps
      (id,request_id,policy_id,template_id,step_number,required_reviews,created_by)
    VALUES (CASE WHEN template_row.step_number=1 THEN first_step ELSE pg_catalog.gen_random_uuid() END,
      new_request,policy_row.policy_id,template_row.id,template_row.step_number,template_row.required_reviews,ctx.actor_id);
  END LOOP;
  IF first_step IS NULL THEN RAISE EXCEPTION 'D1 Student special policy has no first step'; END IF;
  UPDATE app_private.approval_requests SET state='PENDING' WHERE id=new_request RETURNING row_version INTO final_version;
  UPDATE app_private.approval_request_steps SET state='OPEN',opened_at=pg_catalog.statement_timestamp() WHERE id=first_step;
  INSERT INTO app_private.approval_step_reviewers(step_id,reviewer_id,assignment_reason,created_by)
    SELECT first_step,c.candidate_principal_id,'D1_REVIEWER_ROLE_SCOPE',ctx.actor_id
      FROM app_private.d1_student_special_candidates(new_request,first_step) c;
  GET DIAGNOSTICS candidate_count=ROW_COUNT;
  IF candidate_count=0 THEN RAISE EXCEPTION 'D1 Student special step has no reviewer'; END IF;
  receipt:=app_private.d1_student_special_receipt('request.submit',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
    locked.student_version,new_request,NULL,'SUCCEEDED','D1_STUDENT_SPECIAL_REQUEST',new_request,
    pg_catalog.jsonb_build_object('request_version',final_version,'state','PENDING'),NULL);
  INSERT INTO app_private.approval_transitions(request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
  VALUES (new_request,1,NULL,'DRAFT','D1_STUDENT_SPECIAL_DRAFT',receipt,ctx.actor_id),
    (new_request,2,'DRAFT','SUBMITTED','D1_STUDENT_SPECIAL_SUBMIT',receipt,ctx.actor_id),
    (new_request,3,'SUBMITTED','PENDING','D1_STUDENT_SPECIAL_OPEN',receipt,ctx.actor_id);
  PERFORM app_private.d1_student_special_audit(ctx.actor_id,'SUBMIT',p_student_id,locked.source_snapshot_id,
    receipt,new_request,locked.student_version,'PENDING',NULL,pg_catalog.gen_random_uuid());
  RETURN QUERY SELECT new_request,final_version;
END $body$;
REVOKE ALL ON FUNCTION app.d1_submit_student_special_correction(uuid,boolean,boolean,text,text,text)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_submit_student_special_correction(uuid,boolean,boolean,text,text,text) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;
