-- Effect 20 P1 review/apply/read path. This file continues under schoolos_workflow_executor
-- from the preceding submit fragment and resets role before its read/guard sections.
CREATE FUNCTION app.d1_review_employee_experience_request(
  p_request_id uuid,p_decision text,p_expected_request_version bigint,p_reason text,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint,request_state text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; req record; step_row record; next_step record; policy_row record; assignment_id uuid;
  n bigint; candidate_count bigint; final_version bigint; final_state text; receipt uuid; reviewer_role uuid; action text;
BEGIN
  IF p_request_id IS NULL OR p_decision NOT IN ('APPROVE','REJECT') OR p_expected_request_version IS NULL OR p_expected_request_version<1
     OR p_reason IS NULL OR pg_catalog.length(pg_catalog.btrim(p_reason))=0 THEN RAISE EXCEPTION 'D1 Employee experience review intent invalid'; END IF;
  SELECT * INTO ctx FROM app_private.d1_employee_experience_command_context('request.review',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_request_id,p_decision,p_expected_request_version::text,p_reason));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT q.* INTO req FROM app_private.approval_requests q WHERE q.id=p_request_id AND q.operation_id=ctx.operation_id FOR UPDATE;
  IF NOT FOUND OR req.expected_target_version IS NULL OR req.policy_id IS NULL THEN RAISE EXCEPTION 'D1 Employee experience request missing'; END IF;
  action:=req.requested_payload->>'action'; IF action NOT IN ('ADD','CORRECT','ARCHIVE') THEN RAISE EXCEPTION 'D1 Employee experience request payload malformed'; END IF;
  SELECT * INTO policy_row FROM app_private.d1_employee_experience_policy(req.target_ref);
  IF policy_row.policy_id IS DISTINCT FROM req.policy_id OR policy_row.route_mode IS DISTINCT FROM 'APPROVAL' THEN
    RAISE EXCEPTION 'D1 Employee experience request policy no longer applies'; END IF;
  IF ctx.receipt_id IS NOT NULL THEN
    SELECT count(*),min(t.reviewer_role_id::text)::uuid INTO n,reviewer_role
      FROM app_private.approval_reviews v JOIN app_private.approval_request_steps s ON s.id=v.step_id
      JOIN app_private.approval_step_templates t ON t.id=s.template_id
     WHERE s.request_id=p_request_id AND v.reviewer_id=ctx.actor_id AND v.decision=p_decision
       AND v.expected_request_version=p_expected_request_version;
    IF n<>1 OR reviewer_role IS NULL OR NOT app_private.d1_employee_experience_authorized(
      ctx.actor_id,'employee.experience.approve',req.target_ref,reviewer_role) THEN
      RAISE EXCEPTION 'D1 Employee experience reviewer authority revoked'; END IF;
    IF ctx.receipt_state<>'SUCCEEDED' OR ctx.result_ref IS DISTINCT FROM p_request_id OR ctx.result_summary IS NULL
       OR NOT (ctx.result_summary ?& ARRAY['request_version','state']) THEN RAISE EXCEPTION 'D1 Employee experience review receipt invalid'; END IF;
    RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,ctx.result_summary->>'state'; RETURN; END IF;
  SELECT s.* INTO step_row FROM app_private.approval_request_steps s
   WHERE s.request_id=p_request_id AND s.state='OPEN' ORDER BY s.step_number LIMIT 1 FOR UPDATE;
  IF req.state<>'PENDING' OR req.row_version<>p_expected_request_version OR step_row.id IS NULL THEN
    RAISE EXCEPTION 'D1 Employee experience review state changed'; END IF;
  SELECT count(*),min(a.id::text)::uuid INTO n,assignment_id FROM app_private.approval_step_reviewers a
   WHERE a.step_id=step_row.id AND a.reviewer_id=ctx.actor_id AND a.withdrawn_at IS NULL AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
  IF n<>1 OR NOT EXISTS (SELECT 1 FROM app_private.d1_employee_experience_candidates(p_request_id,step_row.id) c
    WHERE c.candidate_principal_id=ctx.actor_id) THEN RAISE EXCEPTION 'D1 Employee experience reviewer authority denied'; END IF;
  INSERT INTO app_private.approval_reviews(reviewer_assignment_id,step_id,reviewer_id,decision,reason,expected_request_version,created_by)
  VALUES (assignment_id,step_row.id,ctx.actor_id,p_decision,p_reason,p_expected_request_version,ctx.actor_id);
  UPDATE app_private.approval_request_steps SET state=CASE p_decision WHEN 'APPROVE' THEN 'APPROVED' ELSE 'REJECTED' END,
    closed_at=pg_catalog.statement_timestamp() WHERE id=step_row.id;
  IF p_decision='REJECT' THEN
    UPDATE app_private.approval_request_steps SET state='CANCELLED',closed_at=pg_catalog.statement_timestamp()
     WHERE request_id=p_request_id AND state='WAITING';
    final_state:='REJECTED';
    UPDATE app_private.approval_requests SET state='REJECTED',decided_at=pg_catalog.statement_timestamp()
     WHERE id=p_request_id RETURNING row_version INTO final_version;
  ELSE
    SELECT s.* INTO next_step FROM app_private.approval_request_steps s
     WHERE s.request_id=p_request_id AND s.step_number=step_row.step_number+1 AND s.state='WAITING' FOR UPDATE;
    IF next_step.id IS NOT NULL THEN
      UPDATE app_private.approval_request_steps SET state='OPEN',opened_at=pg_catalog.statement_timestamp() WHERE id=next_step.id;
      INSERT INTO app_private.approval_step_reviewers(step_id,reviewer_id,assignment_reason,created_by)
      SELECT next_step.id,c.candidate_principal_id,'D1_REVIEWER_ROLE_SCOPE',ctx.actor_id
        FROM app_private.d1_employee_experience_candidates(p_request_id,next_step.id) c;
      GET DIAGNOSTICS candidate_count=ROW_COUNT; IF candidate_count=0 THEN RAISE EXCEPTION 'D1 Employee experience next step has no reviewer'; END IF;
      final_state:='PENDING';
      UPDATE app_private.approval_requests SET row_version=row_version+1,updated_at=pg_catalog.statement_timestamp()
       WHERE id=p_request_id RETURNING row_version INTO final_version;
    ELSE
      final_state:='APPROVED';
      UPDATE app_private.approval_requests SET state='APPROVED',decided_at=pg_catalog.statement_timestamp()
       WHERE id=p_request_id RETURNING row_version INTO final_version;
    END IF;
  END IF;
  receipt:=app_private.d1_employee_experience_receipt('request.review',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
    req.expected_target_version,p_request_id,p_expected_request_version,'SUCCEEDED','D1_EMPLOYEE_EXPERIENCE_REVIEW',p_request_id,
    pg_catalog.jsonb_build_object('request_version',final_version,'state',final_state),NULL);
  PERFORM app_private.d1_employee_experience_audit(ctx.actor_id,'request.review',action,req.target_ref,NULL,NULL,NULL,receipt,p_request_id,
    req.expected_target_version,'SUCCEEDED',pg_catalog.gen_random_uuid());
  RETURN QUERY SELECT p_request_id,final_version,final_state;
END $body$;
REVOKE ALL ON FUNCTION app.d1_review_employee_experience_request(uuid,text,bigint,text,text) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_review_employee_experience_request(uuid,text,bigint,text,text) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE FUNCTION app_private.d1_employee_experience_reviews_live(p_request uuid)
RETURNS boolean LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; requester_person uuid; s record; n bigint; reviewer uuid; reviewer_person uuid; seen bigint:=0;
BEGIN
  SELECT q.* INTO req FROM app_private.approval_requests q JOIN app_private.operation_contracts o ON o.id=q.operation_id
   WHERE q.id=p_request AND o.code='employee.experience.change'; IF NOT FOUND THEN RETURN false; END IF;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id; IF requester_person IS NULL THEN RETURN false; END IF;
  FOR s IN SELECT st.id,st.state,t.reviewer_role_id FROM app_private.approval_request_steps st
    JOIN app_private.approval_step_templates t ON t.id=st.template_id WHERE st.request_id=p_request ORDER BY st.step_number LOOP
    seen:=seen+1; IF s.state<>'APPROVED' OR s.reviewer_role_id IS NULL THEN RETURN false; END IF;
    SELECT count(*),min(v.reviewer_id::text)::uuid INTO n,reviewer FROM app_private.approval_reviews v
    JOIN app_private.approval_step_reviewers a ON a.id=v.reviewer_assignment_id AND a.step_id=s.id
    WHERE v.step_id=s.id AND v.decision='APPROVE' AND a.reviewer_id=v.reviewer_id AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
    IF n<>1 OR reviewer IS NULL THEN RETURN false; END IF;
    SELECT p.person_id INTO reviewer_person FROM app_private.principals p WHERE p.id=reviewer;
    IF reviewer_person IS NULL OR reviewer_person=requester_person THEN RETURN false; END IF;
    IF NOT app_private.d1_employee_experience_authorized(reviewer,'employee.experience.approve',req.target_ref,s.reviewer_role_id) THEN RETURN false; END IF;
  END LOOP;
  RETURN seen>0;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_employee_experience_reviews_live(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_employee_experience_reviews_live(uuid) TO schoolos_workflow_executor,schoolos_read_executor;

CREATE FUNCTION app_private.d1_employee_experience_participant(p_request uuid,p_actor uuid)
RETURNS text LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; final_role uuid; open_step record; n bigint; requester_person uuid; actor_person uuid;
BEGIN
  SELECT q.* INTO req FROM app_private.approval_requests q JOIN app_private.operation_contracts o ON o.id=q.operation_id
   WHERE q.id=p_request AND o.code='employee.experience.change'; IF NOT FOUND OR p_actor IS NULL THEN RETURN NULL; END IF;
  IF p_actor=req.requester_id AND app_private.d1_employee_experience_authorized(p_actor,'employee.experience.change',req.target_ref,NULL)
    THEN RETURN 'REQUESTER'; END IF;
  final_role:=app_private.d1_final_approver_role(p_request,p_actor);
  IF final_role IS NOT NULL AND app_private.d1_employee_experience_authorized(p_actor,'employee.experience.approve',req.target_ref,final_role)
    THEN RETURN 'FINAL_APPROVER'; END IF;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id;
  SELECT p.person_id INTO actor_person FROM app_private.principals p WHERE p.id=p_actor;
  IF requester_person IS NULL OR actor_person IS NULL OR requester_person=actor_person THEN RETURN NULL; END IF;
  SELECT st.id,t.reviewer_role_id INTO open_step FROM app_private.approval_request_steps st JOIN app_private.approval_step_templates t ON t.id=st.template_id
   WHERE st.request_id=p_request AND st.state='OPEN' AND EXISTS (SELECT 1 FROM app_private.approval_step_reviewers a
     WHERE a.step_id=st.id AND a.reviewer_id=p_actor AND a.withdrawn_at IS NULL AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE')
   ORDER BY st.step_number LIMIT 1;
  IF open_step.id IS NOT NULL AND app_private.d1_employee_experience_authorized(p_actor,'employee.experience.approve',req.target_ref,open_step.reviewer_role_id)
     AND EXISTS (SELECT 1 FROM app_private.d1_employee_experience_candidates(p_request,open_step.id) c WHERE c.candidate_principal_id=p_actor)
  THEN RETURN 'OPEN_REVIEWER'; END IF;
  SELECT count(*),min(t.reviewer_role_id::text)::uuid INTO n,final_role FROM app_private.approval_reviews v
   JOIN app_private.approval_request_steps st ON st.id=v.step_id JOIN app_private.approval_step_templates t ON t.id=st.template_id
   WHERE st.request_id=p_request AND v.reviewer_id=p_actor;
  IF n>0 AND final_role IS NOT NULL AND app_private.d1_employee_experience_authorized(p_actor,'employee.experience.approve',req.target_ref,final_role)
    THEN RETURN 'DECIDED_REVIEWER'; END IF;
  RETURN NULL;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_employee_experience_participant(uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_employee_experience_participant(uuid,uuid) TO schoolos_workflow_executor,schoolos_read_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;

GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE FUNCTION app.d1_apply_employee_experience_request(p_request_id uuid,p_expected_request_version bigint,p_idempotency_key text)
RETURNS TABLE(request_id uuid,request_version bigint,request_state text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; req record; policy_row record; pre record; effect_row record; participant text; action text; source_id uuid; lineage uuid;
  org text; role_title text; starts date; ends date; summary_text text; invalidation_code text; final_state text; final_version bigint;
  receipt uuid; sequence_no bigint; correlation uuid:=pg_catalog.gen_random_uuid();
BEGIN
  IF p_request_id IS NULL OR p_expected_request_version IS NULL OR p_expected_request_version<1 THEN RAISE EXCEPTION 'D1 Employee experience apply intent invalid'; END IF;
  SELECT * INTO ctx FROM app_private.d1_employee_experience_command_context('request.apply',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_request_id,p_expected_request_version::text));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT q.* INTO req FROM app_private.approval_requests q WHERE q.id=p_request_id AND q.operation_id=ctx.operation_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'D1 Employee experience request missing'; END IF;
  participant:=app_private.d1_employee_experience_participant(p_request_id,ctx.actor_id);
  IF participant NOT IN ('REQUESTER','FINAL_APPROVER') OR participant IS NULL THEN RAISE EXCEPTION 'D1 Employee experience request unavailable'; END IF;
  IF ctx.receipt_id IS NOT NULL THEN
    IF ctx.receipt_state NOT IN ('SUCCEEDED','REJECTED') OR ctx.result_summary IS NULL OR NOT (ctx.result_summary ?& ARRAY['request_version','state'])
       OR (ctx.receipt_state='SUCCEEDED' AND (ctx.result_ref IS NULL OR ctx.result_summary->>'state'<>'EXECUTED'))
       OR (ctx.receipt_state='REJECTED' AND (ctx.result_ref IS NOT NULL OR ctx.result_summary->>'state'<>'INVALIDATED'))
    THEN RAISE EXCEPTION 'D1 Employee experience apply receipt invalid'; END IF;
    RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,ctx.result_summary->>'state'; RETURN; END IF;
  IF req.state<>'APPROVED' OR req.row_version<>p_expected_request_version THEN RAISE EXCEPTION 'D1 Employee experience approved request changed'; END IF;
  IF req.old_snapshot IS NULL OR pg_catalog.jsonb_typeof(req.old_snapshot)<>'object' OR req.requested_payload IS NULL
     OR pg_catalog.jsonb_typeof(req.requested_payload)<>'object'
     OR NOT (req.old_snapshot ?& ARRAY['source_snapshot_id','experience_record_id','organization_name','role_title','starts_on','ends_on','summary','effective_from','supersedes_id'])
     OR NOT (req.requested_payload ?& ARRAY['action','organization_name','role_title','starts_on','ends_on','summary'])
  THEN RAISE EXCEPTION 'D1 Employee experience stored request payload malformed'; END IF;
  BEGIN
    action:=req.requested_payload->>'action'; source_id:=NULLIF(req.old_snapshot->>'source_snapshot_id','')::uuid;
    lineage:=NULLIF(req.old_snapshot->>'experience_record_id','')::uuid; org:=NULLIF(req.requested_payload->>'organization_name','');
    role_title:=NULLIF(req.requested_payload->>'role_title',''); starts:=NULLIF(req.requested_payload->>'starts_on','')::date;
    ends:=NULLIF(req.requested_payload->>'ends_on','')::date; summary_text:=NULLIF(req.requested_payload->>'summary','');
  EXCEPTION WHEN invalid_text_representation OR datetime_field_overflow THEN RAISE EXCEPTION 'D1 Employee experience stored request payload malformed'; END;
  IF app_private.d1_employee_experience_payload_valid(action,source_id,lineage,org,role_title,starts,ends,summary_text,req.reason) IS DISTINCT FROM true
    THEN RAISE EXCEPTION 'D1 Employee experience stored request payload malformed'; END IF;
  SELECT * INTO policy_row FROM app_private.d1_employee_experience_policy(req.target_ref);
  IF policy_row.policy_id IS DISTINCT FROM req.policy_id OR policy_row.route_mode IS DISTINCT FROM 'APPROVAL' THEN
    invalidation_code:='D1_EMPLOYEE_EXPERIENCE_POLICY_STALE';
  ELSIF NOT app_private.d1_employee_experience_authorized(req.requester_id,'employee.experience.change',req.target_ref,NULL) THEN
    invalidation_code:='D1_EMPLOYEE_EXPERIENCE_REQUESTER_AUTHORITY_STALE';
  ELSIF NOT app_private.d1_employee_experience_reviews_live(p_request_id) THEN
    invalidation_code:='D1_EMPLOYEE_EXPERIENCE_REVIEWER_AUTHORITY_STALE';
  ELSE
    SELECT * INTO pre FROM app_private.d1_employee_experience_preflight(req.target_ref,req.expected_target_version,action,source_id,lineage,
      org,role_title,starts,ends,summary_text,req.reason);
    IF NOT FOUND OR pre.eligible IS NULL THEN RAISE EXCEPTION 'D1 Employee experience preflight result unavailable'; END IF;
    IF pre.eligible IS FALSE THEN IF pre.error_code IS NULL OR pg_catalog.length(pg_catalog.btrim(pre.error_code))=0 THEN
      RAISE EXCEPTION 'D1 Employee experience preflight denial lacks error code'; END IF; invalidation_code:=pre.error_code; END IF;
  END IF;
  IF invalidation_code IS NOT NULL THEN
    final_state:='INVALIDATED'; UPDATE app_private.approval_requests SET state=final_state WHERE id=p_request_id RETURNING row_version INTO final_version;
    receipt:=app_private.d1_employee_experience_receipt('request.apply',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
      req.expected_target_version,p_request_id,p_expected_request_version,'REJECTED',NULL,NULL,
      pg_catalog.jsonb_build_object('request_version',final_version,'state',final_state),invalidation_code);
    PERFORM app_private.d1_employee_experience_audit(ctx.actor_id,'request.apply',action,req.target_ref,NULL,lineage,source_id,receipt,
      p_request_id,req.expected_target_version,'REJECTED',correlation);
  ELSE
    SELECT * INTO effect_row FROM app_private.d1_employee_experience_effect(ctx.actor_id,req.target_ref,req.expected_target_version,action,
      source_id,lineage,org,role_title,starts,ends,summary_text,req.reason);
    final_state:='EXECUTED'; UPDATE app_private.approval_requests SET state=final_state WHERE id=p_request_id RETURNING row_version INTO final_version;
    receipt:=app_private.d1_employee_experience_receipt('request.apply',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
      req.expected_target_version,p_request_id,p_expected_request_version,'SUCCEEDED','D1_EMPLOYEE_EXPERIENCE_APPLY',effect_row.snapshot_id,
      pg_catalog.jsonb_build_object('request_version',final_version,'state',final_state,'action',action,'snapshot_id',effect_row.snapshot_id,
        'experience_record_id',effect_row.experience_record_id,'source_snapshot_id',source_id,'effective_from',effect_row.effective_from,
        'effective_until',effect_row.effective_until,'employee_version',req.expected_target_version),NULL);
    INSERT INTO app_private.approval_applications(request_id,command_receipt_id,operation_id,applied_target_version,result_ref,created_by)
    VALUES (p_request_id,receipt,ctx.operation_id,req.expected_target_version,effect_row.snapshot_id,ctx.actor_id);
    PERFORM app_private.d1_employee_experience_audit(ctx.actor_id,'request.apply',action,req.target_ref,effect_row.snapshot_id,
      effect_row.experience_record_id,source_id,receipt,p_request_id,req.expected_target_version,'SUCCEEDED',correlation);
    PERFORM app_private.d1_employee_experience_event(ctx.actor_id,action,req.target_ref,effect_row.snapshot_id,effect_row.experience_record_id,
      source_id,receipt,req.expected_target_version,correlation);
  END IF;
  SELECT pg_catalog.coalesce(max(t.sequence_number),0) INTO sequence_no FROM app_private.approval_transitions t WHERE t.request_id=p_request_id;
  INSERT INTO app_private.approval_transitions(request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
  VALUES (p_request_id,sequence_no+1,'APPROVED',final_state,CASE WHEN final_state='EXECUTED' THEN 'D1_EMPLOYEE_EXPERIENCE_APPLIED' ELSE invalidation_code END,
    receipt,ctx.actor_id);
  RETURN QUERY SELECT p_request_id,final_version,final_state;
END $body$;
REVOKE ALL ON FUNCTION app.d1_apply_employee_experience_request(uuid,bigint,text) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_apply_employee_experience_request(uuid,bigint,text) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;

GRANT CREATE ON SCHEMA app TO schoolos_read_executor;
SET ROLE schoolos_read_executor;
CREATE FUNCTION app.d1_read_employee_experience_request(p_request_id uuid)
RETURNS TABLE(request_id uuid,request_version bigint,request_state text,employee_id uuid,action text,source_snapshot_id uuid,
  experience_record_id uuid,old_organization_name text,old_role_title text,old_starts_on date,old_ends_on date,old_summary text,
  requested_organization_name text,requested_role_title text,requested_starts_on date,requested_ends_on date,requested_summary text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE actor uuid; participant text; req record;
BEGIN
  PERFORM pg_catalog.pg_advisory_xact_lock_shared(71001,1); actor:=app_private.current_principal_id();
  IF actor IS NULL THEN RAISE EXCEPTION 'D1 Employee experience request unavailable'; END IF;
  participant:=app_private.d1_employee_experience_participant(p_request_id,actor); IF participant IS NULL THEN RAISE EXCEPTION 'D1 Employee experience request unavailable'; END IF;
  SELECT q.* INTO req FROM app_private.approval_requests q JOIN app_private.operation_contracts o ON o.id=q.operation_id
   WHERE q.id=p_request_id AND o.code='employee.experience.change'; IF NOT FOUND THEN RAISE EXCEPTION 'D1 Employee experience request unavailable'; END IF;
  RETURN QUERY SELECT req.id,req.row_version,req.state,req.target_ref,req.requested_payload->>'action',
    NULLIF(req.old_snapshot->>'source_snapshot_id','')::uuid,NULLIF(req.old_snapshot->>'experience_record_id','')::uuid,
    req.old_snapshot->>'organization_name',req.old_snapshot->>'role_title',NULLIF(req.old_snapshot->>'starts_on','')::date,
    NULLIF(req.old_snapshot->>'ends_on','')::date,req.old_snapshot->>'summary',req.requested_payload->>'organization_name',
    req.requested_payload->>'role_title',NULLIF(req.requested_payload->>'starts_on','')::date,NULLIF(req.requested_payload->>'ends_on','')::date,
    req.requested_payload->>'summary';
END $body$;
REVOKE ALL ON FUNCTION app.d1_read_employee_experience_request(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_employee_experience_request(uuid) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_read_executor;
