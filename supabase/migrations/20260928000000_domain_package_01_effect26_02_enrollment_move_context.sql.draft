-- Effect 26 fixed command context and source/destination locked preflight.

GRANT CREATE ON SCHEMA app_private TO schoolos_evidence_writer;
SET ROLE schoolos_evidence_writer;
CREATE FUNCTION app_private.d1_enrollment_move_command_context(p_command_kind text,p_idempotency_key text,p_intent jsonb)
RETURNS TABLE(actor_id uuid,operation_id uuid,receipt_id uuid,result_ref uuid,result_summary jsonb,receipt_state text,intent_hash bytea)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE actor uuid; op uuid; h bytea; digest bytea; resource bigint; rec app_private.command_receipts%ROWTYPE;
BEGIN
  IF p_command_kind NOT IN ('student.enrollment.move','request.submit','request.review','request.apply')
     OR p_idempotency_key IS NULL OR pg_catalog.length(pg_catalog.btrim(p_idempotency_key))=0
     OR p_intent IS NULL OR pg_catalog.jsonb_typeof(p_intent)<>'array' THEN
    RAISE EXCEPTION 'D1 Enrollment move command context intent invalid'; END IF;
  PERFORM pg_catalog.pg_advisory_xact_lock_shared(71001,1);
  actor:=app_private.current_principal_id();
  IF actor IS NULL THEN RAISE EXCEPTION 'D1 Enrollment move requires verified actor'; END IF;
  SELECT o.id INTO op FROM app_private.operation_contracts o
   WHERE o.code='student.enrollment.move' AND o.contract_version=1 AND o.handler_key='student.enrollment.move' AND o.enabled;
  IF op IS NULL THEN RAISE EXCEPTION 'D1 Enrollment move operation is not enabled'; END IF;
  h:=pg_catalog.sha256(pg_catalog.convert_to(app_private.d1_jcs_typed(pg_catalog.jsonb_build_object(
    'canonicalization_version',1,'operation_code','student.enrollment.move','operation_contract_version','1',
    'operation_id',op::text,'command_kind',p_command_kind,'principal_id',actor::text,'intent',p_intent,'idempotency_key',p_idempotency_key)),'UTF8'));
  digest:=pg_catalog.sha256(pg_catalog.convert_to(actor::text||'|'||op::text||'|'||p_idempotency_key,'UTF8'));
  resource:=pg_catalog.get_byte(digest,0)::bigint*16777216+pg_catalog.get_byte(digest,1)::bigint*65536+
    pg_catalog.get_byte(digest,2)::bigint*256+pg_catalog.get_byte(digest,3)::bigint;
  IF resource>2147483647 THEN resource:=resource-4294967296; END IF;
  PERFORM pg_catalog.pg_advisory_xact_lock(71002,resource::integer);
  SELECT r.* INTO rec FROM app_private.command_receipts r WHERE r.principal_id=actor AND r.operation_id=op AND r.idempotency_key=p_idempotency_key;
  IF FOUND THEN
    IF rec.canonicalization_version<>1 OR rec.canonical_payload_hash IS DISTINCT FROM h OR rec.command_kind IS DISTINCT FROM p_command_kind THEN
      RAISE EXCEPTION 'D1 Enrollment move idempotency key conflicts with prior intent'; END IF;
    RETURN QUERY SELECT actor,op,rec.id,rec.result_ref,rec.result_summary,rec.state,h; RETURN;
  END IF;
  RETURN QUERY SELECT actor,op,NULL::uuid,NULL::uuid,NULL::jsonb,NULL::text,h;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_enrollment_move_command_context(text,text,jsonb) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_enrollment_move_command_context(text,text,jsonb) TO schoolos_student_executor,schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_evidence_writer;

GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE FUNCTION app_private.d1_enrollment_move_source_section(p_student uuid,p_source_enrollment uuid)
RETURNS uuid LANGUAGE sql STABLE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
  SELECT e.section_offering_id FROM app_private.enrollments e
   WHERE e.id=p_source_enrollment AND e.student_id=p_student AND e.placement_kind='PRIMARY'
$body$;
REVOKE ALL ON FUNCTION app_private.d1_enrollment_move_source_section(uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_enrollment_move_source_section(uuid,uuid) TO schoolos_student_executor,schoolos_workflow_executor;

CREATE FUNCTION app_private.d1_enrollment_move_lock_context(
  p_student uuid,p_expected_student_version bigint,p_source_enrollment uuid,p_expected_source_section uuid,
  p_expected_source_effective_from date,p_destination_section uuid,p_entry_kind text,p_effective_from date
) RETURNS TABLE(student_version bigint,source_section_id uuid,source_roll_id uuid,school_id uuid,
  source_campus_id uuid,source_year_id uuid,source_class_offering_id uuid,destination_campus_id uuid,destination_year_id uuid,
  destination_class_offering_id uuid,destination_class_capacity integer,destination_section_capacity integer,error_code text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE s app_private.students%ROWTYPE; src app_private.enrollments%ROWTYPE; path record; rid uuid; other_count bigint;
BEGIN
  IF p_student IS NULL OR p_expected_student_version IS NULL OR p_expected_student_version<1 OR p_source_enrollment IS NULL
     OR p_expected_source_section IS NULL OR p_expected_source_effective_from IS NULL OR p_destination_section IS NULL
     OR p_entry_kind NOT IN ('PROMOTION','REPEAT','CLASS_CHANGE','SECTION_CHANGE','CAMPUS_TRANSFER') OR p_effective_from IS NULL THEN
    RETURN QUERY SELECT NULL::bigint,p_expected_source_section,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::integer,NULL::integer,'D1_ENROLLMENT_MOVE_INTENT_INVALID'; RETURN; END IF;
  SELECT * INTO s FROM app_private.students WHERE id=p_student FOR UPDATE;
  IF NOT FOUND THEN RETURN QUERY SELECT NULL::bigint,p_expected_source_section,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::integer,NULL::integer,'D1_ENROLLMENT_MOVE_STUDENT_MISSING'; RETURN; END IF;
  IF s.row_version IS DISTINCT FROM p_expected_student_version OR s.current_status<>'ACTIVE' THEN
    RETURN QUERY SELECT s.row_version,p_expected_source_section,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::integer,NULL::integer,
      CASE WHEN s.row_version IS DISTINCT FROM p_expected_student_version THEN 'D1_ENROLLMENT_MOVE_VERSION_STALE' ELSE 'D1_ENROLLMENT_MOVE_STATUS_INELIGIBLE' END; RETURN; END IF;
  SELECT * INTO src FROM app_private.enrollments e WHERE e.id=p_source_enrollment FOR UPDATE;
  IF NOT FOUND OR src.student_id IS DISTINCT FROM p_student OR src.placement_kind<>'PRIMARY'
     OR src.section_offering_id IS DISTINCT FROM p_expected_source_section OR src.effective_from IS DISTINCT FROM p_expected_source_effective_from
     OR src.placement_state<>'ACTIVE' OR src.effective_until IS NOT NULL OR src.effective_from>=p_effective_from THEN
    RETURN QUERY SELECT s.row_version,p_expected_source_section,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::integer,NULL::integer,'D1_ENROLLMENT_MOVE_SOURCE_STALE'; RETURN; END IF;
  SELECT count(*) INTO other_count FROM app_private.enrollments e
   WHERE e.student_id=p_student AND e.placement_kind='PRIMARY' AND e.id<>p_source_enrollment
     AND e.effective_from>=src.effective_from;
  IF other_count<>0 THEN
    RETURN QUERY SELECT s.row_version,src.section_offering_id,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::uuid,NULL::integer,NULL::integer,'D1_ENROLLMENT_MOVE_SOURCE_NOT_HEAD'; RETURN; END IF;
  SELECT * INTO path FROM app_private.d1_enrollment_move_lock_paths(src.section_offering_id,p_destination_section);
  IF path.error_code IS NOT NULL THEN
    RETURN QUERY SELECT s.row_version,src.section_offering_id,NULL::uuid,path.school_id,path.source_campus_id,path.source_year_id,path.source_class_offering_id,
      path.destination_campus_id,path.destination_year_id,path.destination_class_offering_id,path.destination_class_capacity,path.destination_section_capacity,path.error_code; RETURN; END IF;
  SELECT count(*) INTO other_count FROM app_private.enrollments e
   WHERE e.student_id=p_student AND e.placement_kind='PRIMARY' AND e.id<>p_source_enrollment
     AND e.effective_from<COALESCE(e.effective_until,'infinity'::date)
     AND p_effective_from<COALESCE(e.effective_until,'infinity'::date);
  IF other_count<>0 THEN
    RETURN QUERY SELECT s.row_version,src.section_offering_id,NULL::uuid,path.school_id,path.source_campus_id,path.source_year_id,path.source_class_offering_id,
      path.destination_campus_id,path.destination_year_id,path.destination_class_offering_id,path.destination_class_capacity,path.destination_section_capacity,'D1_ENROLLMENT_MOVE_PRIMARY_OVERLAP'; RETURN; END IF;
  SELECT r.id INTO rid FROM app_private.roll_allocations r
   WHERE r.enrollment_id=src.id AND r.student_id=p_student AND r.effective_from<=p_effective_from
     AND (r.effective_until IS NULL OR p_effective_from<r.effective_until)
   ORDER BY r.effective_from DESC,r.created_at DESC,r.id DESC LIMIT 1 FOR UPDATE;
  IF rid IS NULL THEN
    RETURN QUERY SELECT s.row_version,src.section_offering_id,NULL::uuid,path.school_id,path.source_campus_id,path.source_year_id,path.source_class_offering_id,
      path.destination_campus_id,path.destination_year_id,path.destination_class_offering_id,path.destination_class_capacity,path.destination_section_capacity,'D1_ENROLLMENT_MOVE_SOURCE_ROLL_MISSING'; RETURN; END IF;
  RETURN QUERY SELECT s.row_version,src.section_offering_id,rid,path.school_id,path.source_campus_id,path.source_year_id,path.source_class_offering_id,
    path.destination_campus_id,path.destination_year_id,path.destination_class_offering_id,path.destination_class_capacity,path.destination_section_capacity,NULL::text;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_enrollment_move_lock_context(uuid,bigint,uuid,uuid,date,uuid,text,date) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_enrollment_move_lock_context(uuid,bigint,uuid,uuid,date,uuid,text,date) TO schoolos_student_executor,schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;
