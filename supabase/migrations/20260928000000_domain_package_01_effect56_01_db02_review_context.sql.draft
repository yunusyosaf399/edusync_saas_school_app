-- DB-02 I09: private fixed four-element REVIEW context pending I11's
-- independently owned shared receipt allowlist integration. No REVIEW/APPLY
-- shape added to the common lookup or shared operation registries here.
-- Uses the identical canonical JCS+SHA256+receipt advisory-key contract;
-- no client can call this helper or access raw receipts.
GRANT CREATE ON SCHEMA app_private TO schoolos_evidence_writer;
SET ROLE schoolos_evidence_writer;
CREATE FUNCTION app_private.d1_roll_policy_review_receipt_context(
 p_request uuid,p_decision text,p_expected_version bigint,
 p_reason text,p_idempotency_key text)
RETURNS TABLE(actor_id uuid,operation_id uuid,intent_hash bytea,
 receipt_id uuid,receipt_state text,result_ref uuid,result_summary jsonb)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $body$
DECLARE
 v_actor uuid;
 v_operation uuid;
 v_intent jsonb;
 v_hash bytea;
 v_digest bytea;
 v_resource bigint;
 v_receipt app_private.command_receipts%ROWTYPE;
BEGIN
 IF pg_catalog.current_setting('transaction_isolation') IS DISTINCT FROM 'read committed'
   OR p_request IS NULL OR p_decision NOT IN ('APPROVE','REJECT')
   OR p_expected_version IS NULL OR p_expected_version<1
   OR p_reason IS NULL OR pg_catalog.btrim(p_reason)=''
   OR p_idempotency_key IS NULL
   OR pg_catalog.char_length(p_idempotency_key) NOT BETWEEN 1 AND 200 THEN
   RAISE EXCEPTION 'D1 Roll Policy REVIEW typed context invalid';
 END IF;
 PERFORM pg_catalog.pg_advisory_xact_lock_shared(71001,1);
 v_actor:=app_private.current_principal_id();
 IF v_actor IS NULL THEN
   RAISE EXCEPTION 'D1 Roll Policy REVIEW requires verified actor';
 END IF;
 SELECT o.id INTO v_operation FROM app_private.operation_contracts o
 WHERE o.code='student.roll_policy.change' AND o.contract_version=1
   AND o.handler_key='student.roll_policy.change' AND o.enabled;
 IF v_operation IS NULL THEN
   RAISE EXCEPTION 'D1 Roll Policy REVIEW operation unavailable';
 END IF;
 v_intent:=pg_catalog.jsonb_build_array(
   p_request,p_decision,p_expected_version::text,p_reason);
 v_hash:=pg_catalog.sha256(pg_catalog.convert_to(
  app_private.d1_jcs_typed(pg_catalog.jsonb_build_object(
   'canonicalization_version',1,
   'operation_code','student.roll_policy.change',
   'operation_contract_version','1',
   'operation_id',v_operation::text,
   'command_kind','request.review',
   'principal_id',v_actor::text,
   'intent',v_intent,'idempotency_key',p_idempotency_key)),'UTF8'));
 v_digest:=pg_catalog.sha256(pg_catalog.convert_to(
   v_actor::text||'|'||v_operation::text||'|'||p_idempotency_key,'UTF8'));
 v_resource:=pg_catalog.get_byte(v_digest,0)::bigint*16777216
            +pg_catalog.get_byte(v_digest,1)::bigint*65536
            +pg_catalog.get_byte(v_digest,2)::bigint*256
            +pg_catalog.get_byte(v_digest,3)::bigint;
 IF v_resource>2147483647 THEN v_resource:=v_resource-4294967296; END IF;
 PERFORM pg_catalog.pg_advisory_xact_lock(71002,v_resource::integer);
 SELECT r.* INTO v_receipt FROM app_private.command_receipts r
 WHERE r.principal_id=v_actor AND r.operation_id=v_operation
   AND r.idempotency_key=p_idempotency_key;
 IF FOUND THEN
   IF v_receipt.canonicalization_version IS DISTINCT FROM 1
     OR v_receipt.canonical_payload_hash IS DISTINCT FROM v_hash
     OR v_receipt.command_kind IS DISTINCT FROM 'request.review'
     THEN RAISE EXCEPTION 'D1 idempotency key conflicts with prior intent';
   END IF;
   RETURN QUERY SELECT v_actor,v_operation,v_hash,v_receipt.id,
     v_receipt.state,v_receipt.result_ref,v_receipt.result_summary;
 ELSE
   RETURN QUERY SELECT v_actor,v_operation,v_hash,NULL::uuid,
     NULL::text,NULL::uuid,NULL::jsonb;
 END IF;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_roll_policy_review_receipt_context(
 uuid,text,bigint,text,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_roll_policy_review_receipt_context(
 uuid,text,bigint,text,text) TO schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_evidence_writer;

-- Keep Foundation global P1 approval policy matching an internal Student
-- identity-reader owned fixed function. The client cannot choose a policy.
SET ROLE schoolos_student_executor;
GRANT EXECUTE ON FUNCTION app_private.d1_roll_policy_p1_binding_current(
 uuid,uuid,text) TO schoolos_workflow_executor;
RESET ROLE;
