-- Effect 30 current review-authority proof for APPROVAL apply/replay.

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE FUNCTION app_private.d1_family_relationship_reviews_live(p_request uuid)
RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; requester_person uuid; s record; n bigint; reviewer uuid; reviewer_person uuid; seen bigint:=0;
BEGIN
  -- The authorization reader has explicitly projected columns, not
  -- unrestricted SELECT on approval_requests.
  SELECT q.id,q.requester_id,q.target_ref INTO req FROM app_private.approval_requests q
    JOIN app_private.operation_contracts o ON o.id=q.operation_id
   WHERE q.id=p_request AND o.code='family.relationship.change';
  IF NOT FOUND THEN RETURN false; END IF;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id;
  IF requester_person IS NULL THEN RETURN false; END IF;
  FOR s IN
    SELECT st.id,st.state,t.reviewer_role_id FROM app_private.approval_request_steps st
      JOIN app_private.approval_step_templates t ON t.id=st.template_id
     WHERE st.request_id=p_request ORDER BY st.step_number
  LOOP
    seen:=seen+1;
    IF s.state<>'APPROVED' OR s.reviewer_role_id IS NULL THEN RETURN false; END IF;
    SELECT count(*),min(v.reviewer_id::text)::uuid INTO n,reviewer
      FROM app_private.approval_reviews v
      JOIN app_private.approval_step_reviewers a ON a.id=v.reviewer_assignment_id AND a.step_id=s.id
     WHERE v.step_id=s.id AND v.decision='APPROVE' AND a.reviewer_id=v.reviewer_id
       AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
    IF n<>1 OR reviewer IS NULL THEN RETURN false; END IF;
    SELECT p.person_id INTO reviewer_person FROM app_private.principals p WHERE p.id=reviewer;
    IF reviewer_person IS NULL OR reviewer_person=requester_person
       OR NOT app_private.d1_family_relationship_authorized(
         reviewer,'family.access.approve',req.target_ref,s.reviewer_role_id) THEN RETURN false; END IF;
  END LOOP;
  RETURN seen>0;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_family_relationship_reviews_live(uuid)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_family_relationship_reviews_live(uuid)
  TO schoolos_workflow_executor,schoolos_read_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;
