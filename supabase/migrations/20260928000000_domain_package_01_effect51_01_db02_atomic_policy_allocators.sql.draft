-- DB-02 I05: restricted schema-owner pool writer.
-- Only the Student executor can call it, after an I04 server-verified,
-- School-locked transition; never grant client, Workflow or PUBLIC EXECUTE.
GRANT CREATE ON SCHEMA app_private TO schoolos_schema_owner;
SET ROLE schoolos_schema_owner;
CREATE FUNCTION app_private.d1_roll_policy_provision_revision_pools(
 p_school uuid,p_revision uuid,p_actor uuid)
RETURNS integer LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $body$
DECLARE
  pol app_private.roll_policy_revisions%ROWTYPE;
  school_state text;
  used_max bigint;
  pool_max bigint;
  seed bigint;
  candidate record;
  part uuid;
  total integer:=0;
  eligible boolean;
BEGIN
  IF p_school IS NULL OR p_revision IS NULL OR p_actor IS NULL
     OR p_actor IS DISTINCT FROM app_private.current_principal_id()
     OR pg_catalog.current_setting('transaction_isolation')<>'read committed' THEN
    RAISE EXCEPTION 'D1 roll policy allocator context invalid';
  END IF;
  -- School row is already anchored by the Student I01/I03 context.
  -- Reacquiring it does not change the globally frozen lock prefix.
  SELECT state INTO school_state FROM app_private.school_profiles
    WHERE id=p_school FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'D1 roll policy allocator School missing'; END IF;
  SELECT * INTO pol FROM app_private.roll_policy_revisions
    WHERE id=p_revision AND school_id=p_school FOR UPDATE;
  IF NOT FOUND OR pol.created_by IS DISTINCT FROM p_actor
    OR pol.created_at IS DISTINCT FROM pg_catalog.transaction_timestamp()
    OR pol.effective_until IS NOT NULL OR pol.ended_at IS NOT NULL
    OR pol.effective_from IS DISTINCT FROM app_private.d1_roll_business_date(p_school)
    OR pol.mode NOT IN ('PERSISTENT_STUDENT','ACADEMIC_CONTEXT')
    OR pol.start_value<0 OR pol.start_value>=9223372036854775807 THEN
    RAISE EXCEPTION 'D1 roll policy allocator revision not current transaction';
  END IF;
  -- No partially provisioned or reused revision is allowed.
  IF EXISTS (SELECT 1 FROM app_private.roll_allocator_states
              WHERE policy_revision_id=p_revision) THEN
    RAISE EXCEPTION 'D1 roll policy allocator revision already provisioned';
  END IF;
  IF pol.mode='PERSISTENT_STUDENT' THEN
    -- All retained persistent revisions belong to one School numeric
    -- namespace. Both previously reserved high-water and all assigned
    -- historical numbers are immutable sources (even expired/corrected).
    SELECT pg_catalog.max(s.next_value) INTO pool_max
      FROM app_private.roll_allocator_states s
      JOIN app_private.roll_policy_revisions h ON h.id=s.policy_revision_id
     WHERE h.school_id=p_school AND h.mode='PERSISTENT_STUDENT'
       AND s.class_offering_id IS NULL;
    SELECT pg_catalog.max(a.numeric_value) INTO used_max
      FROM app_private.roll_allocations a
      JOIN app_private.roll_policy_revisions h ON h.id=a.policy_revision_id
     WHERE h.school_id=p_school AND h.mode='PERSISTENT_STUDENT';
    IF pool_max>=9223372036854775807 OR used_max>=9223372036854775806 THEN
      RAISE EXCEPTION 'D1 roll policy persistent allocator exhausted';
    END IF;
    seed:=pg_catalog.greatest(pol.start_value,pg_catalog.coalesce(pool_max,0),
      pg_catalog.coalesce(used_max+1,0));
    IF seed>=9223372036854775807 THEN
      RAISE EXCEPTION 'D1 roll policy persistent allocator exhausted';
    END IF;
    INSERT INTO app_private.roll_allocator_states(
      policy_revision_id,class_offering_id,next_value,created_by)
      VALUES(p_revision,NULL,seed,p_actor);
    RETURN 1;
  END IF;

  -- Existing, nonarchived Class Offerings are enumerated as a School-wide
  -- snapshot, not filtered by Sections, Campus, capacity or intake state.
  -- School is locked; then stabilize academic parent ancestry in Campus →
  -- Academic Year → Class order, using sorted IDs before Offering locks.
  FOR part IN SELECT DISTINCT co.campus_id FROM app_private.class_offerings co
      WHERE co.school_id=p_school AND co.state<>'ARCHIVED'
      ORDER BY co.campus_id LOOP
    PERFORM 1 FROM app.campuses WHERE id=part FOR UPDATE;
  END LOOP;
  FOR part IN SELECT DISTINCT co.academic_year_id FROM app_private.class_offerings co
      WHERE co.school_id=p_school AND co.state<>'ARCHIVED'
      ORDER BY co.academic_year_id LOOP
    PERFORM 1 FROM app.academic_years WHERE id=part FOR UPDATE;
  END LOOP;
  FOR part IN SELECT DISTINCT co.class_id FROM app_private.class_offerings co
      WHERE co.school_id=p_school AND co.state<>'ARCHIVED'
      ORDER BY co.class_id LOOP
    PERFORM 1 FROM app_private.academic_classes WHERE id=part FOR UPDATE;
  END LOOP;
  FOR candidate IN
    SELECT co.id,co.state,cl.school_id AS class_school,cl.state AS class_state,
           cp.school_id AS campus_school,cp.state AS campus_state,
           ay.school_id AS year_school,ay.state AS year_state
      FROM app_private.class_offerings co
      LEFT JOIN app_private.academic_classes cl ON cl.id=co.class_id
      LEFT JOIN app.campuses cp ON cp.id=co.campus_id
      LEFT JOIN app.academic_years ay ON ay.id=co.academic_year_id
     WHERE co.school_id=p_school AND co.state<>'ARCHIVED'
     ORDER BY co.id FOR UPDATE OF co
  LOOP
    eligible:=(school_state IN ('SETUP','ACTIVE')
      AND candidate.state IN ('PLANNED','OPEN','CLOSED')
      AND candidate.class_school IS NOT DISTINCT FROM p_school
      AND candidate.class_state IS NOT DISTINCT FROM 'ACTIVE'
      AND candidate.campus_school IS NOT DISTINCT FROM p_school
      AND candidate.campus_state IN ('PLANNED','ACTIVE')
      AND candidate.year_school IS NOT DISTINCT FROM p_school
      AND candidate.year_state IN ('PLANNED','ACTIVE'));
    IF candidate.state='OPEN' AND NOT pg_catalog.coalesce(eligible,false) THEN
      RAISE EXCEPTION 'D1 roll policy OPEN Offering ancestry invalid';
    END IF;
    IF pg_catalog.coalesce(eligible,false) THEN
      INSERT INTO app_private.roll_allocator_states(
        policy_revision_id,class_offering_id,next_value,created_by)
        VALUES(p_revision,candidate.id,pol.start_value,p_actor);
      total:=total+1;
    END IF;
  END LOOP;
  RETURN total;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_roll_policy_provision_revision_pools(
 uuid,uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_roll_policy_provision_revision_pools(
 uuid,uuid,uuid) TO schoolos_student_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_schema_owner;

-- Compose I05 with the I04 revision mutation in the SAME transaction.
GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE OR REPLACE FUNCTION app_private.d1_roll_policy_revision_transition(
 p_school uuid,p_key text,p_action text,p_source uuid,
 p_expected_revision integer,p_expected_mode text,p_expected_start bigint,
 p_expected_from date,p_new_mode text,p_new_start bigint,p_reason text)
RETURNS uuid LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $body$
DECLARE
  actor uuid;
  chosen record;
  gate record;
  new_id uuid;
  cutover date;
  new_revision integer;
  changed integer;
BEGIN
  -- Enforce I01/I02 Foundation, receipt and School/ALL authorization prefix.
  -- The protected route remains deliberately DIRECT-only and cannot replay.
  SELECT c.actor_id INTO actor
  FROM app_private.d1_roll_policy_command_context(
    p_school,'DIRECT',p_key,p_action,p_source,p_expected_revision,
    p_expected_mode,p_expected_start,p_expected_from,p_new_mode,
    p_new_start,p_reason) AS c;
  IF actor IS NULL OR p_new_start>=9223372036854775807 THEN
    RAISE EXCEPTION 'D1 Roll Policy transition context invalid';
  END IF;
  -- I03 rechecks on the already acquired School lock in the same transaction.
  SELECT * INTO gate FROM app_private.d1_roll_policy_change_preflight(
    p_school,p_action,p_source,p_expected_revision,p_expected_mode,
    p_expected_start,p_expected_from,NULL::date,p_new_mode,p_new_start);
  IF NOT FOUND OR gate.error_code IS NOT NULL OR gate.business_date IS NULL THEN
    RAISE EXCEPTION 'D1 Roll Policy transition preflight invalid';
  END IF;
  cutover:=gate.business_date;
  IF p_action='INIT' THEN
    new_revision:=1;
  ELSIF p_action='REPLACE' THEN
    new_revision:=gate.source_revision+1;
    UPDATE app_private.roll_policy_revisions
       SET effective_until=cutover,ended_at=pg_catalog.statement_timestamp(),
           ended_by=actor
     WHERE id=p_source AND school_id=p_school
       AND revision=gate.source_revision AND mode=p_expected_mode
       AND start_value=p_expected_start AND effective_from=p_expected_from
       AND effective_until IS NULL
       AND effective_from<cutover;
    GET DIAGNOSTICS changed=ROW_COUNT;
    IF changed<>1 THEN
      RAISE EXCEPTION 'D1 Roll Policy source changed after locked preflight';
    END IF;
  ELSE
    RAISE EXCEPTION 'D1 Roll Policy action invalid';
  END IF;
  -- No caller-controlled new revision UUID, predecessor or date.
  INSERT INTO app_private.roll_policy_revisions(
    school_id,revision,mode,start_value,effective_from,reason,
    supersedes_id,created_by)
  VALUES (p_school,new_revision,p_new_mode,p_new_start,cutover,
          p_reason,CASE WHEN p_action='REPLACE' THEN p_source ELSE NULL END,
          actor)
  RETURNING id INTO new_id;
  IF new_id IS NULL THEN RAISE EXCEPTION 'D1 Roll Policy insert failed'; END IF;
  -- I05 is in the same SQL transaction. Any missing candidate/overflow,
  -- duplicate or failed pool INSERT aborts BOTH this revision and old
  -- source closure, before I06 can publish success evidence.
  PERFORM app_private.d1_roll_policy_provision_revision_pools(
    p_school,new_id,actor);
  RETURN new_id;
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;
