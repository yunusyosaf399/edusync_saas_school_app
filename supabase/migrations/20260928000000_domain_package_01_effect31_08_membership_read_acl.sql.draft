-- Effect 31 participant-only typed request read and explicit client ACL closure.
-- Static non-executable continuation only. Migration 10 remains .sql.draft.

SET ROLE schoolos_family_executor;
GRANT EXECUTE ON FUNCTION app_private.d1_family_principal_membership_lock_principals(uuid,uuid,uuid)
  TO schoolos_read_executor;
RESET ROLE;

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE FUNCTION app_private.d1_family_principal_membership_participant_kind(p_request uuid,p_actor uuid)
RETURNS text
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; role_id uuid; n bigint;
BEGIN
  SELECT q.* INTO req FROM app_private.approval_requests q
    JOIN app_private.operation_contracts o ON o.id=q.operation_id
    WHERE q.id=p_request AND o.code='family.principal_membership.change';
  IF NOT FOUND THEN RETURN NULL; END IF;
  IF p_actor=req.requester_id
     AND app_private.d1_family_principal_membership_authorized(
       p_actor,'family.principal_membership.change',NULL) THEN
    RETURN 'REQUESTER';
  END IF;
  role_id:=app_private.d1_final_approver_role(p_request,p_actor);
  IF role_id IS NOT NULL
     AND app_private.d1_family_principal_membership_authorized(
       p_actor,'family.access.approve',role_id) THEN
    RETURN 'FINAL_APPROVER';
  END IF;
  SELECT count(*) INTO n
  FROM app_private.approval_request_steps s
  JOIN app_private.approval_step_reviewers a ON a.step_id=s.id
  JOIN app_private.approval_step_templates t ON t.id=s.template_id
  WHERE s.request_id=p_request AND s.state='OPEN' AND a.reviewer_id=p_actor
    AND a.withdrawn_at IS NULL AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE'
    AND app_private.d1_family_principal_membership_authorized(
      p_actor,'family.access.approve',t.reviewer_role_id);
  IF n=1 THEN RETURN 'OPEN_REVIEWER'; ELSIF n>1 THEN RETURN NULL; END IF;
  SELECT count(*) INTO n
  FROM app_private.approval_reviews v
  JOIN app_private.approval_request_steps s ON s.id=v.step_id
  JOIN app_private.approval_step_templates t ON t.id=s.template_id
  WHERE s.request_id=p_request AND v.reviewer_id=p_actor
    AND app_private.d1_family_principal_membership_authorized(
      p_actor,'family.access.approve',t.reviewer_role_id);
  IF n=1 THEN RETURN 'DECIDED_REVIEWER'; END IF;
  RETURN NULL;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_family_principal_membership_participant_kind(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_family_principal_membership_participant_kind(uuid,uuid)
  TO schoolos_read_executor,schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;

GRANT CREATE ON SCHEMA app TO schoolos_read_executor;
SET ROLE schoolos_read_executor;
CREATE FUNCTION app.d1_read_family_principal_membership_request(p_request_id uuid)
RETURNS TABLE(request_id uuid,request_version bigint,request_state text,family_id uuid,expected_family_version bigint,
  target_principal_id uuid,expected_principal_version bigint,action text,source_membership_id uuid,source_family_id uuid,
  effective_on date,request_reason text,participant_kind text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE actor uuid; req record; kind text; target_principal uuid; principal_version bigint; action text;
  source_id uuid; source_family uuid; effective_on date;
BEGIN
  IF p_request_id IS NULL THEN RETURN; END IF;
  PERFORM pg_catalog.pg_advisory_xact_lock_shared(71001,1);
  actor:=app_private.current_principal_id();
  IF actor IS NULL THEN RETURN; END IF;
  SELECT q.* INTO req FROM app_private.approval_requests q
    JOIN app_private.operation_contracts o ON o.id=q.operation_id
    WHERE q.id=p_request_id AND o.code='family.principal_membership.change';
  IF NOT FOUND OR req.requested_payload IS NULL OR pg_catalog.jsonb_typeof(req.requested_payload)<>'object' THEN RETURN; END IF;
  BEGIN
    target_principal:=NULLIF(req.requested_payload->>'target_principal_id','')::uuid;
    principal_version:=(req.requested_payload->>'expected_principal_version')::bigint;
    action:=req.requested_payload->>'action';
    source_id:=NULLIF(req.requested_payload->>'source_membership_id','')::uuid;
    source_family:=NULLIF(req.requested_payload->>'source_family_id','')::uuid;
    effective_on:=NULLIF(req.requested_payload->>'effective_on','')::date;
  EXCEPTION WHEN invalid_text_representation OR numeric_value_out_of_range OR datetime_field_overflow THEN RETURN; END;
  IF target_principal IS NULL OR principal_version<1 OR action IS NULL
     OR action NOT IN ('ADD','END','CORRECT') OR effective_on IS NULL THEN RETURN; END IF;
  PERFORM app_private.d1_family_principal_membership_lock_principals(actor,req.requester_id,target_principal);
  kind:=app_private.d1_family_principal_membership_participant_kind(p_request_id,actor);
  IF kind IS NULL THEN RETURN; END IF;
  RETURN QUERY SELECT req.id,req.row_version,req.state,req.target_ref,req.expected_target_version,
    target_principal,principal_version,action,source_id,source_family,effective_on,req.reason,kind;
END $body$;
REVOKE ALL ON FUNCTION app.d1_read_family_principal_membership_request(uuid)
  FROM PUBLIC,anon,service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_family_principal_membership_request(uuid) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_read_executor;

REVOKE ALL ON FUNCTION app.d1_change_family_principal_membership(uuid,bigint,uuid,bigint,text,uuid,date,text,text)
  FROM PUBLIC,anon,service_role;
GRANT EXECUTE ON FUNCTION app.d1_change_family_principal_membership(uuid,bigint,uuid,bigint,text,uuid,date,text,text)
  TO authenticated;
REVOKE ALL ON FUNCTION app.d1_submit_family_principal_membership_change(uuid,bigint,uuid,bigint,text,uuid,date,text,text)
  FROM PUBLIC,anon,service_role;
GRANT EXECUTE ON FUNCTION app.d1_submit_family_principal_membership_change(uuid,bigint,uuid,bigint,text,uuid,date,text,text)
  TO authenticated;
REVOKE ALL ON FUNCTION app.d1_review_family_principal_membership_change(uuid,text,bigint,text,text)
  FROM PUBLIC,anon,service_role;
GRANT EXECUTE ON FUNCTION app.d1_review_family_principal_membership_change(uuid,text,bigint,text,text)
  TO authenticated;
REVOKE ALL ON FUNCTION app.d1_apply_family_principal_membership_change(uuid,bigint,text)
  FROM PUBLIC,anon,service_role;
GRANT EXECUTE ON FUNCTION app.d1_apply_family_principal_membership_change(uuid,bigint,text)
  TO authenticated;
