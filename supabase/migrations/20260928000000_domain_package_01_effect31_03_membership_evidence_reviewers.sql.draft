-- Effect 31 evidence boundary and exact P1 reviewer helpers.
-- Static non-executable continuation only. Migration 10 remains .sql.draft.

GRANT CREATE ON SCHEMA app_private TO schoolos_evidence_writer;
SET ROLE schoolos_evidence_writer;
CREATE FUNCTION app_private.d1_family_principal_membership_receipt(
  p_command_kind text,p_actor uuid,p_operation uuid,p_key text,p_hash bytea,p_expected_family bigint,
  p_request uuid,p_expected_request bigint,p_state text,p_result_kind text,p_result uuid,p_summary jsonb,p_error text
) RETURNS uuid
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE rid uuid:=pg_catalog.gen_random_uuid(); k bigint;
BEGIN
  IF p_actor IS NULL OR p_actor IS DISTINCT FROM app_private.current_principal_id()
     OR p_operation IS NULL OR NOT EXISTS (
       SELECT 1 FROM app_private.operation_contracts o
       WHERE o.id=p_operation AND o.code='family.principal_membership.change'
         AND o.contract_version=1 AND o.handler_key='family.principal_membership.change' AND o.enabled)
     OR p_command_kind NOT IN ('family.principal_membership.change','request.submit','request.review','request.apply')
     OR p_key IS NULL OR pg_catalog.length(pg_catalog.btrim(p_key))=0 OR p_hash IS NULL
     OR p_expected_family IS NULL OR p_expected_family<1
     OR p_summary IS NULL OR pg_catalog.jsonb_typeof(p_summary)<>'object'
     OR p_state NOT IN ('SUCCEEDED','REJECTED') THEN
    RAISE EXCEPTION 'D1 Family membership receipt intent denied';
  END IF;
  SELECT count(*) INTO k FROM pg_catalog.jsonb_object_keys(p_summary);
  IF p_command_kind='family.principal_membership.change' THEN
    IF p_request IS NOT NULL OR p_expected_request IS NOT NULL OR p_state<>'SUCCEEDED'
       OR p_result_kind IS DISTINCT FROM 'D1_FAMILY_PRINCIPAL_MEMBERSHIP_CHANGE' OR p_result IS NULL
       OR p_error IS NOT NULL OR k<>10 THEN
      RAISE EXCEPTION 'D1 Family membership direct receipt shape denied';
    END IF;
  ELSIF p_command_kind='request.submit' THEN
    IF p_request IS NULL OR p_expected_request IS NOT NULL OR p_state<>'SUCCEEDED'
       OR p_result_kind IS DISTINCT FROM 'D1_FAMILY_PRINCIPAL_MEMBERSHIP_REQUEST'
       OR p_result IS DISTINCT FROM p_request OR p_error IS NOT NULL OR k<>2
       OR p_summary->>'state'<>'PENDING' THEN
      RAISE EXCEPTION 'D1 Family membership submit receipt shape denied';
    END IF;
  ELSIF p_command_kind='request.review' THEN
    IF p_request IS NULL OR p_expected_request IS NULL OR p_expected_request<1 OR p_state<>'SUCCEEDED'
       OR p_result_kind IS DISTINCT FROM 'D1_FAMILY_PRINCIPAL_MEMBERSHIP_REVIEW'
       OR p_result IS DISTINCT FROM p_request OR p_error IS NOT NULL OR k<>2
       OR p_summary->>'state' NOT IN ('PENDING','APPROVED','REJECTED') THEN
      RAISE EXCEPTION 'D1 Family membership review receipt shape denied';
    END IF;
  ELSIF p_state='SUCCEEDED' THEN
    IF p_request IS NULL OR p_expected_request IS NULL OR p_expected_request<1
       OR p_result_kind IS DISTINCT FROM 'D1_FAMILY_PRINCIPAL_MEMBERSHIP_CHANGE' OR p_result IS NULL
       OR p_error IS NOT NULL OR k<>12 OR p_summary->>'state'<>'EXECUTED' THEN
      RAISE EXCEPTION 'D1 Family membership apply receipt shape denied';
    END IF;
  ELSE
    IF p_request IS NULL OR p_expected_request IS NULL OR p_expected_request<1
       OR p_result_kind IS NOT NULL OR p_result IS NOT NULL
       OR p_error IS NULL OR pg_catalog.length(pg_catalog.btrim(p_error))=0
       OR k<>2 OR p_summary->>'state'<>'INVALIDATED' THEN
      RAISE EXCEPTION 'D1 Family membership invalidation receipt shape denied';
    END IF;
  END IF;
  INSERT INTO app_private.command_receipts
    (id,principal_id,operation_id,command_kind,idempotency_key,canonical_payload_hash,canonicalization_version,
     expected_target_version,request_id,expected_request_version,state,result_kind,result_ref,result_summary,error_code,completed_at,created_by)
  VALUES (rid,p_actor,p_operation,p_command_kind,p_key,p_hash,1,p_expected_family,p_request,p_expected_request,
    p_state,p_result_kind,p_result,p_summary,p_error,pg_catalog.statement_timestamp(),p_actor);
  RETURN rid;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_family_principal_membership_receipt(text,uuid,uuid,text,bytea,bigint,uuid,bigint,text,text,uuid,jsonb,text)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_family_principal_membership_receipt(text,uuid,uuid,text,bytea,bigint,uuid,bigint,text,text,uuid,jsonb,text)
  TO schoolos_family_executor,schoolos_workflow_executor;

CREATE FUNCTION app_private.d1_family_principal_membership_audit(
  p_actor uuid,p_phase text,p_family uuid,p_principal uuid,p_membership uuid,p_source uuid,p_source_family uuid,p_action text,
  p_receipt uuid,p_request uuid,p_family_version bigint,p_principal_version bigint,p_outcome text,p_error text,p_correlation uuid
) RETURNS void
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE expected_kind text;
BEGIN
  expected_kind:=CASE p_phase WHEN 'DIRECT' THEN 'family.principal_membership.change'
    WHEN 'SUBMIT' THEN 'request.submit' WHEN 'REVIEW' THEN 'request.review' WHEN 'APPLY' THEN 'request.apply' END;
  IF p_actor IS NULL OR p_actor IS DISTINCT FROM app_private.current_principal_id()
     OR p_phase NOT IN ('DIRECT','SUBMIT','REVIEW','APPLY') OR p_family IS NULL OR p_principal IS NULL
     OR p_action NOT IN ('ADD','END','CORRECT') OR p_receipt IS NULL
     OR p_family_version IS NULL OR p_family_version<1 OR p_principal_version IS NULL OR p_principal_version<1
     OR p_outcome NOT IN ('SUCCEEDED','REJECTED') OR p_correlation IS NULL
     OR (p_outcome='REJECTED' AND (p_error IS NULL OR pg_catalog.length(pg_catalog.btrim(p_error))=0))
     OR (p_outcome='SUCCEEDED' AND p_error IS NOT NULL)
     OR NOT EXISTS (
       SELECT 1 FROM app_private.command_receipts r
       JOIN app_private.operation_contracts o ON o.id=r.operation_id
       WHERE r.id=p_receipt AND r.principal_id=p_actor AND r.command_kind=expected_kind
         AND r.state=p_outcome AND o.code='family.principal_membership.change'
         AND r.request_id IS NOT DISTINCT FROM p_request) THEN
    RAISE EXCEPTION 'D1 Family membership audit intent denied';
  END IF;
  INSERT INTO app_private.audit_events
    (actor_id,actor_kind,outcome,authority_evidence,target_version,event_type,target_kind,target_ref,
     command_receipt_id,approval_request_id,source_kind,correlation_id,details,created_by)
  VALUES (p_actor,'INDIVIDUAL',p_outcome,
    pg_catalog.jsonb_build_object('operation','family.principal_membership.change','phase',p_phase),
    p_family_version,'family.principal_membership.change','FAMILY',p_family,p_receipt,p_request,'API',p_correlation,
    pg_catalog.jsonb_build_object('principal_id',p_principal,'membership_id',p_membership,
      'source_membership_id',p_source,'source_family_id',p_source_family,'action',p_action,
      'principal_version',p_principal_version,'error_code',p_error),p_actor);
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_family_principal_membership_audit(uuid,text,uuid,uuid,uuid,uuid,uuid,text,uuid,uuid,bigint,bigint,text,text,uuid)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_family_principal_membership_audit(uuid,text,uuid,uuid,uuid,uuid,uuid,text,uuid,uuid,bigint,bigint,text,text,uuid)
  TO schoolos_family_executor,schoolos_workflow_executor;

CREATE FUNCTION app_private.d1_family_principal_membership_event(
  p_actor uuid,p_family uuid,p_principal uuid,p_membership uuid,p_source uuid,p_source_family uuid,p_action text,
  p_receipt uuid,p_correlation uuid
) RETURNS void
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
BEGIN
  IF p_actor IS NULL OR p_actor IS DISTINCT FROM app_private.current_principal_id()
     OR p_family IS NULL OR p_principal IS NULL OR p_membership IS NULL
     OR p_action NOT IN ('ADD','END','CORRECT') OR p_receipt IS NULL OR p_correlation IS NULL
     OR NOT EXISTS (
       SELECT 1 FROM app_private.command_receipts r
       JOIN app_private.operation_contracts o ON o.id=r.operation_id
       WHERE r.id=p_receipt AND r.principal_id=p_actor AND r.state='SUCCEEDED'
         AND r.command_kind IN ('family.principal_membership.change','request.apply')
         AND r.result_ref=p_membership AND o.code='family.principal_membership.change') THEN
    RAISE EXCEPTION 'D1 Family membership event intent denied';
  END IF;
  INSERT INTO app_private.outbox_events
    (event_type,aggregate_kind,aggregate_ref,aggregate_version,command_receipt_id,event_ordinal,correlation_id,payload,created_by)
  VALUES ('family.principal_link_changed','FAMILY_PRINCIPAL_MEMBERSHIP',p_membership,1,p_receipt,1,p_correlation,
    pg_catalog.jsonb_build_object('family_id',p_family,'principal_id',p_principal,'membership_id',p_membership,
      'source_membership_id',p_source,'source_family_id',p_source_family,'action',p_action),p_actor);
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_family_principal_membership_event(uuid,uuid,uuid,uuid,uuid,uuid,text,uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_family_principal_membership_event(uuid,uuid,uuid,uuid,uuid,uuid,text,uuid,uuid)
  TO schoolos_family_executor,schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_evidence_writer;

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE FUNCTION app_private.d1_family_principal_membership_candidates(p_request uuid,p_step uuid)
RETURNS TABLE(candidate_principal_id uuid)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; templ record; requester_person uuid;
BEGIN
  SELECT q.id,q.requester_id INTO req FROM app_private.approval_requests q
    JOIN app_private.operation_contracts o ON o.id=q.operation_id
    WHERE q.id=p_request AND o.code='family.principal_membership.change';
  SELECT t.id,t.reviewer_role_id,t.selection_resolver_key INTO templ FROM app_private.approval_request_steps s
    JOIN app_private.approval_step_templates t ON t.id=s.template_id
    WHERE s.id=p_step AND s.request_id=p_request;
  IF req.id IS NULL OR templ.id IS NULL
     OR templ.selection_resolver_key IS DISTINCT FROM 'D1_REVIEWER_ROLE_SCOPE' THEN RETURN; END IF;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id;
  IF requester_person IS NULL THEN RETURN; END IF;
  RETURN QUERY
  SELECT p.id FROM app_private.principals p
  JOIN app_private.principal_auth_bindings b ON b.principal_id=p.id AND b.principal_kind='INDIVIDUAL'
  WHERE p.kind='INDIVIDUAL' AND p.state='ACTIVE' AND p.person_id IS NOT NULL AND b.auth_user_id IS NOT NULL
    AND p.id<>req.requester_id AND p.person_id<>requester_person
    AND app_private.d1_family_principal_membership_authorized(
      p.id,'family.access.approve',templ.reviewer_role_id)
  ORDER BY p.id;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_family_principal_membership_candidates(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_family_principal_membership_candidates(uuid,uuid)
  TO schoolos_workflow_executor,schoolos_read_executor;

CREATE FUNCTION app_private.d1_family_principal_membership_reviews_live(p_request uuid)
RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; requester_person uuid; s record; n bigint; reviewer uuid; reviewer_person uuid; seen bigint:=0;
BEGIN
  SELECT q.id,q.requester_id INTO req FROM app_private.approval_requests q
    JOIN app_private.operation_contracts o ON o.id=q.operation_id
    WHERE q.id=p_request AND o.code='family.principal_membership.change';
  IF NOT FOUND THEN RETURN false; END IF;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id;
  IF requester_person IS NULL THEN RETURN false; END IF;
  FOR s IN
    SELECT st.id,st.state,t.reviewer_role_id
    FROM app_private.approval_request_steps st
    JOIN app_private.approval_step_templates t ON t.id=st.template_id
    WHERE st.request_id=p_request ORDER BY st.step_number
  LOOP
    seen:=seen+1;
    IF s.state<>'APPROVED' OR s.reviewer_role_id IS NULL THEN RETURN false; END IF;
    SELECT count(*),min(v.reviewer_id::text)::uuid INTO n,reviewer
    FROM app_private.approval_reviews v
    JOIN app_private.approval_step_reviewers a
      ON a.id=v.reviewer_assignment_id AND a.step_id=s.id
    WHERE v.step_id=s.id AND v.decision='APPROVE' AND a.reviewer_id=v.reviewer_id
      AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
    IF n<>1 OR reviewer IS NULL THEN RETURN false; END IF;
    SELECT p.person_id INTO reviewer_person FROM app_private.principals p WHERE p.id=reviewer;
    IF reviewer_person IS NULL OR reviewer_person=requester_person
       OR NOT app_private.d1_family_principal_membership_authorized(
         reviewer,'family.access.approve',s.reviewer_role_id) THEN RETURN false; END IF;
  END LOOP;
  RETURN seen>0;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_family_principal_membership_reviews_live(uuid)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_family_principal_membership_reviews_live(uuid)
  TO schoolos_workflow_executor,schoolos_read_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;
