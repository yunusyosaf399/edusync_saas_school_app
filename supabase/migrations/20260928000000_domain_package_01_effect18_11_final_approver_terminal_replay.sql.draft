CREATE OR REPLACE FUNCTION app_private.d1_employee_campus_affiliation_participant(
  p_request uuid,p_actor uuid
) RETURNS text
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE base text; final_role uuid; ctx record; payload jsonb;
  source_campus uuid; destination_campus uuid;
BEGIN
  base:=app_private.d1_employee_campus_affiliation_participant_v0(p_request,p_actor);
  IF base IS DISTINCT FROM 'DECIDED_REVIEWER' THEN RETURN base; END IF;
  final_role:=app_private.d1_final_approver_role(p_request,p_actor);
  IF final_role IS NULL THEN RETURN base; END IF;
  SELECT r.target_ref,r.old_snapshot,r.requested_payload INTO ctx
    FROM app_private.approval_requests r
    JOIN app_private.operation_contracts o ON o.id=r.operation_id
   WHERE r.id=p_request AND o.code='employee.campus_affiliation.change';
  IF NOT FOUND THEN RETURN base; END IF;
  payload:=ctx.old_snapshot||ctx.requested_payload;
  source_campus:=NULLIF(payload->>'source_campus_id','')::uuid;
  destination_campus:=NULLIF(payload->>'campus_id','')::uuid;
  IF app_private.d1_employee_campus_affiliation_authorized(
      p_actor,'employee.campus_affiliation.approve',ctx.target_ref,
      source_campus,destination_campus,final_role)
  THEN RETURN 'FINAL_APPROVER'; END IF;
  RETURN base;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_employee_campus_affiliation_participant(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_employee_campus_affiliation_participant(uuid,uuid)
  TO schoolos_workflow_executor,schoolos_read_executor;

CREATE OR REPLACE FUNCTION app_private.d1_teaching_capability_participant(
  p_request uuid,p_actor uuid
) RETURNS text
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE base text; final_role uuid; ctx record; payload jsonb; action text; end_on date;
BEGIN
  base:=app_private.d1_teaching_capability_participant_v0(p_request,p_actor);
  IF base IS DISTINCT FROM 'DECIDED_REVIEWER' THEN RETURN base; END IF;
  final_role:=app_private.d1_final_approver_role(p_request,p_actor);
  IF final_role IS NULL THEN RETURN base; END IF;
  SELECT r.target_ref,r.old_snapshot,r.requested_payload INTO ctx
    FROM app_private.approval_requests r
    JOIN app_private.operation_contracts o ON o.id=r.operation_id
   WHERE r.id=p_request AND o.code='teaching.capability.change';
  IF NOT FOUND THEN RETURN base; END IF;
  payload:=ctx.old_snapshot||ctx.requested_payload;
  action:=payload->>'action';
  end_on:=NULLIF(payload->>'effective_until','')::date;
  IF app_private.d1_teaching_capability_authorized(
      p_actor,'teaching.capability.approve',ctx.target_ref,action,end_on,final_role)
  THEN RETURN 'FINAL_APPROVER'; END IF;
  RETURN base;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_teaching_capability_participant(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_teaching_capability_participant(uuid,uuid)
  TO schoolos_workflow_executor,schoolos_read_executor;

