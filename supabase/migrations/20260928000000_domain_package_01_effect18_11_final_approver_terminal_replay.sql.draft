-- D1C1B cross-effect final-approver terminal replay correction.
-- Static non-executable continuation only.
-- Continuation 09 removed row-order dependence for the initial APPROVED apply path,
-- but its full-reviews-live upgrade intentionally requires request state APPROVED.
-- Terminal apply receipt replay occurs after EXECUTED/INVALIDATED, so this continuation
-- rechecks the actor's exact final-step reviewer role/scope directly. The underlying
-- legacy participant still supplies operation/payload/person/current-participant checks.

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;

CREATE FUNCTION app_private.d1_final_approver_role(
  p_request uuid,p_actor uuid
) RETURNS uuid
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE n bigint; final_role uuid;
BEGIN
  IF p_request IS NULL OR p_actor IS NULL THEN RETURN NULL; END IF;
  SELECT count(*),min(t.reviewer_role_id::text)::uuid
    INTO n,final_role
    FROM app_private.approval_request_steps s
    JOIN app_private.approval_step_templates t
      ON t.id=s.template_id AND t.policy_id=s.policy_id
     AND t.step_number=s.step_number
    JOIN app_private.approval_reviews v ON v.step_id=s.id
    JOIN app_private.approval_step_reviewers a
      ON a.id=v.reviewer_assignment_id AND a.step_id=s.id
     AND a.reviewer_id=v.reviewer_id
   WHERE s.request_id=p_request
     AND s.step_number=(
       SELECT max(f.step_number)
         FROM app_private.approval_request_steps f
        WHERE f.request_id=p_request)
     AND s.state='APPROVED'
     AND t.reviewer_role_id IS NOT NULL
     AND t.selection_resolver_key='D1_REVIEWER_ROLE_SCOPE'
     AND v.reviewer_id=p_actor AND v.decision='APPROVE'
     AND a.reviewer_id=p_actor
     AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
  IF n<>1 OR final_role IS NULL THEN RETURN NULL; END IF;
  RETURN final_role;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_final_approver_role(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role,schoolos_workflow_executor,schoolos_read_executor;

CREATE OR REPLACE FUNCTION app_private.d1_profile_participant(
  p_request uuid,p_actor uuid
) RETURNS text
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE base text; final_role uuid; ctx record; profile_kind text; review_code text;
BEGIN
  base:=app_private.d1_profile_participant_v0(p_request,p_actor);
  IF base IS DISTINCT FROM 'DECIDED_REVIEWER' THEN RETURN base; END IF;
  final_role:=app_private.d1_final_approver_role(p_request,p_actor);
  IF final_role IS NULL THEN RETURN base; END IF;
  SELECT r.target_ref,r.campus_id,o.code INTO ctx
    FROM app_private.approval_requests r
    JOIN app_private.operation_contracts o ON o.id=r.operation_id
   WHERE r.id=p_request AND o.code IN ('student.profile.update','employee.profile.update');
  IF NOT FOUND THEN RETURN base; END IF;
  profile_kind:=CASE ctx.code WHEN 'student.profile.update' THEN 'STUDENT' ELSE 'EMPLOYEE' END;
  review_code:=CASE profile_kind WHEN 'STUDENT' THEN 'student.profile.approve'
                                  ELSE 'employee.profile.approve' END;
  IF app_private.d1_profile_authorized(
      p_actor,review_code,profile_kind,ctx.target_ref,ctx.campus_id,final_role)
  THEN RETURN 'FINAL_APPROVER'; END IF;
  RETURN base;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_profile_participant(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_profile_participant(uuid,uuid)
  TO schoolos_workflow_executor,schoolos_read_executor;

CREATE OR REPLACE FUNCTION app_private.d1_employee_state_participant(
  p_request uuid,p_actor uuid
) RETURNS text
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE base text; final_role uuid; target uuid;
BEGIN
  base:=app_private.d1_employee_state_participant_v0(p_request,p_actor);
  IF base IS DISTINCT FROM 'DECIDED_REVIEWER' THEN RETURN base; END IF;
  final_role:=app_private.d1_final_approver_role(p_request,p_actor);
  IF final_role IS NULL THEN RETURN base; END IF;
  SELECT r.target_ref INTO target
    FROM app_private.approval_requests r
    JOIN app_private.operation_contracts o ON o.id=r.operation_id
   WHERE r.id=p_request AND o.code='employee.state.change';
  IF target IS NOT NULL AND app_private.d1_employee_state_authorized(
      p_actor,'employee.state.approve',target,final_role)
  THEN RETURN 'FINAL_APPROVER'; END IF;
  RETURN base;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_employee_state_participant(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_employee_state_participant(uuid,uuid)
  TO schoolos_workflow_executor,schoolos_read_executor;

