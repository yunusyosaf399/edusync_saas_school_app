-- D1 #56 authentic Student Status acceptance: narrow immutable-history locking ACL.
-- Real P1 status change failed with 42501 on app_private.student_status_transitions.
-- The student-executor-owned lock helper previously SELECTed t.* without the
-- created_at SELECT column grant, and attempted FOR UPDATE on the append-only
-- history even though this internal role intentionally has no UPDATE privilege.
-- Preserve SERIALIZATION using first locking app_private.students FOR UPDATE;
-- the immutable history observation then takes a compatible FOR SHARE row lock.
-- Grant only the single missing SELECT column to the existing NOLOGIN Student
-- executor; no table-wide SELECT, no UPDATE on history and no client grants.
-- This only redefines the existing same-owner helper; inactive .sql.draft.

SET ROLE schoolos_schema_owner;
GRANT SELECT (created_at) ON app_private.student_status_transitions
  TO schoolos_student_executor;
RESET ROLE;

GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE OR REPLACE FUNCTION app_private.d1_student_status_lock_context(p_student uuid,p_expected_version bigint DEFAULT NULL)
RETURNS TABLE(student_version bigint,current_status text,last_transition_id uuid,last_effective_on date,last_sequence bigint,
  enrollment_id uuid,enrollment_from date,error_code text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE s app_private.students%ROWTYPE; st app_private.student_status_transitions%ROWTYPE; e app_private.enrollments%ROWTYPE; n bigint;
BEGIN
  SELECT * INTO s FROM app_private.students WHERE id=p_student FOR UPDATE;
  IF NOT FOUND THEN RETURN QUERY SELECT NULL::bigint,NULL::text,NULL::uuid,NULL::date,NULL::bigint,NULL::uuid,NULL::date,'D1_STUDENT_STATUS_STUDENT_MISSING'; RETURN; END IF;
  IF p_expected_version IS NOT NULL AND s.row_version IS DISTINCT FROM p_expected_version THEN
    RETURN QUERY SELECT s.row_version,s.current_status,NULL::uuid,NULL::date,NULL::bigint,NULL::uuid,NULL::date,'D1_STUDENT_STATUS_VERSION_STALE'; RETURN; END IF;
  SELECT t.* INTO st FROM app_private.student_status_transitions t
   WHERE t.student_id=p_student AND NOT EXISTS (SELECT 1 FROM app_private.student_status_transitions x WHERE x.student_id=p_student AND x.supersedes_id=t.id)
   ORDER BY t.effective_on DESC,t.sequence_number DESC LIMIT 1 FOR SHARE;
  IF NOT FOUND OR st.new_status IS DISTINCT FROM s.current_status THEN
    RETURN QUERY SELECT s.row_version,s.current_status,NULL::uuid,NULL::date,NULL::bigint,NULL::uuid,NULL::date,'D1_STUDENT_STATUS_PROJECTION_DIVERGED'; RETURN; END IF;
  SELECT count(*) INTO n FROM app_private.enrollments x WHERE x.student_id=p_student AND x.placement_kind='PRIMARY' AND x.placement_state='ACTIVE' AND x.effective_until IS NULL;
  IF n>1 THEN RETURN QUERY SELECT s.row_version,s.current_status,st.id,st.effective_on,st.sequence_number,NULL::uuid,NULL::date,'D1_STUDENT_STATUS_ACTIVE_PLACEMENT_AMBIGUOUS'; RETURN; END IF;
  IF n=1 THEN SELECT * INTO e FROM app_private.enrollments x WHERE x.student_id=p_student AND x.placement_kind='PRIMARY' AND x.placement_state='ACTIVE' AND x.effective_until IS NULL FOR UPDATE;
    PERFORM r.id FROM app_private.roll_allocations r WHERE r.student_id=p_student AND r.enrollment_id=e.id AND r.effective_until IS NULL ORDER BY r.id FOR UPDATE;
  END IF;
  RETURN QUERY SELECT s.row_version,s.current_status,st.id,st.effective_on,st.sequence_number,e.id,e.effective_from,NULL::text;
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;
