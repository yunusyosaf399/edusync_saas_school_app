-- DB-02 I11: prove the original APPLY terminal response from durable rows.
-- The current School head may have changed; never rerun the domain effect.
GRANT SELECT ON app_private.approval_applications TO schoolos_evidence_writer;
GRANT SELECT(row_version,requested_payload,old_snapshot) ON app_private.approval_requests
 TO schoolos_evidence_writer;
SET ROLE schoolos_schema_owner;
CREATE POLICY db02_i11_evidence_application ON app_private.approval_applications
 FOR SELECT TO schoolos_evidence_writer USING (EXISTS (
 SELECT 1 FROM app_private.approval_requests q WHERE q.id=request_id));
RESET ROLE;
GRANT CREATE ON SCHEMA app_private TO schoolos_evidence_writer;
SET ROLE schoolos_evidence_writer;
CREATE FUNCTION app_private.d1_roll_policy_apply_replay(
 p_actor uuid,p_operation uuid,p_key text,p_hash bytea,p_request uuid,p_expected bigint)
RETURNS TABLE(result_version bigint,result_state text,result_revision uuid)
LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE r app_private.command_receipts%ROWTYPE; q record;
 pol app_private.roll_policy_revisions%ROWTYPE; src record; s jsonb;
 v_action text; v_source uuid; pool_count bigint; audit_n bigint; outbox_n bigint;
BEGIN
 IF p_actor IS NULL OR p_actor IS DISTINCT FROM app_private.current_principal_id()
   OR p_operation IS NULL OR p_request IS NULL OR p_expected<4
   OR p_hash IS NULL OR pg_catalog.octet_length(p_hash)<>32 THEN RETURN; END IF;
 SELECT * INTO r FROM app_private.command_receipts
 WHERE principal_id=p_actor AND operation_id=p_operation AND idempotency_key=p_key;
 IF NOT FOUND OR r.command_kind IS DISTINCT FROM 'request.apply'
   OR r.request_id IS DISTINCT FROM p_request OR r.expected_request_version IS DISTINCT FROM p_expected
   OR r.canonicalization_version IS DISTINCT FROM 1 OR r.canonical_payload_hash IS DISTINCT FROM p_hash
   OR r.created_by IS DISTINCT FROM p_actor OR r.completed_at IS NULL
   OR r.state NOT IN ('SUCCEEDED','REJECTED') THEN RETURN; END IF;
 SELECT operation_id,policy_id,target_ref,requester_id,state,row_version,
        expected_target_version,requested_payload,old_snapshot
 INTO q FROM app_private.approval_requests WHERE id=p_request;
 IF NOT FOUND OR q.operation_id IS DISTINCT FROM p_operation OR q.policy_id IS NULL
   OR q.target_ref IS NULL OR q.row_version IS DISTINCT FROM p_expected+1
   OR q.requested_payload->>'selected_p1_version_id' IS DISTINCT FROM q.policy_id::text
 THEN RETURN; END IF;
 SELECT count(*) INTO audit_n FROM app_private.audit_events a
 WHERE a.command_receipt_id=r.id AND a.actor_id=p_actor AND a.created_by=p_actor
   AND a.event_type='student.roll_policy.change' AND a.target_kind='SCHOOL'
   AND a.target_ref=q.target_ref AND a.approval_request_id=p_request
   AND a.source_kind='API' AND a.actor_kind='INDIVIDUAL'
   AND a.authority_evidence=pg_catalog.jsonb_build_object(
     'operation','student.roll_policy.change','phase','APPLY',
     'selected_p1_version_id',q.policy_id)
   AND a.outcome=CASE r.state WHEN 'SUCCEEDED' THEN 'SUCCEEDED' ELSE 'REJECTED' END;
 IF audit_n<>1 OR (SELECT count(*) FROM app_private.audit_events WHERE command_receipt_id=r.id)<>1
   OR (SELECT count(*) FROM app_private.approval_transitions t
       WHERE t.command_receipt_id=r.id AND t.request_id=p_request
         AND t.from_state='APPROVED' AND t.created_by=p_actor
         AND t.to_state=CASE r.state WHEN 'SUCCEEDED' THEN 'EXECUTED' ELSE 'INVALIDATED' END)<>1
 THEN RETURN; END IF;
 IF r.state='REJECTED' THEN
   IF q.state IS DISTINCT FROM 'INVALIDATED' OR r.result_ref IS NOT NULL
     OR r.result_kind IS NOT NULL OR r.error_code NOT IN (
       'DB02_APPLY_P1_STALE','DB02_APPLY_REQUESTER_REVOKED',
       'DB02_APPLY_REVIEWER_REVOKED','DB02_APPLY_SOURCE_STALE',
       'DB02_APPLY_DATE_STALE','DB02_APPLY_ALLOCATOR_STALE')
     OR r.result_summary IS DISTINCT FROM pg_catalog.jsonb_build_object(
       'request_version',q.row_version,'state','INVALIDATED')
     OR (SELECT count(*) FROM app_private.approval_applications WHERE request_id=p_request)<>0
     OR EXISTS (SELECT 1 FROM app_private.outbox_events WHERE command_receipt_id=r.id)
     OR NOT EXISTS (SELECT 1 FROM app_private.audit_events a WHERE a.command_receipt_id=r.id
          AND a.details=pg_catalog.jsonb_build_object('error_code',r.error_code))
   THEN RETURN; END IF;
   RETURN QUERY SELECT q.row_version,'INVALIDATED'::text,NULL::uuid;
   RETURN;
 END IF;
 s:=r.result_summary; v_action:=q.requested_payload->>'action';
 IF q.state IS DISTINCT FROM 'EXECUTED' OR r.result_kind IS DISTINCT FROM 'D1_STUDENT_ROLL_POLICY'
   OR r.error_code IS NOT NULL OR r.result_ref IS NULL
   OR pg_catalog.jsonb_typeof(s) IS DISTINCT FROM 'object'
   OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(s))<>14
   OR NOT (s ?& ARRAY['school_id','action','source_policy_id','source_revision',
      'source_mode','source_start_value','source_effective_from','policy_revision_id',
      'revision','mode','start_value','effective_from','selected_p1_version_id',
      'allocator_pool_count']) OR v_action NOT IN ('INIT','REPLACE') THEN RETURN; END IF;
 BEGIN v_source:=NULLIF(q.old_snapshot->>'source_policy_id','')::uuid;
 EXCEPTION WHEN invalid_text_representation THEN RETURN; END;
 SELECT * INTO pol FROM app_private.roll_policy_revisions
 WHERE id=r.result_ref AND school_id=q.target_ref;
 IF NOT FOUND OR pol.created_by IS DISTINCT FROM p_actor
   OR pol.supersedes_id IS DISTINCT FROM v_source
   OR s->>'school_id' IS DISTINCT FROM q.target_ref::text
   OR s->>'action' IS DISTINCT FROM v_action
   OR s->>'source_policy_id' IS DISTINCT FROM v_source::text
   OR s->>'policy_revision_id' IS DISTINCT FROM pol.id::text
   OR s->>'selected_p1_version_id' IS DISTINCT FROM q.policy_id::text
   OR s->>'revision' IS DISTINCT FROM pol.revision::text
   OR s->>'mode' IS DISTINCT FROM pol.mode OR s->>'mode' IS DISTINCT FROM q.requested_payload->>'mode'
   OR s->>'start_value' IS DISTINCT FROM pol.start_value::text
   OR s->>'start_value' IS DISTINCT FROM q.requested_payload->>'start_value'
   OR s->>'effective_from' IS DISTINCT FROM pol.effective_from::text
   OR s->>'effective_from' IS DISTINCT FROM q.requested_payload->>'trusted_business_date'
   OR r.expected_target_version IS DISTINCT FROM q.expected_target_version THEN RETURN; END IF;
 IF v_action='INIT' THEN
   IF v_source IS NOT NULL OR pol.revision<>1
     OR s->>'source_revision' IS NOT NULL OR s->>'source_mode' IS NOT NULL
     OR s->>'source_start_value' IS NOT NULL OR s->>'source_effective_from' IS NOT NULL
   THEN RETURN; END IF;
 ELSE
   SELECT revision,mode,start_value,effective_from,effective_until,ended_by,ended_at
   INTO src FROM app_private.roll_policy_revisions WHERE id=v_source AND school_id=q.target_ref;
   IF NOT FOUND OR src.revision+1<>pol.revision
     OR src.effective_until IS DISTINCT FROM pol.effective_from
     OR src.ended_by IS DISTINCT FROM p_actor OR src.ended_at IS NULL
     OR s->>'source_revision' IS DISTINCT FROM src.revision::text
     OR s->>'source_mode' IS DISTINCT FROM src.mode
     OR s->>'source_start_value' IS DISTINCT FROM src.start_value::text
     OR s->>'source_effective_from' IS DISTINCT FROM src.effective_from::text
   THEN RETURN; END IF;
 END IF;
 SELECT count(*) INTO pool_count FROM app_private.roll_allocator_states
 WHERE policy_revision_id=pol.id;
 IF s->>'allocator_pool_count' IS DISTINCT FROM pool_count::text
   OR (pol.mode='PERSISTENT_STUDENT' AND (pool_count<>1 OR NOT EXISTS (
      SELECT 1 FROM app_private.roll_allocator_states WHERE policy_revision_id=pol.id
        AND class_offering_id IS NULL)))
   OR (pol.mode='ACADEMIC_CONTEXT' AND EXISTS (
      SELECT 1 FROM app_private.roll_allocator_states a
      LEFT JOIN app_private.class_offerings co ON co.id=a.class_offering_id
      WHERE a.policy_revision_id=pol.id AND (a.class_offering_id IS NULL OR co.school_id IS DISTINCT FROM q.target_ref)))
   OR (SELECT count(*) FROM app_private.approval_applications a
      WHERE a.request_id=p_request AND a.command_receipt_id=r.id
       AND a.operation_id=p_operation AND a.result_ref=pol.id AND a.created_by=p_actor
       AND a.applied_target_version IS NOT DISTINCT FROM q.expected_target_version)<>1
   OR (SELECT count(*) FROM app_private.approval_applications WHERE request_id=p_request)<>1
 THEN RETURN; END IF;
 SELECT count(*) INTO outbox_n FROM app_private.outbox_events e
 JOIN app_private.audit_events a ON a.command_receipt_id=e.command_receipt_id
 WHERE e.command_receipt_id=r.id AND e.event_type='student.roll_policy_changed'
  AND e.aggregate_kind='ROLL_POLICY' AND e.aggregate_ref=pol.id
  AND e.aggregate_version=pol.revision AND e.event_ordinal=1
  AND e.schema_version=1 AND e.created_by=p_actor
  AND e.correlation_id=a.correlation_id
  AND e.payload=pg_catalog.jsonb_build_object('school_id',q.target_ref,'action',v_action,
    'source_policy_id',v_source,'policy_revision_id',pol.id,
    'revision',pol.revision,'effective_from',pol.effective_from);
 IF outbox_n<>1 OR (SELECT count(*) FROM app_private.outbox_events WHERE command_receipt_id=r.id)<>1
   OR NOT EXISTS (SELECT 1 FROM app_private.audit_events a WHERE a.command_receipt_id=r.id
     AND a.target_version=pol.revision AND a.details=pg_catalog.jsonb_build_object(
      'action',v_action,'source_policy_id',v_source,'policy_revision_id',pol.id,
      'revision',pol.revision,'effective_from',pol.effective_from))
 THEN RETURN; END IF;
 RETURN QUERY SELECT q.row_version,'EXECUTED'::text,pol.id;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_roll_policy_apply_replay(uuid,uuid,text,bytea,uuid,bigint)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_roll_policy_apply_replay(uuid,uuid,text,bytea,uuid,bigint)
 TO schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_evidence_writer;
