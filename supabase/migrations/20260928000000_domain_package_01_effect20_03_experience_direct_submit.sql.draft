GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE FUNCTION app_private.d1_employee_experience_candidates(p_request uuid,p_step uuid)
RETURNS TABLE(candidate_principal_id uuid)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; templ record; requester_person uuid;
BEGIN
  SELECT q.* INTO req FROM app_private.approval_requests q WHERE q.id=p_request;
  SELECT t.* INTO templ FROM app_private.approval_request_steps s JOIN app_private.approval_step_templates t ON t.id=s.template_id
   WHERE s.id=p_step AND s.request_id=p_request;
  IF req.id IS NULL OR templ.id IS NULL OR templ.selection_resolver_key IS DISTINCT FROM 'D1_REVIEWER_ROLE_SCOPE' THEN RETURN; END IF;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id;
  RETURN QUERY SELECT p.id FROM app_private.principals p
   WHERE p.kind='INDIVIDUAL' AND p.state='ACTIVE' AND p.person_id IS NOT NULL
     AND p.id<>req.requester_id AND p.person_id<>requester_person
     AND app_private.d1_employee_experience_authorized(p.id,'employee.experience.approve',req.target_ref,templ.reviewer_role_id)
   ORDER BY p.id;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_employee_experience_candidates(uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_employee_experience_candidates(uuid,uuid) TO schoolos_workflow_executor,schoolos_read_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;

GRANT CREATE ON SCHEMA app TO schoolos_employee_executor;
SET ROLE schoolos_employee_executor;
CREATE FUNCTION app.d1_change_employee_experience(
  p_employee_id uuid,p_expected_employee_version bigint,p_action text,p_source_snapshot_id uuid,p_expected_experience_record_id uuid,
  p_organization_name text,p_role_title text,p_starts_on date,p_ends_on date,p_summary text,p_reason text,p_idempotency_key text
) RETURNS TABLE(snapshot_id uuid,experience_record_id uuid,action text,effective_from timestamptz,effective_until timestamptz,employee_version bigint)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; policy_row record; pre record; effect_row record; receipt uuid; correlation uuid:=pg_catalog.gen_random_uuid(); employee_version bigint;
BEGIN
  SELECT * INTO ctx FROM app_private.d1_employee_experience_command_context('employee.experience.change',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_employee_id,p_expected_employee_version::text,p_action,p_source_snapshot_id,
      p_expected_experience_record_id,p_organization_name,p_role_title,p_starts_on,p_ends_on,p_summary));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  IF NOT app_private.d1_employee_experience_authorized(ctx.actor_id,'employee.experience.change',p_employee_id,NULL)
  THEN RAISE EXCEPTION 'D1 Employee experience authority denied'; END IF;
  SELECT * INTO policy_row FROM app_private.d1_employee_experience_policy(p_employee_id);
  IF policy_row.policy_id IS NULL OR policy_row.route_mode IS DISTINCT FROM 'DIRECT' THEN
    RAISE EXCEPTION 'D1 Employee experience requires approval request'; END IF;
  IF ctx.receipt_id IS NOT NULL THEN
    IF ctx.receipt_state<>'SUCCEEDED' OR ctx.result_ref IS NULL OR ctx.result_summary IS NULL
       OR NOT (ctx.result_summary ?& ARRAY['snapshot_id','experience_record_id','action','effective_from','effective_until','employee_version'])
       OR ctx.result_summary->>'action' IS DISTINCT FROM p_action THEN RAISE EXCEPTION 'D1 Employee experience replay receipt invalid'; END IF;
    RETURN QUERY SELECT ctx.result_ref,(ctx.result_summary->>'experience_record_id')::uuid,p_action,
      (ctx.result_summary->>'effective_from')::timestamptz,
      CASE WHEN ctx.result_summary->>'effective_until' IS NULL THEN NULL::timestamptz ELSE (ctx.result_summary->>'effective_until')::timestamptz END,
      (ctx.result_summary->>'employee_version')::bigint; RETURN; END IF;
  SELECT e.row_version INTO employee_version FROM app_private.employees e WHERE e.id=p_employee_id FOR UPDATE;
  IF employee_version IS DISTINCT FROM p_expected_employee_version THEN RAISE EXCEPTION 'D1 Employee experience employee version changed'; END IF;
  SELECT * INTO pre FROM app_private.d1_employee_experience_preflight(p_employee_id,p_expected_employee_version,p_action,p_source_snapshot_id,
    p_expected_experience_record_id,p_organization_name,p_role_title,p_starts_on,p_ends_on,p_summary,p_reason);
  IF pre.eligible IS DISTINCT FROM true THEN RAISE EXCEPTION 'D1 Employee experience preflight denied: %',pre.error_code; END IF;
  SELECT * INTO effect_row FROM app_private.d1_employee_experience_effect(ctx.actor_id,p_employee_id,p_expected_employee_version,p_action,
    p_source_snapshot_id,p_expected_experience_record_id,p_organization_name,p_role_title,p_starts_on,p_ends_on,p_summary,p_reason);
  receipt:=app_private.d1_employee_experience_receipt('employee.experience.change',ctx.actor_id,ctx.operation_id,p_idempotency_key,
    ctx.intent_hash,p_expected_employee_version,NULL,NULL,'SUCCEEDED','D1_EMPLOYEE_EXPERIENCE_CHANGE',effect_row.snapshot_id,
    pg_catalog.jsonb_build_object('snapshot_id',effect_row.snapshot_id,'experience_record_id',effect_row.experience_record_id,'action',p_action,
      'effective_from',effect_row.effective_from,'effective_until',effect_row.effective_until,'employee_version',employee_version),NULL);
  PERFORM app_private.d1_employee_experience_audit(ctx.actor_id,'employee.experience.change',p_action,p_employee_id,effect_row.snapshot_id,
    effect_row.experience_record_id,p_source_snapshot_id,receipt,NULL,employee_version,'SUCCEEDED',correlation);
  PERFORM app_private.d1_employee_experience_event(ctx.actor_id,p_action,p_employee_id,effect_row.snapshot_id,effect_row.experience_record_id,
    p_source_snapshot_id,receipt,employee_version,correlation);
  RETURN QUERY SELECT effect_row.snapshot_id,effect_row.experience_record_id,p_action,effect_row.effective_from,effect_row.effective_until,employee_version;
END $body$;
REVOKE ALL ON FUNCTION app.d1_change_employee_experience(uuid,bigint,text,uuid,uuid,text,text,date,date,text,text,text)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_change_employee_experience(uuid,bigint,text,uuid,uuid,text,text,date,date,text,text,text) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_employee_executor;

GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE FUNCTION app.d1_submit_employee_experience_change(
  p_employee_id uuid,p_expected_employee_version bigint,p_action text,p_source_snapshot_id uuid,p_expected_experience_record_id uuid,
  p_organization_name text,p_role_title text,p_starts_on date,p_ends_on date,p_summary text,p_reason text,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; policy_row record; pre record; template_row record; src record; new_request uuid:=pg_catalog.gen_random_uuid();
  first_step uuid; candidate_count bigint; final_version bigint; receipt uuid; old_snapshot jsonb; requested_payload jsonb;
BEGIN
  SELECT * INTO ctx FROM app_private.d1_employee_experience_command_context('request.submit',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_employee_id,p_expected_employee_version::text,p_action,p_source_snapshot_id,
      p_expected_experience_record_id,p_organization_name,p_role_title,p_starts_on,p_ends_on,p_summary));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  IF NOT app_private.d1_employee_experience_authorized(ctx.actor_id,'employee.experience.change',p_employee_id,NULL)
  THEN RAISE EXCEPTION 'D1 Employee experience request authority denied'; END IF;
  SELECT * INTO policy_row FROM app_private.d1_employee_experience_policy(p_employee_id);
  IF policy_row.policy_id IS NULL OR policy_row.route_mode IS DISTINCT FROM 'APPROVAL' THEN
    RAISE EXCEPTION 'D1 Employee experience policy selects direct command'; END IF;
  IF ctx.receipt_id IS NOT NULL THEN
    IF ctx.receipt_state<>'SUCCEEDED' OR ctx.result_ref IS NULL OR ctx.result_summary->>'state'<>'PENDING' THEN
      RAISE EXCEPTION 'D1 Employee experience submit receipt invalid'; END IF;
    RETURN QUERY SELECT ctx.result_ref,(ctx.result_summary->>'request_version')::bigint; RETURN; END IF;
  SELECT * INTO pre FROM app_private.d1_employee_experience_preflight(p_employee_id,p_expected_employee_version,p_action,p_source_snapshot_id,
    p_expected_experience_record_id,p_organization_name,p_role_title,p_starts_on,p_ends_on,p_summary,p_reason);
  IF pre.eligible IS DISTINCT FROM true THEN RAISE EXCEPTION 'D1 Employee experience request preflight denied: %',pre.error_code; END IF;
  SELECT x.id,x.experience_record_id,x.organization_name,x.role_title,x.starts_on,x.ends_on,x.summary,x.effective_from,x.supersedes_id INTO src
    FROM app_private.employee_experience_entries x WHERE x.id=p_source_snapshot_id;
  old_snapshot:=pg_catalog.jsonb_build_object('source_snapshot_id',p_source_snapshot_id,'experience_record_id',p_expected_experience_record_id,
    'organization_name',src.organization_name,'role_title',src.role_title,'starts_on',src.starts_on,'ends_on',src.ends_on,
    'summary',src.summary,'effective_from',src.effective_from,'supersedes_id',src.supersedes_id);
  requested_payload:=pg_catalog.jsonb_build_object('action',p_action,'organization_name',p_organization_name,'role_title',p_role_title,
    'starts_on',p_starts_on,'ends_on',p_ends_on,'summary',p_summary);
  INSERT INTO app_private.approval_requests
    (id,operation_id,payload_schema_version,policy_id,requester_id,campus_id,target_ref,expected_target_version,reason,old_snapshot,requested_payload,created_by)
  VALUES (new_request,ctx.operation_id,1,policy_row.policy_id,ctx.actor_id,NULL,p_employee_id,p_expected_employee_version,p_reason,old_snapshot,requested_payload,ctx.actor_id);
  UPDATE app_private.approval_requests SET state='SUBMITTED',submitted_at=pg_catalog.statement_timestamp() WHERE id=new_request;
  FOR template_row IN SELECT t.id,t.step_number,t.required_reviews FROM app_private.approval_step_templates t
    WHERE t.policy_id=policy_row.policy_id ORDER BY t.step_number LOOP
    IF template_row.step_number=1 THEN first_step:=pg_catalog.gen_random_uuid(); END IF;
    INSERT INTO app_private.approval_request_steps(id,request_id,policy_id,template_id,step_number,required_reviews,created_by)
    VALUES (CASE WHEN template_row.step_number=1 THEN first_step ELSE pg_catalog.gen_random_uuid() END,new_request,policy_row.policy_id,
      template_row.id,template_row.step_number,template_row.required_reviews,ctx.actor_id);
  END LOOP;
  IF first_step IS NULL THEN RAISE EXCEPTION 'D1 Employee experience policy has no first step'; END IF;
  UPDATE app_private.approval_requests SET state='PENDING' WHERE id=new_request RETURNING row_version INTO final_version;
  UPDATE app_private.approval_request_steps SET state='OPEN',opened_at=pg_catalog.statement_timestamp() WHERE id=first_step;
  INSERT INTO app_private.approval_step_reviewers(step_id,reviewer_id,assignment_reason,created_by)
  SELECT first_step,c.candidate_principal_id,'D1_REVIEWER_ROLE_SCOPE',ctx.actor_id FROM app_private.d1_employee_experience_candidates(new_request,first_step) c;
  GET DIAGNOSTICS candidate_count=ROW_COUNT;
  IF candidate_count=0 THEN RAISE EXCEPTION 'D1 Employee experience step has no reviewer'; END IF;
  receipt:=app_private.d1_employee_experience_receipt('request.submit',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
    p_expected_employee_version,new_request,NULL,'SUCCEEDED','D1_EMPLOYEE_EXPERIENCE_REQUEST',new_request,
    pg_catalog.jsonb_build_object('request_version',final_version,'state','PENDING'),NULL);
  PERFORM app_private.d1_employee_experience_audit(ctx.actor_id,'request.submit',p_action,p_employee_id,NULL,p_expected_experience_record_id,
    p_source_snapshot_id,receipt,new_request,p_expected_employee_version,'SUCCEEDED',pg_catalog.gen_random_uuid());
  RETURN QUERY SELECT new_request,final_version;
END $body$;
REVOKE ALL ON FUNCTION app.d1_submit_employee_experience_change(uuid,bigint,text,uuid,uuid,text,text,date,date,text,text,text)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_submit_employee_experience_change(uuid,bigint,text,uuid,uuid,text,text,date,date,text,text,text) TO authenticated;
