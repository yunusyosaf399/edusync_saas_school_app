-- Effect 30 explicit APPROVAL apply. Stale business state deterministically invalidates.

GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE FUNCTION app.d1_apply_family_relationship_change(
 p_request_id uuid,p_expected_request_version bigint,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint,request_state text,relationship_id uuid)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; req record; policy_row record; locks record; pre record; eff record; final_role uuid;
  family_id uuid; source_id uuid; adult_person uuid; replacement_id uuid; stored_replacement_family uuid;
  family_version bigint; action text; relationship_kind text; display_name text; relationship_contact text; effective_on date;
  invalidation_code text; final_version bigint; receipt uuid; seq bigint; summary jsonb; base_summary jsonb;
  corr uuid:=pg_catalog.gen_random_uuid();
BEGIN
  IF p_request_id IS NULL OR p_expected_request_version IS NULL OR p_expected_request_version<1 THEN
    RAISE EXCEPTION 'D1 Family relationship apply intent invalid';
  END IF;
  SELECT * INTO ctx FROM app_private.d1_command_receipt_lookup(
    'family.relationship.change','request.apply',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_request_id,p_expected_request_version::text));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT q.* INTO req FROM app_private.approval_requests q
    WHERE q.id=p_request_id AND q.operation_id=ctx.operation_id FOR UPDATE;
  IF NOT FOUND OR req.expected_target_version IS NULL OR req.policy_id IS NULL OR req.reason IS NULL
     OR pg_catalog.length(pg_catalog.btrim(req.reason))=0 OR req.requested_payload IS NULL
     OR pg_catalog.jsonb_typeof(req.requested_payload)<>'object'
     OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(req.requested_payload))<>11
     OR NOT (req.requested_payload ?& ARRAY['family_id','expected_family_version','action','source_relationship_id',
       'adult_person_id','relationship_kind','display_name','relationship_contact','effective_on',
       'primary_replacement_relationship_id','replacement_family_id']) THEN
    RAISE EXCEPTION 'D1 Family relationship stored request malformed';
  END IF;
  BEGIN
    family_id:=NULLIF(req.requested_payload->>'family_id','')::uuid;
    family_version:=(req.requested_payload->>'expected_family_version')::bigint;
    action:=req.requested_payload->>'action';
    source_id:=NULLIF(req.requested_payload->>'source_relationship_id','')::uuid;
    adult_person:=NULLIF(req.requested_payload->>'adult_person_id','')::uuid;
    relationship_kind:=req.requested_payload->>'relationship_kind';
    display_name:=req.requested_payload->>'display_name';
    relationship_contact:=req.requested_payload->>'relationship_contact';
    effective_on:=NULLIF(req.requested_payload->>'effective_on','')::date;
    replacement_id:=NULLIF(req.requested_payload->>'primary_replacement_relationship_id','')::uuid;
    stored_replacement_family:=NULLIF(req.requested_payload->>'replacement_family_id','')::uuid;
  EXCEPTION WHEN invalid_text_representation OR numeric_value_out_of_range OR datetime_field_overflow THEN
    RAISE EXCEPTION 'D1 Family relationship stored request malformed';
  END;
  IF family_id IS NULL OR family_version<1 OR action NOT IN ('ADD','END','CORRECT') OR effective_on IS NULL THEN
    RAISE EXCEPTION 'D1 Family relationship stored request malformed';
  END IF;
  SELECT * INTO locks FROM app_private.d1_family_relationship_lock_targets(
    req.target_ref,family_id,source_id,adult_person,replacement_id);
  IF locks.student_version IS NULL OR locks.family_version IS NULL THEN
    RAISE EXCEPTION 'D1 Family relationship request target missing';
  END IF;
  IF locks.replacement_family_id IS DISTINCT FROM stored_replacement_family THEN
    RAISE EXCEPTION 'D1 Family relationship replacement ancestry changed';
  END IF;
  final_role:=app_private.d1_final_approver_role(p_request_id,ctx.actor_id);
  IF NOT ((ctx.actor_id=req.requester_id AND app_private.d1_family_relationship_authorized(
              ctx.actor_id,'family.relationship.change',req.target_ref,NULL))
       OR (final_role IS NOT NULL AND app_private.d1_family_relationship_authorized(
              ctx.actor_id,'family.access.approve',req.target_ref,final_role))) THEN
    RAISE EXCEPTION 'D1 Family relationship request unavailable';
  END IF;

  IF ctx.receipt_id IS NOT NULL THEN
    IF NOT app_private.d1_family_relationship_authorized(req.requester_id,'family.relationship.change',req.target_ref,NULL) THEN
      RAISE EXCEPTION 'D1 Family relationship requester authority revoked';
    END IF;
    IF ctx.receipt_state='SUCCEEDED' THEN
      IF app_private.d1_family_relationship_reviews_live(p_request_id) IS DISTINCT FROM true
         OR ctx.result_ref IS NULL OR ctx.result_summary IS NULL
         OR ctx.result_summary->>'state'<>'EXECUTED' OR ctx.result_summary->>'request_version' IS NULL THEN
        RAISE EXCEPTION 'D1 Family relationship apply receipt invalid';
      END IF;
      base_summary:=ctx.result_summary-'request_version'-'state';
      IF app_private.d1_family_relationship_result_rows_match(
           req.target_ref,family_id,action,source_id,ctx.result_ref,effective_on,base_summary) IS DISTINCT FROM true
         OR NOT EXISTS (SELECT 1 FROM app_private.approval_applications a
           WHERE a.request_id=p_request_id AND a.command_receipt_id=ctx.receipt_id
             AND a.operation_id=ctx.operation_id AND a.result_ref=ctx.result_ref
             AND a.applied_target_version=req.expected_target_version) THEN
        RAISE EXCEPTION 'D1 Family relationship apply replay evidence invalid';
      END IF;
      RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,'EXECUTED',ctx.result_ref; RETURN;
    ELSIF ctx.receipt_state='REJECTED' THEN
      IF ctx.result_ref IS NOT NULL OR ctx.result_summary IS NULL OR ctx.result_summary->>'state'<>'INVALIDATED' THEN
        RAISE EXCEPTION 'D1 Family relationship invalidation receipt malformed';
      END IF;
      RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,'INVALIDATED',NULL::uuid; RETURN;
    ELSE
      RAISE EXCEPTION 'D1 Family relationship apply receipt invalid';
    END IF;
  END IF;

  IF req.state<>'APPROVED' OR req.row_version<>p_expected_request_version THEN
    RAISE EXCEPTION 'D1 Family relationship approved request changed';
  END IF;
  SELECT * INTO policy_row FROM app_private.d1_family_relationship_policy(req.target_ref);
  IF policy_row.policy_id IS DISTINCT FROM req.policy_id OR policy_row.route_mode IS DISTINCT FROM 'APPROVAL'
     OR policy_row.campus_id IS DISTINCT FROM req.campus_id THEN
    invalidation_code:='D1_FAMILY_RELATIONSHIP_POLICY_STALE';
  ELSIF NOT app_private.d1_family_relationship_authorized(req.requester_id,'family.relationship.change',req.target_ref,NULL) THEN
    invalidation_code:='D1_FAMILY_RELATIONSHIP_REQUESTER_AUTHORITY_STALE';
  ELSIF app_private.d1_family_relationship_reviews_live(p_request_id) IS DISTINCT FROM true THEN
    invalidation_code:='D1_FAMILY_RELATIONSHIP_REVIEW_AUTHORITY_STALE';
  ELSIF locks.student_version IS DISTINCT FROM req.expected_target_version THEN
    invalidation_code:='D1_FAMILY_RELATIONSHIP_STUDENT_VERSION_STALE';
  ELSIF locks.family_version IS DISTINCT FROM family_version THEN
    invalidation_code:='D1_FAMILY_RELATIONSHIP_FAMILY_VERSION_STALE';
  END IF;
  IF invalidation_code IS NULL THEN
    SELECT * INTO pre FROM app_private.d1_family_relationship_preflight(
      req.target_ref,req.expected_target_version,family_id,family_version,action,source_id,adult_person,
      relationship_kind,display_name,relationship_contact,effective_on,req.reason,replacement_id);
    IF pre.eligible IS DISTINCT FROM true THEN
      invalidation_code:=COALESCE(pre.error_code,'D1_FAMILY_RELATIONSHIP_PREFLIGHT_STALE');
    ELSIF pre.replacement_family_id IS DISTINCT FROM stored_replacement_family THEN
      invalidation_code:='D1_FAMILY_RELATIONSHIP_REPLACEMENT_STALE';
    END IF;
  END IF;

  IF invalidation_code IS NOT NULL THEN
    UPDATE app_private.approval_requests SET state='INVALIDATED' WHERE id=p_request_id RETURNING row_version INTO final_version;
    receipt:=app_private.d1_family_relationship_receipt(
      'request.apply',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,req.expected_target_version,
      p_request_id,p_expected_request_version,'REJECTED',NULL,NULL,
      pg_catalog.jsonb_build_object('request_version',final_version,'state','INVALIDATED'),invalidation_code);
    SELECT COALESCE(max(t.sequence_number),0)+1 INTO seq
      FROM app_private.approval_transitions t WHERE t.request_id=p_request_id;
    INSERT INTO app_private.approval_transitions
      (request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
    VALUES (p_request_id,seq,'APPROVED','INVALIDATED',invalidation_code,receipt,ctx.actor_id);
    PERFORM app_private.d1_family_relationship_audit(
      ctx.actor_id,'APPLY',req.target_ref,family_id,source_id,source_id,action,receipt,p_request_id,
      req.expected_target_version,family_version,'REJECTED',invalidation_code,corr);
    RETURN QUERY SELECT p_request_id,final_version,'INVALIDATED',NULL::uuid; RETURN;
  END IF;

  SELECT * INTO eff FROM app_private.d1_family_relationship_effect(
    ctx.actor_id,req.target_ref,req.expected_target_version,family_id,family_version,action,source_id,adult_person,
    relationship_kind,display_name,relationship_contact,effective_on,req.reason,replacement_id);
  summary:=pg_catalog.jsonb_build_object(
    'relationship_id',eff.relationship_id,'source_relationship_id',eff.source_relationship_id,'action',action,
    'effective_from',eff.effective_from,'effective_until',eff.effective_until,'student_version',eff.student_version,
    'family_version',eff.family_version,'primary_context_id',eff.primary_context_id,'access_closed_count',eff.access_closed_count);
  UPDATE app_private.approval_requests SET state='EXECUTED',executed_at=pg_catalog.statement_timestamp()
    WHERE id=p_request_id RETURNING row_version INTO final_version;
  receipt:=app_private.d1_family_relationship_receipt(
    'request.apply',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,req.expected_target_version,
    p_request_id,p_expected_request_version,'SUCCEEDED','D1_FAMILY_RELATIONSHIP_CHANGE',eff.relationship_id,
    summary||pg_catalog.jsonb_build_object('request_version',final_version,'state','EXECUTED'),NULL);
  INSERT INTO app_private.approval_applications
    (request_id,command_receipt_id,operation_id,applied_target_version,result_ref,created_by)
  VALUES (p_request_id,receipt,ctx.operation_id,req.expected_target_version,eff.relationship_id,ctx.actor_id);
  SELECT COALESCE(max(t.sequence_number),0)+1 INTO seq
    FROM app_private.approval_transitions t WHERE t.request_id=p_request_id;
  INSERT INTO app_private.approval_transitions
    (request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
  VALUES (p_request_id,seq,'APPROVED','EXECUTED','D1_FAMILY_RELATIONSHIP_APPLIED',receipt,ctx.actor_id);
  PERFORM app_private.d1_family_relationship_audit(
    ctx.actor_id,'APPLY',req.target_ref,family_id,eff.relationship_id,source_id,action,receipt,p_request_id,
    eff.student_version,eff.family_version,'SUCCEEDED',NULL,corr);
  PERFORM app_private.d1_family_relationship_event(
    ctx.actor_id,req.target_ref,family_id,eff.relationship_id,source_id,action,receipt,corr);
  RETURN QUERY SELECT p_request_id,final_version,'EXECUTED',eff.relationship_id;
END $body$;
REVOKE ALL ON FUNCTION app.d1_apply_family_relationship_change(uuid,bigint,text)
  FROM PUBLIC,anon,service_role;
GRANT EXECUTE ON FUNCTION app.d1_apply_family_relationship_change(uuid,bigint,text) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;
