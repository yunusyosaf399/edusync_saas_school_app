-- DB-01 RC-06/07: authenticated P1 APPROVAL SUBMIT (no Roll mutation).
-- Candidate-only Migration 10 draft, no activation, reviewed source locks,
-- immutable exact approved-source snapshot and independent Person reviewer.
-- Narrow schema-owner receipt/audit witness; Evidence writer must never
-- receive generic read access to historical audit rows.
SET ROLE schoolos_schema_owner;
CREATE FUNCTION app_private.d1_roll_correct_submit_audit_witness(
 p_receipt uuid,p_request uuid,p_actor uuid
) RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE n bigint;
BEGIN
 IF p_receipt IS NULL OR p_request IS NULL OR p_actor IS NULL THEN RETURN false; END IF;
 SELECT count(*) INTO n
 FROM app_private.audit_events a
 JOIN app_private.command_receipts r ON r.id=a.command_receipt_id
 WHERE a.command_receipt_id=p_receipt AND a.approval_request_id=p_request
   AND a.actor_id=p_actor AND a.actor_kind='INDIVIDUAL'
   AND a.event_type='student.roll.correct' AND a.target_kind='STUDENT'
   AND a.outcome='SUCCEEDED'
   AND r.id=p_receipt AND r.request_id=p_request AND r.principal_id=p_actor
   AND r.command_kind='request.submit' AND r.state='SUCCEEDED'
   AND r.result_kind='D1_STUDENT_ROLL_CORRECT_REQUEST';
 RETURN n=1;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_roll_correct_submit_audit_witness(uuid,uuid,uuid)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_roll_correct_submit_audit_witness(uuid,uuid,uuid)
 TO schoolos_evidence_writer;
RESET ROLE;

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE FUNCTION app_private.d1_roll_correct_reviewer_candidates(
 p_request uuid,p_step uuid
) RETURNS TABLE(candidate_principal_id uuid)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; step_info record; requester_person uuid; source_section uuid;
BEGIN
 SELECT q.id,q.requester_id,q.policy_id,q.old_snapshot INTO req
  FROM app_private.approval_requests q WHERE q.id=p_request;
 SELECT t.id,t.policy_id,t.selection_resolver_key,t.required_reviews,t.reviewer_role_id
  INTO step_info FROM app_private.approval_request_steps s
 JOIN app_private.approval_step_templates t ON t.id=s.template_id
 WHERE s.id=p_step AND s.request_id=p_request AND s.policy_id=t.policy_id;
 IF req.id IS NULL OR step_info.id IS NULL OR req.policy_id IS DISTINCT FROM step_info.policy_id
    OR step_info.selection_resolver_key IS DISTINCT FROM 'D1_REVIEWER_ROLE_SCOPE'
    OR step_info.required_reviews IS DISTINCT FROM 1 THEN RETURN; END IF;
 source_section:=NULLIF(req.old_snapshot->>'source_section_offering_id','')::uuid;
 SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id;
 IF source_section IS NULL OR requester_person IS NULL THEN RETURN; END IF;
 RETURN QUERY SELECT p.id FROM app_private.principals p
 WHERE p.kind='INDIVIDUAL' AND p.state='ACTIVE' AND p.person_id IS NOT NULL
   AND p.id<>req.requester_id AND p.person_id<>requester_person
   AND app_private.d1_roll_correct_authorized(p.id,'student.roll.approve',
          source_section,step_info.reviewer_role_id)
 ORDER BY p.id;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_roll_correct_reviewer_candidates(uuid,uuid)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_roll_correct_reviewer_candidates(uuid,uuid)
 TO schoolos_workflow_executor,schoolos_read_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;

GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE FUNCTION app_private.d1_roll_correct_submit_number_available(
 p_student uuid,p_source_section uuid,p_source_roll uuid,p_policy uuid,
 p_requested bigint,p_business_date date
) RETURNS TABLE(number_available boolean,source_origin uuid)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ancestry record; policy_row record; claimed boolean;
BEGIN
 IF p_student IS NULL OR p_source_section IS NULL OR p_source_roll IS NULL
    OR p_policy IS NULL OR p_requested IS NULL OR p_requested<1
    OR p_requested>9223372036854775806::bigint OR p_business_date IS NULL THEN
   RETURN QUERY SELECT false,NULL::uuid; RETURN; END IF;
 SELECT * INTO ancestry FROM app_private.d1_enrollment_place_destination(p_source_section);
 SELECT rp.* INTO policy_row FROM app_private.roll_policy_revisions rp
 WHERE rp.id=p_policy AND rp.school_id=ancestry.school_id;
 IF ancestry.school_id IS NULL OR ancestry.class_offering_id IS NULL OR policy_row.id IS NULL
    OR p_requested<policy_row.start_value
    OR policy_row.mode NOT IN ('PERSISTENT_STUDENT','ACADEMIC_CONTEXT')
    OR policy_row.effective_from>p_business_date
    OR (policy_row.effective_until IS NOT NULL AND p_business_date>=policy_row.effective_until)
 THEN RETURN QUERY SELECT false,NULL::uuid; RETURN; END IF;
 SELECT r.origin_allocation_id INTO source_origin FROM app_private.roll_allocations r
  WHERE r.id=p_source_roll AND r.student_id=p_student AND r.policy_revision_id=p_policy;
 IF NOT FOUND THEN RETURN QUERY SELECT false,NULL::uuid; RETURN; END IF;
 IF policy_row.mode='PERSISTENT_STUDENT' THEN
   SELECT EXISTS(SELECT 1 FROM app_private.roll_allocations r
     JOIN app_private.roll_policy_revisions rp ON rp.id=r.policy_revision_id
     WHERE rp.school_id=ancestry.school_id AND rp.mode='PERSISTENT_STUDENT'
       AND r.student_id<>p_student AND r.numeric_value=p_requested) INTO claimed;
 ELSE
   SELECT EXISTS(SELECT 1 FROM app_private.roll_allocations r
     JOIN app_private.enrollments e ON e.id=r.enrollment_id
     JOIN app_private.section_offerings so ON so.id=e.section_offering_id
     WHERE r.policy_revision_id=p_policy AND r.id<>p_source_roll
       AND so.class_offering_id=ancestry.class_offering_id
       AND r.numeric_value=p_requested AND
       (r.effective_until IS NULL OR p_business_date<r.effective_until)) INTO claimed;
 END IF;
 RETURN QUERY SELECT claimed IS FALSE,source_origin;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_roll_correct_submit_number_available(uuid,uuid,uuid,uuid,bigint,date)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_roll_correct_submit_number_available(uuid,uuid,uuid,uuid,bigint,date)
 TO schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;

GRANT CREATE ON SCHEMA app_private TO schoolos_evidence_writer;
SET ROLE schoolos_evidence_writer;
CREATE FUNCTION app_private.d1_roll_correct_submit_evidence(
 p_actor uuid,p_operation uuid,p_key text,p_hash bytea,
 p_student uuid,p_source_enrollment uuid,p_source_section uuid,
 p_expected_version bigint,p_request uuid,p_request_version bigint
) RETURNS uuid
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE rid uuid:=pg_catalog.gen_random_uuid();
BEGIN
 IF p_actor IS NULL OR p_actor IS DISTINCT FROM app_private.current_principal_id()
    OR p_operation IS NULL OR p_key IS NULL OR length(btrim(p_key))=0
    OR p_hash IS NULL OR p_student IS NULL OR p_source_enrollment IS NULL
    OR p_source_section IS NULL OR p_expected_version IS NULL OR p_expected_version<1
    OR p_request IS NULL OR p_request_version IS NULL OR p_request_version<1
 THEN RAISE EXCEPTION 'D1 Roll correction SUBMIT evidence invalid'; END IF;
 -- The protected workflow executor just created and checked PENDING,
 -- exact source and independent OPEN reviewer in this SAME transaction.
 -- Evidence writer has intentionally no direct approval-table SELECT.
 INSERT INTO app_private.command_receipts(
   id,principal_id,operation_id,command_kind,idempotency_key,
   canonical_payload_hash,canonicalization_version,expected_target_version,
   request_id,expected_request_version,state,result_kind,result_ref,
   result_summary,completed_at,created_by)
 VALUES(rid,p_actor,p_operation,'request.submit',p_key,p_hash,1,p_expected_version,
   p_request,NULL,'SUCCEEDED','D1_STUDENT_ROLL_CORRECT_REQUEST',p_request,
   pg_catalog.jsonb_build_object('request_version',p_request_version::text,'state','PENDING'),
   pg_catalog.statement_timestamp(),p_actor);
 INSERT INTO app_private.audit_events(
   actor_id,actor_kind,outcome,authority_evidence,target_version,event_type,
   target_kind,target_ref,command_receipt_id,approval_request_id,source_kind,
   correlation_id,details,created_by)
 VALUES(p_actor,'INDIVIDUAL','SUCCEEDED',
   pg_catalog.jsonb_build_object('operation','student.roll.correct','phase','SUBMIT'),
   p_expected_version,'student.roll.correct','STUDENT',p_student,rid,p_request,
   'API',pg_catalog.gen_random_uuid(),
   pg_catalog.jsonb_build_object('source_enrollment_id',p_source_enrollment,
      'source_section_offering_id',p_source_section,'request_id',p_request),p_actor);
 RETURN rid;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_roll_correct_submit_evidence(uuid,uuid,text,bytea,uuid,uuid,uuid,bigint,uuid,bigint)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_roll_correct_submit_evidence(uuid,uuid,text,bytea,uuid,uuid,uuid,bigint,uuid,bigint)
 TO schoolos_workflow_executor;

CREATE FUNCTION app_private.d1_roll_correct_submit_receipt_matches_exact(
 p_receipt uuid,p_actor uuid,p_key text,p_hash bytea,
 p_student uuid,p_version bigint,p_enrollment uuid,p_section uuid,
 p_enrollment_from date,p_roll uuid,p_roll_from date,
 p_policy uuid,p_old bigint,p_new bigint,p_reason text
) RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE rec record;
BEGIN
 SELECT * INTO rec FROM app_private.command_receipts r WHERE r.id=p_receipt;
 IF rec.id IS NULL OR rec.principal_id IS DISTINCT FROM p_actor
    OR rec.command_kind IS DISTINCT FROM 'request.submit'
    OR rec.idempotency_key IS DISTINCT FROM p_key
    OR rec.canonical_payload_hash IS DISTINCT FROM p_hash
    OR rec.state IS DISTINCT FROM 'SUCCEEDED'
    OR rec.result_kind IS DISTINCT FROM 'D1_STUDENT_ROLL_CORRECT_REQUEST'
    OR rec.request_id IS NULL OR rec.result_ref IS DISTINCT FROM rec.request_id
    OR rec.expected_target_version IS DISTINCT FROM p_version
    OR rec.result_summary IS NULL OR jsonb_typeof(rec.result_summary)<>'object'
    OR (SELECT count(*) FROM jsonb_object_keys(rec.result_summary))<>2
    OR NOT(rec.result_summary ?& ARRAY['request_version','state'])
    OR rec.result_summary->>'state' IS DISTINCT FROM 'PENDING'
 THEN RETURN false; END IF;
 IF app_private.d1_roll_correct_submit_audit_witness(
     rec.id,rec.request_id,p_actor) IS DISTINCT FROM true
 THEN RETURN false; END IF;
 RETURN true;
EXCEPTION WHEN invalid_text_representation OR numeric_value_out_of_range THEN RETURN false;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_roll_correct_submit_receipt_matches_exact(uuid,uuid,text,bytea,uuid,bigint,uuid,uuid,date,uuid,date,uuid,bigint,bigint,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_roll_correct_submit_receipt_matches_exact(uuid,uuid,text,bytea,uuid,bigint,uuid,uuid,date,uuid,date,uuid,bigint,bigint,text)
 TO schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_evidence_writer;

GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE FUNCTION app.d1_submit_student_roll_correction(
 p_student_id uuid,p_expected_student_version bigint,
 p_source_enrollment_id uuid,p_expected_source_section_id uuid,
 p_expected_enrollment_effective_from date,p_source_roll_allocation_id uuid,
 p_expected_source_roll_effective_from date,p_expected_source_policy_revision_id uuid,
 p_expected_old_numeric_value bigint,p_requested_numeric_value bigint,
 p_reason text,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; route record; locked record; proposal record; prior_request record; req uuid:=pg_catalog.gen_random_uuid();
  template_row record; step_id uuid; final_version bigint; n bigint;
  prior_policy uuid; origin uuid; receipt uuid;
BEGIN
 IF p_student_id IS NULL OR p_expected_student_version IS NULL
    OR p_expected_student_version<1 OR p_expected_student_version>=9223372036854775807::bigint
    OR p_source_enrollment_id IS NULL OR p_expected_source_section_id IS NULL
    OR p_expected_enrollment_effective_from IS NULL OR p_source_roll_allocation_id IS NULL
    OR p_expected_source_roll_effective_from IS NULL OR p_expected_source_policy_revision_id IS NULL
    OR p_expected_old_numeric_value IS NULL OR p_expected_old_numeric_value<1
    OR p_requested_numeric_value IS NULL OR p_requested_numeric_value<1
    OR p_requested_numeric_value>9223372036854775806::bigint
    OR p_requested_numeric_value=p_expected_old_numeric_value
    OR p_reason IS NULL OR length(btrim(p_reason))=0 OR octet_length(p_reason)>2048
    OR p_idempotency_key IS NULL OR length(p_idempotency_key) NOT BETWEEN 1 AND 200
    OR length(btrim(p_idempotency_key))=0
 THEN RAISE EXCEPTION 'D1 Roll correction SUBMIT intent invalid'; END IF;
 SELECT * INTO ctx FROM app_private.d1_roll_correct_command_context(
   'request.submit',p_idempotency_key,pg_catalog.jsonb_build_array(
   p_student_id,p_expected_student_version::text,p_source_enrollment_id,
   p_expected_source_section_id,p_expected_enrollment_effective_from,
   p_source_roll_allocation_id,p_expected_source_roll_effective_from,
   p_expected_source_policy_revision_id,p_expected_old_numeric_value::text,
   p_requested_numeric_value::text,p_reason));
 IF NOT FOUND OR ctx.actor_id IS NULL THEN
   RAISE EXCEPTION 'D1 Roll correction SUBMIT actor invalid'; END IF;
 PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
 IF app_private.d1_roll_correct_authorized(ctx.actor_id,'student.roll.correct',
        p_expected_source_section_id,NULL::uuid) IS DISTINCT FROM true
 THEN RAISE EXCEPTION 'D1 Roll correction SUBMIT current authority denied'; END IF;
 IF ctx.receipt_id IS NOT NULL THEN
   -- Historical request is checked by workflow role (narrow approval table
   -- SELECT), while the private evidence writer verifies receipt and audit.
   -- No PENDING requirement: REVIEW/APPLY can have legally advanced state.
   SELECT * INTO prior_request FROM app_private.approval_requests q
     WHERE q.id=ctx.result_ref;
   IF NOT FOUND OR prior_request.requester_id IS DISTINCT FROM ctx.actor_id
     OR prior_request.operation_id IS DISTINCT FROM ctx.operation_id
     OR prior_request.target_ref IS DISTINCT FROM p_student_id
     OR prior_request.expected_target_version IS DISTINCT FROM p_expected_student_version
     OR prior_request.reason IS DISTINCT FROM p_reason
     OR prior_request.old_snapshot->>'student_id' IS DISTINCT FROM p_student_id::text
     OR prior_request.old_snapshot->>'source_enrollment_id' IS DISTINCT FROM p_source_enrollment_id::text
     OR prior_request.old_snapshot->>'source_section_offering_id' IS DISTINCT FROM p_expected_source_section_id::text
     OR prior_request.old_snapshot->>'source_enrollment_effective_from' IS DISTINCT FROM p_expected_enrollment_effective_from::text
     OR prior_request.old_snapshot->>'source_roll_allocation_id' IS DISTINCT FROM p_source_roll_allocation_id::text
     OR prior_request.old_snapshot->>'source_roll_effective_from' IS DISTINCT FROM p_expected_source_roll_effective_from::text
     OR prior_request.old_snapshot->>'source_policy_revision_id' IS DISTINCT FROM p_expected_source_policy_revision_id::text
     OR prior_request.old_snapshot->>'source_old_numeric_value' IS DISTINCT FROM p_expected_old_numeric_value::text
     OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(prior_request.old_snapshot))<>9
     OR prior_request.requested_payload IS DISTINCT FROM pg_catalog.jsonb_build_object(
       'proposed_numeric_value',p_requested_numeric_value::text)
   THEN RAISE EXCEPTION 'D1 Roll correction SUBMIT immutable request mismatch'; END IF;
   IF ctx.receipt_state IS DISTINCT FROM 'SUCCEEDED'
     OR ctx.result_ref IS NULL OR ctx.result_summary IS NULL
     OR app_private.d1_roll_correct_submit_receipt_matches_exact(
       ctx.receipt_id,ctx.actor_id,p_idempotency_key,ctx.intent_hash,
       p_student_id,p_expected_student_version,p_source_enrollment_id,
       p_expected_source_section_id,p_expected_enrollment_effective_from,
       p_source_roll_allocation_id,p_expected_source_roll_effective_from,
       p_expected_source_policy_revision_id,p_expected_old_numeric_value,
       p_requested_numeric_value,p_reason) IS DISTINCT FROM true
   THEN RAISE EXCEPTION 'D1 Roll correction SUBMIT receipt invalid'; END IF;
   RETURN QUERY SELECT ctx.result_ref,(ctx.result_summary->>'request_version')::bigint;
   RETURN;
 END IF;
 SELECT * INTO route FROM app_private.d1_roll_correct_policy(p_expected_source_section_id);
 IF NOT FOUND OR route.policy_id IS NULL OR route.route_mode IS DISTINCT FROM 'APPROVAL'
    OR route.campus_id IS NULL
 THEN RAISE EXCEPTION 'D1 Roll correction SUBMIT requires APPROVAL policy'; END IF;
 prior_policy:=route.policy_id;
 SELECT * INTO locked FROM app_private.d1_roll_correct_lock_source(
   p_student_id,p_expected_student_version,p_source_enrollment_id,
   p_expected_source_section_id,p_expected_enrollment_effective_from,
   p_source_roll_allocation_id,p_expected_source_roll_effective_from,
   p_expected_source_policy_revision_id,p_expected_old_numeric_value);
 IF NOT FOUND OR locked.error_code IS NOT NULL OR locked.business_date IS NULL
    OR locked.campus_id IS DISTINCT FROM route.campus_id
 THEN RAISE EXCEPTION 'D1 Roll correction SUBMIT source stale'; END IF;
 IF app_private.current_principal_id() IS DISTINCT FROM ctx.actor_id
    OR app_private.d1_roll_correct_authorized(ctx.actor_id,'student.roll.correct',
       p_expected_source_section_id,NULL::uuid) IS DISTINCT FROM true
 THEN RAISE EXCEPTION 'D1 Roll correction SUBMIT authority changed'; END IF;
 SELECT * INTO route FROM app_private.d1_roll_correct_policy(p_expected_source_section_id);
 IF NOT FOUND OR route.policy_id IS DISTINCT FROM prior_policy
    OR route.route_mode IS DISTINCT FROM 'APPROVAL'
    OR route.campus_id IS DISTINCT FROM locked.campus_id
 THEN RAISE EXCEPTION 'D1 Roll correction SUBMIT P1 policy changed'; END IF;
 SELECT * INTO proposal FROM app_private.d1_roll_correct_submit_number_available(
     p_student_id,p_expected_source_section_id,p_source_roll_allocation_id,
     p_expected_source_policy_revision_id,p_requested_numeric_value,
     locked.business_date);
 IF NOT FOUND OR proposal.number_available IS DISTINCT FROM true
 THEN RAISE EXCEPTION 'D1 Roll correction SUBMIT numeric unavailable'; END IF;
 origin:=proposal.source_origin;
 INSERT INTO app_private.approval_requests(
    id,operation_id,payload_schema_version,policy_id,requester_id,campus_id,
    target_ref,expected_target_version,reason,old_snapshot,requested_payload,created_by)
 VALUES(req,ctx.operation_id,1,prior_policy,ctx.actor_id,locked.campus_id,
   p_student_id,p_expected_student_version,p_reason,
   pg_catalog.jsonb_build_object(
     'student_id',p_student_id,'source_enrollment_id',p_source_enrollment_id,
     'source_section_offering_id',p_expected_source_section_id,
     'source_enrollment_effective_from',p_expected_enrollment_effective_from,
     'source_roll_allocation_id',p_source_roll_allocation_id,
     'source_roll_effective_from',p_expected_source_roll_effective_from,
     'source_policy_revision_id',p_expected_source_policy_revision_id,
     'source_old_numeric_value',p_expected_old_numeric_value::text,
     'source_roll_origin_allocation_id',origin),
   pg_catalog.jsonb_build_object('proposed_numeric_value',p_requested_numeric_value::text),
   ctx.actor_id);
 UPDATE app_private.approval_requests
 SET state='SUBMITTED',submitted_at=pg_catalog.statement_timestamp() WHERE id=req;
 FOR template_row IN SELECT t.id,t.step_number,t.required_reviews FROM app_private.approval_step_templates t
   WHERE t.policy_id=prior_policy ORDER BY t.step_number LOOP
   IF template_row.step_number=1 THEN step_id:=pg_catalog.gen_random_uuid(); END IF;
   INSERT INTO app_private.approval_request_steps(
     id,request_id,policy_id,template_id,step_number,required_reviews,created_by)
   VALUES (CASE WHEN template_row.step_number=1 THEN step_id ELSE pg_catalog.gen_random_uuid() END,
     req,prior_policy,template_row.id,template_row.step_number,template_row.required_reviews,ctx.actor_id);
 END LOOP;
 IF step_id IS NULL THEN RAISE EXCEPTION 'D1 Roll correction SUBMIT missing first step'; END IF;
 UPDATE app_private.approval_requests SET state='PENDING'
   WHERE id=req RETURNING row_version INTO final_version;
 UPDATE app_private.approval_request_steps SET state='OPEN',
   opened_at=pg_catalog.statement_timestamp() WHERE id=step_id;
 INSERT INTO app_private.approval_step_reviewers(
    step_id,reviewer_id,assignment_reason,created_by)
 SELECT step_id,c.candidate_principal_id,'D1_REVIEWER_ROLE_SCOPE',ctx.actor_id
 FROM app_private.d1_roll_correct_reviewer_candidates(req,step_id) c;
 GET DIAGNOSTICS n=ROW_COUNT;
 IF n=0 THEN RAISE EXCEPTION 'D1 Roll correction SUBMIT independent reviewer missing'; END IF;
 receipt:=app_private.d1_roll_correct_submit_evidence(
    ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,p_student_id,
    p_source_enrollment_id,p_expected_source_section_id,
    p_expected_student_version,req,final_version);
 IF receipt IS NULL THEN RAISE EXCEPTION 'D1 Roll correction SUBMIT evidence missing'; END IF;
 RETURN QUERY SELECT req,final_version;
END $body$;
REVOKE ALL ON FUNCTION app.d1_submit_student_roll_correction(uuid,bigint,uuid,uuid,date,uuid,date,uuid,bigint,bigint,text,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_submit_student_roll_correction(uuid,bigint,uuid,uuid,date,uuid,date,uuid,bigint,bigint,text,text)
 TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;
