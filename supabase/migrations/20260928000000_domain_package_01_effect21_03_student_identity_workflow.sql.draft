-- D1C1B effect 21/36: Student Restricted Identity P2 public workflow.
-- Static non-executable continuation only.

GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;

CREATE FUNCTION app.d1_submit_student_identity_correction(
  p_student_id uuid,p_national_id text,p_birth_certificate_number text,
  p_birth_certificate_file_id uuid,p_private_address text,p_city text,
  p_guardian_identity_text text,p_guardian_contact text,p_reason text,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; locked record; policy_row record; pre record; template_row record; req record;
  requested jsonb; old_snapshot jsonb; new_request uuid:=pg_catalog.gen_random_uuid(); first_step uuid;
  candidate_count bigint; final_version bigint; receipt uuid;
  n_id text:=NULLIF(pg_catalog.btrim(p_national_id),''); b_no text:=NULLIF(pg_catalog.btrim(p_birth_certificate_number),'');
  addr text:=NULLIF(pg_catalog.btrim(p_private_address),''); city_v text:=NULLIF(pg_catalog.btrim(p_city),'');
  g_id text:=NULLIF(pg_catalog.btrim(p_guardian_identity_text),''); g_contact text:=NULLIF(pg_catalog.btrim(p_guardian_contact),'');
BEGIN
  requested:=pg_catalog.jsonb_build_object('national_id',n_id,'birth_certificate_number',b_no,
    'birth_certificate_file_id',p_birth_certificate_file_id,'private_address',addr,'city',city_v,
    'guardian_identity_text',g_id,'guardian_contact',g_contact);
  IF p_student_id IS NULL OR p_reason IS NULL OR pg_catalog.length(pg_catalog.btrim(p_reason))=0
     OR app_private.d1_student_identity_payload_valid(requested) IS DISTINCT FROM true THEN
    RAISE EXCEPTION 'D1 Student identity request intent invalid'; END IF;

  SELECT * INTO ctx FROM app_private.d1_command_receipt_lookup(
    'student.identity.correct','request.submit',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_student_id,n_id,b_no,p_birth_certificate_file_id,addr,city_v,g_id,g_contact,p_reason));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT * INTO locked FROM app_private.d1_student_identity_lock_context(p_student_id,NULL);
  IF NOT app_private.d1_student_identity_authorized(ctx.actor_id,'student.identity.correct',p_student_id,NULL) THEN
    RAISE EXCEPTION 'D1 Student identity request authority denied'; END IF;

  IF ctx.receipt_id IS NOT NULL THEN
    SELECT r.requester_id,r.target_ref,r.expected_target_version INTO req
      FROM app_private.approval_requests r WHERE r.id=ctx.result_ref AND r.operation_id=ctx.operation_id;
    IF NOT FOUND OR req.requester_id IS DISTINCT FROM ctx.actor_id OR req.target_ref IS DISTINCT FROM p_student_id
       OR ctx.receipt_state<>'SUCCEEDED' OR ctx.result_ref IS NULL
       OR ctx.result_summary IS NULL OR pg_catalog.jsonb_typeof(ctx.result_summary)<>'object'
       OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(ctx.result_summary))<>2
       OR NOT (ctx.result_summary ?& ARRAY['request_version','state']) OR ctx.result_summary->>'state'<>'PENDING' THEN
      RAISE EXCEPTION 'D1 Student identity submit receipt is not replayable'; END IF;
    RETURN QUERY SELECT ctx.result_ref,(ctx.result_summary->>'request_version')::bigint; RETURN;
  END IF;

  IF locked.student_version IS NULL OR locked.error_code IS NOT NULL THEN
    RAISE EXCEPTION 'D1 Student identity source unavailable: %',COALESCE(locked.error_code,'UNKNOWN'); END IF;
  SELECT * INTO policy_row FROM app_private.d1_student_identity_p2_policy(p_student_id);
  IF policy_row.policy_id IS NULL THEN RAISE EXCEPTION 'D1 Student identity approval policy unavailable'; END IF;
  IF NOT EXISTS (
    SELECT 1 FROM app_private.operation_contracts o JOIN app_private.permissions rp ON rp.id=o.review_permission_id
     WHERE o.id=ctx.operation_id AND o.code='student.identity.correct' AND o.contract_version=1 AND o.enabled
       AND rp.code='student.identity.approve' AND rp.state='ENABLED' AND NOT rp.family_safe) THEN
    RAISE EXCEPTION 'D1 Student identity review permission unavailable'; END IF;

  SELECT * INTO pre FROM app_private.d1_student_identity_preflight(p_student_id,locked.student_version,
    locked.source_snapshot_id,locked.national_id,locked.birth_certificate_number,locked.birth_certificate_file_id,
    locked.private_address,locked.city,locked.guardian_identity_text,locked.guardian_contact,
    locked.source_effective_from,locked.source_supersedes_id,n_id,b_no,p_birth_certificate_file_id,addr,city_v,g_id,g_contact);
  IF NOT FOUND OR pre.eligible IS DISTINCT FROM true THEN
    RAISE EXCEPTION 'D1 Student identity request denied: %',COALESCE(pre.error_code,'PREFLIGHT_UNAVAILABLE'); END IF;

  old_snapshot:=pg_catalog.jsonb_build_object('source_snapshot_id',locked.source_snapshot_id,
    'national_id',locked.national_id,'birth_certificate_number',locked.birth_certificate_number,
    'birth_certificate_file_id',locked.birth_certificate_file_id,'private_address',locked.private_address,
    'city',locked.city,'guardian_identity_text',locked.guardian_identity_text,'guardian_contact',locked.guardian_contact,
    'source_effective_from',locked.source_effective_from,'source_supersedes_id',locked.source_supersedes_id,'source_present',true);
  INSERT INTO app_private.approval_requests
    (id,operation_id,payload_schema_version,policy_id,requester_id,campus_id,target_ref,
     expected_target_version,reason,old_snapshot,requested_payload,created_by)
  VALUES (new_request,ctx.operation_id,1,policy_row.policy_id,ctx.actor_id,policy_row.campus_id,p_student_id,
    locked.student_version,p_reason,old_snapshot,requested,ctx.actor_id);
  UPDATE app_private.approval_requests SET state='SUBMITTED',submitted_at=pg_catalog.statement_timestamp() WHERE id=new_request;
  FOR template_row IN
    SELECT t.id,t.step_number,t.required_reviews FROM app_private.approval_step_templates t
     WHERE t.policy_id=policy_row.policy_id ORDER BY t.step_number
  LOOP
    IF template_row.step_number=1 THEN first_step:=pg_catalog.gen_random_uuid(); END IF;
    INSERT INTO app_private.approval_request_steps
      (id,request_id,policy_id,template_id,step_number,required_reviews,created_by)
    VALUES (CASE WHEN template_row.step_number=1 THEN first_step ELSE pg_catalog.gen_random_uuid() END,
      new_request,policy_row.policy_id,template_row.id,template_row.step_number,template_row.required_reviews,ctx.actor_id);
  END LOOP;
  IF first_step IS NULL THEN RAISE EXCEPTION 'D1 Student identity policy has no first step'; END IF;
  UPDATE app_private.approval_requests SET state='PENDING' WHERE id=new_request RETURNING row_version INTO final_version;
  UPDATE app_private.approval_request_steps SET state='OPEN',opened_at=pg_catalog.statement_timestamp() WHERE id=first_step;
  INSERT INTO app_private.approval_step_reviewers(step_id,reviewer_id,assignment_reason,created_by)
    SELECT first_step,c.candidate_principal_id,'D1_REVIEWER_ROLE_SCOPE',ctx.actor_id
      FROM app_private.d1_student_identity_candidates(new_request,first_step) c;
  GET DIAGNOSTICS candidate_count=ROW_COUNT;
  IF candidate_count=0 THEN RAISE EXCEPTION 'D1 Student identity step has no reviewer'; END IF;
  receipt:=app_private.d1_student_identity_receipt('request.submit',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
    locked.student_version,new_request,NULL,'SUCCEEDED','D1_STUDENT_IDENTITY_REQUEST',new_request,
    pg_catalog.jsonb_build_object('request_version',final_version,'state','PENDING'),NULL);
  INSERT INTO app_private.approval_transitions(request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
  VALUES (new_request,1,NULL,'DRAFT','D1_STUDENT_IDENTITY_DRAFT',receipt,ctx.actor_id),
    (new_request,2,'DRAFT','SUBMITTED','D1_STUDENT_IDENTITY_SUBMIT',receipt,ctx.actor_id),
    (new_request,3,'SUBMITTED','PENDING','D1_STUDENT_IDENTITY_OPEN',receipt,ctx.actor_id);
  PERFORM app_private.d1_student_identity_audit(ctx.actor_id,'SUBMIT',p_student_id,locked.source_snapshot_id,
    receipt,new_request,locked.student_version,'PENDING',NULL,pg_catalog.gen_random_uuid());
  RETURN QUERY SELECT new_request,final_version;
END $body$;
REVOKE ALL ON FUNCTION app.d1_submit_student_identity_correction(uuid,text,text,uuid,text,text,text,text,text,text)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_submit_student_identity_correction(uuid,text,text,uuid,text,text,text,text,text,text) TO authenticated;

CREATE FUNCTION app.d1_review_student_identity_request(
  p_request_id uuid,p_decision text,p_expected_request_version bigint,p_reason text,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint,request_state text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; req record; step_row record; next_step record; policy_row record; pre record;
  assignment_id uuid; n bigint; candidate_count bigint; final_version bigint; final_state text; receipt uuid;
  sequence_no bigint; reviewer_role uuid; source_id uuid; source_file uuid; source_from timestamptz; source_sup uuid;
  sn text; sb text; sa text; sc text; sgi text; sgc text; nn text; nb text; na text; nc text; ngi text; ngc text; nf uuid;
BEGIN
  IF p_request_id IS NULL OR p_decision NOT IN ('APPROVE','REJECT') OR p_expected_request_version IS NULL
     OR p_expected_request_version<1 OR p_reason IS NULL OR pg_catalog.length(pg_catalog.btrim(p_reason))=0 THEN
    RAISE EXCEPTION 'D1 Student identity review intent invalid'; END IF;
  SELECT * INTO ctx FROM app_private.d1_command_receipt_lookup('student.identity.correct','request.review',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_request_id,p_decision,p_expected_request_version::text,p_reason));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT r.* INTO req FROM app_private.approval_requests r WHERE r.id=p_request_id AND r.operation_id=ctx.operation_id FOR UPDATE;
  IF NOT FOUND OR app_private.d1_student_identity_request_payload_valid(req.old_snapshot,req.requested_payload) IS DISTINCT FROM true THEN
    RAISE EXCEPTION 'D1 Student identity request unavailable'; END IF;
  PERFORM s.id FROM app_private.approval_request_steps s WHERE s.request_id=p_request_id ORDER BY s.step_number FOR UPDATE;

  IF ctx.receipt_id IS NOT NULL THEN
    SELECT count(*),min(t.reviewer_role_id::text)::uuid INTO n,reviewer_role
      FROM app_private.approval_reviews v JOIN app_private.approval_request_steps s ON s.id=v.step_id
      JOIN app_private.approval_step_templates t ON t.id=s.template_id
     WHERE s.request_id=p_request_id AND v.reviewer_id=ctx.actor_id AND v.decision=p_decision
       AND v.expected_request_version=p_expected_request_version;
    IF n<>1 OR reviewer_role IS NULL OR NOT app_private.d1_student_identity_authorized(
         ctx.actor_id,'student.identity.approve',req.target_ref,reviewer_role)
       OR ctx.receipt_state<>'SUCCEEDED' OR ctx.result_ref IS DISTINCT FROM p_request_id
       OR ctx.result_summary IS NULL OR pg_catalog.jsonb_typeof(ctx.result_summary)<>'object'
       OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(ctx.result_summary))<>2
       OR NOT (ctx.result_summary ?& ARRAY['request_version','state']) THEN
      RAISE EXCEPTION 'D1 Student identity review receipt invalid'; END IF;
    RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,ctx.result_summary->>'state'; RETURN;
  END IF;

  BEGIN
    source_id:=NULLIF(req.old_snapshot->>'source_snapshot_id','')::uuid;
    source_file:=NULLIF(req.old_snapshot->>'birth_certificate_file_id','')::uuid;
    source_from:=NULLIF(req.old_snapshot->>'source_effective_from','')::timestamptz;
    source_sup:=NULLIF(req.old_snapshot->>'source_supersedes_id','')::uuid;
    nf:=NULLIF(req.requested_payload->>'birth_certificate_file_id','')::uuid;
  EXCEPTION WHEN invalid_text_representation OR datetime_field_overflow THEN
    RAISE EXCEPTION 'D1 Student identity stored request payload malformed'; END;
  sn:=NULLIF(req.old_snapshot->>'national_id',''); sb:=NULLIF(req.old_snapshot->>'birth_certificate_number','');
  sa:=NULLIF(req.old_snapshot->>'private_address',''); sc:=NULLIF(req.old_snapshot->>'city','');
  sgi:=NULLIF(req.old_snapshot->>'guardian_identity_text',''); sgc:=NULLIF(req.old_snapshot->>'guardian_contact','');
  nn:=NULLIF(req.requested_payload->>'national_id',''); nb:=NULLIF(req.requested_payload->>'birth_certificate_number','');
  na:=NULLIF(req.requested_payload->>'private_address',''); nc:=NULLIF(req.requested_payload->>'city','');
  ngi:=NULLIF(req.requested_payload->>'guardian_identity_text',''); ngc:=NULLIF(req.requested_payload->>'guardian_contact','');

  SELECT count(*) INTO n FROM app_private.approval_request_steps s WHERE s.request_id=p_request_id AND s.state='OPEN';
  SELECT s.* INTO step_row FROM app_private.approval_request_steps s
   WHERE s.request_id=p_request_id AND s.state='OPEN' ORDER BY s.step_number LIMIT 1;
  IF req.state<>'PENDING' OR req.row_version<>p_expected_request_version OR step_row.id IS NULL OR n<>1 THEN
    RAISE EXCEPTION 'D1 Student identity review state changed'; END IF;
  SELECT * INTO policy_row FROM app_private.d1_student_identity_p2_policy(req.target_ref);
  IF policy_row.policy_id IS DISTINCT FROM req.policy_id OR policy_row.campus_id IS DISTINCT FROM req.campus_id THEN
    RAISE EXCEPTION 'D1 Student identity policy no longer applies'; END IF;
  SELECT * INTO pre FROM app_private.d1_student_identity_preflight(req.target_ref,req.expected_target_version,source_id,sn,sb,
    source_file,sa,sc,sgi,sgc,source_from,source_sup,nn,nb,nf,na,nc,ngi,ngc);
  IF NOT FOUND OR pre.eligible IS DISTINCT FROM true THEN RAISE EXCEPTION 'D1 Student identity request facts changed'; END IF;
  SELECT count(*),min(a.id::text)::uuid INTO n,assignment_id FROM app_private.approval_step_reviewers a
   WHERE a.step_id=step_row.id AND a.reviewer_id=ctx.actor_id AND a.withdrawn_at IS NULL
     AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
  IF n<>1 OR NOT EXISTS (SELECT 1 FROM app_private.d1_student_identity_candidates(p_request_id,step_row.id) c
       WHERE c.candidate_principal_id=ctx.actor_id) THEN RAISE EXCEPTION 'D1 Student identity reviewer authority denied'; END IF;
  INSERT INTO app_private.approval_reviews
    (reviewer_assignment_id,step_id,reviewer_id,decision,reason,expected_request_version,created_by)
  VALUES (assignment_id,step_row.id,ctx.actor_id,p_decision,p_reason,p_expected_request_version,ctx.actor_id);
  UPDATE app_private.approval_request_steps SET state=CASE p_decision WHEN 'APPROVE' THEN 'APPROVED' ELSE 'REJECTED' END,
    closed_at=pg_catalog.statement_timestamp() WHERE id=step_row.id;
  IF p_decision='REJECT' THEN
    UPDATE app_private.approval_request_steps SET state='CANCELLED',closed_at=pg_catalog.statement_timestamp()
     WHERE request_id=p_request_id AND state='WAITING';
    final_state:='REJECTED';
  ELSE
    SELECT s.* INTO next_step FROM app_private.approval_request_steps s
     WHERE s.request_id=p_request_id AND s.step_number=step_row.step_number+1 AND s.state='WAITING' FOR UPDATE;
    IF FOUND THEN
      UPDATE app_private.approval_request_steps SET state='OPEN',opened_at=pg_catalog.statement_timestamp() WHERE id=next_step.id;
      INSERT INTO app_private.approval_step_reviewers(step_id,reviewer_id,assignment_reason,created_by)
        SELECT next_step.id,c.candidate_principal_id,'D1_REVIEWER_ROLE_SCOPE',ctx.actor_id
          FROM app_private.d1_student_identity_candidates(p_request_id,next_step.id) c;
      GET DIAGNOSTICS candidate_count=ROW_COUNT;
      IF candidate_count=0 THEN RAISE EXCEPTION 'D1 Student identity next step has no reviewer'; END IF;
      final_state:='PENDING';
    ELSE
      IF EXISTS (SELECT 1 FROM app_private.approval_request_steps s WHERE s.request_id=p_request_id AND s.state<>'APPROVED') THEN
        RAISE EXCEPTION 'D1 Student identity approval sequence incomplete'; END IF;
      final_state:='APPROVED';
    END IF;
  END IF;
  UPDATE app_private.approval_requests SET state=final_state WHERE id=p_request_id RETURNING row_version INTO final_version;
  receipt:=app_private.d1_student_identity_receipt('request.review',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
    req.expected_target_version,p_request_id,p_expected_request_version,'SUCCEEDED','D1_STUDENT_IDENTITY_REVIEW',p_request_id,
    pg_catalog.jsonb_build_object('request_version',final_version,'state',final_state),NULL);
  SELECT COALESCE(max(t.sequence_number),0) INTO sequence_no FROM app_private.approval_transitions t WHERE t.request_id=p_request_id;
  IF final_state IN ('APPROVED','REJECTED') THEN
    INSERT INTO app_private.approval_transitions(request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
    VALUES (p_request_id,sequence_no+1,'PENDING',final_state,'D1_STUDENT_IDENTITY_REVIEW_'||final_state,receipt,ctx.actor_id);
  END IF;
  PERFORM app_private.d1_student_identity_audit(ctx.actor_id,'REVIEW',req.target_ref,source_id,receipt,p_request_id,
    req.expected_target_version,final_state,NULL,pg_catalog.gen_random_uuid());
  RETURN QUERY SELECT p_request_id,final_version,final_state;
END $body$;
REVOKE ALL ON FUNCTION app.d1_review_student_identity_request(uuid,text,bigint,text,text)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_review_student_identity_request(uuid,text,bigint,text,text) TO authenticated;

CREATE FUNCTION app.d1_apply_student_identity_request(p_request_id uuid,p_expected_request_version bigint,p_idempotency_key text)
RETURNS TABLE(request_id uuid,request_version bigint,request_state text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; req record; policy_row record; pre record; effect_row record; participant text;
  source_id uuid; source_file uuid; source_from timestamptz; source_sup uuid; nf uuid;
  sn text; sb text; sa text; sc text; sgi text; sgc text; nn text; nb text; na text; nc text; ngi text; ngc text;
  invalidation_code text; final_state text; final_version bigint; receipt uuid; sequence_no bigint;
  correlation uuid:=pg_catalog.gen_random_uuid();
BEGIN
  IF p_request_id IS NULL OR p_expected_request_version IS NULL OR p_expected_request_version<1 THEN
    RAISE EXCEPTION 'D1 Student identity apply intent invalid'; END IF;
  SELECT * INTO ctx FROM app_private.d1_command_receipt_lookup('student.identity.correct','request.apply',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_request_id,p_expected_request_version::text));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT r.* INTO req FROM app_private.approval_requests r WHERE r.id=p_request_id AND r.operation_id=ctx.operation_id FOR UPDATE;
  IF NOT FOUND OR app_private.d1_student_identity_request_payload_valid(req.old_snapshot,req.requested_payload) IS DISTINCT FROM true THEN
    RAISE EXCEPTION 'D1 Student identity request unavailable'; END IF;
  PERFORM s.id FROM app_private.approval_request_steps s WHERE s.request_id=p_request_id ORDER BY s.step_number FOR UPDATE;
  participant:=app_private.d1_student_identity_participant(p_request_id,ctx.actor_id);
  IF participant IS NULL OR participant NOT IN ('REQUESTER','FINAL_APPROVER') THEN
    RAISE EXCEPTION 'D1 Student identity request unavailable'; END IF;

  IF ctx.receipt_id IS NOT NULL THEN
    IF ctx.receipt_state NOT IN ('SUCCEEDED','REJECTED') OR ctx.result_summary IS NULL
       OR pg_catalog.jsonb_typeof(ctx.result_summary)<>'object' OR NOT (ctx.result_summary ?& ARRAY['request_version','state'])
       OR (ctx.receipt_state='SUCCEEDED' AND (ctx.result_ref IS NULL
         OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(ctx.result_summary))<>5
         OR NOT (ctx.result_summary ?& ARRAY['identity_snapshot_id','student_version','effective_from'])
         OR ctx.result_summary->>'state'<>'EXECUTED'))
       OR (ctx.receipt_state='REJECTED' AND (ctx.result_ref IS NOT NULL
         OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(ctx.result_summary))<>2
         OR ctx.result_summary->>'state'<>'INVALIDATED')) THEN
      RAISE EXCEPTION 'D1 Student identity apply receipt invalid'; END IF;
    RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,ctx.result_summary->>'state'; RETURN;
  END IF;
  IF req.state<>'APPROVED' OR req.row_version<>p_expected_request_version THEN
    RAISE EXCEPTION 'D1 Student identity approved request changed'; END IF;

  BEGIN
    source_id:=NULLIF(req.old_snapshot->>'source_snapshot_id','')::uuid;
    source_file:=NULLIF(req.old_snapshot->>'birth_certificate_file_id','')::uuid;
    source_from:=NULLIF(req.old_snapshot->>'source_effective_from','')::timestamptz;
    source_sup:=NULLIF(req.old_snapshot->>'source_supersedes_id','')::uuid;
    nf:=NULLIF(req.requested_payload->>'birth_certificate_file_id','')::uuid;
  EXCEPTION WHEN invalid_text_representation OR datetime_field_overflow THEN
    RAISE EXCEPTION 'D1 Student identity stored request payload malformed'; END;
  sn:=NULLIF(req.old_snapshot->>'national_id',''); sb:=NULLIF(req.old_snapshot->>'birth_certificate_number','');
  sa:=NULLIF(req.old_snapshot->>'private_address',''); sc:=NULLIF(req.old_snapshot->>'city','');
  sgi:=NULLIF(req.old_snapshot->>'guardian_identity_text',''); sgc:=NULLIF(req.old_snapshot->>'guardian_contact','');
  nn:=NULLIF(req.requested_payload->>'national_id',''); nb:=NULLIF(req.requested_payload->>'birth_certificate_number','');
  na:=NULLIF(req.requested_payload->>'private_address',''); nc:=NULLIF(req.requested_payload->>'city','');
  ngi:=NULLIF(req.requested_payload->>'guardian_identity_text',''); ngc:=NULLIF(req.requested_payload->>'guardian_contact','');

  SELECT * INTO policy_row FROM app_private.d1_student_identity_p2_policy(req.target_ref);
  IF policy_row.policy_id IS DISTINCT FROM req.policy_id OR policy_row.campus_id IS DISTINCT FROM req.campus_id THEN
    invalidation_code:='D1_STUDENT_IDENTITY_POLICY_STALE';
  ELSIF NOT app_private.d1_student_identity_authorized(req.requester_id,'student.identity.correct',req.target_ref,NULL) THEN
    invalidation_code:='D1_STUDENT_IDENTITY_REQUESTER_AUTHORITY_STALE';
  ELSIF NOT app_private.d1_student_identity_reviews_live(p_request_id) THEN
    invalidation_code:='D1_STUDENT_IDENTITY_REVIEWER_AUTHORITY_STALE';
  ELSE
    SELECT * INTO pre FROM app_private.d1_student_identity_preflight(req.target_ref,req.expected_target_version,source_id,sn,sb,
      source_file,sa,sc,sgi,sgc,source_from,source_sup,nn,nb,nf,na,nc,ngi,ngc);
    IF NOT FOUND OR pre.eligible IS NULL THEN RAISE EXCEPTION 'D1 Student identity preflight result unavailable';
    ELSIF pre.eligible IS FALSE THEN
      IF pre.error_code IS NULL OR pg_catalog.length(pg_catalog.btrim(pre.error_code))=0 THEN
        RAISE EXCEPTION 'D1 Student identity preflight denial lacks error code'; END IF;
      invalidation_code:=pre.error_code;
    END IF;
  END IF;

  IF invalidation_code IS NOT NULL THEN
    final_state:='INVALIDATED';
    UPDATE app_private.approval_requests SET state=final_state WHERE id=p_request_id RETURNING row_version INTO final_version;
    receipt:=app_private.d1_student_identity_receipt('request.apply',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
      req.expected_target_version,p_request_id,p_expected_request_version,'REJECTED',NULL,NULL,
      pg_catalog.jsonb_build_object('request_version',final_version,'state',final_state),invalidation_code);
    PERFORM app_private.d1_student_identity_audit(ctx.actor_id,'APPLY',req.target_ref,source_id,receipt,p_request_id,
      req.expected_target_version,final_state,NULL,correlation);
  ELSE
    SELECT * INTO effect_row FROM app_private.d1_student_identity_effect(req.target_ref,req.expected_target_version,source_id,sn,sb,
      source_file,sa,sc,sgi,sgc,source_from,source_sup,nn,nb,nf,na,nc,ngi,ngc,req.reason);
    final_state:='EXECUTED';
    UPDATE app_private.approval_requests SET state=final_state WHERE id=p_request_id RETURNING row_version INTO final_version;
    receipt:=app_private.d1_student_identity_receipt('request.apply',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
      req.expected_target_version,p_request_id,p_expected_request_version,'SUCCEEDED','D1_STUDENT_IDENTITY_APPLY',
      effect_row.identity_snapshot_id,pg_catalog.jsonb_build_object('request_version',final_version,'state',final_state,
        'identity_snapshot_id',effect_row.identity_snapshot_id,'student_version',effect_row.student_version,
        'effective_from',effect_row.effective_from),NULL);
    INSERT INTO app_private.approval_applications
      (request_id,command_receipt_id,operation_id,applied_target_version,result_ref,created_by)
    VALUES (p_request_id,receipt,ctx.operation_id,effect_row.student_version,effect_row.identity_snapshot_id,ctx.actor_id);
    PERFORM app_private.d1_student_identity_audit(ctx.actor_id,'APPLY',req.target_ref,effect_row.identity_snapshot_id,
      receipt,p_request_id,effect_row.student_version,final_state,effect_row.effective_from,correlation);
    PERFORM app_private.d1_student_identity_event(ctx.actor_id,req.target_ref,effect_row.identity_snapshot_id,source_id,
      receipt,effect_row.student_version,effect_row.effective_from,correlation);
  END IF;
  SELECT COALESCE(max(t.sequence_number),0) INTO sequence_no FROM app_private.approval_transitions t WHERE t.request_id=p_request_id;
  INSERT INTO app_private.approval_transitions(request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
  VALUES (p_request_id,sequence_no+1,'APPROVED',final_state,
    CASE WHEN final_state='EXECUTED' THEN 'D1_STUDENT_IDENTITY_APPLIED' ELSE invalidation_code END,receipt,ctx.actor_id);
  RETURN QUERY SELECT p_request_id,final_version,final_state;
END $body$;
REVOKE ALL ON FUNCTION app.d1_apply_student_identity_request(uuid,bigint,text)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_apply_student_identity_request(uuid,bigint,text) TO authenticated;

RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;

GRANT CREATE ON SCHEMA app TO schoolos_read_executor;
SET ROLE schoolos_read_executor;
CREATE FUNCTION app.d1_read_student_identity_request(p_request_id uuid)
RETURNS TABLE(request_id uuid,request_version bigint,request_state text,student_id uuid,
  source_national_id text,source_birth_certificate_number text,source_birth_certificate_file_id uuid,
  source_private_address text,source_city text,source_guardian_identity_text text,source_guardian_contact text,
  requested_national_id text,requested_birth_certificate_number text,requested_birth_certificate_file_id uuid,
  requested_private_address text,requested_city text,requested_guardian_identity_text text,requested_guardian_contact text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE actor uuid; participant text; req record;
BEGIN
  PERFORM pg_catalog.pg_advisory_xact_lock_shared(71001,1);
  actor:=app_private.current_principal_id();
  IF actor IS NULL THEN RAISE EXCEPTION 'D1 Student identity request unavailable'; END IF;
  participant:=app_private.d1_student_identity_participant(p_request_id,actor);
  IF participant IS NULL THEN RAISE EXCEPTION 'D1 Student identity request unavailable'; END IF;
  SELECT r.* INTO req FROM app_private.approval_requests r
    JOIN app_private.operation_contracts o ON o.id=r.operation_id
   WHERE r.id=p_request_id AND o.code='student.identity.correct';
  IF NOT FOUND OR app_private.d1_student_identity_request_payload_valid(req.old_snapshot,req.requested_payload) IS DISTINCT FROM true THEN
    RAISE EXCEPTION 'D1 Student identity request unavailable'; END IF;
  RETURN QUERY SELECT req.id,req.row_version,req.state,req.target_ref,
    NULLIF(req.old_snapshot->>'national_id',''),NULLIF(req.old_snapshot->>'birth_certificate_number',''),
    NULLIF(req.old_snapshot->>'birth_certificate_file_id','')::uuid,NULLIF(req.old_snapshot->>'private_address',''),
    NULLIF(req.old_snapshot->>'city',''),NULLIF(req.old_snapshot->>'guardian_identity_text',''),
    NULLIF(req.old_snapshot->>'guardian_contact',''),NULLIF(req.requested_payload->>'national_id',''),
    NULLIF(req.requested_payload->>'birth_certificate_number',''),NULLIF(req.requested_payload->>'birth_certificate_file_id','')::uuid,
    NULLIF(req.requested_payload->>'private_address',''),NULLIF(req.requested_payload->>'city',''),
    NULLIF(req.requested_payload->>'guardian_identity_text',''),NULLIF(req.requested_payload->>'guardian_contact','');
END $body$;
REVOKE ALL ON FUNCTION app.d1_read_student_identity_request(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_student_identity_request(uuid) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_read_executor;
