-- Effect 25 capacity and roll allocation helpers.

SET ROLE schoolos_schema_owner;
REVOKE UPDATE ON app_private.roll_allocator_states FROM schoolos_student_executor;
GRANT SELECT (id,policy_revision_id,class_offering_id,next_value,row_version,updated_at) ON app_private.roll_allocator_states TO schoolos_student_executor;
GRANT UPDATE (next_value,row_version,updated_at) ON app_private.roll_allocator_states TO schoolos_student_executor;
RESET ROLE;

GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE FUNCTION app_private.d1_enrollment_place_capacity(
  p_class_offering uuid,p_section uuid,p_effective_from date
) RETURNS TABLE(class_limit integer,section_limit integer,class_count integer,section_count integer,class_full boolean,section_full boolean)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE cl integer; sl integer; cc integer; sc integer;
BEGIN
  IF p_class_offering IS NULL OR p_section IS NULL OR p_effective_from IS NULL THEN RETURN; END IF;
  SELECT co.capacity,so.capacity INTO cl,sl FROM app_private.class_offerings co JOIN app_private.section_offerings so ON so.class_offering_id=co.id
    WHERE co.id=p_class_offering AND so.id=p_section FOR UPDATE OF co,so;
  IF NOT FOUND THEN RETURN; END IF;
  WITH breakpoints AS (
    SELECT p_effective_from AS d
    UNION SELECT e.effective_from FROM app_private.enrollments e JOIN app_private.section_offerings s ON s.id=e.section_offering_id
      WHERE s.class_offering_id=p_class_offering AND e.placement_kind='PRIMARY' AND e.effective_from>=p_effective_from
    UNION SELECT e.effective_until FROM app_private.enrollments e JOIN app_private.section_offerings s ON s.id=e.section_offering_id
      WHERE s.class_offering_id=p_class_offering AND e.placement_kind='PRIMARY' AND e.effective_until IS NOT NULL AND e.effective_until>=p_effective_from
  ), counts AS (
    SELECT b.d,
      1+(SELECT count(*) FROM app_private.enrollments e JOIN app_private.section_offerings s ON s.id=e.section_offering_id
          WHERE s.class_offering_id=p_class_offering AND e.placement_kind='PRIMARY'
            AND e.effective_from<=b.d AND (e.effective_until IS NULL OR b.d<e.effective_until)) AS class_n,
      1+(SELECT count(*) FROM app_private.enrollments e WHERE e.section_offering_id=p_section AND e.placement_kind='PRIMARY'
            AND e.effective_from<=b.d AND (e.effective_until IS NULL OR b.d<e.effective_until)) AS section_n
    FROM breakpoints b WHERE b.d IS NOT NULL
  ) SELECT pg_catalog.coalesce(max(class_n),1)::integer,pg_catalog.coalesce(max(section_n),1)::integer INTO cc,sc FROM counts;
  RETURN QUERY SELECT cl,sl,cc,sc,(cc>cl),(sc>sl);
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_enrollment_place_capacity(uuid,uuid,date) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_enrollment_place_capacity(uuid,uuid,date) TO schoolos_student_executor;

CREATE FUNCTION app_private.d1_enrollment_place_allocate_roll(
  p_actor uuid,p_student uuid,p_enrollment uuid,p_school uuid,p_class_offering uuid,p_effective_from date
) RETURNS TABLE(allocation_id uuid,policy_revision_id uuid,numeric_value bigint,origin_allocation_id uuid,policy_mode text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE pol app_private.roll_policy_revisions%ROWTYPE; pol_count bigint; alloc app_private.roll_allocator_states%ROWTYPE;
  prior record; candidate bigint; aid uuid:=pg_catalog.gen_random_uuid(); origin uuid; mode text;
BEGIN
  IF p_actor IS DISTINCT FROM app_private.current_principal_id() OR p_student IS NULL OR p_enrollment IS NULL OR p_school IS NULL
     OR p_class_offering IS NULL OR p_effective_from IS NULL THEN RAISE EXCEPTION 'D1 Enrollment roll intent invalid'; END IF;
  SELECT count(*) INTO pol_count FROM app_private.roll_policy_revisions r WHERE r.school_id=p_school
    AND r.effective_from<=p_effective_from AND (r.effective_until IS NULL OR p_effective_from<r.effective_until);
  IF pol_count<>1 THEN RAISE EXCEPTION 'D1 Enrollment roll policy unavailable'; END IF;
  SELECT * INTO pol FROM app_private.roll_policy_revisions r WHERE r.school_id=p_school
    AND r.effective_from<=p_effective_from AND (r.effective_until IS NULL OR p_effective_from<r.effective_until) FOR UPDATE;
  mode:=pol.mode;
  IF mode NOT IN ('ACADEMIC_CONTEXT','PERSISTENT_STUDENT') THEN RAISE EXCEPTION 'D1 Enrollment roll policy malformed'; END IF;
  IF mode='PERSISTENT_STUDENT' THEN
    SELECT r.id,r.numeric_value,pg_catalog.coalesce(r.origin_allocation_id,r.id) origin_id INTO prior
      FROM app_private.roll_allocations r JOIN app_private.roll_policy_revisions pr ON pr.id=r.policy_revision_id
      WHERE r.student_id=p_student AND pr.school_id=p_school AND pr.mode='PERSISTENT_STUDENT'
      ORDER BY r.effective_from,r.created_at,r.id LIMIT 1;
    IF prior.id IS NOT NULL THEN candidate:=prior.numeric_value; origin:=prior.origin_id;
    ELSE
      SELECT * INTO alloc FROM app_private.roll_allocator_states a WHERE a.policy_revision_id=pol.id AND a.class_offering_id IS NULL FOR UPDATE;
      IF NOT FOUND THEN RAISE EXCEPTION 'D1 Enrollment persistent roll allocator unavailable'; END IF;
      candidate:=pg_catalog.greatest(alloc.next_value,pol.start_value);
      WHILE EXISTS (
        SELECT 1 FROM app_private.roll_allocations r JOIN app_private.roll_policy_revisions pr ON pr.id=r.policy_revision_id
        WHERE pr.school_id=p_school AND pr.mode='PERSISTENT_STUDENT' AND r.numeric_value=candidate
      ) LOOP candidate:=candidate+1; END LOOP;
      UPDATE app_private.roll_allocator_states SET next_value=candidate+1,row_version=row_version+1,updated_at=pg_catalog.statement_timestamp() WHERE id=alloc.id;
    END IF;
  ELSE
    SELECT * INTO alloc FROM app_private.roll_allocator_states a WHERE a.policy_revision_id=pol.id AND a.class_offering_id=p_class_offering FOR UPDATE;
    IF NOT FOUND THEN RAISE EXCEPTION 'D1 Enrollment academic roll allocator unavailable'; END IF;
    candidate:=pg_catalog.greatest(alloc.next_value,pol.start_value);
    WHILE EXISTS (
      SELECT 1 FROM app_private.roll_allocations r JOIN app_private.enrollments e ON e.id=r.enrollment_id
      JOIN app_private.section_offerings s ON s.id=e.section_offering_id
      WHERE r.policy_revision_id=pol.id AND s.class_offering_id=p_class_offering AND r.numeric_value=candidate
        AND p_effective_from<pg_catalog.coalesce(r.effective_until,'infinity'::date)
    ) LOOP candidate:=candidate+1; END LOOP;
    UPDATE app_private.roll_allocator_states SET next_value=candidate+1,row_version=row_version+1,updated_at=pg_catalog.statement_timestamp() WHERE id=alloc.id;
  END IF;
  INSERT INTO app_private.roll_allocations(id,created_by,enrollment_id,student_id,policy_revision_id,numeric_value,effective_from,effective_until,
    origin_allocation_id,supersedes_id,correction_reason)
  VALUES (aid,p_actor,p_enrollment,p_student,pol.id,candidate,p_effective_from,NULL,origin,NULL,NULL);
  IF mode='PERSISTENT_STUDENT' AND origin IS NULL THEN
    origin:=aid;
    -- Origin is represented by NULL on its own immutable row; consumers coalesce(origin_allocation_id,id).
  END IF;
  RETURN QUERY SELECT aid,pol.id,candidate,origin,mode;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_enrollment_place_allocate_roll(uuid,uuid,uuid,uuid,uuid,date) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_enrollment_place_allocate_roll(uuid,uuid,uuid,uuid,uuid,date) TO schoolos_student_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;
