-- DB-02 I09: independent reviewer decision on an I08 PENDING request.
-- REVIEW cannot create/revise Roll Policy or allocator and cannot emit a
-- student.roll_policy_changed event. Approval != application (I10).
-- Shared REVIEW receipt allowlist remains reserved for I11; all existing
-- receipts are failed closed on replay until I11's separate shared integration.
GRANT SELECT(campus_id,expected_target_version,reason,submitted_at,
 created_by)
 ON app_private.approval_requests TO schoolos_workflow_executor;
GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE FUNCTION app.d1_review_student_roll_policy_change(
 p_request_id uuid,p_decision text,p_expected_request_version bigint,
 p_reason text,p_idempotency_key text)
RETURNS TABLE(request_id uuid,request_version bigint,request_state text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $body$
DECLARE
 v_ctx record;
 v_req record;
 v_step record;
 v_next record;
 v_assign uuid;
 v_n bigint;
 v_candidates bigint;
 v_final_version bigint;
 v_final_state text;
 v_receipt uuid;
 v_seq bigint;
BEGIN
 IF p_request_id IS NULL OR p_decision NOT IN ('APPROVE','REJECT')
   OR p_expected_request_version IS NULL OR p_expected_request_version<3
   OR p_reason IS NULL OR pg_catalog.btrim(p_reason)='' THEN
   RAISE EXCEPTION 'D1 Roll Policy REVIEW intent invalid';
 END IF;
 -- Context verifies authenticated individual, frozen operation, JCS intent,
 -- and the exact principal/operation/idempotency advisory lock namespace.
 SELECT * INTO v_ctx FROM app_private.d1_roll_policy_review_receipt_context(
   p_request_id,p_decision,p_expected_request_version,p_reason,p_idempotency_key);
 IF NOT FOUND OR v_ctx.actor_id IS NULL OR v_ctx.operation_id IS NULL
   OR v_ctx.intent_hash IS NULL OR pg_catalog.octet_length(v_ctx.intent_hash)<>32
 THEN RAISE EXCEPTION 'D1 Roll Policy REVIEW receipt context invalid'; END IF;
 PERFORM app_private.d1_lock_current_principal(v_ctx.actor_id);
 SELECT q.id,q.operation_id,q.policy_id,q.requester_id,q.target_ref,
   q.campus_id,q.payload_schema_version,q.row_version,q.state,
   q.old_snapshot,q.requested_payload,q.submitted_at,q.created_by
 INTO v_req FROM app_private.approval_requests q
 WHERE q.id=p_request_id AND q.operation_id=v_ctx.operation_id FOR UPDATE;
 IF NOT FOUND OR v_req.requester_id IS NULL
   OR v_req.requester_id=v_ctx.actor_id OR v_req.target_ref IS NULL
   OR v_req.policy_id IS NULL OR v_req.campus_id IS NOT NULL
   OR v_req.payload_schema_version IS DISTINCT FROM 1
   OR v_req.submitted_at IS NULL
   OR v_req.created_by IS DISTINCT FROM v_req.requester_id
   OR pg_catalog.jsonb_typeof(v_req.old_snapshot) IS DISTINCT FROM 'object'
   OR (SELECT pg_catalog.count(*) FROM
     pg_catalog.jsonb_object_keys(v_req.old_snapshot))<>5
   OR pg_catalog.jsonb_typeof(v_req.requested_payload) IS DISTINCT FROM 'object'
   OR (SELECT pg_catalog.count(*) FROM
     pg_catalog.jsonb_object_keys(v_req.requested_payload))<>5
   OR v_req.requested_payload->>'selected_p1_version_id' IS DISTINCT FROM
     v_req.policy_id::text
   OR v_req.requested_payload->>'action' NOT IN ('INIT','REPLACE')
   OR v_req.requested_payload->>'mode' NOT IN ('PERSISTENT_STUDENT','ACADEMIC_CONTEXT')
   OR v_req.requested_payload->>'trusted_business_date' IS NULL
 THEN RAISE EXCEPTION 'D1 Roll Policy REVIEW frozen request invalid'; END IF;

 -- Publicly selected route cannot silently drift from the request's exact
 -- frozen Foundation global P1 approval version.
 IF app_private.d1_roll_policy_p1_binding_current(
   v_req.target_ref,v_req.policy_id,'APPROVAL') IS DISTINCT FROM true THEN
   RAISE EXCEPTION 'D1 Roll Policy REVIEW frozen P1 no longer active';
 END IF;
 IF v_ctx.receipt_id IS NOT NULL THEN
   -- I11 must authorize the shared REVIEW/APPLY phase and provide approved
   -- terminal replay verifier; do not pretend a closed step is still OPEN.
   RAISE EXCEPTION 'D1 Roll Policy REVIEW replay reserved for I11';
 END IF;
 IF v_req.state IS DISTINCT FROM 'PENDING'
   OR v_req.row_version IS DISTINCT FROM p_expected_request_version THEN
   RAISE EXCEPTION 'D1 Roll Policy REVIEW request version/state changed';
 END IF;
 SELECT s.id,s.step_number,s.policy_id,s.template_id,s.required_reviews
 INTO v_step FROM app_private.approval_request_steps s
 WHERE s.request_id=p_request_id AND s.state='OPEN'
 ORDER BY s.step_number LIMIT 1 FOR UPDATE;
 IF NOT FOUND OR v_step.policy_id IS DISTINCT FROM v_req.policy_id
   OR v_step.required_reviews IS DISTINCT FROM 1 THEN
   RAISE EXCEPTION 'D1 Roll Policy REVIEW open step unavailable';
 END IF;
 SELECT pg_catalog.count(*),pg_catalog.min(a.id::text)::uuid INTO v_n,v_assign
 FROM app_private.approval_step_reviewers a
 WHERE a.step_id=v_step.id AND a.reviewer_id=v_ctx.actor_id
   AND a.withdrawn_at IS NULL AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
 IF v_n<>1 OR v_assign IS NULL
   OR app_private.d1_current_reviewer_eligible(p_request_id,v_step.id)
       IS DISTINCT FROM true
   OR NOT EXISTS (SELECT 1 FROM app_private.d1_review_candidates(
      p_request_id,v_step.id) c
      WHERE c.candidate_principal_id=v_ctx.actor_id)
 THEN RAISE EXCEPTION 'D1 Roll Policy REVIEW independent reviewer denied'; END IF;

 INSERT INTO app_private.approval_reviews(
   reviewer_assignment_id,step_id,reviewer_id,decision,reason,
   expected_request_version,created_by)
 VALUES(v_assign,v_step.id,v_ctx.actor_id,p_decision,p_reason,
   p_expected_request_version,v_ctx.actor_id);
 UPDATE app_private.approval_request_steps SET
   state=CASE WHEN p_decision='APPROVE' THEN 'APPROVED' ELSE 'REJECTED' END,
   closed_at=pg_catalog.statement_timestamp() WHERE id=v_step.id;
 IF p_decision='REJECT' THEN
   UPDATE app_private.approval_request_steps SET state='CANCELLED',
     closed_at=pg_catalog.statement_timestamp()
   WHERE request_id=p_request_id AND state='WAITING';
   v_final_state:='REJECTED';
   UPDATE app_private.approval_requests SET state=v_final_state
     WHERE id=p_request_id RETURNING row_version INTO v_final_version;
 ELSE
   SELECT s.id,s.step_number INTO v_next
     FROM app_private.approval_request_steps s
    WHERE s.request_id=p_request_id
      AND s.step_number=v_step.step_number+1 AND s.state='WAITING'
    FOR UPDATE;
   IF FOUND THEN
     UPDATE app_private.approval_request_steps SET state='OPEN',
       opened_at=pg_catalog.statement_timestamp() WHERE id=v_next.id;
     INSERT INTO app_private.approval_step_reviewers(
       step_id,reviewer_id,assignment_reason,created_by)
     SELECT v_next.id,c.candidate_principal_id,'D1_REVIEWER_ROLE_SCOPE',
       v_ctx.actor_id
     FROM app_private.d1_review_candidates(p_request_id,v_next.id) c;
     GET DIAGNOSTICS v_candidates=ROW_COUNT;
     IF v_candidates<1 THEN
       RAISE EXCEPTION 'D1 Roll Policy REVIEW next independent reviewer unavailable';
     END IF;
     v_final_state:='PENDING';
     UPDATE app_private.approval_requests SET
       row_version=row_version+1,updated_at=pg_catalog.statement_timestamp()
     WHERE id=p_request_id RETURNING row_version INTO v_final_version;
   ELSE
     v_final_state:='APPROVED';
     UPDATE app_private.approval_requests SET state=v_final_state
       WHERE id=p_request_id RETURNING row_version INTO v_final_version;
   END IF;
 END IF;
 IF v_final_version IS NULL OR v_final_version<=p_expected_request_version THEN
   RAISE EXCEPTION 'D1 Roll Policy REVIEW version progression missing';
 END IF;
 -- Evidence helper validates exact decision/actor/request before receipt and
 -- the minimized audit; review reason never goes into summary or audit.
 v_receipt:=app_private.d1_roll_policy_review_success_evidence(
   v_ctx.actor_id,v_ctx.operation_id,p_idempotency_key,v_ctx.intent_hash,
   p_request_id,v_req.policy_id,v_req.target_ref,p_expected_request_version,
   p_decision,v_final_version,v_final_state,v_step.id,v_assign);
 IF v_final_state IN ('APPROVED','REJECTED') THEN
   SELECT pg_catalog.coalesce(pg_catalog.max(t.sequence_number),0)+1
   INTO v_seq FROM app_private.approval_transitions t
   WHERE t.request_id=p_request_id;
   INSERT INTO app_private.approval_transitions(
     request_id,sequence_number,from_state,to_state,reason,
     command_receipt_id,created_by)
   VALUES(p_request_id,v_seq,'PENDING',v_final_state,
    'D1_ROLL_POLICY_REVIEW_'||v_final_state,v_receipt,v_ctx.actor_id);
 END IF;
 RETURN QUERY SELECT p_request_id,v_final_version,v_final_state;
END $body$;
REVOKE ALL ON FUNCTION app.d1_review_student_roll_policy_change(
 uuid,text,bigint,text,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_review_student_roll_policy_change(
 uuid,text,bigint,text,text) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;
