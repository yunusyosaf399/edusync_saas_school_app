-- Effect 24 command receipt helper.
GRANT CREATE ON SCHEMA app_private TO schoolos_evidence_writer;
SET ROLE schoolos_evidence_writer;
CREATE FUNCTION app_private.d1_student_status_correct_receipt(
  p_phase text,p_actor uuid,p_operation uuid,p_key text,p_hash bytea,p_expected bigint,p_request uuid,p_request_version bigint,
  p_state text,p_result_kind text,p_result_ref uuid,p_summary jsonb,p_error text
) RETURNS uuid LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE rid uuid:=pg_catalog.gen_random_uuid();
BEGIN
  IF p_phase NOT IN ('request.submit','request.review','request.apply') OR p_actor IS NULL OR p_operation IS NULL OR p_key IS NULL OR p_hash IS NULL
     OR p_state NOT IN ('SUCCEEDED','REJECTED') OR p_summary IS NULL OR pg_catalog.jsonb_typeof(p_summary)<>'object'
     OR (p_state='REJECTED' AND (p_phase<>'request.apply' OR p_error IS NULL OR p_result_ref IS NOT NULL))
  THEN RAISE EXCEPTION 'D1 Student status correction receipt intent denied'; END IF;
  INSERT INTO app_private.command_receipts(id,principal_id,operation_id,command_kind,idempotency_key,canonical_payload_hash,canonicalization_version,
    expected_target_version,request_id,expected_request_version,state,result_kind,result_ref,result_summary,error_code,completed_at,created_by)
  VALUES (rid,p_actor,p_operation,p_phase,p_key,p_hash,1,p_expected,p_request,p_request_version,p_state,p_result_kind,p_result_ref,p_summary,p_error,
    pg_catalog.statement_timestamp(),p_actor); RETURN rid;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_student_status_correct_receipt(text,uuid,uuid,text,bytea,bigint,uuid,bigint,text,text,uuid,jsonb,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_student_status_correct_receipt(text,uuid,uuid,text,bytea,bigint,uuid,bigint,text,text,uuid,jsonb,text)
 TO schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_evidence_writer;