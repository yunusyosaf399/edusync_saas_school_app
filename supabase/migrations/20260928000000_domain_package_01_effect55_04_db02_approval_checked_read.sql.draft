-- DB-02 I08: checked, minimal request-participant projection.
-- No raw approval tables or private reason are granted to clients.
-- A requester must STILL hold current School ALL authority; an assigned
-- OPEN reviewer must independently satisfy the current Foundation reviewer
-- eligibility helper. Other Persons receive zero rows, not a raw error.
GRANT SELECT(id,operation_id,requester_id,target_ref,row_version,state,
 old_snapshot,requested_payload,payload_schema_version,policy_id)
 ON app_private.approval_requests TO schoolos_workflow_executor;
GRANT SELECT(id,code) ON app_private.operation_contracts TO schoolos_workflow_executor;
SET ROLE schoolos_schema_owner;
CREATE POLICY db02_i08_workflow_request_read ON app_private.approval_requests
 FOR SELECT TO schoolos_workflow_executor USING (EXISTS (
  SELECT 1 FROM app_private.operation_contracts o
   WHERE o.id=operation_id AND o.code='student.roll_policy.change'));
CREATE POLICY db02_i08_workflow_operation_read ON app_private.operation_contracts
 FOR SELECT TO schoolos_workflow_executor USING (code='student.roll_policy.change');
RESET ROLE;

GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE FUNCTION app.d1_read_student_roll_policy_request(p_request_id uuid)
RETURNS TABLE(
 request_id uuid,request_version bigint,request_state text,school_id uuid,
 action text,source_policy_id uuid,source_revision integer,
 new_mode text,new_start_value bigint,trusted_business_date date,
 participant_kind text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path=pg_catalog,pg_temp AS $body$
DECLARE
  actor uuid;
  q record;
  access_kind text;
  v_source uuid;
  v_revision integer;
  v_start bigint;
  v_date date;
  reviewer_count integer:=0;
  step record;
BEGIN
 IF p_request_id IS NULL THEN RETURN; END IF;
 PERFORM pg_catalog.pg_advisory_xact_lock_shared(71001,1);
 actor:=app_private.current_principal_id();
 IF actor IS NULL THEN RETURN; END IF;
 PERFORM app_private.d1_lock_current_principal(actor);
 SELECT q.id,q.operation_id,q.requester_id,q.target_ref,q.row_version,
   q.state,q.old_snapshot,q.requested_payload,q.payload_schema_version,q.policy_id
   INTO q FROM app_private.approval_requests q
   JOIN app_private.operation_contracts o ON o.id=q.operation_id
 WHERE q.id=p_request_id AND o.code='student.roll_policy.change';
 IF NOT FOUND OR q.payload_schema_version IS DISTINCT FROM 1
   OR q.target_ref IS NULL OR q.policy_id IS NULL
   OR pg_catalog.jsonb_typeof(q.old_snapshot)<>'object'
   OR (SELECT pg_catalog.count(*) FROM pg_catalog.jsonb_object_keys(q.old_snapshot))<>5
   OR pg_catalog.jsonb_typeof(q.requested_payload)<>'object'
   OR (SELECT pg_catalog.count(*) FROM pg_catalog.jsonb_object_keys(q.requested_payload))<>5
   OR NOT (q.old_snapshot ?& ARRAY[
     'source_policy_id','source_revision','source_mode','source_start_value',
     'source_effective_from'])
   OR NOT (q.requested_payload ?& ARRAY[
     'action','mode','start_value','selected_p1_version_id',
     'trusted_business_date']) THEN RETURN; END IF;
 IF actor=q.requester_id
   AND app_private.d1_roll_policy_submit_actor_allowed(q.target_ref,actor) IS TRUE THEN
   access_kind:='REQUESTER';
 ELSE
   -- Merely being a historical candidate is NOT authorization. Only a
   -- currently OPEN, assigned and still independently eligible reviewer.
   FOR step IN SELECT s.id FROM app_private.approval_request_steps s
     JOIN app_private.approval_step_reviewers a ON a.step_id=s.id
     WHERE s.request_id=p_request_id AND s.state='OPEN'
       AND a.reviewer_id=actor AND a.withdrawn_at IS NULL
       AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE'
   LOOP
     IF app_private.d1_current_reviewer_eligible(p_request_id,step.id) IS TRUE THEN
       reviewer_count:=reviewer_count+1;
     END IF;
   END LOOP;
   IF reviewer_count<>1 THEN RETURN; END IF;
   access_kind:='OPEN_REVIEWER';
 END IF;
 BEGIN
   v_source:=NULLIF(q.old_snapshot->>'source_policy_id','')::uuid;
   v_revision:=(q.old_snapshot->>'source_revision')::integer;
   v_start:=(q.requested_payload->>'start_value')::bigint;
   v_date:=(q.requested_payload->>'trusted_business_date')::date;
 EXCEPTION WHEN invalid_text_representation OR numeric_value_out_of_range
   OR datetime_field_overflow THEN RETURN;
 END;
 IF v_start IS NULL OR v_start<0 OR v_date IS NULL
   OR q.requested_payload->>'trusted_business_date'
       IS DISTINCT FROM pg_catalog.to_char(v_date,'YYYY-MM-DD')
   OR q.requested_payload->>'action' NOT IN ('INIT','REPLACE')
   OR q.requested_payload->>'mode' NOT IN ('PERSISTENT_STUDENT','ACADEMIC_CONTEXT')
   OR q.requested_payload->>'selected_p1_version_id' IS DISTINCT FROM q.policy_id::text
   OR (q.requested_payload->>'action'='INIT'
       AND (v_source IS NOT NULL OR v_revision IS NOT NULL))
   OR (q.requested_payload->>'action'='REPLACE'
       AND (v_source IS NULL OR v_revision IS NULL OR v_revision<1))
 THEN RETURN; END IF;
 RETURN QUERY SELECT q.id,q.row_version,q.state,q.target_ref,
   q.requested_payload->>'action',v_source,v_revision,
   q.requested_payload->>'mode',v_start,v_date,access_kind;
END $body$;
REVOKE ALL ON FUNCTION app.d1_read_student_roll_policy_request(uuid)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_student_roll_policy_request(uuid)
 TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;
