-- Effect 28 retained-history replay correction.
-- A successful ADD/CORRECT receipt must remain replayable after that retained result row is
-- legitimately ended or superseded later. Verify the original receipt summary plus immutable
-- lineage facts instead of requiring the result row to remain the current open head.

GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE OR REPLACE FUNCTION app_private.d1_student_emergency_contact_result_rows_match(
 p_student uuid,p_action text,p_source uuid,p_result uuid,p_effective_on date,p_summary jsonb
) RETURNS boolean LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE v bigint; summary_from date; summary_until date;
BEGIN
  IF p_summary IS NULL OR pg_catalog.jsonb_typeof(p_summary)<>'object' OR (SELECT count(*) FROM pg_catalog.jsonb_object_keys(p_summary))<>6
     OR NOT (p_summary ?& ARRAY['contact_id','source_contact_id','action','effective_from','effective_until','student_version']) THEN RETURN false; END IF;
  BEGIN
    v:=(p_summary->>'student_version')::bigint;
    summary_from:=NULLIF(p_summary->>'effective_from','')::date;
    summary_until:=NULLIF(p_summary->>'effective_until','')::date;
  EXCEPTION WHEN invalid_text_representation OR numeric_value_out_of_range OR datetime_field_overflow THEN RETURN false; END;
  IF v<1 OR p_summary->>'action' IS DISTINCT FROM p_action OR NULLIF(p_summary->>'contact_id','')::uuid IS DISTINCT FROM p_result
     OR NULLIF(p_summary->>'source_contact_id','')::uuid IS DISTINCT FROM p_source OR summary_from IS NULL THEN RETURN false; END IF;
  IF p_action IN ('ADD','CORRECT') THEN
    IF summary_from IS DISTINCT FROM p_effective_on OR summary_until IS NOT NULL THEN RETURN false; END IF;
  ELSIF p_action='END' THEN
    IF summary_until IS DISTINCT FROM p_effective_on THEN RETURN false; END IF;
  ELSE
    RETURN false;
  END IF;
  IF p_action='ADD' THEN
    RETURN EXISTS (SELECT 1 FROM app_private.student_emergency_contacts x
      WHERE x.id=p_result AND x.student_id=p_student AND x.supersedes_id IS NULL AND x.effective_from=p_effective_on);
  ELSIF p_action='CORRECT' THEN
    RETURN EXISTS (SELECT 1 FROM app_private.student_emergency_contacts x
      WHERE x.id=p_result AND x.student_id=p_student AND x.supersedes_id=p_source AND x.effective_from=p_effective_on)
      AND EXISTS (SELECT 1 FROM app_private.student_emergency_contacts s
        WHERE s.id=p_source AND s.student_id=p_student AND s.effective_until=p_effective_on
          AND s.ended_at IS NOT NULL AND s.ended_by IS NOT NULL);
  ELSIF p_action='END' THEN
    RETURN p_result=p_source AND EXISTS (SELECT 1 FROM app_private.student_emergency_contacts s
      WHERE s.id=p_source AND s.student_id=p_student AND s.effective_from=summary_from AND s.effective_until=p_effective_on
        AND s.ended_at IS NOT NULL AND s.ended_by IS NOT NULL);
  END IF;
  RETURN false;
EXCEPTION WHEN invalid_text_representation OR datetime_field_overflow THEN RETURN false;
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;
