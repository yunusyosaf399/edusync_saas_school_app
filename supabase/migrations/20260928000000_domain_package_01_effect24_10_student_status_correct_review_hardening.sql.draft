-- Effect 24 correction: review replay rechecks current exact reviewer authority and terminal decisions append lifecycle evidence.
GRANT CREATE ON SCHEMA app TO schoolos_workflow_executor;
SET ROLE schoolos_workflow_executor;
CREATE OR REPLACE FUNCTION app.d1_review_student_status_correction(
 p_request_id uuid,p_decision text,p_expected_request_version bigint,p_reason text,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint,request_state text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; req record; step_row record; next_step record; assignment_id uuid; pre record; ps record; pn record;
 n bigint; candidate_count bigint; final_version bigint; final_state text; receipt uuid; source_id uuid; source_status text; source_date date; new_status text; new_date date;
 reviewer_role uuid; seq bigint;
BEGIN
  IF p_request_id IS NULL OR p_decision NOT IN ('APPROVE','REJECT') OR p_expected_request_version IS NULL OR p_expected_request_version<1
     OR p_reason IS NULL OR pg_catalog.length(pg_catalog.btrim(p_reason))=0 THEN RAISE EXCEPTION 'D1 Student status correction review intent invalid'; END IF;
  SELECT * INTO ctx FROM app_private.d1_student_status_correct_command_context('request.review',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_request_id,p_decision,p_expected_request_version::text,p_reason));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT q.* INTO req FROM app_private.approval_requests q WHERE q.id=p_request_id AND q.operation_id=ctx.operation_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'D1 Student status correction request missing'; END IF;
  BEGIN source_id:=NULLIF(req.old_snapshot->>'source_transition_id','')::uuid; source_status:=req.old_snapshot->>'new_status';
    source_date:=NULLIF(req.old_snapshot->>'effective_on','')::date; new_status:=req.requested_payload->>'new_status'; new_date:=NULLIF(req.requested_payload->>'effective_on','')::date;
  EXCEPTION WHEN OTHERS THEN RAISE EXCEPTION 'D1 Student status correction stored request malformed'; END;
  IF source_id IS NULL OR source_status IS NULL OR source_date IS NULL OR new_status IS NULL OR new_date IS NULL THEN RAISE EXCEPTION 'D1 Student status correction stored request malformed'; END IF;
  SELECT * INTO ps FROM app_private.d1_student_status_correct_policy(req.target_ref,source_date); SELECT * INTO pn FROM app_private.d1_student_status_correct_policy(req.target_ref,new_date);
  IF ps.policy_id IS DISTINCT FROM req.policy_id OR pn.policy_id IS DISTINCT FROM req.policy_id OR ps.campus_id IS DISTINCT FROM req.campus_id OR pn.campus_id IS DISTINCT FROM req.campus_id
    THEN RAISE EXCEPTION 'D1 Student status correction policy no longer applies'; END IF;
  IF ctx.receipt_id IS NOT NULL THEN
    SELECT count(*),min(t.reviewer_role_id::text)::uuid INTO n,reviewer_role FROM app_private.approval_reviews v
      JOIN app_private.approval_request_steps s ON s.id=v.step_id JOIN app_private.approval_step_templates t ON t.id=s.template_id
      WHERE s.request_id=p_request_id AND v.reviewer_id=ctx.actor_id AND v.decision=p_decision AND v.expected_request_version=p_expected_request_version;
    IF n<>1 OR reviewer_role IS NULL OR app_private.d1_student_status_correct_authorized_pair(ctx.actor_id,'student.status.approve',req.target_ref,
      source_date,new_date,reviewer_role) IS DISTINCT FROM true OR ctx.receipt_state<>'SUCCEEDED' OR ctx.result_ref IS DISTINCT FROM p_request_id
      OR ctx.result_summary IS NULL OR NOT (ctx.result_summary ?& ARRAY['request_version','state']) THEN
      RAISE EXCEPTION 'D1 Student status correction review replay authority invalid'; END IF;
    RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,ctx.result_summary->>'state'; RETURN; END IF;
  SELECT * INTO pre FROM app_private.d1_student_status_correct_preflight(req.target_ref,req.expected_target_version,source_id,source_status,source_date,new_status,new_date,req.reason);
  IF pre.eligible IS DISTINCT FROM true THEN RAISE EXCEPTION 'D1 Student status correction request facts changed: %',pre.error_code; END IF;
  SELECT s.* INTO step_row FROM app_private.approval_request_steps s WHERE s.request_id=p_request_id AND s.state='OPEN' ORDER BY s.step_number LIMIT 1 FOR UPDATE;
  IF req.state<>'PENDING' OR req.row_version<>p_expected_request_version OR step_row.id IS NULL THEN RAISE EXCEPTION 'D1 Student status correction review state changed'; END IF;
  SELECT count(*),min(a.id::text)::uuid INTO n,assignment_id FROM app_private.approval_step_reviewers a
   WHERE a.step_id=step_row.id AND a.reviewer_id=ctx.actor_id AND a.withdrawn_at IS NULL AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
  IF n<>1 OR NOT EXISTS (SELECT 1 FROM app_private.d1_student_status_correct_candidates(p_request_id,step_row.id) c WHERE c.candidate_principal_id=ctx.actor_id)
    THEN RAISE EXCEPTION 'D1 Student status correction reviewer authority denied'; END IF;
  INSERT INTO app_private.approval_reviews(reviewer_assignment_id,step_id,reviewer_id,decision,reason,expected_request_version,created_by)
  VALUES (assignment_id,step_row.id,ctx.actor_id,p_decision,pg_catalog.btrim(p_reason),p_expected_request_version,ctx.actor_id);
  UPDATE app_private.approval_request_steps SET state=CASE p_decision WHEN 'APPROVE' THEN 'APPROVED' ELSE 'REJECTED' END,closed_at=pg_catalog.statement_timestamp() WHERE id=step_row.id;
  IF p_decision='REJECT' THEN
    UPDATE app_private.approval_request_steps SET state='CANCELLED',closed_at=pg_catalog.statement_timestamp() WHERE request_id=p_request_id AND state='WAITING';
    final_state:='REJECTED'; UPDATE app_private.approval_requests SET state='REJECTED',decided_at=pg_catalog.statement_timestamp() WHERE id=p_request_id RETURNING row_version INTO final_version;
  ELSE
    SELECT s.* INTO next_step FROM app_private.approval_request_steps s WHERE s.request_id=p_request_id AND s.step_number=step_row.step_number+1 AND s.state='WAITING' FOR UPDATE;
    IF next_step.id IS NOT NULL THEN UPDATE app_private.approval_request_steps SET state='OPEN',opened_at=pg_catalog.statement_timestamp() WHERE id=next_step.id;
      INSERT INTO app_private.approval_step_reviewers(step_id,reviewer_id,assignment_reason,created_by)
        SELECT next_step.id,c.candidate_principal_id,'D1_REVIEWER_ROLE_SCOPE',ctx.actor_id FROM app_private.d1_student_status_correct_candidates(p_request_id,next_step.id) c;
      GET DIAGNOSTICS candidate_count=ROW_COUNT; IF candidate_count=0 THEN RAISE EXCEPTION 'D1 Student status correction next step has no reviewer'; END IF;
      final_state:='PENDING'; UPDATE app_private.approval_requests SET row_version=row_version+1,updated_at=pg_catalog.statement_timestamp() WHERE id=p_request_id RETURNING row_version INTO final_version;
    ELSE IF EXISTS (SELECT 1 FROM app_private.approval_request_steps s WHERE s.request_id=p_request_id AND s.state<>'APPROVED') THEN RAISE EXCEPTION 'D1 Student status correction approval sequence incomplete'; END IF;
      final_state:='APPROVED'; UPDATE app_private.approval_requests SET state='APPROVED',decided_at=pg_catalog.statement_timestamp() WHERE id=p_request_id RETURNING row_version INTO final_version;
    END IF;
  END IF;
  receipt:=app_private.d1_student_status_correct_receipt('request.review',ctx.actor_id,ctx.operation_id,p_idempotency_key,ctx.intent_hash,
    req.expected_target_version,p_request_id,p_expected_request_version,'SUCCEEDED','D1_STUDENT_STATUS_CORRECT_REVIEW',p_request_id,pg_catalog.jsonb_build_object('request_version',final_version,'state',final_state),NULL);
  IF final_state IN ('APPROVED','REJECTED') THEN SELECT pg_catalog.coalesce(max(sequence_number),0)+1 INTO seq FROM app_private.approval_transitions WHERE request_id=p_request_id;
    INSERT INTO app_private.approval_transitions(request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
    VALUES (p_request_id,seq,'PENDING',final_state,'D1_STUDENT_STATUS_CORRECT_'||final_state,receipt,ctx.actor_id); END IF;
  PERFORM app_private.d1_student_status_correct_audit(ctx.actor_id,'REVIEW',req.target_ref,source_id,NULL,receipt,p_request_id,req.expected_target_version,new_status,new_date,final_state,pg_catalog.gen_random_uuid());
  RETURN QUERY SELECT p_request_id,final_version,final_state;
END $body$;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;