-- Effect 24 successful application guard: bind approved request, receipt and factual supersession.
GRANT CREATE ON SCHEMA app_private TO schoolos_evidence_writer;
SET ROLE schoolos_evidence_writer;
CREATE FUNCTION app_private.d1_guard_student_status_correct_application()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE op_code text; req record; rec record; result_row record; source_row record; student_version bigint; source_id uuid; new_status text; new_date date;
BEGIN
  SELECT o.code INTO op_code FROM app_private.operation_contracts o WHERE o.id=NEW.operation_id;
  IF op_code IS DISTINCT FROM 'student.status.correct' THEN RETURN NEW; END IF;
  SELECT q.* INTO req FROM app_private.approval_requests q JOIN app_private.operation_contracts o ON o.id=q.operation_id
   WHERE q.id=NEW.request_id AND q.operation_id=NEW.operation_id AND o.code='student.status.correct' AND o.contract_version=1 AND o.enabled;
  IF NOT FOUND OR req.state<>'EXECUTED' OR NEW.result_ref IS NULL OR NEW.command_receipt_id IS NULL THEN
    RAISE EXCEPTION 'D1 Student status correction application request binding invalid'; END IF;
  SELECT r.* INTO rec FROM app_private.command_receipts r WHERE r.id=NEW.command_receipt_id AND r.request_id=req.id
    AND r.operation_id=req.operation_id AND r.command_kind='request.apply' AND r.state='SUCCEEDED'
    AND r.result_kind='D1_STUDENT_STATUS_CORRECT_APPLY' AND r.result_ref=NEW.result_ref;
  IF NOT FOUND OR rec.result_summary IS NULL OR rec.result_summary->>'state'<>'EXECUTED' OR rec.result_summary->>'transition_id' IS DISTINCT FROM NEW.result_ref::text
     OR (rec.result_summary->>'student_version')::bigint IS DISTINCT FROM NEW.applied_target_version THEN
    RAISE EXCEPTION 'D1 Student status correction application receipt binding invalid'; END IF;
  BEGIN source_id:=NULLIF(req.old_snapshot->>'source_transition_id','')::uuid; new_status:=req.requested_payload->>'new_status';
    new_date:=NULLIF(req.requested_payload->>'effective_on','')::date;
  EXCEPTION WHEN OTHERS THEN RAISE EXCEPTION 'D1 Student status correction stored request malformed'; END;
  SELECT t.* INTO result_row FROM app_private.student_status_transitions t WHERE t.id=NEW.result_ref AND t.student_id=req.target_ref;
  SELECT t.* INTO source_row FROM app_private.student_status_transitions t WHERE t.id=source_id AND t.student_id=req.target_ref;
  SELECT s.row_version INTO student_version FROM app_private.students s WHERE s.id=req.target_ref;
  IF result_row.id IS NULL OR source_row.id IS NULL OR result_row.supersedes_id IS DISTINCT FROM source_id
     OR result_row.new_status IS DISTINCT FROM new_status OR result_row.effective_on IS DISTINCT FROM new_date
     OR result_row.reason IS DISTINCT FROM req.reason OR student_version IS DISTINCT FROM NEW.applied_target_version
     OR EXISTS (SELECT 1 FROM app_private.student_status_transitions x WHERE x.student_id=req.target_ref AND x.supersedes_id=source_id AND x.id<>result_row.id)
  THEN RAISE EXCEPTION 'D1 Student status correction application result binding invalid'; END IF;
  RETURN NEW;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_guard_student_status_correct_application() FROM PUBLIC,anon,authenticated,service_role;
-- Temporary packaging privilege: the trigger creator must be able to execute
-- this evidence-owned function. Revoke immediately after trigger creation.
GRANT EXECUTE ON FUNCTION app_private.d1_guard_student_status_correct_application() TO schoolos_schema_owner;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_evidence_writer;

SET ROLE schoolos_schema_owner;
CREATE TRIGGER d1_effect24_status_correct_application_guard
BEFORE INSERT ON app_private.approval_applications
FOR EACH ROW EXECUTE FUNCTION app_private.d1_guard_student_status_correct_application();
RESET ROLE;
SET ROLE schoolos_evidence_writer;
REVOKE EXECUTE ON FUNCTION app_private.d1_guard_student_status_correct_application() FROM schoolos_schema_owner;
RESET ROLE;
