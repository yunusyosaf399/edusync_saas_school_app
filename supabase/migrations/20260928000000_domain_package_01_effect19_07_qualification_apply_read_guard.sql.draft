GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE FUNCTION app_private.d1_employee_qualification_reviews_live(p_request uuid)
RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; requester_person uuid; s record; n bigint; reviewer uuid; reviewer_person uuid; role_id uuid; seen bigint:=0;
BEGIN
  SELECT q.* INTO req FROM app_private.approval_requests q
    JOIN app_private.operation_contracts o ON o.id=q.operation_id
   WHERE q.id=p_request AND o.code='employee.qualification.change';
  IF NOT FOUND THEN RETURN false; END IF;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id;
  IF requester_person IS NULL THEN RETURN false; END IF;
  FOR s IN SELECT st.id,st.state,t.reviewer_role_id FROM app_private.approval_request_steps st
      JOIN app_private.approval_step_templates t ON t.id=st.template_id
     WHERE st.request_id=p_request ORDER BY st.step_number LOOP
    seen:=seen+1;
    IF s.state<>'APPROVED' OR s.reviewer_role_id IS NULL THEN RETURN false; END IF;
    SELECT count(*),min(v.reviewer_id::text)::uuid INTO n,reviewer
      FROM app_private.approval_reviews v
      JOIN app_private.approval_step_reviewers a ON a.id=v.reviewer_assignment_id AND a.step_id=s.id
     WHERE v.step_id=s.id AND v.decision='APPROVE' AND a.reviewer_id=v.reviewer_id
       AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE';
    IF n<>1 OR reviewer IS NULL THEN RETURN false; END IF;
    SELECT p.person_id INTO reviewer_person FROM app_private.principals p WHERE p.id=reviewer;
    IF reviewer_person IS NULL OR reviewer_person=requester_person THEN RETURN false; END IF;
    IF NOT app_private.d1_employee_qualification_authorized(
        reviewer,'employee.qualification.approve',req.target_ref,s.reviewer_role_id) THEN RETURN false; END IF;
  END LOOP;
  RETURN seen>0;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_employee_qualification_reviews_live(uuid)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_employee_qualification_reviews_live(uuid)
  TO schoolos_workflow_executor,schoolos_read_executor;

CREATE FUNCTION app_private.d1_employee_qualification_participant(p_request uuid,p_actor uuid)
RETURNS text
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE req record; final_role uuid; s record; n bigint; requester_person uuid; actor_person uuid;
BEGIN
  SELECT q.* INTO req FROM app_private.approval_requests q
    JOIN app_private.operation_contracts o ON o.id=q.operation_id
   WHERE q.id=p_request AND o.code='employee.qualification.change';
  IF NOT FOUND OR p_actor IS NULL THEN RETURN NULL; END IF;
  IF p_actor=req.requester_id AND app_private.d1_employee_qualification_authorized(
      p_actor,'employee.qualification.change',req.target_ref,NULL) THEN RETURN 'REQUESTER'; END IF;
  final_role:=app_private.d1_final_approver_role(p_request,p_actor);
  IF final_role IS NOT NULL AND app_private.d1_employee_qualification_authorized(
      p_actor,'employee.qualification.approve',req.target_ref,final_role) THEN RETURN 'FINAL_APPROVER'; END IF;
  SELECT p.person_id INTO requester_person FROM app_private.principals p WHERE p.id=req.requester_id;
  SELECT p.person_id INTO actor_person FROM app_private.principals p WHERE p.id=p_actor;
  IF requester_person IS NULL OR actor_person IS NULL OR requester_person=actor_person THEN RETURN NULL; END IF;
  SELECT st.id,t.reviewer_role_id INTO s FROM app_private.approval_request_steps st
    JOIN app_private.approval_step_templates t ON t.id=st.template_id
   WHERE st.request_id=p_request AND st.state='OPEN'
     AND EXISTS (SELECT 1 FROM app_private.approval_step_reviewers a
       WHERE a.step_id=st.id AND a.reviewer_id=p_actor AND a.withdrawn_at IS NULL
         AND a.assignment_reason='D1_REVIEWER_ROLE_SCOPE')
   ORDER BY st.step_number LIMIT 1;
  IF s.id IS NOT NULL AND app_private.d1_employee_qualification_authorized(
      p_actor,'employee.qualification.approve',req.target_ref,s.reviewer_role_id)
     AND EXISTS (SELECT 1 FROM app_private.d1_employee_qualification_candidates(p_request,s.id) c WHERE c.candidate_principal_id=p_actor)
  THEN RETURN 'OPEN_REVIEWER'; END IF;
  SELECT count(*),min(t.reviewer_role_id::text)::uuid INTO n,final_role
    FROM app_private.approval_reviews v
    JOIN app_private.approval_request_steps st ON st.id=v.step_id
    JOIN app_private.approval_step_templates t ON t.id=st.template_id
   WHERE st.request_id=p_request AND v.reviewer_id=p_actor;
  IF n>0 AND final_role IS NOT NULL AND app_private.d1_employee_qualification_authorized(
      p_actor,'employee.qualification.approve',req.target_ref,final_role) THEN RETURN 'DECIDED_REVIEWER'; END IF;
  RETURN NULL;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_employee_qualification_participant(uuid,uuid)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_employee_qualification_participant(uuid,uuid)
  TO schoolos_workflow_executor,schoolos_read_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;

CREATE FUNCTION app.d1_apply_employee_qualification_request(
  p_request_id uuid,p_expected_request_version bigint,p_idempotency_key text
) RETURNS TABLE(request_id uuid,request_version bigint,request_state text)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE ctx record; req record; policy_row record; pre record; effect_row record;
  participant text; action text; source_id uuid; lineage uuid; qtype text; qtitle text;
  institution text; specialization text; awarded date; invalidation_code text;
  final_state text; final_version bigint; receipt uuid; sequence_no bigint;
  correlation uuid:=pg_catalog.gen_random_uuid(); payload jsonb;
BEGIN
  IF p_request_id IS NULL OR p_expected_request_version IS NULL OR p_expected_request_version<1 THEN
    RAISE EXCEPTION 'D1 Employee qualification apply intent invalid'; END IF;
  SELECT * INTO ctx FROM app_private.d1_employee_qualification_command_context('request.apply',p_idempotency_key,
    pg_catalog.jsonb_build_array(p_request_id,p_expected_request_version::text));
  PERFORM app_private.d1_lock_current_principal(ctx.actor_id);
  SELECT q.* INTO req FROM app_private.approval_requests q
   WHERE q.id=p_request_id AND q.operation_id=ctx.operation_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'D1 Employee qualification request missing'; END IF;
  participant:=app_private.d1_employee_qualification_participant(p_request_id,ctx.actor_id);
  IF participant NOT IN ('REQUESTER','FINAL_APPROVER') OR participant IS NULL THEN
    RAISE EXCEPTION 'D1 Employee qualification request unavailable'; END IF;
  IF ctx.receipt_id IS NOT NULL THEN
    IF ctx.receipt_state NOT IN ('SUCCEEDED','REJECTED') OR ctx.result_summary IS NULL
       OR pg_catalog.jsonb_typeof(ctx.result_summary)<>'object'
       OR NOT (ctx.result_summary ?& ARRAY['request_version','state'])
       OR (ctx.receipt_state='SUCCEEDED' AND (ctx.result_ref IS NULL OR ctx.result_summary->>'state'<>'EXECUTED'))
       OR (ctx.receipt_state='REJECTED' AND (ctx.result_ref IS NOT NULL OR ctx.result_summary->>'state'<>'INVALIDATED')) THEN
      RAISE EXCEPTION 'D1 Employee qualification apply receipt invalid'; END IF;
    RETURN QUERY SELECT p_request_id,(ctx.result_summary->>'request_version')::bigint,ctx.result_summary->>'state'; RETURN;
  END IF;
  IF req.state<>'APPROVED' OR req.row_version<>p_expected_request_version THEN
    RAISE EXCEPTION 'D1 Employee qualification approved request changed'; END IF;
  IF req.old_snapshot IS NULL OR pg_catalog.jsonb_typeof(req.old_snapshot)<>'object'
     OR req.requested_payload IS NULL OR pg_catalog.jsonb_typeof(req.requested_payload)<>'object'
     OR NOT (req.old_snapshot ?& ARRAY['source_snapshot_id','qualification_record_id','qualification_type','title','institution','specialization','awarded_on','effective_from','supersedes_id'])
     OR NOT (req.requested_payload ?& ARRAY['action','qualification_type','title','institution','specialization','awarded_on']) THEN
    RAISE EXCEPTION 'D1 Employee qualification stored request payload malformed'; END IF;
  BEGIN
    action:=req.requested_payload->>'action';
    source_id:=NULLIF(req.old_snapshot->>'source_snapshot_id','')::uuid;
    lineage:=NULLIF(req.old_snapshot->>'qualification_record_id','')::uuid;
    qtype:=NULLIF(req.requested_payload->>'qualification_type','');
    qtitle:=NULLIF(req.requested_payload->>'title','');
    institution:=NULLIF(req.requested_payload->>'institution','');
    specialization:=NULLIF(req.requested_payload->>'specialization','');
    awarded:=NULLIF(req.requested_payload->>'awarded_on','')::date;
  EXCEPTION WHEN invalid_text_representation OR datetime_field_overflow THEN
    RAISE EXCEPTION 'D1 Employee qualification stored request payload malformed';
  END;
  IF app_private.d1_employee_qualification_payload_valid(action,source_id,lineage,qtype,qtitle,institution,specialization,awarded,req.reason)
       IS DISTINCT FROM true THEN RAISE EXCEPTION 'D1 Employee qualification stored request payload malformed'; END IF;
  SELECT * INTO policy_row FROM app_private.d1_employee_qualification_policy(req.target_ref);
  IF policy_row.policy_id IS DISTINCT FROM req.policy_id OR policy_row.route_mode IS DISTINCT FROM 'APPROVAL' THEN
    invalidation_code:='D1_EMPLOYEE_QUALIFICATION_POLICY_STALE';
  ELSIF NOT app_private.d1_employee_qualification_authorized(req.requester_id,'employee.qualification.change',req.target_ref,NULL) THEN
    invalidation_code:='D1_EMPLOYEE_QUALIFICATION_REQUESTER_AUTHORITY_STALE';
  ELSIF NOT app_private.d1_employee_qualification_reviews_live(p_request_id) THEN
    invalidation_code:='D1_EMPLOYEE_QUALIFICATION_REVIEWER_AUTHORITY_STALE';
  ELSE
    SELECT * INTO pre FROM app_private.d1_employee_qualification_preflight(req.target_ref,req.expected_target_version,
      action,source_id,lineage,qtype,qtitle,institution,specialization,awarded,req.reason);
    IF NOT FOUND OR pre.eligible IS NULL THEN RAISE EXCEPTION 'D1 Employee qualification preflight result unavailable'; END IF;
    IF pre.eligible IS FALSE THEN
      IF pre.error_code IS NULL OR pg_catalog.length(pg_catalog.btrim(pre.error_code))=0 THEN
        RAISE EXCEPTION 'D1 Employee qualification preflight denial lacks error code'; END IF;
      invalidation_code:=pre.error_code;
    END IF;
  END IF;
  IF invalidation_code IS NOT NULL THEN
    final_state:='INVALIDATED';
    UPDATE app_private.approval_requests SET state=final_state WHERE id=p_request_id RETURNING row_version INTO final_version;
    receipt:=app_private.d1_employee_qualification_receipt('request.apply',ctx.actor_id,ctx.operation_id,p_idempotency_key,
      ctx.intent_hash,req.expected_target_version,p_request_id,p_expected_request_version,'REJECTED',NULL,NULL,
      pg_catalog.jsonb_build_object('request_version',final_version,'state',final_state),invalidation_code);
    PERFORM app_private.d1_employee_qualification_audit(ctx.actor_id,'request.apply',action,req.target_ref,NULL,lineage,source_id,
      receipt,p_request_id,req.expected_target_version,'REJECTED',correlation);
  ELSE
    SELECT * INTO effect_row FROM app_private.d1_employee_qualification_effect(ctx.actor_id,req.target_ref,req.expected_target_version,
      action,source_id,lineage,qtype,qtitle,institution,specialization,awarded,req.reason);
    final_state:='EXECUTED';
    UPDATE app_private.approval_requests SET state=final_state WHERE id=p_request_id RETURNING row_version INTO final_version;
    receipt:=app_private.d1_employee_qualification_receipt('request.apply',ctx.actor_id,ctx.operation_id,p_idempotency_key,
      ctx.intent_hash,req.expected_target_version,p_request_id,p_expected_request_version,'SUCCEEDED','D1_EMPLOYEE_QUALIFICATION_APPLY',
      effect_row.snapshot_id,pg_catalog.jsonb_build_object('request_version',final_version,'state',final_state,'action',action,
        'snapshot_id',effect_row.snapshot_id,'qualification_record_id',effect_row.qualification_record_id,
        'source_snapshot_id',source_id,'effective_from',effect_row.effective_from,'effective_until',effect_row.effective_until,
        'employee_version',req.expected_target_version),NULL);
    INSERT INTO app_private.approval_applications
      (request_id,command_receipt_id,operation_id,applied_target_version,result_ref,created_by)
    VALUES (p_request_id,receipt,ctx.operation_id,req.expected_target_version,effect_row.snapshot_id,ctx.actor_id);
    PERFORM app_private.d1_employee_qualification_audit(ctx.actor_id,'request.apply',action,req.target_ref,effect_row.snapshot_id,
      effect_row.qualification_record_id,source_id,receipt,p_request_id,req.expected_target_version,'SUCCEEDED',correlation);
    PERFORM app_private.d1_employee_qualification_event(ctx.actor_id,action,req.target_ref,effect_row.snapshot_id,
      effect_row.qualification_record_id,source_id,receipt,req.expected_target_version,correlation);
  END IF;
  SELECT pg_catalog.coalesce(max(t.sequence_number),0) INTO sequence_no FROM app_private.approval_transitions t WHERE t.request_id=p_request_id;
  INSERT INTO app_private.approval_transitions
    (request_id,sequence_number,from_state,to_state,reason,command_receipt_id,created_by)
  VALUES (p_request_id,sequence_no+1,'APPROVED',final_state,
    CASE WHEN final_state='EXECUTED' THEN 'D1_EMPLOYEE_QUALIFICATION_APPLIED' ELSE invalidation_code END,receipt,ctx.actor_id);
  RETURN QUERY SELECT p_request_id,final_version,final_state;
END $body$;
REVOKE ALL ON FUNCTION app.d1_apply_employee_qualification_request(uuid,bigint,text)
  FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_apply_employee_qualification_request(uuid,bigint,text) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_workflow_executor;

GRANT CREATE ON SCHEMA app TO schoolos_read_executor;
SET ROLE schoolos_read_executor;
CREATE FUNCTION app.d1_read_employee_qualification_request(p_request_id uuid)
RETURNS TABLE(request_id uuid,request_version bigint,request_state text,employee_id uuid,action text,
  source_snapshot_id uuid,qualification_record_id uuid,old_qualification_type text,old_title text,
  old_institution text,old_specialization text,old_awarded_on date,requested_qualification_type text,
  requested_title text,requested_institution text,requested_specialization text,requested_awarded_on date)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE actor uuid; participant text; req record;
BEGIN
  PERFORM pg_catalog.pg_advisory_xact_lock_shared(71001,1);
  actor:=app_private.current_principal_id();
  IF actor IS NULL THEN RAISE EXCEPTION 'D1 Employee qualification request unavailable'; END IF;
  participant:=app_private.d1_employee_qualification_participant(p_request_id,actor);
  IF participant IS NULL THEN RAISE EXCEPTION 'D1 Employee qualification request unavailable'; END IF;
  SELECT q.* INTO req FROM app_private.approval_requests q
    JOIN app_private.operation_contracts o ON o.id=q.operation_id
   WHERE q.id=p_request_id AND o.code='employee.qualification.change';
  IF NOT FOUND THEN RAISE EXCEPTION 'D1 Employee qualification request unavailable'; END IF;
  RETURN QUERY SELECT req.id,req.row_version,req.state,req.target_ref,req.requested_payload->>'action',
    NULLIF(req.old_snapshot->>'source_snapshot_id','')::uuid,NULLIF(req.old_snapshot->>'qualification_record_id','')::uuid,
    req.old_snapshot->>'qualification_type',req.old_snapshot->>'title',req.old_snapshot->>'institution',
    req.old_snapshot->>'specialization',NULLIF(req.old_snapshot->>'awarded_on','')::date,
    req.requested_payload->>'qualification_type',req.requested_payload->>'title',req.requested_payload->>'institution',
    req.requested_payload->>'specialization',NULLIF(req.requested_payload->>'awarded_on','')::date;
END $body$;
REVOKE ALL ON FUNCTION app.d1_read_employee_qualification_request(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app.d1_read_employee_qualification_request(uuid) TO authenticated;
RESET ROLE;
REVOKE CREATE ON SCHEMA app FROM schoolos_read_executor;

SET ROLE schoolos_schema_owner;
CREATE FUNCTION app_private.d1_employee_qualification_application_receipt_guard()
RETURNS trigger
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE op_code text; receipt app_private.command_receipts%ROWTYPE; req app_private.approval_requests%ROWTYPE;
  q app_private.employee_qualifications%ROWTYPE; pred app_private.employee_qualifications%ROWTYPE;
  action text; source_id uuid; lineage uuid;
BEGIN
  SELECT o.code INTO op_code FROM app_private.operation_contracts o WHERE o.id=NEW.operation_id;
  IF op_code<>'employee.qualification.change' THEN RETURN NEW; END IF;
  SELECT r.* INTO receipt FROM app_private.command_receipts r
   WHERE r.id=NEW.command_receipt_id AND r.operation_id=NEW.operation_id AND r.request_id=NEW.request_id
     AND r.command_kind='request.apply' AND r.state='SUCCEEDED' AND r.result_kind='D1_EMPLOYEE_QUALIFICATION_APPLY'
     AND r.result_ref=NEW.result_ref;
  SELECT a.* INTO req FROM app_private.approval_requests a
   WHERE a.id=NEW.request_id AND a.operation_id=NEW.operation_id AND a.state='EXECUTED';
  SELECT e.* INTO q FROM app_private.employee_qualifications e WHERE e.id=NEW.result_ref;
  IF receipt.id IS NULL OR req.id IS NULL OR q.id IS NULL OR q.employee_id IS DISTINCT FROM req.target_ref
     OR NEW.applied_target_version IS DISTINCT FROM req.expected_target_version
     OR receipt.result_summary->>'state'<>'EXECUTED'
     OR (receipt.result_summary->>'employee_version')::bigint IS DISTINCT FROM NEW.applied_target_version
     OR (receipt.result_summary->>'qualification_record_id')::uuid IS DISTINCT FROM q.qualification_record_id THEN
    RAISE EXCEPTION 'D1 Employee qualification approval application receipt mismatch'; END IF;
  action:=receipt.result_summary->>'action';
  source_id:=NULLIF(receipt.result_summary->>'source_snapshot_id','')::uuid;
  lineage:=(receipt.result_summary->>'qualification_record_id')::uuid;
  IF action='ADD' THEN
    IF source_id IS NOT NULL OR q.supersedes_id IS NOT NULL OR q.effective_until IS NOT NULL THEN
      RAISE EXCEPTION 'D1 Employee qualification ADD application mismatch'; END IF;
  ELSIF action='CORRECT' THEN
    SELECT p.* INTO pred FROM app_private.employee_qualifications p WHERE p.id=source_id;
    IF pred.id IS NULL OR q.supersedes_id IS DISTINCT FROM pred.id
       OR pred.qualification_record_id IS DISTINCT FROM lineage
       OR pred.effective_until IS DISTINCT FROM q.effective_from THEN
      RAISE EXCEPTION 'D1 Employee qualification CORRECT application mismatch'; END IF;
  ELSIF action='ARCHIVE' THEN
    IF source_id IS DISTINCT FROM q.id OR q.effective_until IS NULL OR q.qualification_record_id IS DISTINCT FROM lineage THEN
      RAISE EXCEPTION 'D1 Employee qualification ARCHIVE application mismatch'; END IF;
  ELSE RAISE EXCEPTION 'D1 Employee qualification application action invalid'; END IF;
  RETURN NEW;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_employee_qualification_application_receipt_guard()
  FROM PUBLIC,anon,authenticated,service_role;
DROP TRIGGER IF EXISTS d1_employee_qualification_application_receipt_guard ON app_private.approval_applications;
CREATE TRIGGER d1_employee_qualification_application_receipt_guard BEFORE INSERT ON app_private.approval_applications
  FOR EACH ROW EXECUTE FUNCTION app_private.d1_employee_qualification_application_receipt_guard();
RESET ROLE;
