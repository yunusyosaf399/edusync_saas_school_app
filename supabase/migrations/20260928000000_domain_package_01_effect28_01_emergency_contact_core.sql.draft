-- D1C1B effect 28/36: Student Emergency Contact change core.
-- Static non-executable continuation only. Migration 10 remains .sql.draft.
-- P1 ADD/END/CORRECT retained contact history; no Family/access/guardian/pickup authority.

SET ROLE schoolos_schema_owner;
GRANT SELECT (id,row_version,current_status) ON app_private.students TO schoolos_student_executor;
GRANT SELECT (id,student_id,person_id,contact_name,relationship_label,contact_phone,contact_email,effective_from,effective_until,reason,supersedes_id,created_at,created_by,ended_at,ended_by),
  INSERT (id,student_id,person_id,contact_name,relationship_label,contact_phone,contact_email,effective_from,effective_until,reason,supersedes_id,created_by),
  UPDATE (effective_until,ended_at,ended_by)
  ON app_private.student_emergency_contacts TO schoolos_student_executor;
GRANT SELECT (id) ON app_private.people TO schoolos_student_executor;
RESET ROLE;

GRANT CREATE ON SCHEMA app_private TO schoolos_authz_reader;
SET ROLE schoolos_authz_reader;
CREATE FUNCTION app_private.d1_student_emergency_contact_authorized(
  p_principal uuid,p_permission text,p_student uuid,p_reviewer_role uuid DEFAULT NULL
) RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE at_time timestamptz:=pg_catalog.clock_timestamp(); on_date date:=at_time::date; placement record; n bigint;
BEGIN
  IF p_principal IS NULL OR p_student IS NULL
     OR p_permission NOT IN ('student.emergency_contact.change','student.emergency_contact.approve')
     OR NOT EXISTS (SELECT 1 FROM app_private.students s WHERE s.id=p_student)
     OR NOT EXISTS (SELECT 1 FROM app_private.principals p JOIN app_private.principal_auth_bindings b ON b.principal_id=p.id
       WHERE p.id=p_principal AND p.kind='INDIVIDUAL' AND p.state='ACTIVE' AND p.person_id IS NOT NULL AND b.auth_user_id IS NOT NULL)
  THEN RETURN false; END IF;
  IF p_reviewer_role IS NOT NULL AND NOT EXISTS (
    SELECT 1 FROM app_private.principal_role_assignments a JOIN app_private.roles r ON r.id=a.role_id
     WHERE a.principal_id=p_principal AND a.role_id=p_reviewer_role AND a.principal_kind='INDIVIDUAL'
       AND a.context_kind='INDIVIDUAL' AND r.state='ACTIVE' AND NOT r.family_only
       AND a.valid_from<=at_time AND (a.valid_until IS NULL OR at_time<a.valid_until)
       AND (a.revoked_at IS NULL OR at_time<a.revoked_at)) THEN RETURN false; END IF;
  SELECT count(*) INTO n FROM app_private.enrollments e
   WHERE e.student_id=p_student AND e.placement_kind='PRIMARY' AND e.placement_state='ACTIVE'
     AND e.effective_from<=on_date AND (e.effective_until IS NULL OR on_date<e.effective_until);
  IF n>1 THEN RETURN false; END IF;
  IF n=1 THEN
    SELECT so.id section_id,co.id class_id,co.campus_id INTO placement
      FROM app_private.enrollments e JOIN app_private.section_offerings so ON so.id=e.section_offering_id
      JOIN app_private.class_offerings co ON co.id=so.class_offering_id
     WHERE e.student_id=p_student AND e.placement_kind='PRIMARY' AND e.placement_state='ACTIVE'
       AND e.effective_from<=on_date AND (e.effective_until IS NULL OR on_date<e.effective_until);
  END IF;
  RETURN EXISTS (
    SELECT 1 FROM app_private.assignment_permission_scopes sc
    JOIN app_private.principal_role_assignments a ON a.id=sc.assignment_id
    JOIN app_private.role_permission_grants g ON g.id=sc.grant_id
    JOIN app_private.permission_scope_contracts c ON c.id=sc.scope_contract_id
    JOIN app_private.permissions p ON p.id=sc.permission_id JOIN app_private.roles r ON r.id=sc.role_id
     WHERE a.principal_id=p_principal AND a.principal_kind='INDIVIDUAL' AND a.context_kind='INDIVIDUAL'
       AND a.role_id=sc.role_id AND g.role_id=sc.role_id AND g.permission_id=sc.permission_id
       AND c.permission_id=sc.permission_id AND c.scope_kind=sc.scope_kind AND c.resolver_key=sc.resolver_key AND c.enabled
       AND p.code=p_permission AND p.state='ENABLED' AND NOT p.family_safe AND r.state='ACTIVE' AND NOT r.family_only
       AND (p_reviewer_role IS NULL OR sc.role_id=p_reviewer_role)
       AND a.valid_from<=at_time AND (a.valid_until IS NULL OR at_time<a.valid_until) AND (a.revoked_at IS NULL OR at_time<a.revoked_at)
       AND g.valid_from<=at_time AND (g.valid_until IS NULL OR at_time<g.valid_until) AND (g.revoked_at IS NULL OR at_time<g.revoked_at)
       AND sc.valid_from<=at_time AND (sc.valid_until IS NULL OR at_time<sc.valid_until) AND (sc.revoked_at IS NULL OR at_time<sc.revoked_at)
       AND sc.resolver_key='DIRECT'
       AND ((sc.scope_kind='ALL' AND sc.campus_id IS NULL)
         OR (n=1 AND sc.scope_kind='CAMPUS' AND sc.campus_id=placement.campus_id)
         OR (n=1 AND sc.scope_kind='CLASS' AND sc.class_offering_id=placement.class_id)
         OR (n=1 AND sc.scope_kind='SECTION' AND sc.section_offering_id=placement.section_id)));
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_student_emergency_contact_authorized(uuid,text,uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_student_emergency_contact_authorized(uuid,text,uuid,uuid)
 TO schoolos_student_executor,schoolos_workflow_executor,schoolos_read_executor;

CREATE FUNCTION app_private.d1_student_emergency_contact_policy(p_student uuid)
RETURNS TABLE(policy_id uuid,route_mode text,campus_id uuid)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE at_time timestamptz:=pg_catalog.clock_timestamp(); on_date date:=at_time::date; target_campus uuid; n bigint;
  school_n bigint; campus_n bigint; school_p uuid; school_r text; campus_p uuid; campus_r text; chosen uuid; route text; steps bigint; invalid bigint;
BEGIN
  SELECT count(*) INTO n FROM app_private.enrollments e WHERE e.student_id=p_student AND e.placement_kind='PRIMARY'
    AND e.placement_state='ACTIVE' AND e.effective_from<=on_date AND (e.effective_until IS NULL OR on_date<e.effective_until);
  IF n>1 THEN RETURN; END IF;
  IF n=1 THEN SELECT co.campus_id INTO target_campus FROM app_private.enrollments e
    JOIN app_private.section_offerings so ON so.id=e.section_offering_id JOIN app_private.class_offerings co ON co.id=so.class_offering_id
    WHERE e.student_id=p_student AND e.placement_kind='PRIMARY' AND e.placement_state='ACTIVE'
      AND e.effective_from<=on_date AND (e.effective_until IS NULL OR on_date<e.effective_until); END IF;
  SELECT count(*),min(v.id::text)::uuid,min(v.d1_route_mode) INTO school_n,school_p,school_r
    FROM app_private.approval_policy_versions v JOIN app_private.operation_contracts o ON o.id=v.operation_id
   WHERE o.code='student.emergency_contact.change' AND o.contract_version=1 AND o.enabled AND v.state='ACTIVE' AND v.campus_id IS NULL
     AND v.d1_route_mode IN ('DIRECT','APPROVAL') AND v.effective_from<=at_time AND (v.effective_until IS NULL OR at_time<v.effective_until);
  IF target_campus IS NULL THEN IF school_n<>1 THEN RETURN; END IF; chosen:=school_p; route:=school_r;
  ELSE
    SELECT count(*),min(v.id::text)::uuid,min(v.d1_route_mode) INTO campus_n,campus_p,campus_r
      FROM app_private.approval_policy_versions v JOIN app_private.operation_contracts o ON o.id=v.operation_id
     WHERE o.code='student.emergency_contact.change' AND o.contract_version=1 AND o.enabled AND v.state='ACTIVE' AND v.campus_id=target_campus
       AND v.d1_route_mode IN ('DIRECT','APPROVAL') AND v.effective_from<=at_time AND (v.effective_until IS NULL OR at_time<v.effective_until);
    IF campus_n>1 OR school_n>1 THEN RETURN; END IF;
    IF campus_n=1 THEN chosen:=campus_p; route:=campus_r; ELSIF school_n=1 THEN chosen:=school_p; route:=school_r; ELSE RETURN; END IF;
  END IF;
  IF route='APPROVAL' THEN
    SELECT count(*),count(*) FILTER (WHERE r.id IS NULL OR r.state<>'ACTIVE' OR t.required_reviews<>1
      OR t.selection_resolver_key IS DISTINCT FROM 'D1_REVIEWER_ROLE_SCOPE') INTO steps,invalid
      FROM app_private.approval_step_templates t LEFT JOIN app_private.roles r ON r.id=t.reviewer_role_id WHERE t.policy_id=chosen;
    IF steps=0 OR invalid<>0 THEN RETURN; END IF;
  END IF;
  RETURN QUERY SELECT chosen,route,target_campus;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_student_emergency_contact_policy(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_student_emergency_contact_policy(uuid) TO schoolos_student_executor,schoolos_workflow_executor,schoolos_read_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_authz_reader;

GRANT CREATE ON SCHEMA app_private TO schoolos_student_executor;
SET ROLE schoolos_student_executor;
CREATE FUNCTION app_private.d1_student_emergency_contact_preflight(
 p_student uuid,p_expected_student_version bigint,p_action text,p_source uuid,p_person uuid,p_contact_name text,
 p_relationship text,p_phone text,p_email text,p_effective_on date,p_reason text
) RETURNS TABLE(eligible boolean,error_code text,source_effective_from date)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE sver bigint; src app_private.student_emergency_contacts%ROWTYPE; dup bigint; normalized_name text;
BEGIN
  SELECT s.row_version INTO sver FROM app_private.students s WHERE s.id=p_student FOR UPDATE;
  IF sver IS NULL THEN RETURN QUERY SELECT false,'D1_EMERGENCY_CONTACT_STUDENT_MISSING',NULL::date; RETURN; END IF;
  IF sver IS DISTINCT FROM p_expected_student_version THEN RETURN QUERY SELECT false,'D1_EMERGENCY_CONTACT_VERSION_STALE',NULL::date; RETURN; END IF;
  IF p_action NOT IN ('ADD','END','CORRECT') OR p_effective_on IS NULL OR p_reason IS NULL OR pg_catalog.length(pg_catalog.btrim(p_reason))=0 THEN
    RETURN QUERY SELECT false,'D1_EMERGENCY_CONTACT_INTENT_INVALID',NULL::date; RETURN; END IF;
  IF p_action='END' THEN
    IF p_source IS NULL OR p_person IS NOT NULL OR p_contact_name IS NOT NULL OR p_relationship IS NOT NULL OR p_phone IS NOT NULL OR p_email IS NOT NULL THEN
      RETURN QUERY SELECT false,'D1_EMERGENCY_CONTACT_END_SHAPE_INVALID',NULL::date; RETURN; END IF;
  ELSE
    IF (p_person IS NULL)=(p_contact_name IS NULL) OR (p_contact_name IS NOT NULL AND pg_catalog.length(pg_catalog.btrim(p_contact_name))=0)
       OR p_relationship IS NULL OR pg_catalog.length(pg_catalog.btrim(p_relationship))=0
       OR p_phone IS NULL OR pg_catalog.length(pg_catalog.btrim(p_phone))=0
       OR (p_email IS NOT NULL AND pg_catalog.length(pg_catalog.btrim(p_email))=0)
       OR (p_person IS NOT NULL AND NOT EXISTS (SELECT 1 FROM app_private.people x WHERE x.id=p_person)) THEN
      RETURN QUERY SELECT false,'D1_EMERGENCY_CONTACT_FACTS_INVALID',NULL::date; RETURN; END IF;
    IF p_action='ADD' AND p_source IS NOT NULL THEN RETURN QUERY SELECT false,'D1_EMERGENCY_CONTACT_ADD_SOURCE_INVALID',NULL::date; RETURN; END IF;
    IF p_action='CORRECT' AND p_source IS NULL THEN RETURN QUERY SELECT false,'D1_EMERGENCY_CONTACT_CORRECT_SOURCE_MISSING',NULL::date; RETURN; END IF;
  END IF;
  IF p_source IS NOT NULL THEN
    SELECT * INTO src FROM app_private.student_emergency_contacts x WHERE x.id=p_source AND x.student_id=p_student FOR UPDATE;
    IF NOT FOUND OR src.effective_until IS NOT NULL OR EXISTS (SELECT 1 FROM app_private.student_emergency_contacts y WHERE y.student_id=p_student AND y.supersedes_id=src.id) THEN
      RETURN QUERY SELECT false,'D1_EMERGENCY_CONTACT_SOURCE_STALE',NULL::date; RETURN; END IF;
    IF p_effective_on<=src.effective_from THEN RETURN QUERY SELECT false,'D1_EMERGENCY_CONTACT_DATE_INVALID',src.effective_from; RETURN; END IF;
    IF p_action='CORRECT' AND src.person_id IS NOT DISTINCT FROM p_person
       AND src.contact_name IS NOT DISTINCT FROM (CASE WHEN p_contact_name IS NULL THEN NULL ELSE pg_catalog.btrim(p_contact_name) END)
       AND src.relationship_label IS NOT DISTINCT FROM pg_catalog.btrim(p_relationship)
       AND src.contact_phone IS NOT DISTINCT FROM pg_catalog.btrim(p_phone)
       AND src.contact_email IS NOT DISTINCT FROM (CASE WHEN p_email IS NULL THEN NULL ELSE pg_catalog.btrim(p_email) END) THEN
      RETURN QUERY SELECT false,'D1_EMERGENCY_CONTACT_NOOP',src.effective_from; RETURN; END IF;
  END IF;
  IF p_action<>'END' THEN
    normalized_name:=CASE WHEN p_contact_name IS NULL THEN NULL ELSE pg_catalog.lower(pg_catalog.btrim(p_contact_name)) END;
    SELECT count(*) INTO dup FROM app_private.student_emergency_contacts x
     WHERE x.student_id=p_student AND (p_source IS NULL OR x.id<>p_source)
       AND (x.effective_until IS NULL OR p_effective_on<x.effective_until)
       AND ((p_person IS NOT NULL AND x.person_id=p_person)
         OR (p_person IS NULL AND x.person_id IS NULL AND pg_catalog.lower(pg_catalog.btrim(x.contact_name))=normalized_name
             AND pg_catalog.btrim(x.contact_phone)=pg_catalog.btrim(p_phone)))
       AND NOT EXISTS (SELECT 1 FROM app_private.student_emergency_contacts z WHERE z.student_id=p_student AND z.supersedes_id=x.id);
    IF dup<>0 THEN RETURN QUERY SELECT false,'D1_EMERGENCY_CONTACT_DUPLICATE_IDENTITY',CASE WHEN p_source IS NULL THEN NULL ELSE src.effective_from END; RETURN; END IF;
  END IF;
  RETURN QUERY SELECT true,NULL::text,CASE WHEN p_source IS NULL THEN NULL ELSE src.effective_from END;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_student_emergency_contact_preflight(uuid,bigint,text,uuid,uuid,text,text,text,text,date,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_student_emergency_contact_preflight(uuid,bigint,text,uuid,uuid,text,text,text,text,date,text)
 TO schoolos_student_executor,schoolos_workflow_executor;

CREATE FUNCTION app_private.d1_student_emergency_contact_effect(
 p_actor uuid,p_student uuid,p_expected_student_version bigint,p_action text,p_source uuid,p_person uuid,p_contact_name text,
 p_relationship text,p_phone text,p_email text,p_effective_on date,p_reason text
) RETURNS TABLE(contact_id uuid,source_contact_id uuid,action text,effective_from date,effective_until date,student_version bigint)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $body$
DECLARE pre record; new_id uuid:=pg_catalog.gen_random_uuid(); src_from date;
BEGIN
  IF p_actor IS DISTINCT FROM app_private.current_principal_id() THEN RAISE EXCEPTION 'D1 Emergency Contact actor denied'; END IF;
  SELECT * INTO pre FROM app_private.d1_student_emergency_contact_preflight(p_student,p_expected_student_version,p_action,p_source,p_person,
    p_contact_name,p_relationship,p_phone,p_email,p_effective_on,p_reason);
  IF pre.eligible IS DISTINCT FROM true THEN RAISE EXCEPTION 'D1 Emergency Contact preflight denied: %',pre.error_code; END IF;
  src_from:=pre.source_effective_from;
  IF p_action IN ('END','CORRECT') THEN
    UPDATE app_private.student_emergency_contacts SET effective_until=p_effective_on,ended_at=pg_catalog.statement_timestamp(),ended_by=p_actor
     WHERE id=p_source AND student_id=p_student AND effective_until IS NULL;
    IF NOT FOUND THEN RAISE EXCEPTION 'D1 Emergency Contact source changed'; END IF;
  END IF;
  IF p_action IN ('ADD','CORRECT') THEN
    INSERT INTO app_private.student_emergency_contacts
      (id,student_id,person_id,contact_name,relationship_label,contact_phone,contact_email,effective_from,reason,supersedes_id,created_by)
    VALUES (new_id,p_student,p_person,CASE WHEN p_contact_name IS NULL THEN NULL ELSE pg_catalog.btrim(p_contact_name) END,
      pg_catalog.btrim(p_relationship),pg_catalog.btrim(p_phone),CASE WHEN p_email IS NULL THEN NULL ELSE pg_catalog.btrim(p_email) END,
      p_effective_on,pg_catalog.btrim(p_reason),CASE WHEN p_action='CORRECT' THEN p_source ELSE NULL END,p_actor);
    RETURN QUERY SELECT new_id,p_source,p_action,p_effective_on,NULL::date,p_expected_student_version;
  ELSE
    RETURN QUERY SELECT p_source,p_source,p_action,src_from,p_effective_on,p_expected_student_version;
  END IF;
END $body$;
REVOKE ALL ON FUNCTION app_private.d1_student_emergency_contact_effect(uuid,uuid,bigint,text,uuid,uuid,text,text,text,text,date,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION app_private.d1_student_emergency_contact_effect(uuid,uuid,bigint,text,uuid,uuid,text,text,text,text,date,text)
 TO schoolos_student_executor,schoolos_workflow_executor;
RESET ROLE;
REVOKE CREATE ON SCHEMA app_private FROM schoolos_student_executor;